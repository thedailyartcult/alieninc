[Unit]
Description=CMB MCP server over Streamable HTTP (localhost:8765)
After=network.target cmb-engine.service
Wants=cmb-engine.service

[Service]
Type=simple
User=cmb
Group=cmb
ExecStart=/srv/cmb/venv/bin/cmb-mcp-http
EnvironmentFile=/srv/cmb/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
