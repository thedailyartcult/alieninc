[Unit]
Description=Centra Compliance Scanner
After=network.target alieninc.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/alieninc/centra/engine
ExecStart=/usr/bin/python3 /home/alieninc/centra/engine/compliance_report.py
StandardOutput=append:/home/alieninc/centra/engine/compliance-scan.log
StandardError=append:/home/alieninc/centra/engine/compliance-scan.log
