function open(){PANEL.classList.remove('yono-hidden','yono-min');setTimeout(function(){input.focus();},300);
  if(!sessionId)boot();}
function close(){
  if(docked){ // × while docked: put the agent away and hand the column back to Maven
    floatWasHidden=true;undock(true);
    if(window.__mavenSetFeature){try{window.__mavenSetFeature('maven');}catch(e){}}
    return;
  }
  PANEL.classList.add('yono-hidden');
}
function minimize(){PANEL.classList.add('yono-min');}
/* --- Maven AGENT-feature docking: one #yono-panel instance, two homes.
   Floating = original body-level spot; Docked = inside section[data-mpanel="yono"]
   with data-mfeat="yono" owning the maven column (mirrors GAIA/WONote routing). */
const HOME_PARENT=PANEL.parentNode,HOME_NEXT=PANEL.nextSibling;
const DOCK_SEC=document.querySelector('#mavenLeftCol section[data-mpanel="yono"]');
let docked=false,floatWasHidden=true;
function dock(){
  if(docked)return;
  floatWasHidden=PANEL.classList.contains('yono-hidden');
  if(DOCK_SEC){DOCK_SEC.appendChild(PANEL);docked=true;}
  else return;
  PANEL.classList.remove('yono-hidden','yono-min');
  if(window.__mavenSetFeature){try{window.__mavenSetFeature('yono');}catch(e){}} // claim the column (GAIA/WONote routing contract)
  if(!sessionId)boot();
}
function undock(restoreHidden){
  if(!docked)return;
  docked=false;
  if(HOME_NEXT&&HOME_NEXT.parentNode===HOME_PARENT)HOME_PARENT.insertBefore(PANEL,HOME_NEXT);
  else HOME_PARENT.appendChild(PANEL);
  PANEL.classList.toggle('yono-hidden',restoreHidden===true?true:floatWasHidden);
}
function toggle(){
  if(docked){ // Ctrl+Shift+Y pulls it out of Maven: float it and hand the column back
    floatWasHidden=false;undock(false);
    if(window.__mavenSetFeature){try{window.__mavenSetFeature('maven');}catch(e){}}
    open();return;
  }
  PANEL.classList.contains('yono-hidden')?open():close();
}
window.YonoAgent={toggle:toggle,open:open,close:close,dock:dock,undock:function(r){undock(r);},
  isDocked:function(){return docked;}};

async function replayHistory(){
  if(!sessionId)return false;
  try{
    const h=await apiCall('/yono/panel/history?session_id='+encodeURIComponent(sessionId));
    for(const m of h.messages){
      if(m.role==='user')bubble('yono-msg-user',m.content);
      else botHtml(mdLite(m.content));
    }
    return h.messages.length>0;
  }catch(e){
    try{localStorage.removeItem(LS_SESSION);}catch(_){}
    sessionId=null;return false;
  }
}

async function boot(){
  try{
    const s=await apiCall('/yono/panel/status');
    modelName=(s.model&&(s.model.display_name||s.model.model_id))||'no model';
    badge.textContent=modelName;
    statusEl.textContent=s.open_proposals?('· '+s.open_proposals+' open proposal'+(s.open_proposals>1?'s':'')):'';
    if(!sessionId){try{sessionId=localStorage.getItem(LS_SESSION)||null;}catch(e){}}
    if(sessionId){
      const had=await replayHistory();
      if(had)return;
    }
    botHtml('<b>'+esc(s.agent?s.agent.display_name:'YONO')+'</b> online — grounded in the Spinal Cracker ontology'
      +'('+((s.agent&&s.agent.allowed_object_types)||[]).length+' readable types)'
      +'. Ask about objects, links, latest activity, or propose governed actions.');
  }catch(e){badge.textContent='offline';badge.style.background='rgba(255,255,255,.2)';
    bubble('yono-msg-err','Cannot reach YONO service: '+e.message);}
}
try{sessionId=localStorage.getItem(LS_SESSION);}catch(e){}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot);}else{boot();}
window.YONO={open:open,close:close,toggle:toggle,minimize:minimize,
  get isOpen(){return !PANEL.classList.contains('yono-hidden');},
  get sessionId(){return sessionId;}};
window.__yonoCloseForMss = close;
window.__yonoDockForMss = dock;
window.__yonoUndockForMss = undock;
})();
</script>
<script id="mss-gateway-engine">
/* ══════════════════════════════════════════════════════════════════════
   MSS MODE GATEWAY — Manual vs Automatic for the MAVEN SMART SYSTEM.
   No backend. Per-browser localStorage (mss_mode). Map stays live.
   Manual → full deck (MAVEN|GEO|NOTES|AGENT feat-bar + drawer).
   Automatic → YONO-only column, YONO docked + greeting.
   ══════════════════════════════════════════════════════════════════════ */
(function(){
  "use strict";
  var LS='mss_mode';
  var COL_ID='mavenLeftCol', GW_ID='mssGateway', TOG_ID='mssModeToggle', GW_MODEL_ID='mssGwModel';
  function col(){return document.getElementById(COL_ID);}
  function gw(){return document.getElementById(GW_ID);}
  function tog(){return document.getElementById(TOG_ID);}
  function getMode(){try{return localStorage.getItem(LS);}catch(e){return null;}}
  function setMode(v){
    try{if(v===null) localStorage.removeItem(LS); else localStorage.setItem(LS,String(v));}catch(e){}
    renderToggle();
  }
  function renderToggle(){
    var t=tog(); if(!t) return;
    var m=getMode();
    var c=col(), isGw=c && c.getAttribute('data-mfeat')==='gateway';
    if(isGw){ t.textContent='MODE \u25c6'; t.title='MSS mode select — pick Manual or Automatic'; }
    else if(m==='automatic'){ t.textContent='AUTOMATIC \u21bb'; t.title='MSS is Automatic — click to return to Mode Select'; }
    else if(m==='manual'){ t.textContent='MANUAL \u21bb'; t.title='MSS is Manual — click to return to Mode Select'; }
    else { t.textContent='MSS \u25c6'; t.title='Choose MSS mode'; }
    t.style.display='';
    var bar=document.getElementById('mssSwitchBar');
    if(bar){ bar.classList.toggle('mss-hidden', !!isGw || !m); }
  }
  function syncGwModel(){
    var el=document.getElementById(GW_MODEL_ID); if(!el) return;
    var b=document.getElementById('yonoModelBadge');
    var txt=b ? (b.textContent||'').trim() : '';
    el.textContent = txt ? ('YONO \u00b7 '+txt) : 'YONO \u2014 connecting\u2026';
  }
  function showGateway(){
    var c=col(), g=gw(); if(!c||!g) return;
    if(c.getAttribute('data-mfeat')!=='gateway'){
      try{c.setAttribute('data-mss-prev', c.getAttribute('data-mfeat')||'maven');}catch(e){}
    }
    c.setAttribute('data-mfeat','gateway');
    var ap2=document.getElementById('mssAutoPanel'); if(ap2) ap2.classList.add('mss-hidden');
    g.classList.remove('mss-hidden');
    // dimension reveal — whole section as Panteon section (index.html 87 dim-overlay + 543 reveal)
    var dim=document.getElementById('mssDimOverlay');
    if(dim){ dim.classList.remove('dim-passed'); void dim.offsetWidth; }
    var lines=g.querySelectorAll('.reveal-text-line');
    lines.forEach(function(l){ l.classList.remove('revealed'); });
    g.classList.remove('mss-enter'); g.classList.add('mss-enter-pre');
    void g.offsetWidth;
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      if(dim) dim.classList.add('dim-passed');
      lines.forEach(function(l,i){
        setTimeout(function(){ l.classList.add('revealed'); }, 80 + i*140);
      });
      g.classList.remove('mss-enter-pre'); g.classList.add('mss-enter');
      setTimeout(function(){ g.classList.remove('mss-enter'); }, 900);
    });});
    if(window.YonoAgent && window.YonoAgent.isDocked && window.YonoAgent.isDocked()){ try{window.YonoAgent.undock(true);}catch(e){} }
    syncGwModel(); renderToggle();
    var b=document.getElementById('yonoModelBadge');
    if(b && !b.__mssObs){
      b.__mssObs=true;
      try{new MutationObserver(syncGwModel).observe(b,{childList:true,characterData:true,subtree:true});}catch(e){}
    }
  }
  function _runSkeletonThen(mode, done){
    var c0=col();
    // whole-section build: hide real content while skeleton frame + WebGL constructs the section
    if(c0) c0.classList.add('mss-building');
    var hasSkeleton = typeof window.__mssSkeletonRun==='function';
    var reduced=false; try{ reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){}
    var wrapped=function(){
      if(c0) c0.classList.remove('mss-building');
      try{ done(); }catch(e){}
    };
    if(!hasSkeleton || reduced){ wrapped(); return; }
    try{ window.__mssSkeletonRun(mode, wrapped); }catch(e){ wrapped(); }
  }
  function enterManual(){
    setMode('manual');
    var exec=function(){
      var c=col(), g=gw(), ap=document.getElementById('mssAutoPanel');
      if(c) c.setAttribute('data-mfeat','maven');
      if(g) g.classList.add('mss-hidden');
      if(ap) ap.classList.add('mss-hidden');
      // stop voice if leaving automatic
      if(window.__mssAuto && ap && ap.classList.contains('mss-voice-listening')){ /* voice stays off */ }
      if(window.__mavenSetFeature) try{window.__mavenSetFeature('maven');}catch(e){}
      if(window.YonoAgent && window.YonoAgent.isDocked && window.YonoAgent.isDocked()){ try{window.YonoAgent.undock(true);}catch(e){} }
      var yp=document.getElementById('yono-panel');
      if(yp && !yp.classList.contains('yono-hidden') && !(window.YonoAgent&&window.YonoAgent.isDocked&&window.YonoAgent.isDocked())){
        yp.classList.add('yono-hidden');
      }
      renderToggle();
      setTimeout(function(){ var m=window.fusionMap|| (typeof getMap==='function'?getMap():null); if(m) try{m.resize();}catch(e){} },260);
    };
    // Manual is instant — no skeleton/terrain build
    exec();
  }
  function enterAutomatic(){
    setMode('automatic');
    var exec=function(){
      var c=col(), g=gw(), ap=document.getElementById('mssAutoPanel');
      if(g) g.classList.add('mss-hidden');
      if(c) c.setAttribute('data-mfeat','automatic');
      if(ap){ ap.classList.remove('mss-hidden'); }
      // ensure YONO floating is hidden — Automatic is voice-only, not YONO dock
      if(window.YonoAgent && window.YonoAgent.isDocked && window.YonoAgent.isDocked()){ try{window.YonoAgent.undock(true);}catch(e){} }
      var yp=document.getElementById('yono-panel');
      if(yp && !yp.classList.contains('yono-hidden')) yp.classList.add('yono-hidden');
      // init spinal circle + voice
      if(window.__mssAuto && window.__mssAuto.ensureCircle) try{ window.__mssAuto.ensureCircle(); }catch(e){}
      if(typeof window.updateVoiceModel==='function') try{ window.updateVoiceModel(); }catch(e){}
      // keep model badge in sync for Automatic foot
      syncGwModel();
      var vm=document.getElementById('mssVoiceModel');
      if(vm){
        var b=document.getElementById('yonoModelBadge');
        var t=b? (b.textContent||'').trim():''; vm.textContent=t?('YONO · '+t):'YONO';
      }
      renderToggle();
      setTimeout(function(){ var m=window.fusionMap|| (typeof getMap==='function'?getMap():null); if(m) try{m.resize();}catch(e){} },260);
    };
    _runSkeletonThen('automatic', exec);
  }
  function onFusionEnter(){
    var c=col(); if(!c) return;
    // don't hijack if user collapsed column
    if(c.classList.contains('collapsed')) return;
    var m=getMode();
    if(m==='manual'){ if(c.getAttribute('data-mfeat')==='gateway') enterManual(); renderToggle(); return; }
    if(m==='automatic'){ enterAutomatic(); return; }
    // first visit — show gateway
    showGateway();
  }
  // wire gateway cards + header toggle — tap feedback then governed enter
  function wire(){
    var g=gw(); if(!g||g.__wired) return; g.__wired=true;
    g.querySelectorAll('[data-mss]').forEach(function(b){
      b.addEventListener('click', function(){
        var v=b.getAttribute('data-mss');
        b.classList.add('is-selecting');
        setTimeout(function(){
          b.classList.remove('is-selecting');
          if(v==='manual') enterManual();
          else if(v==='automatic') enterAutomatic();
        }, 160);
      });
    });
    var t=tog(); if(t && !t.__wired){ t.__wired=true; t.addEventListener('click', function(){ showGateway(); });}
    var sb=document.getElementById('mssSwitchBtn'); if(sb && !sb.__wired){ sb.__wired=true; sb.addEventListener('click', function(){ showGateway(); }); }
    var bar=document.getElementById('mssSwitchBar'); if(bar && !bar.__mssObs){
      bar.__mssObs=true;
      // allow double-click header also toggles - keep current behavior
    }
    // keyboard 1/2 while gateway visible
    document.addEventListener('keydown', function(e){
      var c=col(); if(!c || c.getAttribute('data-mfeat')!=='gateway') return;
      if(e.key==='1'){ e.preventDefault(); enterManual(); }
      if(e.key==='2'){ e.preventDefault(); enterAutomatic(); }
      if(e.key==='Escape'){ e.preventDefault(); // gateway is mandatory first visit, but Esc after mode set returns to that mode
        var m=getMode(); if(m==='manual') enterManual(); else if(m==='automatic') enterAutomatic();
      }
    });
  }
  // YONO × in automatic should return to gateway, not to maven
  (function patchYonoClose(){
    var iv=setInterval(function(){
      if(!window.YONO || !window.__yonoCloseForMss) return;
      if(window.__yonoCloseForMss.__mssPatched) { clearInterval(iv); return; }
      // wrap close via YONO object
      var origClose=window.__yonoCloseForMss;
      var wrapped=function(){
        var m=getMode();
        var docked=window.YonoAgent && window.YonoAgent.isDocked && window.YonoAgent.isDocked();
        if(m==='automatic' && docked){
          showGateway(); return;
        }
        return origClose.apply(this, arguments);
      };
      window.__yonoCloseForMss.__mssPatched=true;
      wrapped.__mssPatched=true;
      window.__yonoCloseForMss=wrapped;
      // also patch window.YONO.close and YonoAgent.close
      if(window.YONO) window.YONO.close=wrapped;
      if(window.YonoAgent) window.YonoAgent.close=function(){ return wrapped(); };
      // patch toggle: Ctrl+Shift+Y in automatic should keep automatic (re-dock)
      clearInterval(iv);
    }, 400);
  })();
  // expose
  window.__mssOnFusionEnter = onFusionEnter;
  window.__mssShowGateway = showGateway;
  window.__mssEnterManual = enterManual;
  window.__mssEnterAutomatic = enterAutomatic;
  window.__mssGetMode = getMode;
  // boot
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ wire(); renderToggle(); syncGwModel(); });
  else { wire(); renderToggle(); syncGwModel(); }
  // if already on sc-fusion at load (deep link), trigger after a tick once fusionMap pane is visible
  setTimeout(function(){
    var sc=document.getElementById('page-sc-fusion');
    if(sc && !sc.classList.contains('hidden') && sc.offsetParent!==null) onFusionEnter();
  }, 900);
})();
</script>
<script id="mss-terrain-engine">
/* ══════════════════════════════════════════════════════════════════════
   MSS WEBGL TERRAIN/SEA — Bullagao point-cloud port for the gateway
   column (gateway-only 372px). OVERRIDE per operator 2026-08-29:
   brings three.js r128 into admin.html outside terranean guard.
   Manual = mountain (dark), Automatic = sea (Abyss blue + wave).
   Pauses when gateway hidden/collapsed/reduced-motion.
   ══════════════════════════════════════════════════════════════════════ */
(function initMssTerrain(){
  "use strict";
  var LS='mss_mode';
  function getMode(){ try{ return localStorage.getItem(LS); }catch(e){ return null; } }
  function isReduced(){ try{ return window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){ return false; } }
  if(isReduced()) return;
  // Skeleton transform is the primary render — gateway bg canvas stays as fallback, hidden when skeleton WebGL live
  var canvas=document.getElementById('mssSkeletonCanvas');
  var sk=document.getElementById('mssSkeleton');
  var bgCanvas=document.getElementById('mssWebglCanvas');
  var gateway=document.getElementById('mssGateway');
  var col=document.getElementById('mavenLeftCol');
  if(!canvas||!sk||!gateway) return;
  if(typeof THREE==='undefined'){
    var bg=document.querySelector('.mss-scan-bg'), ln=document.querySelector('.mss-scan-line');
    if(bg) bg.classList.add('mss-fallback-on'); if(ln) ln.classList.add('mss-fallback-on');
    return;
  }
  var renderer;
  try{ renderer=new THREE.WebGLRenderer({canvas:canvas, antialias:false, alpha:true, powerPreference:'high-performance'});}catch(e){
    console.warn('[MSS] WebGL init failed',e);
    var bg2=document.querySelector('.mss-scan-bg'), ln2=document.querySelector('.mss-scan-line');
    if(bg2) bg2.classList.add('mss-fallback-on'); if(ln2) ln2.classList.add('mss-fallback-on');
    if(bgCanvas) bgCanvas.classList.add('mss-webgl-hidden');
    return;
  }
  // skeleton covers full left column (not just gateway) — portrait 372px x col height
  function sizeCanvas(){
    var w=col ? (col.clientWidth||372) : 372;
    var h=col ? (col.clientHeight||520) : 520;
    if(h<200) h=520;
    if(w<100) w=372;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio||1, 1.5));
    renderer.setSize(w, h, false);
    return {w:w,h:h};
  }
  var sz=sizeCanvas();
  var scene=new THREE.Scene();
  var colFogDark=new THREE.Color(0x000000);
  var colFogSea=new THREE.Color(0x00111a);
  var colBaseDark=new THREE.Color(0x181e24);
  var colBaseSea=new THREE.Color(0x0a1e2e);
  var colNeonDark=new THREE.Color(0xDFF140);
  var colNeonSea=new THREE.Color(0x80e0ff);
  var colWireDark=new THREE.Color(0x11161b);
  var colWireSea=new THREE.Color(0x0e2a3a);
  var currentFog=new THREE.Color(0x000000);
  var currentWire=new THREE.Color(0x11161b);
  scene.fog=new THREE.FogExp2(0x000000, 0.0028);
  renderer.setClearColor(0x000000, 1.0);
  // nadir plan view — whole section builds as topographic plan filling the column rectangle
  var camera=new THREE.PerspectiveCamera(48, sz.w/sz.h, 1, 3000);
  camera.position.set(0, 620, 0.1);
  camera.lookAt(0, 0, 0);
