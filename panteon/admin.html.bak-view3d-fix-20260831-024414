function attachHelpChip(el, text) {
    if (!el || !text || el.hasAttribute('data-help')) return;
    const flexGrow = parseFloat(window.getComputedStyle(el).flexGrow) || 0;
    const wrap = document.createElement('span');
    wrap.className = 'help-wrap';
    if (flexGrow > 0) {
        wrap.style.flex = flexGrow + ' 1 0px';
        el.style.flex = '0 1 auto';
        el.style.width = '100%';
    }
    el.parentNode.insertBefore(wrap, el);
    wrap.appendChild(el);
    const chip = document.createElement('span');
    chip.className = 'help-chip';
    chip.textContent = 'i';
    chip.setAttribute('role', 'img');
    chip.setAttribute('aria-label', 'About this control: ' + text);
    chip.setAttribute('tabindex', '0');
    const tip = document.createElement('span');
    tip.className = 'help-tip';
    tip.textContent = text;
    chip.appendChild(tip);
    wrap.appendChild(chip);
    el.setAttribute('data-help', '1');
}

