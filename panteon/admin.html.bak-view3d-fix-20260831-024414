    // Single-open platform accordion — nav-section-title = platform, nav-items = features.
    // Exactly one section open at a time; navigation force-reveals the active platform's
    // section via window.revealNavSection(). Rail mode ignores folding entirely (CSS-scoped).
    (function () {
        const LS_NAVSEC = 'sc_nav_sections_v1';
        const sections = Array.from(document.querySelectorAll('.sidebar-nav .nav-section'));
        if (!sections.length) return;

        function titleOf(sec) {
            const t = sec.querySelector('.nav-section-title');
            return t ? t.textContent.trim() : '';
        }
        function openSec(sec, persist) {
            sections.forEach(s => {
                const on = s === sec;
                s.classList.toggle('collapsed', !on);
                const t = s.querySelector('.nav-section-title');
                if (t) t.setAttribute('aria-expanded', on ? 'true' : 'false');
            });
            if (persist !== false) {
                try { localStorage.setItem(LS_NAVSEC, JSON.stringify(titleOf(sec))); } catch (e) {}
            }
        }
        function foldSec(sec) {
            sec.classList.add('collapsed');
            const t = sec.querySelector('.nav-section-title');
            if (t) t.setAttribute('aria-expanded', 'false');
            try { localStorage.setItem(LS_NAVSEC, JSON.stringify('')); } catch (e) {}
        }
        function sectionForItem(item) {
            let n = item;
            while (n && !n.classList.contains('nav-section')) n = n.parentElement;
            return n && sections.indexOf(n) >= 0 ? n : null;
        }
        // Auto-reveal: open the section owning a page/tool id when it is currently folded
        window.revealNavSection = function (id) {
            if (!id) return;
            const item = document.querySelector('.nav-item[data-page="' + id + '"]') ||
                         (id === 'gaia' ? document.getElementById('gaiaNavItem') : null) ||
                         (id === 'won' ? document.getElementById('wonNavItem') : null);
            const sec = item ? sectionForItem(item) : null;
            if (sec && sec.classList.contains('collapsed')) openSec(sec, false);
        };

        sections.forEach(sec => {
            const t = sec.querySelector('.nav-section-title');
            if (!t) return;
            t.setAttribute('role', 'button');
            t.setAttribute('tabindex', '0');
            t.setAttribute('aria-expanded', sec.classList.contains('collapsed') ? 'false' : 'true');
            const toggle = () => { sec.classList.contains('collapsed') ? openSec(sec, true) : foldSec(sec); };
            t.addEventListener('click', toggle);
            t.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
            });
        });

        // Boot: reveal the active page's platform; fall back to persisted choice, else first section
        let stored = '';
        try { stored = JSON.parse(localStorage.getItem(LS_NAVSEC)) || ''; } catch (e) {}
        const activeItem = document.querySelector('.sidebar-nav .nav-item.active');
        let target = activeItem ? sectionForItem(activeItem) : null;
        if (!target && stored) target = sections.find(s => titleOf(s) === stored) || null;
        openSec(target || sections[0], false);
        requestAnimationFrame(() => {
            const sb = document.querySelector('.sidebar');
            if (sb) sb.classList.add('sc-nav-ready');
