    function refreshStatuses() {
        REGISTRY.forEach(function (d) {
            var row = listEl.querySelector('[data-layer="' + d.id + '"]');
            if (!row) return;
            var st = state[d.id] || {};
            var tag = 'IDLE', cls = 'dim';
            if (!hasProvider(d.id) && !d.host && !st.on) { tag = 'NO FEED'; cls = 'dim'; }
            else if (!st.on) { tag = 'IDLE'; cls = 'dim'; }
            else {
                if (d.host === 'threats') {
                    var nT = Array.isArray(window.fusionThreatEvents) ? window.fusionThreatEvents.length : 0;
                    if (nT > 0) { tag = nT + ' EV'; cls = 'live'; } else { tag = window.fusionMap ? 'EMPTY' : 'STANDBY'; cls = 'warn'; }
                } else if (d.host === 'aviation') {
                    var nA = Array.isArray(window.fusionFlights) ? window.fusionFlights.length : 0;
                    if (nA > 0) { tag = nA + ' TRK'; cls = 'live'; } else { tag = window.fusionMap ? 'EMPTY' : 'STANDBY'; cls = 'warn'; }
                } else if (d.id === 'drones') {
                    if (droneTimer) { tag = dronePts.length + ' DRN'; cls = 'live'; }
                    else { tag = 'ARMED'; cls = 'busy'; }
                } else if (d.id === 'satellite') {
                    if (satErr) { tag = satErr.toUpperCase(); cls = 'warn'; }
                    else { tag = 'TILE\u00b7' + gaiaModeShort(); cls = 'live'; }
                } else if (d.id === 'weather') {
                    if (wxErr) { tag = 'NO RADAR'; cls = 'err'; }
                    else if (wxFrameTime) {
                        var ageMin = Math.round((Date.now() - wxFrameTime) / 60000);
                        tag = ageMin >= 20 ? ageMin + 'M OLD' : 'RADAR';
                        cls = ageMin >= 20 ? 'warn' : 'live';
                    } else { tag = 'PULL'; cls = 'busy'; }
                } else if (d.source) {
                    var src = d.source;
                    if (src.status === 'live') {
                        tag = (src.count != null ? src.count + ' ' : '') + (src.type === 'tile' ? 'TILE' : 'OK');
                        cls = 'live';
                    } else if (src.status === 'cached') {
                        tag = 'CACHED';
                        cls = 'warn';
                    } else if (src.status === 'unavailable') {
                        tag = 'DOWN';
                        cls = 'err';
                    } else { tag = 'IDLE'; cls = 'dim'; }
                    if (src.freshness && src.type === 'tile') {
                        var ageH = Math.round((Date.now() - src.freshness) / 3600000);
                        tag += ageH < 1 ? ' NOW' : ageH < 24 ? ' ' + ageH + 'H' : ' ' + Math.round(ageH / 24) + 'D';
                    }
                    if (src.budget) {
                        tag += ' ' + src.budget.used + '/' + src.budget.max;
                    }
                } else { tag = 'ARMED'; cls = 'busy'; }
            }
            var dot = row.querySelector('[data-gaia-dot]');
            var stat = row.querySelector('[data-gaia-status]');
            if (dot) dot.setAttribute('data-status', cls);
            if (stat) { stat.setAttribute('data-status', cls); stat.textContent = tag; }
        });
        syncModeChip();
        metaEl.textContent = REGISTRY.filter(function (d) { return state[d.id] && state[d.id].on; }).length + '/' + REGISTRY.length + ' LAYERS';
    }
    function syncModeChip() {
        if (!modeChip) return;
        var anyData = ((Array.isArray(window.fusionThreatEvents) && window.fusionThreatEvents.length) ||
                       (Array.isArray(window.fusionFlights) && window.fusionFlights.length) ||
                       gaiaObjects.length || dronePts.length);
        var mode, label;
        if (activeFilter) { mode = 'filter'; label = 'FILTERED'; }
        else if (anyData) { mode = 'live'; label = 'LIVE'; }
        else { mode = 'standby'; label = 'STANDBY'; }
        modeChip.setAttribute('data-mode', mode);
        modeChip.textContent = label;
        if (panel) panel.classList.toggle('gaia-mode-filter', activeFilter != null);
    }

    // ------------------------------------------------------- open/close/min/geom
    var geom = loadGeom();
    function loadGeom() {
        try { return JSON.parse(localStorage.getItem(LS_GEOM)) || {}; } catch (e) { return {}; }
    }
    function saveGeom() {
        try {
            localStorage.setItem(LS_GEOM, JSON.stringify({
                w: parseInt(panel.style.width, 10),
                h: parseInt(panel.style.height, 10),
                right: parseInt(panel.style.right, 10),
                top: parseInt(panel.style.top, 10)
            }));
        } catch (e) {}
    }
    function applyGeometry() {
        var vw = window.innerWidth, vh = window.innerHeight;
        var w = clamp(geom.w || 380, 320, Math.min(vw - 16, 560));
        var h = clamp(geom.h || Math.round(vh * 0.72), 260, vh - 24);
        var right = geom.right;
        if (right == null) { // first run: avoid covering an open Watch Notes panel
            right = 20;
            var wp = $('won-panel');
            if (wp && !wp.classList.contains('won-hidden') && !wp.classList.contains('won-min')) right += wp.offsetWidth + 12;
        }
        right = clamp(right, 8, Math.max(8, vw - w - 8));
        var top = clamp(geom.top == null ? 76 : geom.top, 8, Math.max(8, vh - 80));
        panel.style.width = w + 'px';
        if (!minimized) panel.style.height = h + 'px';
        panel.style.right = right + 'px';
        panel.style.top = top + 'px';
    }
    function initDrag() {
        $('gaiaHeader').addEventListener('pointerdown', function (e) {
            if (e.target.closest('button') || e.button !== 0) return;
            e.preventDefault();
            var startX = e.clientX, startY = e.clientY;
            var startRight = parseInt(panel.style.right, 10) || 20;
            var startTop = parseInt(panel.style.top, 10) || 76;
            $('gaiaHeader').setPointerCapture(e.pointerId);
            function onMove(ev) {
                var vw = window.innerWidth, vh = window.innerHeight, w = panel.offsetWidth;
                panel.style.right = clamp(startRight - (ev.clientX - startX), 8, Math.max(8, vw - w - 8)) + 'px';
                panel.style.top = clamp(startTop + (ev.clientY - startY), 8, Math.max(8, vh - 80)) + 'px';
            }
            function onUp() {
                $('gaiaHeader').removeEventListener('pointermove', onMove);
                $('gaiaHeader').removeEventListener('pointerup', onUp);
                saveGeom();
            }
            $('gaiaHeader').addEventListener('pointermove', onMove);
            $('gaiaHeader').addEventListener('pointerup', onUp);
        });
    }
    function initResize() {
        $('gaiaResizeHandle').addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            var startX = e.clientX, startY = e.clientY;
            var startW = panel.offsetWidth, startH = panel.offsetHeight;
            var startRight = parseInt(panel.style.right, 10) || 20;
            $('gaiaResizeHandle').setPointerCapture(e.pointerId);
            function onMove(ev) {
                var vw = window.innerWidth, vh = window.innerHeight;
                var w = clamp(startW + (startX - ev.clientX), 320, vw - 16);
                var h = clamp(startH + (ev.clientY - startY), 260, vh - 24);
                panel.style.width = w + 'px';
                panel.style.height = h + 'px';
                panel.style.right = clamp(startRight - (w - startW), 8, Math.max(8, vw - w - 8)) + 'px';
            }
            function onUp() {
                $('gaiaResizeHandle').removeEventListener('pointermove', onMove);
                $('gaiaResizeHandle').removeEventListener('pointerup', onUp);
                saveGeom();
            }
            $('gaiaResizeHandle').addEventListener('pointermove', onMove);
            $('gaiaResizeHandle').addEventListener('pointerup', onUp);
        });
    }
    function setOpen(v, persist) {
        isOpen = !!v;
        panel.classList.toggle('gaia-hidden', !isOpen);
        // Embedded mode: opening selects the GEO feature in the MAVEN column; closing
        // falls back to the MAVEN layer so the column never shows an empty body.
        if (typeof window.__mavenSetFeature === 'function') {
            try { window.__mavenSetFeature(isOpen ? 'gaia' : 'maven'); } catch (e) {}
        }
        if (persist !== false) { try { localStorage.setItem(LS_OPEN, isOpen ? '1' : '0'); } catch (e) {} }
