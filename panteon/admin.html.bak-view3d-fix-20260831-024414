function renderVolumeChart(history) {
    const el = document.getElementById('volumeChart');
    if (!history || !history.length) { el.innerHTML = '<div class="empty-state">No data</div>'; return; }
    const W = el.clientWidth || 400, H = el.clientHeight || 200;
    const max = Math.max(...history.map(h => h.total_requests), 1);
    const barW = Math.max(2, (W - 40) / history.length - 2);
    let svg = '<svg width="' + W + '" height="' + H + '" style="overflow:visible">';
    history.forEach((h, i) => {
        const x = 20 + i * ((W - 40) / history.length);
        const barH = (h.total_requests / max) * (H - 30);
        svg += '<rect x="' + x + '" y="' + (H - 20 - barH) + '" width="' + barW + '" height="' + barH + '" rx="2" fill="var(--accent-cyan)" opacity="0.7"><title>' + h.timestamp + ': ' + h.total_requests + ' reqs</title></rect>';
    });
    svg += '<line x1="20" y1="' + (H - 20) + '" x2="' + (W - 20) + '" y2="' + (H - 20) + '" stroke="rgba(255,255,255,0.1)" stroke-width="1"/></svg>';
    el.innerHTML = svg;
}

function renderErrorChart(history) {
    const el = document.getElementById('errorChart');
    if (!history || !history.length) { el.innerHTML = '<div class="empty-state">No data</div>'; return; }
    const W = el.clientWidth || 400, H = el.clientHeight || 200;
    const max = Math.max(...history.map(h => h.errors_5xx + h.errors_4xx), 1);
    let svg = '<svg width="' + W + '" height="' + H + '">';
    const stepX = (W - 40) / Math.max(history.length - 1, 1);
    let pts4 = '', pts5 = '';
    history.forEach((h, i) => {
        const x = 20 + i * stepX;
        const y4 = H - 20 - (h.errors_4xx / max) * (H - 30);
        const y5 = H - 20 - (h.errors_5xx / max) * (H - 30);
        pts4 += x + ',' + y4 + ' ';
        pts5 += x + ',' + y5 + ' ';
    });
    svg += '<polyline points="' + pts4 + '" fill="none" stroke="var(--amber)" stroke-width="2"/>';
    svg += '<polyline points="' + pts5 + '" fill="none" stroke="var(--red)" stroke-width="2"/>';
    svg += '<line x1="20" y1="' + (H - 20) + '" x2="' + (W - 20) + '" y2="' + (H - 20) + '" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>';
    svg += '<text x="' + (W - 80) + '" y="16" fill="var(--amber)" font-size="10">4xx</text>';
    svg += '<text x="' + (W - 40) + '" y="16" fill="var(--red)" font-size="10">5xx</text></svg>';
    el.innerHTML = svg;
}

