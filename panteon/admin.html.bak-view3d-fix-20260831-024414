// --- Conflict classification & query presets --------------------------------
// GDELT DOC 2.0 article JSON no longer exposes a per-article tone value, so the
// previous "threat = negative tone" logic always reported 0 active threats.
// DOC headlines are in the article's local language and GDELT matches queries
// against its machine-translated index, so headline keyword matching is
// unreliable. Instead we use the active QUERY as the classifier: coverage
// pulled by a conflict/terror/protest query is conflict-relevant by
// construction. Tone is still used when available; headline keywords are the
// last-resort fallback.
const CONFLICT_KEYWORDS = {
    violence: ["attack", "airstrike", "assault", "bomb", "explosion", "killed", "kill",
               "dead", "death", "offensive", "raid", "shelling", "strike", "battle",
               "war", "fighting", "clash", "combat", "gunfire", "ambush", "terrorist",
               "terror", "insurgent", "militant", "hostage", "siege", "massacre"],
    coerce: ["sanction", "embargo", "coerce", "threat", "ultimatum", "blackmail"],
    protest: ["protest", "protests", "demonstration", "demonstrations", "rally",
              "march", "riot", "unrest", "uprising", "sit-in"],
    arrest: ["arrest", "detain", "deport", "arrests", "extradite", "exile"],
};

// Preset query buttons (GDELT DOC 2.0 query operators, per GDELTProjectInstruction manual).
// GDELT DOC 2.0 constraints (verified against the official API guide):
//   * "Boolean OR blocks cannot be nested at this time" -> single flat (...) OR group.
//   * Quoting a short single word yields "The specified phrase is too short"; the
//     official examples leave single words UNQUOTED and quote only multi-word phrases
//     (e.g. ("islamic state" OR isis OR daesh)). We follow that convention here.
const QUERY_PRESETS = [
    { name: "Conflicts", query: '(military OR war OR battle OR conflict OR offensive)', intent: "attack", color: "var(--red)" },
    { name: "Terrorism", query: '(theme:TERROR OR terrorist OR insurgent OR militant)', intent: "attack", color: "var(--red)" },
    { name: "Attacks",   query: '(theme:ATTACK OR airstrike OR bombing OR explosion OR killed)', intent: "attack", color: "var(--orange)" },
    { name: "Protests",  query: '(protest OR demonstration OR unrest OR theme:PROTEST)', intent: "protest", color: "var(--amber)" },
    { name: "Negative",  query: "tone<-5", intent: "attack", color: "var(--orange)" },
];

let threatQueryIntent = null; // set by presets / inferred in renderThreatMap

function queryIntent(query) {
    const q = (query || "").toLowerCase();
    if (!q) return null;
    // tone<-N queries select negative-tone coverage; DOC has no per-article tone
    // value to read back, but the query itself guarantees negative framing, so
    // we treat the batch as threat-level 'attack'.
    if (/tone<-/.test(q)) return "attack";
    if (/tone>/.test(q)) return "protest";
    if (/(theme:terror|terrorist|insurgent|militant|airstrike|bomb|attack|battlefield|offensive|combat|siege|weapon|troop|conflict|war)/.test(q)) return "attack";
    if (/(theme:protest|protest|demonstration|march|riot|unrest|uprising)/.test(q)) return "protest";
    return null;
}

// ============================================================================
// Verification-first GDELT query flow
// ----------------------------------------------------------------------------
// A query is verified BEFORE it reaches the background pipeline so a bad query
// can never trigger a GDELT retry storm / IP throttle. Layer 1 is an instant
// client-side structural check (mirrors GDELT DOC 2.0 rules); Layer 2 is a
// single live probe (maxrecords=1) via /gkg/pipeline/validate. "Render Map"
// only starts a pull once the exact query has passed verification.
// ============================================================================
function validateQuerySyntax(query) {
    // Returns {errors:[...], warnings:[...]} — severity "error" blocks Run.
    const issues = [];
    const q = (query || '').trim();
    if (!q) return { errors: [{ kind: 'empty', message: 'Query is empty.' }], warnings: [] };
    // Quote-stripped copy for OR/paren analysis (quotes preserved as "" markers).
    const stripped = q.replace(/"[^"]*"/g, '""');
    // Paren depth at each OR token (outside quotes).
    const orDepths = [];
    for (const m of stripped.matchAll(/\bOR\b/g)) {
        const before = stripped.slice(0, m.index);
        orDepths.push((before.match(/\(/g) || []).length - (before.match(/\)/g) || []).length);
    }
    if (orDepths.length) {
        if (orDepths.some(d => d <= 0)) {
            issues.push({ kind: 'or_not_parenthesized', severity: 'error',
                message: "OR'd terms must be surrounded by () — e.g. (a OR b OR c)." });
        } else if (new Set(orDepths).size > 1) {
            issues.push({ kind: 'nested_or', severity: 'error',
                message: "Boolean OR blocks cannot be nested — use a single flat (a OR b OR c) group." });
        }
    }
    // Quoted single words: official GDELT convention is single words UNQUOTED.
    for (const m of q.matchAll(/"([^"]*)"/g)) {
        const tok = m[1];
        if (tok && !tok.includes(' ')) {
            issues.push({ kind: 'quoted_single_word', severity: 'warning',
                message: 'GDELT prefers single words unquoted — use ' + tok + ' not "' + tok +
                         '" (short quoted words are rejected as "too short").' });
        }
    }
    return { errors: issues.filter(i => i.severity === 'error'), warnings: issues.filter(i => i.severity === 'warning') };
}

function gkgValidateStatusEl() { return document.getElementById('gkgValidateStatus'); }
function gkgBudgetMeterEl() { return document.getElementById('gkgBudgetMeter'); }

function renderGkgValidation(result) {
    const el = gkgValidateStatusEl();
    window._lastGkgValidation = result || null;
    if (!el) return;
    if (!result) { el.innerHTML = ''; return; }
    const errors = result.errors || [];
    const warnings = result.warnings || [];
    const parts = [];
    if (result.valid) {
        const live = result.live === 'cached' ? 'cached' : 'live OK';
        const sample = result.sample_count != null ? ' · ' + result.sample_count + ' sample articles' : '';
        parts.push('<span style="color:var(--green)">✓ QUERY VERIFIED (' + live + sample + ')</span>');
    } else {
        parts.push('<span style="color:var(--red)">✗ QUERY REJECTED' + (result.error_kind ? ' · ' + result.error_kind : '') + '</span>');
    }
    errors.forEach(e => parts.push('<span style="color:var(--red)">• ' + escapeHtml(e.message) + '</span>'));
    warnings.forEach(w => parts.push('<span style="color:var(--amber)">• ' + escapeHtml(w.message) + '</span>'));
    if (result.message && !result.valid) parts.push('<span style="color:var(--red)">' + escapeHtml(result.message) + '</span>');
    if (result.wait_s) parts.push('<span style="color:var(--amber)">cooldown: ' + Math.ceil(result.wait_s) + 's</span>');
    el.innerHTML = parts.join(' ');
}

function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

