async function loadCrackerboxThreatMap() {
    try {
        const [events, risk] = await Promise.all([api('/crackerbox/geo-events?days_back=90&limit=500'), api('/crackerbox/country-risk')]);
        const svg = document.getElementById('threatMapSvg');
        const W = svg.clientWidth || 900, H = svg.clientHeight || 500;
        function lonToX(lon) { return ((lon + 180) / 360) * W; }
        function latToY(lat) { return ((90 - lat) / 180) * H; }
        const sevColors = {informational:'var(--green)',minor:'var(--amber)',moderate:'var(--amber)',major:'#f97316',critical:'var(--red)'};
        const sevRadius = {informational:3,minor:4,moderate:5,major:7,critical:9};
        let mapContent = '<rect width="' + W + '" height="' + H + '" fill="var(--bg-input)"/>';
        for (let lon = -180; lon <= 180; lon += 30) { mapContent += '<line x1="' + lonToX(lon) + '" y1="0" x2="' + lonToX(lon) + '" y2="' + H + '" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>'; }
        for (let lat = -90; lat <= 90; lat += 30) { mapContent += '<line x1="0" y1="' + latToY(lat) + '" x2="' + W + '" y2="' + latToY(lat) + '" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>'; }
        events.forEach(e => { if (e.latitude && e.longitude) { const x = lonToX(e.longitude), y = latToY(e.latitude); const col = sevColors[e.severity] || 'var(--accent-purple)'; const r = sevRadius[e.severity] || 4; mapContent += '<circle cx="' + x + '" cy="' + y + '" r="' + r + '" fill="' + col + '" opacity="0.7"><title>' + e.title + ' (' + e.country + ', ' + e.severity + ')</title></circle><circle cx="' + x + '" cy="' + y + '" r="' + (r+4) + '" fill="none" stroke="' + col + '" opacity="0.3" stroke-width="1"><animate attributeName="r" from="' + (r+2) + '" to="' + (r+12) + '" dur="2s" repeatCount="infinite"/><animate attributeName="opacity" from="0.3" to="0" dur="2s" repeatCount="infinite"/></circle>'; } });
        svg.innerHTML = mapContent;
        const tbody = document.getElementById('countryRiskBody');
        tbody.innerHTML = risk.length ? risk.map(c => { const events90 = c.recent_events ? Object.values(c.recent_events).reduce((a,b) => a+b, 0) : 0; return '<tr><td style="font-weight:500">' + c.country + '</td><td><span class="tag ' + (c.overall_risk_score>5?'tag-red':c.overall_risk_score>2?'tag-amber':'') + '">' + c.overall_risk_score.toFixed(1) + '</span></td><td>' + c.security_risk.toFixed(1) + '</td><td>' + c.political_risk.toFixed(1) + '</td><td>' + c.health_risk.toFixed(1) + '</td><td style="font-variant-numeric:tabular-nums">' + events90 + '</td></tr>'; }).join('') : '<tr><td colspan="6"><div class="empty-state">No country risk data</div></td></tr>';
    } catch (e) { document.getElementById('threatMapCanvas').innerHTML = '<div class="empty-state">Error: ' + e.message + '</div>'; }
}

async function loadCrackerboxEntities() {
    try {
        const [entities, graph] = await Promise.all([api('/crackerbox/entities?limit=100'), api('/crackerbox/graph/analyze')]);
        const levelColors = {low:'',elevated:'tag-amber',high:'tag-red',critical:'tag-red',imminent:'tag-red'};
        document.getElementById('entitiesBody').innerHTML = entities.length ? entities.map(e => '<tr><td style="font-weight:500">' + e.name + '</td><td><span class="tag">' + e.entity_type + '</span></td><td><span class="tag ' + (levelColors[e.threat_level]||'') + '">' + e.threat_level + '</span></td><td style="font-variant-numeric:tabular-nums">' + e.risk_score.toFixed(1) + '</td><td style="font-size:10px">' + ((e.aliases||[]).join(', ') || '--') + '</td><td style="font-variant-numeric:tabular-nums">' + e.connection_count + '</td><td style="white-space:nowrap">' + (e.last_seen ? fmtDate(e.last_seen) : '--') + '</td></tr>').join('') : '<tr><td colspan="7"><div class="empty-state">No entities found</div></td></tr>';
        if (graph.nodes.length) {
            const svg = document.getElementById('entityGraphSvg');
            const W = svg.clientWidth || 900, H = svg.clientHeight || 400;
            const cx = W/2, cy = H/2, r = Math.min(W, H) * 0.35;
            const positions = {};
            graph.nodes.forEach((n, i) => { const angle = (i / graph.nodes.length) * Math.PI * 2 - Math.PI/2; positions[n.id] = { x: cx + r * Math.cos(angle), y: cy + r * Math.sin(angle) }; });
            const nodeColors = {person:'#3b82f6',organization:'#a855f7',location:'#10b981',asset:'#f59e0b'};
            let content = '';
            graph.edges.forEach(e => { const from = positions[e.source], to = positions[e.target]; if (from && to) content += '<line x1="' + from.x + '" y1="' + from.y + '" x2="' + to.x + '" y2="' + to.y + '" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>'; });
            graph.nodes.forEach(n => { const pos = positions[n.id]; if (!pos) return; const col = nodeColors[n.type] || 'var(--accent-purple)'; const sz = 20 + n.risk_score * 2; content += '<circle cx="' + pos.x + '" cy="' + pos.y + '" r="' + sz + '" fill="' + col + '22" stroke="' + col + '" stroke-width="2"/><text x="' + pos.x + '" y="' + (pos.y + 4) + '" fill="white" font-size="10" text-anchor="middle" font-family="var(--font-sans)">' + (n.name||'').slice(0,12) + '</text>'; if (n.risk_score > 0) content += '<text x="' + pos.x + '" y="' + (pos.y + sz + 14) + '" fill="' + col + '" font-size="9" text-anchor="middle">' + n.risk_score.toFixed(1) + '</text>'; });
            svg.innerHTML = content;
        }
    } catch (e) { document.getElementById('entitiesBody').innerHTML = '<tr><td colspan="7"><div class="empty-state">Error: ' + e.message + '</div></td></tr>'; }
}

