    // -------------------------------------------------------------- layer rows
    function rowHTML(d) {
        var st = state[d.id] || {};
        var on = !!st.on;
        var dormant = !d.host && !hasProvider(d.id);
        var slider = (d.host || typeof d.opacity === 'function')
            ? '<input type="range" class="gaia-slider" min="20" max="100" step="5" value="' + Math.round((st.opacity == null ? 1 : st.opacity) * 100) + '" title="Layer opacity">'
            : '';
        return '<div class="gaia-row' + (on ? ' on' : '') + (dormant ? ' dormant' : '') + '" data-layer="' + esc(d.id) + '">' +
            '<span class="gaia-dot" data-gaia-dot></span>' +
            '<div class="gaia-row-main"><span class="gaia-row-label">' + esc(d.label) + '</span>' +
            '<span class="gaia-row-meta">' + esc(d.meta) + '</span></div>' +
            '<span class="gaia-row-status" data-gaia-status data-status="dim">IDLE</span>' +
            slider +
