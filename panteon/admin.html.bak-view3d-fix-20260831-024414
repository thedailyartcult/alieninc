                    try{ if(window.LZDZ.showHoverDisc) window.LZDZ.showHoverDisc(hb2.lat, hb2.lng, rr.eligible); }catch(e2){}
                    setGhost(hb2.footprint, hb2.height);
                    setHint((rr.eligible?'✅ LZ AVAILABLE — ':'❌ NO LZ — ')+(hb2.name||'BUILDING')+' · '+rr.reason);
                } else {
                    setGhost(hb2.footprint, hb2.height);
                    setHint('HOVER A BUILDING · CLICK TO CHECK LZ · ESC CANCELS');
                }
                return;
            }
            // single-hover enforcement: only one maven object highlighted at a time — clear ghost when hovering persisted objects
            setGhost(null);
            var fs = null;
            try { fs = m.queryRenderedFeatures(ev.point, { layers: ['maven-objs-fill','maven-objs-vol'] }); } catch (err) {}
            var nid = (fs && fs.length) ? fs[0].id : null;
            if (nid !== S._hovId) {
                if (S._hovId != null) {
                    try { m.setFeatureState({ source: 'maven-objs', id: S._hovId }, { hover: false }); } catch (e) {}
                }
                // defensive: if query returned stacked features (identical footprint), clear all others
                if(fs && fs.length>1){
                    for(var k=1;k<fs.length;k++){ try{ m.setFeatureState({source:'maven-objs', id:fs[k].id},{hover:false}); }catch(e){} }
                }
                S._hovId = nid;
                if (nid != null) {
                    try { m.setFeatureState({ source: 'maven-objs', id: nid }, { hover: true }); } catch (e) {}
                }
                try { m.getCanvas().style.cursor = nid != null ? 'pointer' : ''; } catch (e) {}
            }
        });
