const AUTH_CHANNEL = ('BroadcastChannel' in window) ? new BroadcastChannel('panteon-auth') : null;
function broadcastAuth(msg) { try { if (AUTH_CHANNEL) AUTH_CHANNEL.postMessage(msg); } catch (_) {} }

function clearLocalSession() {
    authToken = null;
    currentUser = null;
    try {
        localStorage.removeItem('hs_session');
        for (let i = localStorage.length - 1; i >= 0; i--) {
            const k = localStorage.key(i);
