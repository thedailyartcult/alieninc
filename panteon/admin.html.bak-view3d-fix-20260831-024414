    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            /* Index canonical tokens */
            --bg-dark: #000000;
            --bg-light: #ffffff;
            --bg-gray: #f8f9fa;
            --text-dark: #000000;
            --text-light: #ffffff;
            --text-muted: #71717a;
            --accent-neon: #DFF140;
            --border-light: rgba(255, 255, 255, 0.15);
            --border-dark: #000000;
            --border-subtle: rgba(0, 0, 0, 0.12);
            /* Admin aliases - dark default */
            --bg: #000000;
            --bg-card: #08090a;
            --bg-panel: #0b0c0e;
            --bg-sidebar: #000000;
            --bg-topbar: rgba(0, 0, 0, 0.4);
            --bg-input: #0d0e10;
            --border-color: var(--border-light);
            --border-hover: rgba(223, 241, 64, 0.35);
            --accent-purple: var(--accent-neon);
            --accent-purple-glow: rgba(223, 241, 64, 0.15);
            --accent-cyan: var(--accent-neon);
            --cyan: var(--accent-neon);
            --green: #10b981;
            --red: #f43f5e;
            --amber: #f59e0b;
            --blue: #3b82f6;
            --text: #ffffff;
            --text-primary: var(--text);
            --text-dim: rgba(255, 255, 255, 0.5);
            --font-sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
            --font-tech: "Space Grotesk", sans-serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
            --font-brand: "Inter", -apple-system, sans-serif;
            --sidebar-w: 240px;
            --z-topbar: 1001;
            --z-drawer: 1500;
            --z-dock: 1600;
            --z-float-panel: 1900;
            --z-modal: 2000;
            --z-toast: 3000;
        }
        /* Light mode - mirrors index light surfaces */
        [data-theme="light"] {
            --bg: #ffffff;
            --bg-card: #f8f9fa;
            --bg-panel: #ffffff;
            --bg-sidebar: #f8f9fa;
            --bg-topbar: rgba(255, 255, 255, 0.85);
            --bg-input: #ffffff;
            --border-color: var(--border-subtle);
            --border-hover: rgba(0, 0, 0, 0.2);
            --text: #000000;
            --text-primary: var(--text);
            --text-muted: #71717a;
            --text-dim: rgba(0, 0, 0, 0.5);
        }
        /* Smooth theme transition like index header 0.4s */
        html, body, .topbar, .sidebar, .main-container, .content, input, select, textarea, .card, .camera-group-container, .workflow-column {
            transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
        }

        html, body {
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 13px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            overflow: hidden;
        }

        a { color: inherit; text-decoration: none; }
        button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

        input, select, textarea {
            font-family: inherit;
            font-size: 11px;
            color: var(--text);
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 0px;
            padding: 6px 10px;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 6px rgba(0, 240, 255, 0.2);
        }

        select {
            appearance: none;
            background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%23707275' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 10px center;
            padding-right: 28px;
        }

        textarea { resize: vertical; min-height: 80px; }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(223, 241, 64, 0.15); border-radius: 0px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent-cyan); }

        .app { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: var(--bg); }
        [data-theme="light"] .app { background: var(--bg-gray); }

        .topbar {
            height: 78px;
            background: rgba(0, 0, 0, 0.42);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-light);
            clip-path: url(#topbar-hill-edge);
            -webkit-clip-path: url(#topbar-hill-edge);
            margin: 0;
            width: calc(100% - 48px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px 0 20px;
            flex-shrink: 0;
            z-index: 1001;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18), 0 1px 0 rgba(223,241,64,0.08);
            position: fixed;
            top: 12px;
            left: 24px;
            right: 24px;
            overflow: hidden;
            transition: background-color 0.4s ease, border-color 0.4s ease, transform 0.4s cubic-bezier(0.16,1,0.3,1);
        }
        .topbar:hover { transform: scale(1.01); }
        [data-theme="light"] .topbar {
            background: rgba(255, 255, 255, 0.80);
            border-color: var(--border-subtle);
        }
        .topbar-hill {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            display: block;
        }
        .topbar-branding, .topbar-actions, .topbar-tabs { position: relative; z-index: 2; }
        /* Hill glass fill behind content */
        .topbar-hill-bg {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.38);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-light);
            pointer-events: none;
            z-index: 0;
        }
        .shared-hill {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            display: block;
        }
        .app { position: relative; }
        [data-theme="light"] .topbar-hill-bg {
            background: rgba(255, 255, 255, 0.78);
            border-color: var(--border-subtle);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }

        [data-theme="light"] .topbar {
            background: rgba(255, 255, 255, 0.85);
            border-color: var(--border-dark);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }
        /* Index scroll progress bar replication */
        .admin-scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 2px;
            width: 0%;
            background-color: var(--accent-neon);
            z-index: 1005;
            transition: width 0.1s ease-out;
        }

        .topbar-branding { display: flex; align-items: center; gap: 12px; }

        .logo-wrap { display: flex; align-items: center; cursor: pointer; color: var(--text); vertical-align: middle; }
        .logo-wrap svg { height: 26px; width: auto; max-width: 200px; fill: currentColor; overflow: visible; display: block; }

        .topbar-title-divider {
            color: rgba(223, 241, 64, 0.4);
            font-family: var(--font-tech);
            font-weight: 300;
        }

        .topbar-branding { display: flex; align-items: center; gap: 12px; flex:1; min-width:0; overflow:hidden; }
        .topbar-title {
            font-size: 11px;
            font-family: var(--font-tech);
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--accent-cyan);
            text-shadow: 0 0 8px rgba(0, 240, 255, 0.2);
            flex:1; min-width:0; max-width:560px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
            display:flex; align-items:center; gap:8px;
            transition: color .2s;
        }
        /* Topbar info bar — replaces YONO speaking (was nav__thinking port) */
        .topbar-title.is-info{color:rgba(255,255,255,.92);text-shadow:none;letter-spacing:.06em;text-transform:none;font-weight:400;font-size:11px;gap:6px}
        .topbar-title.is-info::before{content:'◆';color:var(--accent-neon);font-size:7px;flex:none;opacity:.9}
        .topbar-title.is-idle{color:rgba(255,255,255,.38);text-shadow:none;letter-spacing:.10em;text-transform:uppercase;font-weight:300;font-size:10px;gap:6px;opacity:.9}
        .topbar-title.is-idle::before{content:'◆';color:var(--accent-neon);font-size:7px;flex:none;opacity:.32}
        .topbar-info-word{display:inline-block;animation:topbar-word-in .28s cubic-bezier(0.16,1,0.3,1) both}
        @keyframes topbar-word-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
        /* Light — topbar is white, so info/idle must be dark for contrast (was white-on-white invisible) */
        [data-theme="light"] .topbar-title.is-info{color:rgba(0,0,0,.88);text-shadow:none}
        [data-theme="light"] .topbar-title.is-idle{color:rgba(0,0,0,.42);text-shadow:none}
        [data-theme="light"] .topbar-title.is-info::before{color:#000;opacity:.72}
        [data-theme="light"] .topbar-title.is-idle::before{color:#000;opacity:.28}
        /* legacy YONO topbar classes kept as no-op stubs for compat (topbar no longer speaks) */
        .topbar-yono-pulse{display:none !important}
        .topbar-yono-line{display:none !important}
        .topbar-title.yono-speaking{color:var(--accent-cyan);text-shadow:0 0 8px rgba(0,240,255,.2)}

        /* ==========================================================================
           CONSTAN THEME SUITE — 0px Sharp Cyber-Industrial Design Language
           ========================================================================== */
        .theme-suite {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            padding: 3px 5px;
            border-radius: 0px;
        }
        .theme-tri-switch {
            display: flex;
            gap: 2px;
        }
        .theme-mode-btn {
            font-family: var(--font-mono);
            font-size: 9px;
            font-weight: 600;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 0px;
            color: var(--text-muted);
            background: transparent;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .theme-mode-btn:hover {
            color: var(--text);
            border-color: var(--border-light);
        }
        .theme-mode-btn.active {
            background: var(--accent-neon);
            color: #000000;
            border-color: var(--accent-neon);
            font-weight: 700;
        }
        /* Bernardo Spectrum Slider Bar */
        .constan-slider-wrap {
            display: none;
            align-items: center;
            gap: 6px;
            padding-left: 4px;
            border-left: 1px solid var(--border-color);
        }
        [data-theme="constan"] .constan-slider-wrap {
            display: flex;
        }
        .constan-panel-label {
            font-family: var(--font-mono);
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 0.08em;
            color: var(--accent-neon);
            min-width: 14px;
        }
        /* Custom 0px Slider */
        #constanSpectrumSlider {
            -webkit-appearance: none;
            appearance: none;
            width: 72px;
            height: 3px;
            background: linear-gradient(90deg, #162d22 0%, #2e141b 33%, #121b33 66%, #1f0e0e 100%);
            border: 1px solid var(--border-color);
            outline: none;
            border-radius: 0px;
            cursor: pointer;
        }
        #constanSpectrumSlider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 8px;
            height: 14px;
            background: var(--accent-neon);
            border: 1px solid #000000;
            border-radius: 0px;
            cursor: pointer;
            box-shadow: 0 0 6px var(--accent-neon);
            transition: transform 0.1s ease;
        }
        #constanSpectrumSlider::-moz-range-thumb {
            width: 8px;
            height: 14px;
            background: var(--accent-neon);
            border: 1px solid #000000;
            border-radius: 0px;
            cursor: pointer;
        }
        #constanSpectrumSlider:hover::-webkit-slider-thumb {
            transform: scaleY(1.15);
        }
        /* Constan — topbar glass tints to Bernardo's Deep Field */
        [data-theme="constan"] .topbar{background:var(--bg-topbar);border-color:var(--border-color)}
        [data-theme="constan"] .topbar-hill-bg{background:var(--bg-topbar);border-color:var(--border-color)}

        .topbar-actions { display: flex; align-items: center; gap: 12px; }
        /* deprecated single-toggle kept as fallback no-op */
        .theme-toggle {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border-light);
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: inherit;
            transition: border-color 0.2s, background-color 0.2s;
        }
        .theme-toggle:hover { border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.05); }
        [data-theme="light"] .theme-toggle { border-color: rgba(0,0,0,0.15); }
        [data-theme="light"] .theme-toggle:hover { border-color: rgba(0,0,0,0.4); background: rgba(0,0,0,0.03); }
        /* Haring war-room accents - index 0px language, neon only */
        .haring-divider { display:flex; align-items:center; gap:8px; color:var(--text-muted); opacity:0.28; }
        .haring-divider svg { width:18px; height:18px; flex-shrink:0; }
        .haring-top-divider { display:inline-flex; align-items:center; color:var(--accent-neon); }
        .haring-top-divider svg { width:12px; height:12px; }
        .topbar-title-divider.haring { color:var(--accent-neon); display:inline-flex; }
        .camera-target-box.haring::before, .camera-target-box.haring::after { border-color: currentColor; }
        .haring-pulse { animation: haringPulse 1.6s cubic-bezier(0.4,0,0.6,1) infinite alternate; }
        @keyframes haringPulse { 0%{transform:scale(1); opacity:0.7;} 100%{transform:scale(1.08); opacity:1;} }
        /* Haring sun - pulsing dot + slow rotating radiant */
        .haring-sun-dot { animation: haringSunPulse 2.2s cubic-bezier(0.4,0,0.6,1) infinite alternate; transform-origin: 20px 64px; }
        @keyframes haringSunPulse { 0%{transform:scale(1);} 100%{transform:scale(1.06);} }
        .haring-sun-rays { animation: haringSpin 12s linear infinite; transform-origin: 20px 64px; }
        @keyframes haringSpin { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }
        @media (prefers-reduced-motion: reduce) { .haring-sun-dot, .haring-sun-rays, .haring-pulse { animation: none; } }
        .sidebar-footer.haring { display:flex; align-items:center; gap:8px; justify-content:center; border-top:1px solid var(--border-light); }
        .sidebar-footer.haring svg { width:64px; height:18px; }

        .topbar-btn {
            background: rgba(223, 241, 64, 0.05);
            border: 1px solid rgba(223, 241, 64, 0.35);
            padding: 5px 12px;
            border-radius: 0px;
            font-size: 10px;
            font-family: var(--font-tech);
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .topbar-btn:hover {
            background: rgba(223, 241, 64, 0.15);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
        }

        .topbar-status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.02);
            padding: 4px 8px;
            border-radius: 0px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            flex-shrink: 0;
            display: inline-block;
            box-shadow: 0 0 6px var(--green);
            animation: pulseGlow 1.5s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { opacity: 0.5; box-shadow: 0 0 2px var(--green); }
            100% { opacity: 1; box-shadow: 0 0 8px var(--green); }
        }

        .status-dot.offline { background: var(--red); box-shadow: 0 0 6px var(--red); animation: none; }

        .user-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: var(--text);
            cursor: pointer;
            background: rgba(255, 255, 255, 0.02);
            padding: 4px 8px;
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 0px;
        }

        .user-avatar {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-purple);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            font-weight: 700;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .user-menu-wrap { position: relative; }
        .user-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 220px;
            background: var(--bg-panel);
            border: 1px solid var(--border-color);
            border-radius: 0px;
            padding: 12px;
            display: none;
            z-index: var(--z-float-panel);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
        }
        .user-menu.open { display: block; }
        .user-menu-email {
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--text-muted);
            padding-bottom: 10px;
            margin-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
            word-break: break-all;
        }
        .user-menu-signout {
            width: 100%;
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text);
            font-family: var(--font-mono);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 8px;
            border-radius: 0px;
            cursor: pointer;
        }
        .user-menu-signout:hover { border-color: var(--accent-neon); color: var(--accent-neon); }

        .workspace-shell { display: flex; flex: 1; overflow: hidden; position: relative; gap: 20px; padding: 96px 24px 16px 24px; }

        .sidebar {
            width: var(--sidebar-w);
            min-width: var(--sidebar-w);
            background: transparent;
            border: none;
            display: flex;
            flex-direction: column;
            overflow-y: visible;
            flex-shrink: 0;
            height: fit-content;
            max-height: calc(100vh - 96px);
            position: sticky;
            top: 12px;
            gap: 0;
        }
        [data-theme="light"] .sidebar { background: transparent; border: none; }

        .sidebar-nav { flex: 1; padding: 12px 0; display: flex; flex-direction: column; gap: 20px; position: relative; }

        .nav-section { margin-bottom: 0; display: flex; flex-direction: column; gap: 6px; }

        .nav-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 12px;
            font-size: 11px;
            font-weight: 300;
            font-family: 'Zen Dots', Inter, sans-serif;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--text);
            opacity: 1;
            cursor: pointer;
            user-select: none;
            margin: 16px 12px 6px 12px;
            background: transparent;
            border: none;
            position: relative;
            transition: color .18s cubic-bezier(0.16, 1, 0.3, 1), opacity .18s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-section-title::before {
            content: "";
            position: absolute;
            left: 0;
            bottom: -4px;
            width: 24px;
            height: 2px;
            background: var(--accent-neon);
            transition: width .3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-section-title:hover::before { width: 48px; }
        .nav-section-title::after {
            content: '\25BE';
            margin-left: auto;
            font-size: 8px;
