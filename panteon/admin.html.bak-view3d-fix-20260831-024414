(function(){
  const title=document.getElementById('topbarTitle');
  const bar=document.querySelector('.topbar');
  if(!title||!bar) return;
  const PAGES_MAP=window.PAGES||{};
  const IDLE_TEXT='— hover a control —';
  let infoActive=false, infoTimer=null, words=[], wIdx=0;
  let restoreTimer=null, currentSrc=null;

  function setIdle(){
    infoActive=false; currentSrc=null;
    if(infoTimer){clearInterval(infoTimer); infoTimer=null;}
    title.classList.remove('is-info','yono-speaking');
    title.classList.add('is-idle');
