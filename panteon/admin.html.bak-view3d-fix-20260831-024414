            toast('Coverage cleared', 'info');
        };
        var sr = $('mvScopeRegion'), sc = $('mvScopeCountry');
        if (sr && sc && typeof SC_REGION_BBOXES !== 'undefined') {
            var ro = '<option value="Worldwide">WORLDWIDE</option>';
            Object.keys(SC_REGION_BBOXES).forEach(function (k) {
                ro += '<option value="' + k + '">' + k.toUpperCase() + '</option>';
            });
            sr.innerHTML = ro;
            var co = '<option value="">ALL COUNTRIES</option>';
            Object.keys(COUNTRY_FIPS).forEach(function (k) {
                co += '<option value="' + k + '">' + k.toUpperCase() + '</option>';
            });
            sc.innerHTML = co;
            sr.value = SCScope.region;
            sc.value = SCScope.country || '';
            sr.onchange = function () {
                SCScope.region = sr.value;
                SCScope.country = '';
                SCScope.zone = '';
                SCScope.island=''; SCScope.city='';
                sc.value = '';
                try{ var si2=$('mvScopeIsland'), scc2=$('mvScopeCity'), phRow2=$('mvScopePHRow'); if(si2) si2.value=''; if(scc2) scc2.value=''; if(phRow2) phRow2.classList.add('maven-hidden'); }catch(e){}
                var legacy = document.getElementById('scCountrySelect');
                if (legacy) legacy.value = '';
                try { scUpdateEmptyState(); } catch (e) {}
                mvScopeFly();
                if (window.__forceFusionReload) window.__forceFusionReload();
                if (typeof window.renderThreatMap === 'function') { try { window.renderThreatMap(true); } catch (e) {} }
                toast('SCOPE: ' + sr.value + ' — feeds reloading', 'success');
            };
            sc.onchange = function () {
                SCScope.country = sc.value || '';
                if (SCScope.country) SCScope.zone = '';
                var legacy = document.getElementById('scCountrySelect');
                if (legacy) legacy.value = SCScope.country;
                try { scUpdateEmptyState(); } catch (e) {}
                // PH hierarchical: show island/city only for Philippines
                try{
                  var phRow=$('mvScopePHRow'), si=$('mvScopeIsland'), scc=$('mvScopeCity');
                  if(SCScope.country==='Philippines'){
                    if(phRow) phRow.classList.remove('maven-hidden');
                    if(si && !SCScope.island){ si.value='Luzon'; SCScope.island='Luzon'; }
                    if(scc) populatePHCities();
                    // default to BGC for your test if no city yet
                    if(scc && !SCScope.city){ scc.value='BGC'; SCScope.city='BGC'; }
                  } else {
                    if(phRow) phRow.classList.add('maven-hidden');
                    SCScope.island=''; SCScope.city=''; if(si) si.value=''; if(scc) scc.value='';
                  }
                }catch(e){}
                mvScopeFly();
                if (window.__forceFusionReload) window.__forceFusionReload();
                if (typeof window.renderThreatMap === 'function') { try { window.renderThreatMap(true); } catch (e) {} }
                toast('SCOPE: ' + (SCScope.country || sr.value) + ' — feeds reloading', 'success');
            };
            // PH island/city hierarchical loader — GTA chunked
            var si=$('mvScopeIsland'), scc=$('mvScopeCity'), phRow=$('mvScopePHRow');
            function populatePHCities(){
              if(!scc||!si) return;
              var isl=si.value||'Luzon';
              var opts='<option value="">— CITY —</option>';
              Object.keys(PH_CITIES).forEach(function(k){
                var c=PH_CITIES[k];
                if(c.island===isl || k==='BGC' && isl==='Luzon') opts+='<option value="'+k+'">'+k.toUpperCase()+'</option>';
                else if(isl==='Luzon' && ['Makati','Taguig','BGC','Manila','Quezon City'].indexOf(k)>-1) opts+='<option value="'+k+'">'+k.toUpperCase()+'</option>';
                else if(isl==='Visayas' && k==='Cebu City') opts+='<option value="'+k+'">'+k.toUpperCase()+'</option>';
                else if(isl==='Mindanao' && k==='Davao City') opts+='<option value="'+k+'">'+k.toUpperCase()+'</option>';
              });
              // unique dedup
              scc.innerHTML=opts;
              scc.value=SCScope.city||'';
            }
            if(si && scc){
              // init visibility
              try{
                if(SCScope.country==='Philippines'){ if(phRow) phRow.classList.remove('maven-hidden'); populatePHCities(); }
                si.value=SCScope.island||'';
                scc.value=SCScope.city||'';
