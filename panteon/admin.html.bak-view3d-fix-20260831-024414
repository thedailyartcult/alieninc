async function loadOntologyGraph() {
    try {
        const g = await api('sims/ontology/graph?limit=400');
        if (!g || !Array.isArray(g.nodes)) return;
        SIMS.ont = g;
        const chip = document.getElementById('simsOntCountChip');
        if (chip && g.counts) chip.textContent = `${g.counts.nodes} OBJECTS · ${g.counts.edges} LINKS`;
        renderOntPanel();
        renderFusionOntLayer();
        renderFusionRealLayer();
    } catch (e) { /* gateway or route offline — silent */ }
}

function ontNodeCoords(n) {
    const p = (n && n.properties) || {};
    return (typeof p.lat === 'number' && typeof p.lng === 'number') ? [p.lng, p.lat] : null;
}

function simsOntLinkedNames(nodeId) {
    if (!SIMS.ont) return [];
    const byId = {};
    SIMS.ont.nodes.forEach(nd => { byId[nd.id] = nd; });
    const names = [];
    SIMS.ont.edges.forEach(e => {
        let other = null, lt = e.link_type || '';
        if (e.source === nodeId) other = byId[e.target];
        else if (e.target === nodeId) other = byId[e.source];
        if (!other) return;
        const label = lt.replace('ks_', '').replace(/_/g, ' ');
        names.push(`${label} → ${ONT_TYPE_LABEL[other.type] || other.type}: ${(other.properties && other.properties.name) || other.pk}`);
    });
    return names.slice(0, 5);
}

function ontPopupHtml(n) {
    const p = n.properties || {};
    const rows = Object.entries(p)
        .filter(([k]) => !['lat', 'lng', 'bounds'].includes(k))
        .slice(0, 12)
        .map(([k, v]) => `<tr><td style="color:var(--text-muted);padding-right:10px">${simsEsc(k)}</td><td style="color:var(--text);text-align:right">${simsEsc(v == null ? '—' : String(v))}</td></tr>`).join('');
    const links = simsOntLinkedNames(n.id)
        .map(l => `<div style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">↳ ${simsEsc(l)}</div>`).join('');
    return `<b>${simsEsc(ONT_TYPE_LABEL[n.type] || n.type)}</b> · ${simsEsc(n.pk)}` +
        `<table style="margin-top:6px;font-size:10px;font-family:var(--font-mono)">${rows}</table>${links}`;
}

function renderFusionOntLayer() {
    fusionSimOntMarkers.forEach(m => {
        try { m.remove(); } catch (e) {}
        try { m._el && m._el.remove(); } catch (e) {}
    });
    fusionSimOntMarkers = [];
    if (!fusionMap) return;
    // link lines live in a GeoJSON layer — drop any stale one first
    try {
        if (fusionMap.getLayer('sims-ont-links')) fusionMap.removeLayer('sims-ont-links');
        if (fusionMap.getSource('sims-ont-links')) fusionMap.removeSource('sims-ont-links');
    } catch (e) {}
    if (!fusionLayers.simsOnt || !SIMS.ont || !Array.isArray(SIMS.ont.nodes)) return;

    const byId = {};
    SIMS.ont.nodes.forEach(nd => { byId[nd.id] = nd; });

    const feats = [];
    SIMS.ont.edges.forEach(e => {
        const s = byId[e.source], t = byId[e.target];
        if (!s || !t) return;
        const a = ontNodeCoords(s), b = ontNodeCoords(t);
        if (!a || !b) return;
        feats.push({
            type: 'Feature',
            properties: { lt: e.link_type || '' },
            geometry: { type: 'LineString', coordinates: [a, b] },
        });
    });
    if (feats.length) {
        try {
            fusionMap.addSource('sims-ont-links', { type: 'geojson', data: { type: 'FeatureCollection', features: feats } });
            fusionMap.addLayer({
                id: 'sims-ont-links', type: 'line', source: 'sims-ont-links',
                paint: {
                    'line-color': ['match', ['get', 'lt'],
                        'ks_assessed_in', '#DFF140',
                        'ks_opposes', '#ef4444',
                        'ks_located_in', '#22c5ee',
                        'rgba(148,163,184,.5)'],
                    'line-width': 1.1, 'line-opacity': 0.65,
                    'line-dasharray': [2, 2],
                },
            });
        } catch (e) {}
    }

    SIMS.ont.nodes.forEach(n => {
        if (n.type === 'world_country' || n.type === 'arsenal_system') return; // real layer owns these
        const c = ontNodeCoords(n);
        if (!c) return;
        const p = n.properties || {};
        const el = document.createElement('div');
        let title = '';
        if (n.type === 'kriegspiel_theater') {
            el.className = 'sims-ont-theater';
            el.innerHTML = '<span></span>';
            title = p.name || '';
        } else if (n.type === 'kriegspiel_force') {
            el.className = 'sims-ont-force side-' + (p.side === 'red' ? 'red' : 'blue');
            title = `${(p.doctrine || '?')} (${p.side})`;
        } else {
            el.className = 'sims-ont-assess' +
                (p.dominant_winner === 'red' ? ' w-red' : p.dominant_winner === 'blue' ? ' w-blue' : '');
            title = `${p.mode || 'battle'} · ${(p.matchup || '')}`;
        }
        const popup = new maplibregl.Popup({ closeButton: false, offset: 8 }).setHTML(ontPopupHtml(n));
        const mk = new maplibregl.Marker({ element: el }).setLngLat(c).setPopup(popup).addTo(fusionMap);
        mk._el = el;
        if (title) el.title = title;
        fusionSimOntMarkers.push(mk);
    });
}

function renderOntPanel() {
    const panel = document.getElementById('simsOntPanel');
    if (!panel || !SIMS.ont) return;
    const assessments = SIMS.ont.nodes.filter(n => n.type === 'kriegspiel_assessment')
        .sort((a, b) => ((b.properties || {}).executed_at || '').localeCompare((a.properties || {}).executed_at || ''))
        .slice(0, 6);
    if (!assessments.length) { panel.innerHTML = '<div class="empty-state">No assessments emitted yet — run a battle.</div>'; return; }
    panel.innerHTML = assessments.map(a => {
        const p = a.properties || {};
        const tone = p.dominant_winner === 'red' ? 'bad' : p.dominant_winner === 'blue' ? 'good' : 'warn';
        return `<div class="sims-flash-row">
            <span class="sims-chip" data-tone="${tone}">${simsEsc((p.dominant_winner || '?').toUpperCase())} ${Number(p.red_win_pct || 0)}%</span>
            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${simsEsc(p.theater || a.pk)} · ${simsEsc(p.matchup || '')} · ${simsEsc(String(p.scenarios_run || ''))} runs${p.source_event_title ? ' · ⚡ ' + simsEsc(String(p.source_event_title).slice(0, 40)) : ''}</span>
            <span style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">${simsEsc((p.executed_at || '').replace('T', ' ').slice(0, 16))}</span>
        </div>`;
    }).join('');
}

// --------------------------- real-world anchoring --------------------------
function simsFmtNum(v) {
    if (v == null) return '--';
    if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
    if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
    if (v >= 1e3) return (v / 1e3).toFixed(0) + 'k';
    return String(Math.round(v));
}

