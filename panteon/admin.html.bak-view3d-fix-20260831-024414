async function generateSmmPlan() {
    const goal = document.getElementById('smmGoalInput').value.trim();
    if (!goal) { toast('Describe your campaign goal', 'error'); return; }
    const el = document.getElementById('smmPlanResult');
    el.innerHTML = '<span class="loading"></span>';
    const platformHints = {
        facebook: smmServicesCache.filter(s => /facebook|fb/i.test(s.name)),
        instagram: smmServicesCache.filter(s => /instagram|ig/i.test(s.name)),
        tiktok: smmServicesCache.filter(s => /tiktok/i.test(s.name)),
        twitter: smmServicesCache.filter(s => /twitter|x\.com/i.test(s.name)),
    };
    const detected = [];
    for (const [plat, svcs] of Object.entries(platformHints)) {
        if (new RegExp(plat, 'i').test(goal) && svcs.length) detected.push({ platform: plat, services: svcs.slice(0, 5) });
    }
    if (!detected.length) {
        el.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0">Could not auto-detect platform. Mention Facebook, Instagram, TikTok, or Twitter in your goal.</div>';
        return;
    }
    let html = '<div style="font-size:12px;padding:8px 0">';
    html += '<div style="font-weight:600;color:var(--text);margin-bottom:8px">Suggested Plan</div>';
    detected.forEach(d => {
        html += '<div style="margin-bottom:12px"><span class="tag" style="margin-bottom:4px;display:inline-block">' + d.platform.toUpperCase() + '</span>';
        d.services.forEach(s => {
            html += '<div style="padding:4px 0;color:var(--text-muted)">Service #' + s.service + ': ' + s.name + ' — $' + s.rate + '/1k</div>';
        });
        html += '</div>';
    });
    html += '<button class="btn btn-primary btn-sm" style="margin-top:8px" onclick="toast(\'Order placement coming soon — use the Order tab\')">Place Suggested Orders</button>';
    html += '</div>';
    el.innerHTML = html;
}

