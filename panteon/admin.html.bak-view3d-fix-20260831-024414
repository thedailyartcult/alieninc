}

function simsBestDoctrineFor(terrain) {
    if (!SIMS.learning || !Array.isArray(SIMS.learning.matrix)) return null;
    const ti = SIMS.learning.terrains.indexOf(terrain);
    if (ti < 0) return null;
    let best = null;
    SIMS.learning.doctrines.forEach((doc, di) => {
        const cell = (SIMS.learning.matrix[di] || [])[ti];
        if (cell && cell.win_rate != null && (!best || cell.win_rate > best.win_rate)) best = { doc, win_rate: cell.win_rate, samples: cell.samples };
    });
    return best;
}

