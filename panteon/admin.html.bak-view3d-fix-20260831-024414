function renderThreatTables(events) {
    const mapper = document.getElementById('threatEventMap');
    const matrix = document.getElementById('linkMatrixBody');
    const actors = document.getElementById('actorMapBody');
    if (!events.length) {
        mapper.innerHTML = '<div class="empty-state">No threat events found. Render the map to pull GDELT GKG events.</div>';
        matrix.innerHTML = '<tr><td colspan="5"><div class="empty-state">No threat events loaded</div></td></tr>';
        actors.innerHTML = '<tr><td colspan="4"><div class="empty-state">No actor data loaded</div></td></tr>';
        return;
    }
    mapper.innerHTML = events.slice(0, 25).map(ev => {
        const geo = parseActionGeo(ev);
        const tone = threatLevelForEvent(ev);
        const coord = geo ? '[' + geo.latitude + ', ' + geo.longitude + ']' : '[no geo]';
        const color = tone === 'red' ? 'var(--red)' : tone === 'amber' ? 'var(--amber)' : 'var(--green)';
        const threat = THREAT_LABEL[tone];
        const label = ev.event_type || 'GDELT';
        return '<div style="margin-bottom:2px"><span class="coordinate" style="color:' + color + '">' + coord +
            ' // ' + threat + ' ' + label + ' ' + (ev.event_code || '') +
            (ev.sourcecountry ? ' (' + ev.sourcecountry + ')' : '') + '</span>' +
            (ev.title ? '<div style="font-size:10px;color:var(--text-muted)">' + (ev.title.length > 120 ? ev.title.slice(0, 120) + '…' : ev.title) + '</div>' : '') +
            '</div>';
    }).join('') +
    '<div style="margin-top:6px;font-size:9px;color:var(--text-muted)">Showing top ' + Math.min(25, events.length) + ' of ' + events.length + ' events · Threat: ' + events.filter(e=>threatLevelForEvent(e)!=='green').length + ' active</div>';

    matrix.innerHTML = events.slice(0, 50).map(ev => {
        const geo = parseActionGeo(ev);
        return '<tr><td>' + (ev.event_date || '') + '</td><td>' + (ev.actor1 || ev.event_type || 'GDELT') +
            '</td><td>' + (ev.event_code || '') + '</td><td>' + (ev.actor2 || (geo ? geo.country : '') || 'GLOBAL') +
            '</td><td>' + (ev.avg_tone != null ? Number(ev.avg_tone).toFixed(2) : 'n/a') + '</td></tr>';
    }).join('');

    const counts = {};
    events.forEach(ev => {
        const geo = parseActionGeo(ev);
        const name = ev.actor1 || ev.event_type || ev.event_code || 'GDELT';
        const key = name + '|' + (ev.event_code || '');
        if (!counts[key]) counts[key] = { name: name, cameo: ev.event_code || '', country: geo ? geo.country : '', tones: [] };
        if (ev.avg_tone != null) counts[key].tones.push(ev.avg_tone);
    });
    actors.innerHTML = Object.values(counts).slice(0, 50).map(a => {
        const tone = threatLevelForTone(a.tones.length ? a.tones.reduce((x, y) => x + y, 0) / a.tones.length : null);
        return '<tr><td>' + a.name + '</td><td>' + a.cameo + '</td><td>' + (a.country || '—') + '</td><td>' + THREAT_LABEL[tone] + '</td></tr>';
    }).join('');
}

