<script id="gaia-integrations">
// ============================================================================
// GAIA INTEGRATIONS ADD-ON v1 — three armable data sources on the Unified Map.
//
// Pure add-on, zero core edits (same contract as tb-addon): injects an
// "INTEGRATIONS" collapsible sub-section directly under the Tactical Terrain
// row of the GAIA · GEO CONTROLLER Layers list, keeps the bottom layer counter
// ("X/N LAYERS"), the map HUD ("… threats · … aircraft plotted") and the GAIA
// footer strip in sync via observed DOM writes, and renders tracks as MapLibre
// markers using the existing icon language + legend colors.
//
// FREE/OPEN DATA ONLY — no paid keys, no hardcoded secrets:
//   1. AIS source 1          → AISStream.io free WebSocket feed. Get a key at
//                              https://aisstream.io and put it in GI_CONFIG.ais.apiKey
//                              (or localStorage 'sc_ais_key'). No key = clearly
//                              labeled SIM fleet around the scope center.
//   2. FutureForces TAK src 1 → Cursor-on-Target over WebSocket or polling HTTP,
//                              FreeTAKServer / PyTAK compatible. Empty URL = local
//                              CoT mock generator that emits REAL CoT 2.0 XML
//                              through the same parser, so pointing it at a live
//                              FreeTAKServer later is a config change only.
//   3. OTHT-Gold             → over-the-horizon style long-range track fusion:
//                              filters the LIVE OpenSky aircraft array + AIS
//                              contacts for high-interest (fast/high/military)
//                              movers; gold glow symbology. Falls back to a small
//                              simulated OTH picture when feeds are quiet.
//
// Every source degrades gracefully: dead feed → subtle OFFLINE chip next to the
// toggle, UI never breaks. Swap-in points for commercial feeds = GI_CONFIG only.
// ============================================================================
(function () {
    'use strict';
    if (typeof maplibregl === 'undefined' || !maplibregl.Marker) return;

    // ------------------------------------------------------------- config ----
    // CONFIG SURFACE for future sources: add an entry here + a provider in
    // PROVIDERS below. Nothing else needs to change.
    var GI_CONFIG = {
        ais: {
            label: 'AIS source 1',
            meta: 'AISStream.io \u00b7 free WS feed',
            // FREE TIER KEY (https://aisstream.io). Override at runtime with
            // localStorage.setItem('sc_ais_key', '<key>'). Leave '' for SIM mode.
            apiKey: '',
            url: 'wss://stream.aisstream.io/v0/stream',
            maxMarkers: 80,      // DOM marker cap — keep the map snappy
            staleMs: 600000,     // drop contacts silent >10 min (live feed)
            retryMax: 3,         // reconnect attempts before showing OFFLINE
            simVessels: 16,      // synthetic fleet size when no key configured
            tickMs: 4000
        },
        tak: {
            label: 'FutureForces TAK source 1',
            meta: 'CoT gateway \u00b7 FreeTAK compatible',
            transport: 'websocket',   // 'websocket' | 'poll'
            // Point at a CoT-over-WebSocket bridge (FreeTAKServer + ws relay,
            // PyTAK --cot-url ws://...) e.g. 'ws://freetak:8000/cot'. ''
            // = local CoT mock stream (real XML through the same parser).
            wsUrl: '',
            pollUrl: '',              // used when transport === 'poll'
            pollMs: 15000,
            staleMs: 180000,
            retryMax: 3,
            simContacts: 7,
            tickMs: 5000
        },
        otht: {
            label: 'OTHT-Gold',
            meta: 'OpenSky + AIS fused \u00b7 long-range',
            mode: 'fused',            // 'fused' | 'sim'
            minSpeedKts: 430,         // high-interest thresholds for fused picks
            minAltFt: 28000,
            minVesselKts: 22,         // fast movers on the AIS picture
            minShow: 4,               // below this the SIM OTH picture backfills
            simTracks: 5,
            refreshMs: 5000
        }
    };
    var SRC_IDS = ['ais', 'tak', 'otht'];
    var LS_STATE = 'sc_gaia_integrations_v1';
    var LS_COLLAPSE = 'sc_gaia_int_collapsed_v1';

    // ---------------------------------------------------------------- state --
    var state = { ais: { on: false }, tak: { on: false }, otht: { on: false } };
    var pts = { ais: [], tak: [], otht: [] };       // live contact arrays
    var markers = { ais: [], tak: [], otht: [] };   // maplibregl.Marker pools
    var timers = { ais: null, tak: null, otht: null };
    var socks = { ais: null, tak: null };           // WebSocket handles
    var linkState = { ais: 'idle', tak: 'idle', otht: 'idle' }; // idle|connecting|live|sim|offline
    var listEl = null, metaEl = null, hudEl = null, statusEl = null, legendDone = false;
    var lastMetaWritten = '', lastHudWritten = '';

    try {
        var saved = JSON.parse(localStorage.getItem(LS_STATE));
        if (saved && typeof saved === 'object') SRC_IDS.forEach(function (id) {
            if (saved[id] && typeof saved[id].on === 'boolean') state[id].on = saved[id].on;
        });
    } catch (e) {}

    function saveState() { try { localStorage.setItem(LS_STATE, JSON.stringify(state)); } catch (e) {} }
    function esc(s) {
        s = s == null ? '' : String(s);
        if (typeof window.escapeHtml === 'function') return window.escapeHtml(s);
        return s.replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function cfgKey(id, key) {
        if (key !== 'apiKey') return GI_CONFIG[id][key];
        var lsKey = '';
        try { lsKey = localStorage.getItem('sc_ais_key') || ''; } catch (e) {}
        return lsKey || GI_CONFIG.ais.apiKey || '';
    }
    function scopeBbox() {
        try { if (typeof window.scBbox === 'function') return window.scBbox(); } catch (e) {}
        return null;
    }
    function scopeCenter() {
        var b = scopeBbox();
        if (b) return { lat: (b.lamin + b.lamax) / 2, lng: (b.lomin + b.lomax) / 2 };
        try {
            if (window.fusionMap && window.fusionMap.getCenter) {
                var c = window.fusionMap.getCenter();
                return { lat: c.lat, lng: c.lng };
            }
        } catch (e) {}
        return { lat: 20, lng: 20 };
    }
    function ensureMap() {
        var m = window.fusionMap;
        if ((!m || !m.addSource) && typeof window.initFusionMap === 'function') {
            try { m = window.initFusionMap(); } catch (e) { m = null; }
        }
        return m && m.addSource ? m : null;
    }

    // ------------------------------------------------------- panel section ---
    function injectSection() {
        listEl = document.getElementById('gaiaIntList');
        if (listEl) return true; // idempotent
        var anchor = document.getElementById('gaiaLayerList');
        if (!anchor) return false;
        var wrap = document.createElement('div');
        wrap.innerHTML =
            '<div class="gaia-section-tag" id="gaiaIntTag" role="button" tabindex="0" aria-expanded="true" title="Toggle INTEGRATIONS">' +
                '<span class="sc-wireframe-boxes"><span class="sc-wireframe-box active"></span><span class="sc-wireframe-box active"></span>' +
                '<span class="sc-wireframe-box active"></span><span class="sc-wireframe-box active"></span><span class="sc-wireframe-box"></span></span>' +
                '<span>INTEGRATIONS</span>' +
                '<span class="gi-chev" aria-hidden="true">&#9662;</span>' +
            '</div>' +
            '<div class="gaia-layer-list" id="gaiaIntList"></div>';
        var intTag = wrap.children[0], intList = wrap.children[1];
        anchor.insertAdjacentElement('afterend', intTag);       // section tag under the Layers rows
        intTag.insertAdjacentElement('afterend', intList);      // integrations list under the tag
        listEl = document.getElementById('gaiaIntList');
        renderRows();
        bindRows();
        var closed = false;
        try { closed = localStorage.getItem(LS_COLLAPSE) === '1'; } catch (e) {}
        setCollapsed(closed, false);
        return true;
    }
    function setCollapsed(closed, persist) {
        var tag = document.getElementById('gaiaIntTag');
        if (listEl) listEl.classList.toggle('gi-collapsed', !!closed);
        if (tag) {
            tag.classList.toggle('gi-closed', !!closed);
            tag.setAttribute('aria-expanded', closed ? 'false' : 'true');
        }
        if (persist !== false) { try { localStorage.setItem(LS_COLLAPSE, closed ? '1' : '0'); } catch (e) {} }
    }

    function rowHTML(id) {
        var c = GI_CONFIG[id];
        var on = !!state[id].on;
        return '<div class="gaia-row gi-row' + (on ? ' on' : '') + '" data-int="' + id + '">' +
            '<span class="gaia-dot" data-int-dot></span>' +
            '<div class="gaia-row-main"><span class="gaia-row-label">' + esc(c.label) +
                '<span class="gi-count" data-int-count hidden></span></span>' +
            '<span class="gaia-row-meta">' + esc(c.meta) + '</span></div>' +
            '<span class="gaia-row-status" data-int-status data-status="dim">IDLE</span>' +
            '<button type="button" class="gaia-switch" role="switch" aria-checked="' + on + '" title="Toggle ' + esc(c.label) + '"></button>' +
            '</div>';
    }
    function renderRows() {
        if (!listEl) return;
        listEl.innerHTML = SRC_IDS.map(rowHTML).join('');
        refreshStatuses();
    }
    function bindRows() {
        listEl.addEventListener('click', function (e) {
            var sw = e.target.closest ? e.target.closest('.gaia-switch') : null;
            var row = sw && sw.closest('.gaia-row');
            if (!row) return;
            toggle(row.getAttribute('data-int'));
        });
        var tag = document.getElementById('gaiaIntTag');
        if (tag) {
            var flip = function () { setCollapsed(!listEl.classList.contains('gi-collapsed')); };
            tag.addEventListener('click', flip);
            tag.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); }
            });
        }
    }

    // ------------------------------------------------------------ statuses ---
    function statusFor(id) {
        var n = pts[id].length, st = state[id].on;
        if (!st) return { tag: 'IDLE', cls: 'dim' };
        if (linkState[id] === 'offline') return { tag: 'OFFLINE', cls: 'err' };
        if (linkState[id] === 'sim') return n ? { tag: 'SIM\u00b7' + n, cls: 'warn' } : { tag: 'ARMED', cls: 'busy' };
        if (linkState[id] === 'connecting') return { tag: 'ARMED', cls: 'busy' };
        return n ? { tag: n + ' ' + (id === 'ais' ? 'SHP' : id === 'tak' ? 'COT' : 'OTH'), cls: 'live' }
                 : { tag: 'ARMED', cls: 'busy' };
    }
    function refreshStatuses() {
        SRC_IDS.forEach(function (id) {
            var row = listEl && listEl.querySelector('[data-int="' + id + '"]');
            if (!row) return;
            var s = statusFor(id), n = pts[id].length;
            row.classList.toggle('on', !!state[id].on);
            var dot = row.querySelector('[data-int-dot]');
            var stat = row.querySelector('[data-int-status]');
            var cnt = row.querySelector('[data-int-count]');
            if (dot) dot.setAttribute('data-status', s.cls);
            if (stat) { stat.setAttribute('data-status', s.cls); stat.textContent = s.tag; }
            if (cnt) {
                cnt.hidden = !(state[id].on && n > 0);
                cnt.textContent = '\u00b7 ' + n;
                cnt.setAttribute('data-hot', s.cls === 'live' ? '1' : '0');
            }
            var swb = row.querySelector('.gaia-switch');
            if (swb) swb.setAttribute('aria-checked', state[id].on ? 'true' : 'false');
        });
        writeMeta();
    }

    // ------------------------------------------- chrome: counter/HUD/status --
    function armedIds() { return SRC_IDS.filter(function (id) { return state[id].on; }); }
    function baseRegistryCounts() {
        var out = { on: 0, total: 0 };
        try {
            (window.GAIA.layers() || []).forEach(function (r) { out.total++; if (r.on) out.on++; });
        } catch (e) {}
        return out;
    }
    function writeMeta() {
        if (!metaEl) return;
        var b = baseRegistryCounts();
        var armed = armedIds().length;
        lastMetaWritten = (b.on + armed) + '/' + (b.total + SRC_IDS.length) + ' LAYERS';
        if (metaEl.textContent !== lastMetaWritten) metaEl.textContent = lastMetaWritten;
    }
    function hudSuffix() {
        var parts = [];
        SRC_IDS.forEach(function (id) {
            if (state[id].on && pts[id].length) parts.push((id === 'ais' ? 'AIS ' : id === 'tak' ? 'TAK ' : 'OTH ') + pts[id].length);
        });
        return parts.length ? ' \u00b7 INTEGRATIONS ' + parts.join(' \u00b7 ') : '';
    }
    function footerSummary() {
        if (!statusEl) return;
        var armed = armedIds();
        if (!armed.length) { statusEl.textContent = 'Standing by.'; return; }
        statusEl.textContent = 'INTEGRATIONS ARMED \u2014 ' + armed.map(function (id) {
            var s = statusFor(id);
            return GI_CONFIG[id].label + ' (' + s.tag + ')';
        }).join(' \u00b7 ');
    }

    // ------------------------------------------------------------- markers ---
    var SHIP_D = 'M12 2.2 L14.6 7.6 L13.9 20 L10.1 20 L9.4 7.6 Z M12 4.6 L12 17'; // hull + centerline
    function vesselColor(cat) {
        return cat === 'military' ? '#ef4444' : cat === 'private' ? '#f59e0b' : '#22d3ee';
    }
    function mkRemove(list) { (list || []).forEach(function (mk) { try { mk.remove(); } catch (e) {} }); }
    function renderSource(id) {
        var m = ensureMap();
        mkRemove(markers[id]);
        markers[id] = [];
        if (!m) return;
        var cap = id === 'ais' ? GI_CONFIG.ais.maxMarkers : 120;
        pts[id].slice(0, cap).forEach(function (p) {
            var el = document.createElement('div');
            el.className = 'gi-mk';
            var rot = ((Number(p.heading) % 360) + 360) % 360 || 0;
            var mk;
            if (id === 'ais') {
                el.title = p.label + ' \u00b7 AIS ' + p.cat.toUpperCase() + ' \u00b7 ' + Math.round(p.speed) + ' kts \u00b7 HDG ' + Math.round(rot);
                el.style.color = vesselColor(p.cat);
                el.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' +
                    '<circle class="gi-vessel-ring" cx="12" cy="12" r="10.4"/>' +
                    '<path d="' + SHIP_D + '" fill="currentColor" stroke="none"/></svg>';
                mk = new maplibregl.Marker({ element: el, anchor: 'center', rotation: rot, rotationAlignment: 'map', pitchAlignment: 'map' });
            } else if (id === 'tak') {
                var aff = p.cat === 'friendly' ? '' : p.cat === 'hostile' ? ' gi-hst' : ' gi-unk';
                el.title = p.label + ' \u00b7 TAK ' + p.cat.toUpperCase() + ' \u00b7 type ' + (p.cotType || '?');
                el.innerHTML = '<div class="gi-tak' + aff + '"><i></i></div>';
                mk = new maplibregl.Marker({ element: el, anchor: 'center' });
            } else {
                el.title = p.label + ' \u00b7 OTHT-GOLD \u00b7 ' + Math.round(p.speed) + ' kts' +
                    (p.alt ? ' \u00b7 FL' + Math.round(Number(p.alt) / 100) : '') + ' \u00b7 HDG ' + Math.round(rot);
                el.innerHTML = '<div class="gi-oth-wrap">' +
                    '<div class="gi-oth-trail" style="transform:rotate(' + (rot - 90) + 'deg)"></div>' +
                    '<div class="gi-oth"></div></div>';
                mk = new maplibregl.Marker({ element: el, anchor: 'center', rotation: rot, rotationAlignment: 'map', pitchAlignment: 'map' });
            }
            try { mk.setLngLat([p.lng, p.lat]).addTo(m); markers[id].push(mk); } catch (e) {}
        });
    }
    function renderAllArmed() { SRC_IDS.forEach(function (id) { if (state[id].on) renderSource(id); }); }

    // ------------------------------------------------------ toggle plumbing --
    function toggle(id, force) {
        var want = force != null ? !!force : !state[id].on;
        if (state[id].on === want) return;
        state[id].on = want;
        saveState();
        PROVIDERS[id](want);
        refreshStatuses();
        ensureLegend();
        footerSummary();
    }

    // ============================================================== PROVIDERS
    var PROVIDERS = {
        // ------------------------------------------------------------- AIS ---
        ais: function (want) {
            if (timers.ais) { clearInterval(timers.ais); timers.ais = null; }
            closeSock('ais');
            if (!want) { pts.ais = []; linkState.ais = 'idle'; renderSource('ais'); return; }
            var c = GI_CONFIG.ais;
            if (cfgKey('ais', 'apiKey')) {
                linkState.ais = 'connecting';
                connectAis(0);
            } else {
                linkState.ais = 'sim';
                seedSimVessels(c.simVessels);
            }
            timers.ais = setInterval(function () {
                if (!state.ais.on) return;
                stepContacts(pts.ais, GI_CONFIG.ais.tickMs);
                pruneStale(pts.ais, c.staleMs, 'ais');
                renderSource('ais');
                refreshStatuses();
            }, c.tickMs);
        },
        // ------------------------------------------------------------- TAK ---
        tak: function (want) {
            if (timers.tak) { clearInterval(timers.tak); timers.tak = null; }
            closeSock('tak');
            if (!want) { pts.tak = []; linkState.tak = 'idle'; renderSource('tak'); return; }
            var c = GI_CONFIG.tak;
            if (c.transport === 'websocket' && c.wsUrl) {
                linkState.tak = 'connecting';
                connectTak(0);
            } else if (c.transport === 'poll' && c.pollUrl) {
                linkState.tak = 'connecting';
                pollTak();
                timers.tak = setInterval(function () { if (state.tak.on) pollTak(); }, c.pollMs);
            } else {
                // Local CoT mock: REAL CoT 2.0 XML pushed through the same parser.
                linkState.tak = 'sim';
            }
            timers.tak = setInterval(function () {
                if (!state.tak.on) return;
                if (linkState.tak === 'sim') mockCoTTick();
                stepContacts(pts.tak, GI_CONFIG.tak.tickMs);
                pruneStale(pts.tak, c.staleMs, 'tak');
                renderSource('tak');
                refreshStatuses();
            }, c.tickMs);
        },
        // ------------------------------------------------------------ OTHT ---
        otht: function (want) {
            if (timers.otht) { clearInterval(timers.otht); timers.otht = null; }
            if (!want) { pts.otht = []; linkState.otht = 'idle'; renderSource('otht'); return; }
            seedSimOth(GI_CONFIG.otht.simTracks); // backfill; replaced as fused data flows
            linkState.otht = 'live';
            buildOthPicture();
            timers.otht = setInterval(function () {
                if (!state.otht.on) return;
                buildOthPicture();
                stepContacts(pts.otht.filter(function (p) { return p.sim; }), GI_CONFIG.otht.refreshMs * 2);
                renderSource('otht');
                refreshStatuses();
            }, GI_CONFIG.otht.refreshMs);
        }
    };
    function closeSock(id) {
        if (socks[id]) { try { socks[id].onclose = null; socks[id].close(); } catch (e) {} socks[id] = null; }
    }

    // --------------------------------------------------------- AIS provider --
    function connectAis(attempt) {
        var c = GI_CONFIG.ais;
        var ws;
        // Relay mode: key stays server-side (backend injects AISSTREAM_API_KEY).
        var useRelay = false;
        try { useRelay = c.relay === true || localStorage.getItem('sc_ais_relay') === '1'; } catch (e) {}
        if (useRelay && typeof authToken === 'string' && authToken) {
            var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
            try { ws = new WebSocket(proto + location.host + '/api/v1/maven/ais/ws?token=' + encodeURIComponent(authToken)); }
            catch (e) { aisFail(attempt); return; }
        } else {
            try { ws = new WebSocket(c.url); } catch (e) { aisFail(attempt); return; }
        }
        socks.ais = ws;
        ws.onopen = function () {
            // aisstream.io wire format: each BBoxID is [[sw_lat, sw_lon], [ne_lat, ne_lon]]
            var b = scopeBbox();
            var box = b ? [[[b.lamin, b.lomin], [b.lamax, b.lomax]]] : [[[-85, -180], [85, 180]]];
            var sub = {
                APIVersion: 'v1',
                BBoxIDs: box,
                FilterMessageTypes: ['PositionReport', 'StaticDataReport']
            };
            if (!useRelay) sub.APIKey = cfgKey('ais', 'apiKey');
            ws.send(JSON.stringify(sub));
            linkState.ais = 'live';
            refreshStatuses();
        };
        ws.onmessage = function (ev) {
            var msg;
            try { msg = JSON.parse(ev.data); } catch (e) { return; }
            ingestAisMessage(msg);
        };
        ws.onerror = function () { /* onclose follows */ };
        ws.onclose = function () {
            socks.ais = null;
            if (!state.ais.on) return;
            if (attempt < c.retryMax) {
                setTimeout(function () { if (state.ais.on) connectAis(attempt + 1); }, 1500 * (attempt + 1));
            } else {
                linkState.ais = pts.ais.length ? linkState.ais : 'offline';
                refreshStatuses();
                footerSummary();
            }
        };
    }
    function aisFail(attempt) {
        if (attempt < GI_CONFIG.ais.retryMax) setTimeout(function () { if (state.ais.on) connectAis(attempt + 1); }, 1500);
        else { linkState.ais = 'offline'; refreshStatuses(); }
    }
    function upsert(arr, id, fields) {
        var i;
        for (i = 0; i < arr.length; i++) if (arr[i].id === id) break;
        if (i < arr.length) { Object.assign(arr[i], fields, { ts: Date.now() }); return arr[i]; }
        var p = Object.assign({ id: id, ts: Date.now(), ts0: Date.now(), heading: 0, speed: 0 }, fields);
        arr.push(p);
        return p;
    }
    function ingestAisMessage(msg) {
        if (!msg || !msg.MessageType) return;
        var md = msg.MetaData || {}, body = msg.Message || {};
        var lat = md.latitude, lng = md.longitude;
        if (lat == null && body.PositionReport) { lat = body.PositionReport.Latitude; lng = lng == null ? body.PositionReport.Longitude : lng; }
        if (lat == null || lng == null) {
            // StaticDataReport may arrive alone — enrich name/type on the MMSI.
            if (msg.MessageType === 'StaticDataReport') {
                var rd = (body.StaticDataReport || {}).ReportedData || {};
                var mm = md.MMSI || body.StaticDataReport && body.StaticDataReport.UserID;
                if (mm != null) {
                    var ex = pts.ais.filter(function (p) { return p.id === String(mm); })[0];
                    if (ex) {
                        if (rd.Name) ex.label = String(rd.Name).trim();
                        var t = parseInt(rd.Type, 10);
                        if (Number.isFinite(t)) ex.cat = aisCat(t);
                        renderSource('ais'); refreshStatuses();
                    }
                }
            }
            return;
        }
        var pr = body.PositionReport || {};
        var sog = parseFloat(pr.Sog); var cog = parseFloat(pr.Cog);
        var p = upsert(pts.ais, String(md.MMSI || pr.UserID || ('unk-' + lat.toFixed(3))), {
            lat: Number(lat), lng: Number(lng),
            speed: Number.isFinite(sog) ? sog : 0,
            heading: Number.isFinite(cog) ? cog : 0,
            cat: 'commercial',
            label: (md.ShipName || '').trim() || ('MMSI ' + (md.MMSI || pr.UserID || '?'))
        });
        p.live = true;
    }
    function aisCat(t) { // AIS ship-type codes → design-language categories
        if (t === 35) return 'military';
        if (t === 36 || t === 37 || (t >= 40 && t <= 49)) return 'private';
        return 'commercial';
    }
    function seedSimVessels(n) {
        pts.ais = [];
        var c = scopeCenter(), degKm = 1 / 111;
        var names = ['MV MERIDIAN', 'ST ARGOSY', 'FV NORTHWIND', 'MT CORAL SEA', 'MV KESTREL', 'ST HALCYON',
                     'FV BOREALIS', 'MV SOLENNE', 'YT PILOT-4', 'MV TASMAN', 'FS VIGILANT', 'ST CYGNET',
                     'MV ORINOCO', 'FV PELAGIA', 'MS TRANQUIL', 'MV ANDES'];
        for (var i = 0; i < n; i++) {
            var r = (40 + (i * 137) % 380) * degKm;                       // 40–420 km ring
            var brg = (i * 222.5 * Math.PI / 180);
            var cat = i % 10 === 3 ? 'military' : (i % 3 === 0 ? 'private' : 'commercial');
            upsert(pts.ais, 'sim-' + (211000000 + i * 7717), {
                lat: c.lat + Math.cos(brg) * r, lng: c.lng + Math.sin(brg) * r / Math.max(.2, Math.cos(c.lat * Math.PI / 180)),
                speed: 8 + (i * 3.7) % 18, heading: (i * 47) % 360,
                cat: cat, label: names[i % names.length] + ' ' + (Math.floor(i / names.length) + 1)
            }).sim = true;
        }
    }

    // ---------------------------------------------------- contact kinematics -
    function stepContacts(arr, dtMs) {
        var now = Date.now(), dtH = Math.max(1, dtMs) / 3600000, degKm = 1 / 111;
        arr.forEach(function (p) {
            var spd = Number(p.speed) || 0;                       // knots → nm/h ≈ km/h*0.54; use kt-nautical deg approx
            var distKm = spd * 1.852 * dtH;
            var rad = (p.heading || 0) * Math.PI / 180;
            p.lat += Math.cos(rad) * distKm * degKm;
            p.lng += Math.sin(rad) * distKm * degKm / Math.max(.2, Math.cos(p.lat * Math.PI / 180));
            p.heading = (((p.heading || 0) + (Math.sin(now / 9000 + p.lat) * 1.4)) % 360 + 360) % 360;
            p.ts = now;
        });
    }
    function pruneStale(arr, staleMs, srcId) {
        var now = Date.now();
        for (var i = arr.length - 1; i >= 0; i--) {
            var keepLive = !arr[i].sim && (now - (arr[i].ts || 0)) < staleMs;
            var keepSim = arr[i].sim && state[srcId] && state[srcId].on; // sims persist while their source is armed
            if (!(keepLive || keepSim)) arr.splice(i, 1);
        }
    }

    // --------------------------------------------------------- TAK provider --
    function ingestCoT(text) {
        // Accepts concatenated CoT 2.0 XML events or JSON lines — both land here.
        var chunks = String(text).split(/(?=<event[\s>])/g);
        chunks.forEach(function (chunk) {
            chunk = chunk.trim();
            if (!chunk) return;
            if (chunk[0] === '{') {
                try { ingestCoTJson(JSON.parse(chunk)); } catch (e) {}
                return;
            }
            var doc;
            try { doc = new DOMParser().parseFromString(chunk, 'text/xml'); } catch (e) { return; }
            var evs = doc.getElementsByTagName('event');
            for (var i = 0; i < evs.length; i++) cotEventToPoint(evs[i]);
        });
    }
    function cotEventToPoint(ev) {
        var pt = ev.getElementsByTagName('point')[0];
        if (!ev.getAttribute || !pt) return;
        var lat = parseFloat(pt.getAttribute('lat')), lng = parseFloat(pt.getAttribute('lon'));
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
        var uid = ev.getAttribute('uid') || ('cot-' + lat.toFixed(4));
        var type = ev.getAttribute('type') || 'a-u-A';
        var affChar = (type.split('-')[1] || 'u').toLowerCase();
        var cat = affChar === 'f' || affChar === 'n' ? 'friendly'
                : affChar === 'h' || affChar === 's' || affChar === 'j' ? 'hostile' : 'unknown';
        var det = ev.getElementsByTagName('detail')[0];
        var csEl = det && det.getElementsByTagName ? det.getElementsByTagName('contact')[0] : null;
        var trkEl = det && det.getElementsByTagName ? det.getElementsByTagName('track')[0] : null;
        var course = trkEl ? parseFloat(trkEl.getAttribute('course')) : NaN;
        var speed = trkEl ? parseFloat(trkEl.getAttribute('speed')) : NaN; // m/s
        var callsign = (csEl && csEl.getAttribute && csEl.getAttribute('callsign')) || uid;
        upsert(pts.tak, uid, {
            lat: lat, lng: lng,
            heading: Number.isFinite(course) ? course : 0,
            speed: Number.isFinite(speed) ? speed * 1.94384 : 0,
            cat: cat, label: callsign, cotType: type
        }).live = true;
    }
    function ingestCoTJson(j) {
        if (!j || !Number.isFinite(parseFloat(j.lat))) return;
        upsert(pts.tak, j.uid || j.callsign || ('j-' + j.lat), {
            lat: parseFloat(j.lat), lng: parseFloat(j.lng),
            heading: parseFloat(j.course) || 0, speed: (parseFloat(j.speed) || 0) * 1.94384,
            cat: j.cat || 'unknown', label: j.callsign || j.uid || 'CoT', cotType: j.type || 'a-u-A'
        }).live = true;
    }
    function connectTak(attempt) {
        var c = GI_CONFIG.tak, ws;
        try { ws = new WebSocket(c.wsUrl); } catch (e) { takOffline(); return; }
        socks.tak = ws;
        ws.onopen = function () { linkState.tak = 'live'; refreshStatuses(); };
        ws.onmessage = function (ev) { ingestCoT(typeof ev.data === 'string' ? ev.data : ''); renderSource('tak'); refreshStatuses(); };
        ws.onerror = function () {};
        ws.onclose = function () {
            socks.tak = null;
            if (!state.tak.on) return;
            if (attempt < c.retryMax) setTimeout(function () { if (state.tak.on) connectTak(attempt + 1); }, 1500 * (attempt + 1));
            else takOffline();
        };
    }
    function takOffline() {
        linkState.tak = pts.tak.length ? linkState.tak : 'offline';
        refreshStatuses(); footerSummary();
    }
    function pollTak() {
        if (typeof fetch !== 'function') { takOffline(); return; }
        fetch(GI_CONFIG.tak.pollUrl).then(function (r) { return r.text(); }).then(function (t) {
            linkState.tak = 'live';
            ingestCoT(t);
            renderSource('tak'); refreshStatuses();
        }).catch(function () { takOffline(); });
    }
    // Local CoT mock generator — emits genuine CoT 2.0 event XML through ingestCoT,
    // so swapping wsUrl to a live FreeTAKServer exercises identical code paths.
    var MOCK_TAK = [
        { uid: 'FF-TAK-01', type: 'a-f-A-M-FQF', aff: 'f', cs: 'FF-ALPHA-1' },
        { uid: 'FF-TAK-02', type: 'a-f-A-M-FQF', aff: 'f', cs: 'FF-ALPHA-2' },
        { uid: 'FF-TAK-03', type: 'a-f-G-E-V-C', aff: 'f', cs: 'FF-CONVOY-7' },
        { uid: 'FF-TAK-04', type: 'a-u-A-M-FQ', aff: 'u', cs: 'UNK-TRACK-44' },
        { uid: 'FF-TAK-05', type: 'a-u-A-M-FQ', aff: 'u', cs: 'UNK-TRACK-51' },
        { uid: 'FF-TAK-06', type: 'a-u-S-N-I', aff: 'u', cs: 'UNK-SIGNAL-09' },
        { uid: 'FF-TAK-07', type: 'a-f-A-M-FQ', aff: 'f', cs: 'FF-BRAVO-3' }
    ];
    function iso(msAgo) { return new Date(Date.now() - (msAgo || 0)).toISOString(); }
    function mockCoTTick() {
        var c = scopeCenter(), degKm = 1 / 111;
        MOCK_TAK.slice(0, GI_CONFIG.tak.simContacts).forEach(function (m, i) {
            var r = (25 + i * 33) * degKm, brg = (i * 51.4 + Date.now() / 240000) * Math.PI / 180;
            var lat = c.lat + Math.cos(brg) * r;
            var lng = c.lng + Math.sin(brg) * r / Math.max(.2, Math.cos(c.lat * Math.PI / 180));
            var xml = '<event version="2.0" uid="' + m.uid + '" type="' + m.type + '"' +
                ' time="' + iso(0) + '" start="' + iso(0) + '" stale="' + iso(-300000) + '" how="m-g">' +
                '<point lat="' + lat.toFixed(5) + '" lon="' + lng.toFixed(5) + '" hae="120" ce="12" le="20"/>' +
                '<detail><contact callsign="' + m.cs + '"/><track course="' + Math.round(((brg * 180 / Math.PI) % 360 + 360) % 360) + '" speed="' + (40 + i * 9) + '"/>' +
                '<__group name="' + (m.aff === 'f' ? 'Blue' : 'Unknown') + '" role="Team Member"/></detail></event>';
            ingestCoT(xml);
            var p = pts.tak.filter(function (q) { return q.id === m.uid; })[0];
            if (p) { p.sim = true; delete p.live; } // mock stays flagged synthetic
        });
    }

    // -------------------------------------------------------- OTHT provider --
    function flightProps() {
        var out = [];
        try {
            (window.fusionFlights || []).forEach(function (f) {
                var p = f && f.properties;
                if (p && p.lat != null && p.lng != null) out.push(p);
            });
        } catch (e) {}
        return out;
    }
    function buildOthPicture() {
        var c = GI_CONFIG.otht, found = [];
        if (c.mode === 'fused') {
            flightProps().forEach(function (p) {
                var spd = parseFloat(p.speed_knots), alt = parseFloat(String(p.alt).replace(/[^\d.]/g, ''));
                var hot = (Number.isFinite(spd) && spd >= c.minSpeedKts) ||
                          (Number.isFinite(alt) && alt >= c.minAltFt) ||
                          p.category === 'military';
                if (hot) found.push({
                    id: 'oth-air-' + (p.icao24 || p.callsign || (p.lat + ',' + p.lng)),
                    lat: Number(p.lat), lng: Number(p.lng),
                    speed: Number.isFinite(spd) ? spd : 0, alt: Number.isFinite(alt) ? alt : 0,
                    heading: parseFloat(p.heading) || 0,
                    label: p.callsign || p.icao24 || 'AIR', kind: 'AIR'
                });
            });
            pts.ais.forEach(function (p) {
                if (p.speed >= c.minVesselKts) found.push({
                    id: 'oth-sea-' + p.id, lat: p.lat, lng: p.lng,
                    speed: p.speed, alt: 0, heading: p.heading, label: p.label, kind: 'SEA'
                });
            });
        }
        // Simulated long-range tracks fill the picture only while fused data is
        // thin; they never churn (top-up semantics, no strip/re-seed cycling).
        var nowTs = Date.now();
        var wantSim = GI_CONFIG.otht.mode === 'sim' || found.length < GI_CONFIG.otht.minShow;
        pts.otht = pts.otht.filter(function (p) {
            if (p.sim) return wantSim && state.otht.on;
            return nowTs - (p.ts || 0) < 300000; // fused contacts vanish 5 min after their feed stops listing them
        });
        if (wantSim) {
            var have = pts.otht.reduce(function (n, p) { return n + (p.sim ? 1 : 0); }, 0);
            if (have < GI_CONFIG.otht.simTracks) seedSimOth(GI_CONFIG.otht.simTracks - have);
        }
        found.forEach(function (p) { p.ts = Date.now(); p.live = true; upsert(pts.otht, p.id, p); });
        linkState.otht = found.length ? 'live' : (pts.otht.length ? 'sim' : 'idle');
    }
    function seedSimOth(n) {
        var c = scopeCenter(), degKm = 1 / 111;
        for (var i = 0; i < n; i++) {
            var r = (480 + i * 130) * degKm, brg = (i * 77 + Date.now() / 600000) * Math.PI / 180;
            upsert(pts.otht, 'oth-sim-' + i, {
                lat: c.lat + Math.cos(brg) * r,
                lng: c.lng + Math.sin(brg) * r / Math.max(.2, Math.cos(c.lat * Math.PI / 180)),
                speed: 430 + i * 45, heading: ((brg * 180 / Math.PI) + 180) % 360,
                label: 'OTH-SIM-' + (i + 1), kind: 'AIR'
            }).sim = true;
        }
    }

    // --------------------------------------------------- legend + observers --
    function ensureLegend() {
        if (legendDone || !armedIds().length) return;
        var leg = document.querySelector('.sc-legend');
        if (!leg) return;
        var dot = function (color, glow, label) {
            return '<span><span class="sc-legend-dot" style="background:' + color + ';box-shadow:0 0 4px ' + (glow || color) + '"></span> ' + label + '</span>';
        };
        leg.insertAdjacentHTML('beforeend',
            dot('#22d3ee', null, 'Vessel') +
            dot('#22c544', null, 'TAK-Friendly') +
            dot('#8a8f98', null, 'TAK-Unknown') +
            dot('#ffd166', '#ffd166', 'OTH-Gold'));
        legendDone = true;
    }
    function wireChrome() {
        metaEl = document.getElementById('gaiaMeta');
        hudEl = document.getElementById('fusionMapHud');
        statusEl = document.getElementById('gaiaStatus');
        if (metaEl) {
            new MutationObserver(function () {
                if (metaEl.textContent !== lastMetaWritten) writeMeta();
            }).observe(metaEl, { childList: true, characterData: true, subtree: true });
        }
        if (hudEl) {
            new MutationObserver(function () {
                var suffix = hudSuffix();
                var base = hudEl.textContent.replace(/\s*\u00b7 INTEGRATIONS.*$/, '');
                var want = base + suffix;
                if (hudEl.textContent !== want) { lastHudWritten = want; hudEl.textContent = want; }
            }).observe(hudEl, { childList: true, characterData: true, subtree: true });
        }
        // Re-add markers after any core fusion-map rebuild (additive wrap).
        if (typeof window.renderFusionMap === 'function' && !window.renderFusionMap.__giWrapped) {
            var origRender = window.renderFusionMap;
            window.renderFusionMap = function () {
                var res = origRender.apply(this, arguments);
                setTimeout(renderAllArmed, 450);
                return res;
            };
            window.renderFusionMap.__giWrapped = true;
        }
    }

    // -------------------------------------------------------------- public ---
    window.GAIA_INTEGRATIONS = {
        toggle: function (id, on) { if (GI_CONFIG[id]) toggle(id, on); },
        state: function () { return JSON.parse(JSON.stringify(state)); },
        counts: function () { return { ais: pts.ais.length, tak: pts.tak.length, otht: pts.otht.length }; },
        config: GI_CONFIG   // ← swap-in point for real/commercial feeds
    };

    // ---------------------------------------------------------------- boot ---
    var bootTries = 0;
    function boot() {
        // Gate on the GAIA controller itself: rows rendered + public API live —
        // so counter math (GAIA.layers) and DOM anchors are guaranteed.
        var anchor = document.getElementById('gaiaLayerList');
        if (!anchor || !anchor.children.length || !window.GAIA || typeof window.GAIA.layers !== 'function') {
            if (++bootTries < 40) setTimeout(boot, 500);
            return;
        }
        if (!injectSection()) return;
        wireChrome();
        SRC_IDS.forEach(function (id) { if (state[id].on) { PROVIDERS[id](true); } });
        if (armedIds().length) { ensureLegend(); footerSummary(); }
        refreshStatuses();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 350); });
    else setTimeout(boot, 350);
})();
</script>

