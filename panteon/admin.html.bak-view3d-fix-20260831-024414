async function fusionRunOpenSky() {
    const el = document.getElementById('fusionValidateStatus');
    const bbox = scBbox();
    const scopeLabel = SCScope.country || SCScope.zone || SCScope.region;
    const rate = await api('/opensky/pipeline/rate').catch(() => null);
    if (rate && !rate.can_pull_adsb_now) {
        const waitS = Math.ceil(rate.adsb_seconds_left || 0);
        if (el) el.innerHTML = '<span style="color:var(--amber)">⏸ Feed: wait ' + waitS + 's until next pull' + (rate.opensky_seconds_left > 0 ? ' · OpenSky enrichment due in ' + Math.ceil(rate.opensky_seconds_left) + 's' : '') + '</span>';
        return;
    }
    if (el) el.innerHTML = '<span style="color:var(--amber)">⟳ Running feed pull for ' + scopeLabel + ' (background)…</span>';
    try {
        const payload = { client_id: '', client_secret: '', fetch_military: true, request_timeout: 30, max_retries: 5 };
        if (bbox) { payload.lamin = bbox.lamin; payload.lomin = bbox.lomin; payload.lamax = bbox.lamax; payload.lomax = bbox.lomax; }
        const start = await api('/opensky/pipeline/run', { method: 'POST', body: JSON.stringify(payload) });
        if (start.status === 'rejected') {
            if (el) el.innerHTML = '<span style="color:var(--amber)">⏸ Feed: ' + escapeHtml(start.message || 'not due') + '</span>';
            return;
        }
        fusionAutoRunAt = Date.now(); // don't double-fire vs live loop
    } catch (e) { if (el) el.innerHTML = '<span style="color:var(--red)">✗ ' + escapeHtml(e.message) + '</span>'; return; }
    // Poll status.
    const t0 = Date.now();
    while (Date.now() - t0 < 180000) {
        await new Promise(r => setTimeout(r, 3000));
        let st;
        try { st = await api('/opensky/pipeline/status'); } catch (e) { continue; }
        if (st.status === 'complete') {
            const r = st.report || {};
            if (el) el.innerHTML = '<span style="color:var(--green)">✓ OpenSky: ' + (r.classification ? r.classification.military + ' military / ' + (r.opensky ? r.opensky.total : 0) + ' total' : 'done') + '</span>';
            break;
        }
        if (st.status === 'failed') {
            if (el) el.innerHTML = '<span style="color:var(--red)">✗ OpenSky: ' + escapeHtml(st.error || 'failed') + '</span>';
            break;
        }
        if (el) el.innerHTML = '<span style="color:var(--amber)">⟳ OpenSky running…</span>';
    }
    renderFusionMap(true);
}

function fitThreatBounds() {
    if (!threatMap) return;
    const pts = threatMapEvents.map(parseActionGeo).filter(Boolean);
    if (!pts.length) { resetMapView(); return; }
    const b = pts.reduce((bb, p) => ({
        minX: Math.min(bb.minX, p.longitude), maxX: Math.max(bb.maxX, p.longitude),
        minY: Math.min(bb.minY, p.latitude), maxY: Math.max(bb.maxY, p.latitude),
    }), { minX: 180, maxX: -180, minY: 90, maxY: -90 });
    threatMap.fitBounds([[b.minX, b.minY], [b.maxX, b.maxY]], { padding: 60, maxZoom: 8, duration: 1200 });
}

async function renderThreatMap(auto) {
    const query = document.getElementById('threatMapQuery').value.trim() || '(military OR defense OR conflict)';
    const layer = document.getElementById('threatMapLayer').value;
    // Infer threat intent from the query so markers/tables/threat count reflect
    // conflict coverage even on the default "Render Map" action.
    threatQueryIntent = queryIntent(query);
    const map = initThreatMap();
    const hudMeta = document.getElementById('threatMapHudMeta');
    const hint = document.getElementById('threatMapHint');
    if (hudMeta) hudMeta.textContent = 'Loading events from OSv2 / GKG pipeline...';
    if (hint) hint.textContent = 'QUERY: ' + query + ' — pulling events';

    let data;
    try {
        var cc = (typeof scCountryFips === 'function' && SCScope.country) ? ('&country=' + encodeURIComponent(SCScope.country)) : '';
        data = await api('/gkg/events?limit=250' + cc);
    } catch (e) {
        data = { events: [] };
    }
    let events = gkgEventsFrom(data && data.events);
    // Stored events are query-agnostic (DOC headlines are multi-language, so we
    // do not keyword-filter the store). The query box drives fresh pipeline
    // pulls (below) and the threat-intent coloring, while the Layer dropdown
    // filters what is plotted from the store.
    if (!events.length && !auto) {
        const st = await startGkgPipeline({ query: query, mode: 'events', timespan: '24h', maxrecords: 50, api_key: '' }, (s) => {
            if (!hudMeta) return;
            if (s.status === 'running') {
                const secs = Math.round((Date.now() - new Date(s.started_at || Date.now()).getTime()) / 1000);
                hudMeta.textContent = 'GKG pipeline running... ' + secs + 's';
            } else if (s.error) {
                hudMeta.textContent = 'GKG pipeline error: ' + s.error;
            }
        });
        if (st && (st.status === 'complete' || st.status === 'failed')) {
            try {
                const d2 = await api('/gkg/events?limit=250');
                const ev2 = gkgEventsFrom(d2 && d2.events);
                if (ev2.length) events = ev2;
            } catch (e) { /* keep stored events */ }
        }
        if (hudMeta) hudMeta.textContent = events.length
            ? 'Loaded ' + events.length + ' events from GDELT'
            : 'No geocoded events yet — run the GKG pipeline';
    } else if (!events.length && auto) {
        if (hudMeta) hudMeta.textContent = 'No events stored yet — click "Render Map" to pull GDELT GKG coverage, or pick a conflict preset';
        if (hint) hint.textContent = 'No stored events. Use the presets above to seed a conflict search.';
    }
    threatMapEvents = events;

    let filtered = events;
    if (layer === 'geospatial') filtered = events.filter(e => parseActionGeo(e));
    else if (layer === 'actors') filtered = events.filter(e => e.actor1 || e.event_type);
    else if (layer === 'tone') filtered = events.filter(e => e.avg_tone != null);

    renderThreatMarkers(filtered);
    renderThreatTables(filtered);
    const m = computeIntelMetrics(filtered);
    document.getElementById('metricSystemicImportance').textContent = m.systemic;
    document.getElementById('metricPropagationPotential').textContent = m.propagation;
    document.getElementById('metricMarketSensitivity').textContent = m.sensitivity;
    document.getElementById('threatMapEventCount').textContent = m.geoCoded;
    document.getElementById('threatMapThreatCount').textContent = m.negative;
    if (hudMeta) hudMeta.textContent = filtered.length + ' events analyzed · ' + m.geoCoded + ' geocoded · ' + m.negative + ' active threats · layer: ' + layer;
    if (hint) hint.textContent = m.geoCoded ? (m.negative ? m.negative + ' conflict markers plotted' : m.geoCoded + ' markers plotted') : 'No geocoded events — run the GKG pipeline';
    requestAnimationFrame(() => { if (threatMap) threatMap.resize(); });
    if (filtered.length) fitThreatBounds();
}

