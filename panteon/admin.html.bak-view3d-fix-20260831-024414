        try {
            // ontology-honest: prefer real buildings over landuse — landuse was masking Grand Hyatt
            var fs = m.queryRenderedFeatures(point, { layers: ['3d-buildings'] });
            if (!fs || !fs.length) {
                var landLayers=['landuse_residential','landuse_commercial','landuse_industrial','landuse_park','landuse_forest','landuse_farm'].filter(function(l){ return m.getLayer(l); });
                if(landLayers.length) fs = m.queryRenderedFeatures(point, { layers: landLayers });
            }
            if (!fs || !fs.length) return null;
            function geomArea(geom) {
                if (!geom || !geom.coordinates) return 0;
                var coords = geom.coordinates;
                if (geom.type === 'Polygon') {
                    var ring = coords[0];
                    var area = 0;
                    for (var i = 0; i < ring.length - 1; i++) {
                        area += ring[i][0] * ring[i + 1][1] - ring[i + 1][0] * ring[i][1];
                    }
                    return Math.abs(area);
                }
                if (geom.type === 'MultiPolygon') {
                    var total = 0;
                    for (var p = 0; p < coords.length; p++) {
                        var ring = coords[p][0];
                        var area = 0;
                        for (var i = 0; i < ring.length - 1; i++) {
                            area += ring[i][0] * ring[i + 1][1] - ring[i + 1][0] * ring[i][1];
                        }
                        total += Math.abs(area);
                    }
                    return total;
                }
                return 0;
            }
            // Filter: prefer landuse layers (larger polygons), then larger buildings
            // Filter out tiny features (< 0.000001 deg^2 ≈ 100m²) which are likely individual houses
            var minArea = 1e-6;
            var scored = fs.map(function (f) {
                var a = geomArea(f.geometry);
                var pr = f.properties || {};
                var isLanduse = f.layer && f.layer.id && f.layer.id.startsWith('landuse');
                var hasName = pr.name || pr['name:latin'] || pr['name:en'];
                var height = Number(pr.height || pr.render_height) || 0;
                var lvl = Number(pr['building:levels']||pr.levels||0);
                // Score: honest — buildings win, landuse deprioritized (was 1000); named/height/levels still matter
                var score = (isLanduse ? -800 : 0) + (hasName ? 180 : 0) + (height * 0.7) + (lvl*12) + (a * 1e6 * 0.25);
                return { feature: f, area: a, score: score, isLanduse: isLanduse };
            });
            // Filter out tiny features unless they're landuse or named
            scored = scored.filter(function (s) { return s.area >= minArea || s.isLanduse || s.feature.properties && (s.feature.properties.name || s.feature.properties['name:latin'] || s.feature.properties['name:en']); });
            if (!scored.length) return null;
            scored.sort(function (a, b) { return b.score - a.score; });
            var f = scored[0].feature, pr = f.properties || {};
            var c = geomCentroid(f.geometry);
            return {
                name: String(pr.name || pr['name:latin'] || pr['name:en'] || '').trim(),
                height: Number(pr.height || pr.render_height) || null,
                lat: c ? c.lat : null, lng: c ? c.lng : null,
                footprint: f.geometry || null
            };
        } catch (e) { return null; }
    }
    function geomFinite(c) {
        function walk(x) {
            if (Array.isArray(x)) {
                for (var i = 0; i < x.length; i++) if (!walk(x[i])) return false;
                return true;
            }
            return typeof x !== 'number' || isFinite(x);
        }
        try { return walk(c); } catch (e) { return false; }
    }
    function fpGeom(fp) {
        if (!fp || !fp.length) return null;
        try {
            if (!geomFinite(fp)) return null;
            return Array.isArray(fp[0][0][0])
                ? { type: 'MultiPolygon', coordinates: fp }
                : { type: 'Polygon', coordinates: fp };
        } catch (e) { return null; }
    }
