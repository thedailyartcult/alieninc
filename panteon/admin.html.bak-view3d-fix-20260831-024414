                    lat: b && b.lat != null ? b.lat : e.lngLat.lat,
                    lng: b && b.lng != null ? b.lng : e.lngLat.lng,
                    name: b ? b.name : '',
                    height: b ? b.height : null,
                    footprint: b ? b.footprint : null
                };
                setGhost(null);
                exitObjMode();
                selectTab('objects');
                renderObjects();
                var ob = document.querySelector('.maven-body');
                if (ob) ob.scrollTop = 0;
                return;
            }
            // SCOUT: armed placement/retarget — walks with physics, never teleports
            if (S.scoutMode) {
                var sbld = pickBuildingAt(m, e.point);
                var slat = (sbld && sbld.lat != null) ? sbld.lat : e.lngLat.lat;
                var slng = (sbld && sbld.lng != null) ? sbld.lng : e.lngLat.lng;
                S.scoutMode = false;
                var sbtn2 = $('mavenScoutBtn');
                if (sbtn2) { sbtn2.textContent = S.scout ? 'SCOUT: MOVING' : '◉ SCOUT: IDLE'; sbtn2.classList.remove('active'); }
                var wrapSc = document.querySelector('.sc-map-canvas-wrap');
                if (wrapSc) wrapSc.classList.remove('maven-crosshair');
                hideHint();
                deployScoutAt(slat, slng, sbld ? sbld.name : '', sbld ? sbld.height : null);
                return;
            }
            if (!S.aoiMode) {
                var pf = null;
                try { pf = m.queryRenderedFeatures(e.point, { layers: ['maven-places-dot'] }); } catch (err) {}
                if (pf && pf.length && S.places) {
                    var pr = pf[0].properties || {};
                    var pool;
                    if (pr.grp === 'landmark') pool = S.places.landmarks || [];
                    else if (pr.grp === 'bgc') pool = S.places.companies || [];
                    else pool = S.places.nodes || [];
                    var hit = pool.filter(function (p2) { return p2.name === pr.name; })[0];
                    if (hit) {
                        S.placeInfo = hit;
                        selectTab('places');
                        renderPlaces();
                        // landmark dot click flies directly to the landmark in 3D
                        if (pr.grp === 'landmark') flyToLandmark(Number(hit.lat), Number(hit.lng));
                        return;
                    }
                }
                return;
            }
            // PICK TARGET — hover-check LZ/DZ only, no radius, no task
            var bld = pickBuildingAt(m, e.point);
            if (!bld || !bld.footprint) {
                // ground click — not a building, no LZ
                setGhost(null);
                try{ if(window.LZDZ && typeof window.LZDZ.showGroundNoLZ==='function') window.LZDZ.showGroundNoLZ(e.lngLat.lat, e.lngLat.lng); }catch(err2){}
                // keep mode armed for next hover
                return;
            }
            // delegate to LZ point-check (BGC helipad + civilian + slope + 20m disc)
            if (window.LZDZ && typeof window.LZDZ.checkPointLZ==='function') {
                var res = window.LZDZ.checkPointLZ(bld.lat, bld.lng, bld);
                window.LZDZ.showLZResult(bld.lat, bld.lng, bld, res);
                // do not lock pending — stay armed for next hover/click inspection
                // ghost color updated via showLZResult (green/red disc)
            } else {
                // fallback: just highlight building
                setGhost(bld.footprint, bld.height);
            }
            // keep aoiMode armed — user hovers next building, ESC to exit
        });
        var lastMM = 0;
        m.on('mousemove', function (ev) {
            if (!S.open) return;
            var now = Date.now();
            if (now - lastMM < 70) return;
            lastMM = now;
            if (S.objMode) {
                // enforce single highlight in Register Object mode — clear persisted hover so only the ghost shows
                if(S._hovId!=null){ try{ m.setFeatureState({source:'maven-objs', id:S._hovId},{hover:false}); }catch(e){} S._hovId=null; }
                var hb = pickBuildingAt(m, ev.point);
                setGhost(hb ? hb.footprint : null, hb ? hb.height : null);
                return;
            }
            if (S.aoiMode) {
                var hb2 = pickBuildingAt(m, ev.point);
