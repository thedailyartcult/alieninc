        });
        if (r.error) throw new Error(r.error);
        SIMS.outcomes[r.battlefield] = r;
        const o = r.ontology || {};
        statusEl.textContent = o.emitted
            ? `Assessment emitted: +${o.objects_created} objects, +${o.links_created} links — see the War Ontology layer on the map.`
            : `Simulation done but ontology writeback failed: ${o.error || 'unknown'}`;
        renderBattleResults(r);
        loadOntologyGraph();
        loadSimsResearch();
    } catch (e) {
        statusEl.textContent = 'Flashpoint failed: ' + e.message;
    }
}

function simsMatchThreats() {
    const statusEl = document.getElementById('simsMatchStatus'), listEl = document.getElementById('simsThreatList');
    if (!SIMS.battlefields.length) { statusEl.textContent = 'Theaters not loaded yet.'; return; }
    const events = Array.isArray(window.fusionThreatEvents) ? window.fusionThreatEvents : [];
    if (!events.length) { statusEl.textContent = 'No GDELT events on the fusion map — run the pipeline in Spinal Cracker first.'; listEl.innerHTML = ''; return; }
    const matches = [];
    events.forEach(ev => {
        const geo = parseActionGeoSafe(ev);
        if (!geo) return;
        const near = simsNearestTheater(geo.latitude, geo.longitude);
        const tone = (typeof threatLevelForEvent === 'function') ? threatLevelForEvent(ev) : 'green';
        if (near && tone !== 'green') matches.push({ ev, geo, near, tone });
    });
    SIMS.matches = matches;
    matches.sort((a, b) => (a.near.km - b.near.km));
    const top = matches.slice(0, 12);
    statusEl.textContent = `${matches.length} negative-tone events geo-matched to theaters (showing ${top.length}).`;
    listEl.innerHTML = top.length ? top.map((m, i) =>
        `<div class="sims-flash-row">
            <span class="sims-chip" data-tone="${m.tone === 'red' ? 'bad' : 'warn'}">${m.tone.toUpperCase()}</span>
            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${simsEsc(m.ev.title || '')}">${simsEsc((m.ev.title || m.ev.event_type || 'event').slice(0, 80))}</span>
            <span style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">${simsEsc(m.geo.country || '')} → ${simsEsc(m.near.bf.name)} @ ${Math.round(m.near.km).toLocaleString()} km</span>
            <button class="btn btn-primary btn-sm" style="font-size:9px;padding:2px 8px"
                onclick="simsRunFlashpoint(SIMS.matches[${i}])">SIM IT</button>
         </div>`).join('') : '<div class="empty-state">No negative-tone events within range of a theater.</div>';
}
