    async function pollVessels() {
        var now = Date.now();
        if (now - _vesselLastPoll < VESSEL_POLL_MS) return;
        _vesselLastPoll = now;
        try {
            var url = '/api/v1/vessels';
            if (vesselFilter !== 'all') url += '?category=' + encodeURIComponent(vesselFilter);
            var resp = await fetch(url);
            if (!resp.ok) return;
            var data = await resp.json();
            var vessels = data.vessels || [];
            // Update index for tick interpolation
            vessels.forEach(function (v) {
                var entry = fusionVesselsIndex[v.mmsi];
                if (!entry) {
                    entry = { lngLat: [v.lng, v.lat], target: [v.lng, v.lat], speed: v.sog, heading: v.heading, f: v, mk: null };
                    fusionVesselsIndex[v.mmsi] = entry;
                } else {
                    entry.target = [v.lng, v.lat];
                    entry.speed = v.sog;
                    entry.heading = v.heading;
                    entry.f = v;
                }
            });
            vesselPts = vessels;
            renderVesselMarkers();
            // Update source status in GAIA panel
            if (window.GAIA && data.meta) {
                window.GAIA.setLayerSource('vessels', {
                    type: data.meta.mode === 'mock' ? 'mock' : 'ais',
                    status: data.meta.connected ? 'live' : (data.meta.mode === 'mock' ? 'mock' : 'disconnected'),
                    count: data.total_tracked || 0,
                    freshness: data.meta.uptime_s ? Math.round(data.meta.uptime_s) + 's' : null,
                });
            }
        } catch (e) {
            console.warn('[vessels] poll error:', e);
        }
    }

    function vesselTick() {
        var m = ensureFusionMap();
        if (!m || !state.vessels || !state.vessels.on) return;
        var nowMs = Date.now();
        var dt = Math.min(2, Math.max(0.01, (nowMs - _vesselLastTickMs) / 1000));
        _vesselLastTickMs = nowMs;
        for (var mmsi in fusionVesselsIndex) {
            var e = fusionVesselsIndex[mmsi];
            if (!e.lngLat || !isFinite(e.heading)) continue;
            if (smoothEntityTick(e, dt)) {
                try { e.mk && e.mk.setLngLat(e.lngLat); } catch (err) {}
            }
        }
    }

