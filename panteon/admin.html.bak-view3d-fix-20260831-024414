<script>
// ============================== SIMS WAR ROOM ==============================
const SIMS = {
    battlefields: [], doctrines: ['attrition', 'maneuver', 'shock', 'defensive', 'guerrilla', 'logistical', 'information'],
    outcomes: {},        // battlefield name -> last battle report (drives map popups)
    learning: null,      // last strategy-table payload (drives confidence overlay)
    ont: null,           // war ontology graph {nodes, edges, counts}
    real: null,          // ingested world_country summaries
    matches: [],         // last flashpoint matches (event -> theater)
    loaded: false,
};
let fusionSimWarMarkers = [], fusionSimLearnMarkers = [], fusionSimOntMarkers = [], fusionSimRealMarkers = [];

const ONT_TYPE_LABEL = {
    kriegspiel_theater: 'THEATER',
    kriegspiel_force: 'FORCE',
    kriegspiel_assessment: 'ASSESSMENT',
    world_country: 'COUNTRY (REAL)',
    arsenal_system: 'ARSENAL (REAL)',
};

function simsEsc(s) {
    s = s == null ? '' : String(s);
    return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function simsPct(part, total) { return total > 0 ? Math.round(100 * part / total) : 0; }

async function simsApi(path, opts = {}) {
    return api('sims/' + path, opts);
}

// ============================================================================
// Chronos — historical what-if engine
// ============================================================================
const CHRONOS = { loaded: false, battles: [], lastReplay: null };

function switchSimsTab(tab) {
    document.querySelectorAll('#page-sims-war .gdelt-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('#page-sims-war .gdelt-tab-content').forEach(c => c.classList.remove('active'));
    document.querySelector(`#page-sims-war .gdelt-tab[data-tab="${tab}"]`).classList.add('active');
    document.getElementById(tab === 'chronos' ? 'simsTabChronos' : 'simsTabFuture').classList.add('active');
    if (tab === 'chronos' && !CHRONOS.loaded) initChronos();
}

async function initChronos() {
    CHRONOS.loaded = true;
    loadChronosPowers();
    try {
        const rows = await simsApi('chronos/battles?war=WORLD%20WAR%20II&limit=200');
        CHRONOS.battles = Array.isArray(rows) ? rows : [];
        const sel = document.getElementById('chronosBattleSelect');
        sel.innerHTML = CHRONOS.battles.map(b =>
            `<option value="cdb90-${b.isqno}">${b.isqno} · ${b.name}${b.start_date ? ' (' + String(b.start_date).slice(0, 10) + ')' : ''}</option>`
        ).join('') || '<option value="">No battles found</option>';
    } catch (e) {
        document.getElementById('chronosBattleSelect').innerHTML = `<option value="">Load failed: ${e.message}</option>`;
    }
}

async function loadChronosPowers() {
    const year = parseInt(document.getElementById('chronosYear').value, 10) || 1939;
    document.getElementById('chronosYearSlider').value = year;
    const body = document.getElementById('chronosPowersBody');
    body.innerHTML = '<div class="empty-state"><span class="loading"></span></div>';
    try {
        const r = await simsApi('chronos/powers/' + year);
        if (r.error) throw new Error(r.error);
        const maxCinc = Math.max(...r.top.map(t => t.cinc || 0), 0.001);
        const stateName = { USA: 'United States', GMY: 'Germany', RUS: 'Russia/USSR', UKG: 'United Kingdom', CHN: 'China', FRN: 'France', ITA: 'Italy', JPN: 'Japan' };
        body.innerHTML = r.top.map(t => `
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <div style="width:120px;font-size:11px;font-family:var(--font-mono);color:var(--text-muted)">${stateName[t.stateabb] || t.stateabb}</div>
                <div style="flex:1;height:14px;background:rgba(255,255,255,0.05);border-radius:3px;overflow:hidden">
                    <div style="height:100%;width:${Math.round(100 * (t.cinc || 0) / maxCinc)}%;background:linear-gradient(90deg,var(--accent-cyan),var(--green))"></div>
                </div>
                <div style="width:150px;font-size:10px;font-family:var(--font-mono);color:var(--text)">
                    CINC ${(t.cinc * 100).toFixed(1)}% · ${Math.round((t.milper || 0) * 1000).toLocaleString()} troops
                </div>
            </div>`).join('') +
            `<div style="font-size:9px;color:var(--text-muted);font-family:var(--font-mono);margin-top:6px">Source: ${r.source} · milper in thousands (troops shown absolute)</div>`;
    } catch (e) {
        body.innerHTML = `<div class="empty-state">Power data unavailable: ${e.message}</div>`;
    }
}

async function runChronosReplay() {
    const btn = document.getElementById('chronosReplayBtn'), status = document.getElementById('chronosReplayStatus');
    const battleKey = document.getElementById('chronosBattleSelect').value;
    const universes = parseInt(document.getElementById('chronosUniverses').value, 10) || 400;
    if (!battleKey) { status.textContent = 'Pick a battle first.'; return; }
    btn.disabled = true; status.textContent = `Replaying ${battleKey} across ${universes} branches...`;
    try {
        const r = await simsApi('chronos/replay', {
            method: 'POST', timeout: 180000,
            body: JSON.stringify({ battle_key: battleKey, universes }),
        });
        if (r.error) throw new Error(r.error);
        CHRONOS.lastReplay = r;
        renderChronosReplay(r);
        status.textContent = r.passed
            ? `FIDELITY GATE PASSED — engine reproduces the recorded outcome (${Math.round(r.checks.winner_fidelity * 100)}% of branches). Counterfactuals unlocked.`
            : `FIDELITY GATE FAILED — predicted ${r.predicted_winner}, history says ${r.actual_winner}. What-if remains locked for this battle.`;
    } catch (e) {
        status.textContent = 'Replay failed: ' + e.message;
    } finally { btn.disabled = false; }
}

function renderChronosReplay(r) {
    const b = r.battle || {};
    const att = b.attacker || {}, dfd = b.defender || {};
    const wd = r.win_distribution || {};
    const bar = (label, pct, color) => `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
            <div style="width:70px;font-size:10px;font-family:var(--font-mono);color:var(--text-muted)">${label}</div>
            <div style="flex:1;height:12px;background:rgba(255,255,255,0.05);border-radius:3px;overflow:hidden">
                <div style="height:100%;width:${Math.round(pct)}%;background:${color}"></div>
            </div>
            <div style="width:44px;font-size:10px;font-family:var(--font-mono)">${Math.round(pct)}%</div>
        </div>`;
    const kvRow = (k, v) => `<div class="sims-kv" style="display:flex;justify-content:space-between;font-size:10px;font-family:var(--font-mono);padding:2px 0"><span style="color:var(--text-muted)">${k}</span><b>${v}</b></div>`;
    document.getElementById('chronosReplayResults').innerHTML = `
        <div style="margin-bottom:8px">
            <div style="font-family:var(--font-tech);font-size:13px;margin-bottom:2px">${b.name || '--'} <span style="color:var(--text-muted)">· ${b.year || '?'} · era: ${b.era || '?'}</span></div>
            <div style="font-size:10px;color:var(--text-muted)">${att.actors || []} (${Math.round(att.strength || 0).toLocaleString()} men, ${att.tanks || 0} tanks, ${att.aircraft || 0} aircraft)
                vs ${dfd.actors || []} (${Math.round(dfd.strength || 0).toLocaleString()} men)</div>
        </div>
        ${bar('ATTACKER', (wd.attacker || 0) * 100, 'var(--red)')}
        ${bar('DEFENDER', (wd.defender || 0) * 100, 'var(--accent-cyan)')}
        ${bar('STALEMATE', (wd.stalemate || 0) * 100, 'var(--amber)')}
        <div style="display:flex;gap:16px;margin-top:8px">
            <div style="flex:1">${kvRow('History says', r.actual_winner)}${kvRow('Engine predicts', r.predicted_winner)}</div>
            <div style="flex:1">${kvRow('Attacker cas. sim/actual', `${((r.simulated_attacker_casualty_fraction || 0) * 100).toFixed(1)}% / ${((r.actual_attacker_casualty_fraction || 0) * 100).toFixed(1)}%`)}${kvRow('Defender cas. sim/actual', `${((r.simulated_defender_casualty_fraction || 0) * 100).toFixed(1)}% / ${((r.actual_defender_casualty_fraction || 0) * 100).toFixed(1)}%`)}</div>
        </div>
        <div style="margin-top:6px;font-size:10px;font-family:var(--font-mono);color:${r.passed ? 'var(--green)' : 'var(--red)'}">
            FIDELITY SCORE ${(r.fidelity_score * 100).toFixed(0)}% · ${r.passed ? 'GATE OPEN' : 'GATE LOCKED'}
        </div>
        ${renderChronosOob(r.oob)}`;
}

function renderChronosOob(oob) {
    if (!oob || !oob.length) return '';
    const eqStr = e => {
        const parts = [];
        for (const [k, v] of Object.entries(e.equipment || {})) {
            if (typeof v === 'number') parts.push(`${v.toLocaleString()} ${k.replace(/_/g, ' ')}`);
        }
        return parts.join(', ');
    };
    const side = (name, rows, color) => {
        if (!rows.length) return '';
        return `<div style="flex:1;min-width:220px">
            <div style="font-size:10px;font-family:var(--font-mono);color:${color};margin-bottom:4px;text-transform:uppercase">${name}</div>
            ${rows.map(e => `
                <div style="padding:5px 8px;margin-bottom:4px;background:rgba(255,255,255,0.03);border-left:2px solid ${color};border-radius:0 3px 3px 0">
                    <div style="font-size:11px;font-family:var(--font-tech)">${e.unit_name}${e.engagement_fraction && e.engagement_fraction < 1 ? ` <span style="color:var(--text-muted);font-size:9px">(engaged ${Math.round(e.engagement_fraction * 100)}%)</span>` : ''}</div>
                    <div style="font-size:9px;font-family:var(--font-mono);color:var(--text-muted)">
                        ${e.echelon || ''} · ${Math.round(e.strength || 0).toLocaleString()} men${eqStr(e) ? ' · ' + eqStr(e) : ''} · ${e.confidence}
                    </div>
                </div>`).join('')}
        </div>`;
    };
    return `<div style="margin-top:10px;padding-top:8px;border-top:1px solid var(--border-color)">
        <div style="font-size:10px;color:var(--text-muted);font-family:var(--font-mono);margin-bottom:6px">ORDER OF BATTLE — curated from the historical record</div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
            ${side('Attacking', oob.filter(e => e.side === 'attacker'), 'var(--red)')}
            ${side('Defending', oob.filter(e => e.side === 'defender'), 'var(--accent-cyan)')}
        </div>
        <div style="font-size:9px;color:var(--text-muted);font-family:var(--font-mono);margin-top:4px">Source: ${oob[0].source || 'curated references'}</div>
    </div>`;
}

async function runChronosWhatIf() {
    const btn = document.getElementById('chronosWhatIfBtn'), status = document.getElementById('chronosWhatIfStatus');
    if (!CHRONOS.lastReplay || !CHRONOS.lastReplay.passed) {
        status.textContent = 'Locked — run a passing replay first.'; return;
    }
    const battleKey = document.getElementById('chronosBattleSelect').value;
    const variable = document.getElementById('chronosVarSelect').value;
    let value = parseFloat(document.getElementById('chronosVarValue').value) || 1.5;
    if (variable.endsWith('_mult')) value = Math.abs(value);
    else value = Math.abs(value);
    const universes = parseInt(document.getElementById('chronosUniverses').value, 10) || 400;
    btn.disabled = true; status.textContent = 'Branching counterfactual timelines...';
    try {
        const r = await simsApi('chronos/what-if', {
            method: 'POST', timeout: 180000,
            body: JSON.stringify({ battle_key: battleKey, override: { [variable]: value }, universes }),
        });
        if (r.error) throw new Error(r.error);
        renderChronosWhatIf(r);
        status.textContent = `Counterfactual complete — winner shift: ${r.delta.winner_shift}.`;
    } catch (e) {
        status.textContent = 'What-if failed: ' + e.message;
    } finally { btn.disabled = false; }
}

function renderChronosWhatIf(r) {
    const base = r.baseline || {}, cf = r.counterfactual || {}, d = r.delta || {};
    const row = (tag, s) => `
        <div style="margin-bottom:8px">
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-muted);margin-bottom:3px">${tag}</div>
            <div style="display:flex;gap:12px;font-size:11px;font-family:var(--font-mono)">
                <span>Winner: <b>${s.predicted_winner}</b></span>
                <span>Attacker wins ${Math.round((s.win_distribution || {}).attacker * 100 || 0)}%</span>
                <span>Avg attacker casualties: ${Math.round(s.avg_attacker_casualties || 0).toLocaleString()}</span>
            </div>
        </div>`;
    const chg = d.win_prob_change || {};
    document.getElementById('chronosWhatIfResults').innerHTML = `
        ${row('HISTORY AS IT HAPPENED', base)}
        ${row('COUNTERFACTUAL — ' + Object.keys((cf.overrides || {}))[0] + ' = ' + Object.values(cf.overrides || {})[0], cf)}
        <div style="border-top:1px solid var(--border-color);padding-top:6px;font-size:11px;font-family:var(--font-mono)">
            Δ winner: <b>${d.winner_shift || '--'}</b>
            · Δ attacker win prob: ${chg.attacker > 0 ? '+' : ''}${Math.round((chg.attacker || 0) * 100)}pts
            · Δ attacker casualties: ${d.attacker_casualty_change_pct > 0 ? '+' : ''}${d.attacker_casualty_change_pct}%
        </div>`;
}

function initSimsWarRoom() {
    if (!SIMS.loaded) {
        loadSimsBattlefields();
        loadSimsResearch();
        loadSimsReal();
        loadOntologyGraph();
        SIMS.loaded = true;
    } else {
        loadSimsResearch();
        loadSimsReal();
        loadOntologyGraph();
    }
    simsGatewayHealth();
    registerSimsGaiaLayers();
}

async function simsProbe(path) {
    const out = { url: API_BASE.replace(/\/+$/, '') + '/' + String(path).replace(/^\/+/, ''), host: location.host };
    try {
        const headers = { 'Content-Type': 'application/json' };
        if (!authToken) {
            const { data } = await supabaseClient.auth.getSession();
            if (data.session) authToken = data.session.access_token;
        }
        if (authToken) headers['Authorization'] = 'Bearer ' +
            authToken.slice(0, 10) + '...(' + authToken.length + ' chars)';
        else out.token = 'NONE';
        const res = await fetch(out.url, { headers, cache: 'no-store' });
        out.status = res.status;
        out.headers = {};
        res.headers.forEach((v, k) => {
            if (/^(cf-|server|content-type|cache-control|age$)/i.test(k)) out.headers[k] = v;
        });
        out.body = (await res.text()).slice(0, 250);
    } catch (e) { out.fetchError = String(e); }
    return out;
}

async function simsGatewayHealth() {
    const tag = document.getElementById('simsGatewayTag');
    try {
        const h = await simsApi('health');
        if (h && h.status) { tag.textContent = 'GATEWAY: ONLINE'; tag.className = 'tag tag-green'; }
        else { tag.textContent = 'GATEWAY: DEGRADED'; tag.className = 'tag tag-blue'; }
    } catch (e) {
        tag.textContent = 'GATEWAY: OFFLINE'; tag.className = 'tag';
        tag.title = e.message + ' @ ' + location.host;
        const st = document.getElementById('simsRunStatus');
        if (st) st.textContent = 'Sims gateway unreachable: ' + e.message + ' — running probe…';
        simsProbe('sims/health').then(probe => {
            let box = document.getElementById('simsDiagBox');
            if (!box && st && st.parentElement) {
                box = document.createElement('pre');
                box.id = 'simsDiagBox';
                box.style.cssText = 'font-family:var(--font-mono);font-size:9px;color:var(--accent-cyan);background:rgba(0,0,0,.4);border:1px solid var(--border-color);border-radius:4px;padding:6px;margin-top:6px;white-space:pre-wrap;word-break:break-all';
                st.parentElement.appendChild(box);
            }
            if (box) box.textContent = '[edge probe] ' + JSON.stringify(probe, null, 1);
        });
    }
}

async function loadSimsBattlefields() {
    try {
        const bfs = await simsApi('kriegspiel/battlefields');
        if (!Array.isArray(bfs)) throw new Error('bad payload');
        SIMS.battlefields = bfs.filter(b => b.source === 'canonical' || true);
        const opts = bfs.map(b =>
            `<option value="${simsEsc(b.name)}">${simsEsc(b.name)} · ${simsEsc(b.terrain)}</option>`).join('');
        for (const id of ['simsBfSelect', 'simsCampBf']) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = `<option value="random">Random theater</option>` + opts;
        }
        const docs = SIMS.doctrines.map(d => `<option value="${d}">${d}</option>`).join('');
        for (const [id, def] of [['simsCampRedDoc', 'maneuver'], ['simsCampBlueDoc', 'defensive']]) {
            const el = document.getElementById(id);
            if (el) { el.innerHTML = docs; el.value = def; }
        }
    } catch (e) {
        const st = document.getElementById('simsRunStatus');
        if (st) st.textContent = 'Failed to load theaters: ' + e.message;
    }
}

