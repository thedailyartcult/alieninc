[Unit]
Description=CMB MCP server over Streamable HTTP (localhost:8765)
After=network.target cmb-engine.service
Wants=cmb-engine.service

[Service]
Type=simple
User=cmb
Group=cmb
# Guard: the DB must be owned by the service user. A laptop sync that restored an
# alien owner (e.g. chatwoot) silently makes the whole DB read-only for cmb and
# every write fails with OperationalError. Fix owner before start, every start.
ExecStartPre=/bin/chown cmb:cmb /srv/cmb/data/cmb.db
ExecStart=/srv/cmb/venv/bin/cmb-mcp-http
EnvironmentFile=/srv/cmb/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
