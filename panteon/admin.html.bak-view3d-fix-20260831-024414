        var exitRow = wsMenu.querySelector('[data-act="exit"]');
        exitRow.addEventListener('click', function () { applyWorkspace('Classic'); wsMenu.classList.remove('open'); });
        var inp = $('deckWsNewName'), add = $('deckWsAdd');
        add.addEventListener('click', function () {
            var v = (inp.value || '').trim();
            if (!v) return;
            saveCurrentAs(v);
            wsMenu.classList.remove('open');
        });
        inp.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { add.click(); }
            if (e.key === 'Escape') wsMenu.classList.remove('open');
            e.stopPropagation();
        });
    }

    // ------------------------------------------------------------ rail / rail pins
    var railHidden = {};
    function initRail() {
        var st = read(LS_RAIL) || {};
        var sidebar = document.querySelector('.sidebar');
        if (st.mode === 'rail') sidebar.classList.add('rail-mode');
        (st.hidden || []).forEach(function (id) { railHidden[id] = true; });
        applyRailPins();
        document.querySelectorAll('.nav-item').forEach(function (item) {
            var id = item.dataset.page || (item.id === 'gaiaNavItem' ? 'gaia' : item.id === 'wonNavItem' ? 'won' : null);
            if (!id) return;
            var lbl = labelOf(item) || (TOOLS[id] && TOOLS[id].title) || id;
            item.title = lbl + ' \u00b7 click: open tab \u00b7 Shift+click: full page \u00b7 right-click: pin/unpin';
            item.addEventListener('contextmenu', function (e) {
                e.preventDefault();
                railHidden[id] = !railHidden[id];
                applyRailPins(); saveRail(); toastRail(id);
            });
        });
        var foot = document.querySelector('.sidebar-footer');
        if (foot && !$('deckRailHint')) {
            var hint = document.createElement('div');
            hint.className = 'rail-only';
            hint.id = 'deckRailHint';
            hint.style.cssText = 'margin-top:6px;line-height:1.5;';
            hint.textContent = 'DECK: click opens tab \u00b7 Shift+click full page \u00b7 right-click pin/unpin \u00b7 Ctrl+K search';
            foot.appendChild(hint);
        }
        if (foot && !$('deckRailChip')) {
            var chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'deck-rail-chip rail-only';
            chip.id = 'deckRailChip';
            chip.addEventListener('click', function () { togglePalette(); });
            foot.appendChild(chip);
        }
        updateRailChip();
    }
    function applyRailPins() {
        document.querySelectorAll('.nav-item').forEach(function (item) {
            var id = item.dataset.page || (item.id === 'gaiaNavItem' ? 'gaia' : item.id === 'wonNavItem' ? 'won' : null);
            item.classList.toggle('rail-hidden', !!railHidden[id]);
        });
        updateRailChip();
    }
    function updateRailChip() {
        var chip = $('deckRailChip');
        if (!chip) return;
        var n = Object.keys(railHidden).filter(function (k) { return railHidden[k]; }).length;
        chip.style.display = n ? 'flex' : 'none';
        chip.textContent = '\u22ef ' + n + ' hidden';
        chip.title = n + ' unpinned tool' + (n === 1 ? '' : 's') + ' \u2014 click to browse (opening from the palette re-pins it)';
    }
    function saveRail() {
        var sidebar = document.querySelector('.sidebar');
        store(LS_RAIL, { mode: sidebar.classList.contains('rail-mode') ? 'rail' : 'full', hidden: Object.keys(railHidden).filter(function (k) { return railHidden[k]; }) });
    }
    function toastRail(id) {
        if (typeof window.toast === 'function') {
            var t = TOOLS[id];
            toast((railHidden[id] ? 'Unpinned from rail: ' : 'Pinned to rail: ') + (t ? t.title : id));
        }
    }
    function toggleRail() {
        var sidebar = document.querySelector('.sidebar');
        sidebar.classList.toggle('rail-mode');
        saveRail();
        scheduleMapResize();
    }

    // ------------------------------------------------------------ Ctrl+K palette
    function palEntries(q) {
        q = (q || '').trim().toLowerCase();
        var groups = [], gi = {};
        function grp(name) {
            if (!gi[name]) { gi[name] = { head: name, items: [] }; groups.push(gi[name]); }
            return gi[name];
        }
        PLATFORM_ORDER.forEach(grp);
        grp('Controllers');
        var wsGrp = grp('Workspaces'), actGrp = grp('Actions');

        Object.keys(TOOLS).forEach(function (id) {
            var t = TOOLS[id];
            if (q && (t.title + ' ' + t.label + ' ' + t.platform).toLowerCase().indexOf(q) < 0) return;
            grp(t.platform).items.push({
                kind: (t.win ? 'WIN \u00b7 ' : '') + t.platform,
                label: t.title, icon: t.icon, sub: '',
                run: function () {
                    if (railHidden[id]) { railHidden[id] = false; applyRailPins(); saveRail(); }
                    open(id, { zone: 'S' });
                }
            });
        });
        Object.keys(wsAll()).forEach(function (n) {
            if (q && ('workspace ' + n).toLowerCase().indexOf(q) < 0) return;
            wsGrp.items.push({ kind: 'workspace', label: 'Workspace: ' + n, sub: '', icon: '', run: function () { applyWorkspace(n); } });
        });
        [
            { label: 'Save current layout', run: function () { var a = wsActiveName(); if (a === 'Classic') saveCurrentAs('Workspace ' + (Object.keys(wsAll()).length + 1)); else saveCurrentAs(a); } },
            { label: 'Exit to Classic view', run: function () { applyWorkspace('Classic'); } },
            { label: 'Toggle launcher rail', run: function () { toggleRail(); } },
            { label: 'Add or remove platforms\u2026', run: function () { if (window.PLATFORM_SELECT) PLATFORM_SELECT.open(false); else if (typeof togglePalette === 'function') togglePalette(); } }
        ].forEach(function (a) {
            if (q && ('action ' + a.label).toLowerCase().indexOf(q) < 0) return;
            actGrp.items.push({ kind: 'action', label: a.label, sub: '', icon: '', run: a.run });
        });

        var flat = [], count = 0;
        groups.forEach(function (g) {
            if (!g.items.length) return;
            flat.push({ head: g.head });
            g.items.forEach(function (it) { if (count < 30) { flat.push(it); count++; } });
        });
        return flat;
    }

    function buildPalette() {
        if ($('deckPalette')) return;
        var pal = document.createElement('div');
        pal.id = 'deckPalette';
        pal.innerHTML =
            '<div class="deck-pal-card">' +
                '<input class="deck-pal-input" id="deckPalInput" placeholder="Search tools, workspaces, commands\u2026" spellcheck="false" autocomplete="off">' +
                '<div class="deck-pal-list" id="deckPalList"></div>' +
            '</div>';
        document.body.appendChild(pal);
        var input = $('deckPalInput'), list = $('deckPalList'), sel = 0;

        function render() {
            var entries = palEntries(input.value);
            var items = entries.filter(function (en) { return !en.head; });
            sel = clamp(sel, 0, Math.max(0, items.length - 1));
            var ii = 0;
            list.innerHTML = items.length
                ? entries.map(function (en) {
                    if (en.head) return '<div class="deck-pal-head">' + esc(en.head) + '</div>';
                    var cls = 'deck-pal-item' + (ii === sel ? ' sel' : '');
                    var idx = ii++;
                    return '<div class="' + cls + '" data-i="' + idx + '">' + (en.icon || '<span class="deck-pal-spacer"></span>') + '<span>' + esc(en.label) + '</span><span class="deck-pal-kind">' + esc(en.kind) + '</span></div>';
                }).join('')
                : '<div class="deck-pal-empty">No matches.</div>';
            list._items = items;
            list._entries = entries;
        }
        function runSel() {
            var items = list._items || [];
            var en = items[sel];
            if (!en) return;
            pal.classList.remove('open');
            input.value = '';
            en.run();
        }
        pal.addEventListener('mousedown', function (e) { if (e.target === pal) pal.classList.remove('open'); });
        list.addEventListener('click', function (e) {
            var it = e.target.closest('.deck-pal-item');
            if (!it) return;
            sel = parseInt(it.dataset.i, 10) || 0;
            runSel();
        });
        input.addEventListener('input', function () { sel = 0; render(); });
        input.addEventListener('keydown', function (e) {
            var items = list._items || [];
            if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(items.length - 1, sel + 1); render(); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); render(); }
            else if (e.key === 'Enter') { e.preventDefault(); runSel(); }
            else if (e.key === 'Escape') { pal.classList.remove('open'); }
        });
        pal._render = render;
    }
    function togglePalette() {
        if (isMobile()) return;
        var pal = $('deckPalette');
        if (!pal) buildPalette();
        pal = $('deckPalette');
        pal.classList.toggle('open');
        if (pal.classList.contains('open')) { $('deckPalInput').value = ''; $('deckPalette')._render(); setTimeout(function () { $('deckPalInput').focus(); }, 0); }
    }

    // ------------------------------------------------------------ api / boot
    function isMobile() { return window.innerWidth <= 1024; }

    function openFromNav(item) {
        var id = item.dataset.page || (item.id === 'gaiaNavItem' ? 'gaia' : item.id === 'wonNavItem' ? 'won' : null);
        if (!id) { var pgFallback = item.dataset.page; if (pgFallback) navigate(pgFallback); return; }
        var t = findTool(id);
        if (!t) { if (item.dataset.page) navigate(item.dataset.page); return; }
        open(id, { zone: 'S' });
    }

    window.DECK = {
        open: function (id, opts) { return open(id, opts); },
        close: close,
        openFromNav: openFromNav,
        exitDeck: exitDeck,
        toggleRail: toggleRail,
        togglePalette: togglePalette,
        refreshTabs: function () { renderTopbarTabs._sig = null; renderTopbarTabs(); },
        noteClassicPage: function (id) {
            var t = findTool(id);
            if (t && t.platform) {
                PLAT.focus[t.platform] = id;
                if (PLAT.stack.indexOf(t.platform) < 0) PLAT.stack.push(t.platform);
            }
        },
        isMobile: isMobile,
        tools: function () { return Object.keys(TOOLS).map(function (k) { return { id: k, title: TOOLS[k].title, win: !!TOOLS[k].win }; }); },
        rebuildTools: function () {
            // Mission Select changed: close panels of disabled platforms, then re-derive registry
            Object.keys(TOOLS).forEach(function (id) {
                var t = TOOLS[id];
                if (!t) return;
                var el = t.el || (document.querySelector('.nav-item[data-page="' + id + '"]'));
                if (el && el.closest && el.closest('.nav-section.ps-off')) close(id);
            });
            Object.keys(TOOLS).forEach(function (k) { delete TOOLS[k]; });
            PLATFORM_ORDER.length = 0;
            buildTools();
        },
        layout: function () { return JSON.parse(JSON.stringify(S.zones)); }
    };

    document.addEventListener('keydown', function (e) {
        if ((e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
            var tag = (e.target && e.target.tagName) || '';
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
            e.preventDefault();
            togglePalette();
        }
    });

    window.addEventListener('resize', function () {
        if (isMobile() && root && rootVisible()) {
            // collapse to classic on mobile — capture first so panels rehydrate intact
            captureCurrentToActive();
            Object.keys(TOOLS).forEach(function (id) { if (panelByTool(id)) close(id); });
            showRoot(false);
        }
    });

    function boot() {
        buildTools();
        ensureDom();
        buildWsUI();
        initRail();
        buildPalette();
        initTopbar();
        var saved = read(LS_LAYOUT);
        if (saved && saved.v === 1 && saved.zones &&
            (saved.zones.L || []).concat(saved.zones.R || []).concat(saved.zones.B || []).concat(saved.zones.S || []).length) {
            if (Array.isArray(saved.tabOrder)) S.tabOrder = saved.tabOrder.filter(function (id) { return findTool(id); });
            applyLayout(saved);
        }
        if (saved && saved.plat) {
            PLAT.stash = saved.plat.stash || {};
            PLAT.focus = saved.plat.focus || {};
            PLAT.stack = Array.isArray(saved.plat.stack) ? saved.plat.stack.filter(function (p) {
                return typeof p === 'string';
            }) : [];
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>

<script id="tb-addon">
// ============================================================================
// TACTICAL BASEMAP ADD-ON v2.1 — Maven-style basemap for the Spinal Cracker
// fusion map ONLY. Pure add-on, zero core edits. Control lives in the GAIA
// panel Layers list (row "Tactical Terrain" via GAIA.registerLayer — no map
// buttons). Zero network: the pristine dark style is captured from the map
// itself and repainted in place (Maven palette: purple-indigo land #302f52 /
// pale water #c9cdcc / vivid purple borders, sampled from maven-terrain.png,
// + terrarium-DEM hillshade). Style swaps force diff:false — MapLibre's diff
// path never fires style.load, which silently dropped every runtime layer
// (gaia-sat satellite imagery, sc-*/sims-* markers, 3d-buildings). Runtime
// layers survive swaps WITH their exact visibility, so a hidden GAIA
// satellite overlay can never resurrect as visible.
// ============================================================================
(function () {
    'use strict';
    if (typeof maplibregl === 'undefined' || !maplibregl.Map) return;

    var LS_KEY = 'sc_basemap_v1';
    // Palette sampled from Palantir Maven reference (maven-terrain.png):
    // purple-indigo landmass #302f52, neutral pale water #c9cdcc, vivid purple
    // borders, light glyphs on land / mid-gray glyphs on water.
    var HALO_LAND = '#232244';
    var HALO_WATER = '#e2e4e2';
    var PAINT = {
        'background': { 'background-color': '#302f52' },
        'water': { 'fill-color': '#c9cdcc' },
        'landcover_ice_shelf': { 'fill-color': '#cfd3d4' },
        'landcover_glacier': { 'fill-color': '#cfd3d4' },
        'landuse_residential': { 'fill-color': '#37365e' },
        'landcover_wood': { 'fill-color': '#2d2c50' },
        'landuse_park': { 'fill-color': '#2f2e55' },
        'waterway': { 'line-color': '#c9cdcc' },
        'building': { 'fill-color': '#3d3c68' },
        'aeroway-taxiway': { 'line-color': '#56557f' },
        'aeroway-runway-casing': { 'line-color': '#262548' },
        'aeroway-area': { 'fill-color': '#3d3c68' },
        'aeroway-runway': { 'line-color': '#8f8cc0' },
        'road_area_pier': { 'fill-color': '#3d3c68' },
        'road_pier': { 'line-color': '#56557f' },
        'highway_path': { 'line-color': '#56557f' },
        'highway_minor': { 'line-color': '#56557f' },
        'highway_major_casing': { 'line-color': '#262548' },
        'highway_major_subtle': { 'line-color': '#67669a' },
        'highway_major_inner': { 'line-color': '#9d94d6' },
        'highway_motorway_casing': { 'line-color': '#262548' },
        'highway_motorway_subtle': { 'line-color': '#7573ab' },
        'highway_motorway_inner': { 'line-color': '#b3aae8' },
        'railway_transit': { 'line-color': '#636292' },
        'railway_transit_dashline': { 'line-color': '#4a4978' },
        'railway_minor': { 'line-color': '#636292' },
        'railway_minor_dashline': { 'line-color': '#4a4978' },
        'railway': { 'line-color': '#636292' },
        'railway_dashline': { 'line-color': '#4a4978' },
        'boundary_state': { 'line-color': '#5f5396' },
        'boundary_country_z0-4': { 'line-color': '#6d2bd8' },
        'boundary_country_z5-': { 'line-color': '#6d2bd8' },
        'water_name': { 'text-color': '#8a8f96', 'text-halo-color': HALO_WATER },
        'highway_name_other': { 'text-color': '#a9abbe', 'text-halo-color': HALO_LAND },
        'highway_name_motorway': { 'text-color': '#a9abbe', 'text-halo-color': HALO_LAND },
        'place_other': { 'text-color': '#9fa1b5', 'text-halo-color': HALO_LAND },
        'place_suburb': { 'text-color': '#9fa1b5', 'text-halo-color': HALO_LAND },
        'place_village': { 'text-color': '#a4a6ba', 'text-halo-color': HALO_LAND },
        'place_town': { 'text-color': '#b4b6c8', 'text-halo-color': HALO_LAND },
        'place_city': { 'text-color': '#cfd0da', 'text-halo-color': HALO_LAND },
        'place_city_large': { 'text-color': '#d6d7e0', 'text-halo-color': HALO_LAND },
        'place_state': { 'text-color': '#8f91a8', 'text-halo-color': HALO_LAND },
        'place_country_other': { 'text-color': '#cfd0da', 'text-halo-color': HALO_LAND },
        'place_country_minor': { 'text-color': '#d2d3dc', 'text-halo-color': HALO_LAND },
        'place_country_major': { 'text-color': '#d6d7e0', 'text-halo-color': HALO_LAND }
    };

    var state = { choice: 'dark', fusion: null, pristine: null };

    function readChoice() {
        try { return localStorage.getItem(LS_KEY) === 'tactical' ? 'tactical' : 'dark'; }
        catch (e) { return 'dark'; }
    }
    function persistChoice(c) { try { localStorage.setItem(LS_KEY, c); } catch (e) {} }
    function clone(v) { return JSON.parse(JSON.stringify(v)); }
    function isRuntimeId(id) { return /^(sc-|sims-|gaia-)/.test(id) || id === '3d-buildings'; }
    function firstSymbolId(st) {
        for (var i = 0; i < st.layers.length; i++) if (st.layers[i].type === 'symbol') return st.layers[i].id;
        return null;
    }

    function repaint(dark) {
        // Only apply paint props the layer TYPE supports — an invalid prop
        // (e.g. line-color on a symbol layer) fails strict style validation
        // on full reload and the whole style is rejected (dark screen).
        var TYPE_OF = { 'background-color': 'background', 'fill-color': 'fill', 'line-color': 'line',
                        'text-color': 'symbol', 'text-halo-color': 'symbol' };
        var st = clone(dark);
        st.layers.forEach(function (l) {
            var o = PAINT[l.id];
            if (!o) return;
            if (!l.paint) l.paint = {};
            Object.keys(o).forEach(function (k) {
                if (TYPE_OF[k] !== l.type) return;
                l.paint[k] = o[k];
            });
        });
        var at = st.layers.length;
        for (var i = 0; i < st.layers.length; i++) { if (st.layers[i].id === 'landuse_park') { at = i + 1; break; } }
        st.sources['tb-dem'] = {
            type: 'raster-dem',
            tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png'],
            tileSize: 256, encoding: 'terrarium', maxzoom: 15
        };
        st.layers.splice(at, 0, {
            id: 'tb-hillshade', type: 'hillshade', source: 'tb-dem', minzoom: 5,
            paint: {
                'hillshade-exaggeration': 0.35,
                'hillshade-shadow-color': '#1f1e40',
                'hillshade-highlight-color': '#504f80',
                'hillshade-accent-color': '#26254a'
            }
        });
        return st;
    }

    function snapshot(m) {
        var keep = { sources: {}, layers: [] }, st = null;
        try { st = m.getStyle(); } catch (e) { return keep; }
        if (!st || !st.layers) return keep;
        Object.keys(st.sources || {}).forEach(function (id) {
            if (isRuntimeId(id)) keep.sources[id] = clone(st.sources[id]);
        });
        st.layers.forEach(function (l) {
            if (!isRuntimeId(l.id)) return;
            var c = clone(l), vis = null;
            try { vis = m.getLayoutProperty(l.id, 'visibility'); } catch (e) {}
            if (!c.layout) c.layout = {};
            c.layout.visibility = vis === 'none' ? 'none' : 'visible';
            keep.layers.push(c);
        });
        return keep;
    }

    function reapply(m, keep) {
        Object.keys(keep.sources).forEach(function (id) {
            if (m.getSource(id)) return;
            try { m.addSource(id, keep.sources[id]); } catch (e) {}
        });
        var symId = null;
        try { symId = firstSymbolId(m.getStyle()); } catch (e) {}
        keep.layers.forEach(function (l) {
            if (m.getLayer(l.id)) return;
            var vis = (l.layout && l.layout.visibility) || 'visible';
            try {
                m.addLayer(l, (l.type === 'raster' && symId) ? symId : undefined);
                m.setLayoutProperty(l.id, 'visibility', vis);
            } catch (e) {}
        });
    }

    function patchMap(inst) {
        if (inst.__tbPatched) return;
        inst.__tbPatched = true;
        var orig = inst.setStyle.bind(inst);
        inst.setStyle = function (spec, opts) {
            var keep = snapshot(inst);
            // MapLibre's setStyle diff path (default) NEVER fires 'style.load',
            // so reapply() below would never run and the diff would silently
            // drop every runtime layer (gaia-sat imagery, sc-*/sims-* markers,
            // 3d-buildings). Force a full reload so style.load always fires.
            var full = { diff: false };
            if (opts) for (var k in opts) full[k] = opts[k];
            var r = orig(spec, full);
            inst.once('style.load', function () {
                reapply(inst, keep);
                try { if (window.GAIA && typeof window.GAIA.applyScope === 'function') window.GAIA.applyScope(); } catch (e) {}
            });
            return r;
        };
        inst.once('style.load', function () {
            try { if (!state.pristine) state.pristine = clone(inst.getStyle()); } catch (e) { return; }
            if (state.choice === 'tactical') inst.setStyle(repaint(state.pristine));
        });
    }

    function getFusion() {
        try { if (typeof fusionMap !== 'undefined' && fusionMap) return fusionMap; } catch (e) {}
        return state.fusion;
    }

    function currentChoice() {
        try {
            if (window.GAIA && typeof window.GAIA.layers === 'function') {
                var rows = window.GAIA.layers();
                for (var i = 0; i < rows.length; i++) {
                    if (rows[i].id === 'tactical-terrain') return rows[i].on ? 'tactical' : 'dark';
                }
            }
        } catch (e) {}
        return readChoice();
    }

    function applyChoice(c, persist) {
        if (c !== 'tactical' && c !== 'dark') return;
        state.choice = c;
        if (persist) persistChoice(c);
        var m = getFusion();
        if (!m) return;
        if (c === 'dark') {
            if (state.pristine) m.setStyle(clone(state.pristine));
            return;
        }
        if (state.pristine) { m.setStyle(repaint(state.pristine)); return; }
        m.once('style.load', function () {
            try { if (!state.pristine) state.pristine = clone(m.getStyle()); } catch (e) { return; }
            if (state.choice === 'tactical') m.setStyle(repaint(state.pristine));
        });
    }

    var _Map = maplibregl.Map;
    function TBMap(opts) {
        opts = opts || {};
        var isFusion = opts.container === 'fusionMap';
        var inst = new _Map(opts);
        if (isFusion) {
            state.fusion = inst;
            state.choice = currentChoice();
            patchMap(inst);
        }
        return inst;
    }
    TBMap.prototype = _Map.prototype;
    Object.setPrototypeOf(TBMap, _Map);
    maplibregl.Map = TBMap;

    function registerGaiaRow(attempt) {
        if (window.GAIA && typeof window.GAIA.registerLayer === 'function') {
            window.GAIA.registerLayer({
                id: 'tactical-terrain',
                label: 'Tactical Terrain',
                meta: 'Maven-style basemap \u00b7 hillshade',
                source: { type: 'tile', status: 'live', count: 1 },
                on: function (v) { applyChoice(v ? 'tactical' : 'dark', true); }
            });
            return;
        }
        if (attempt < 20) setTimeout(function () { registerGaiaRow(attempt + 1); }, 500);
    }

    window.TB = {
        get: function () { return state.choice; },
        set: function (c) { applyChoice(c, true); }
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { registerGaiaRow(0); });
    else registerGaiaRow(0);
})();
</script>

