    // -------------------------------------------------------------------- init
    function init() {
        panel = $('gaia-panel');
        if (!panel) return; // add-on markup missing — stay inert
        listEl = $('gaiaLayerList');
        statusEl = $('gaiaStatus');
        metaEl = $('gaiaMeta');
        modeChip = $('gaiaModeChip');
        resultsHead = $('gaiaResultsHead');
        samplesEl = $('gaiaSamples');
        inputEl = $('gaiaSearchInput');
        chipsEl = $('gaiaChips');

        installRenderHooks();
        try { minimized = localStorage.getItem(LS_MIN) === '1'; } catch (e) {}
        setMinimized(minimized);
        applyGeometry();

        renderChips();
        renderRows();
        bindEvents();

        loadObjects();
        renderObjectMarkers();

        try { inputEl.value = ''; } catch (e) {}
        updateResults();

        temporalInit();

        // Restore persisted layer states onto the host WITHOUT re-render storms:
        // only flip layers whose stored state differs from the live one.
