<script>
(function () {
    'use strict';

    // ------------------------------------------------------------------ config
    var LS_NOTES = 'sc_won_notes_v1';
    var LS_GEOM = 'sc_won_geom_v1';
    var LS_OPEN = 'sc_won_open_v1';      // settings flag: panel visible
    var LS_MIN = 'sc_won_min_v1';        // settings flag: minimized
    var LS_AI_URL = 'sc_won_ai_url';     // optional AI endpoint; unset => offline templates
    var MAX_NOTES = 200;

    // --------------------------------------------------- host-data accessors
    function esc(s) {
        s = s == null ? '' : String(s);
        if (typeof window.escapeHtml === 'function') return window.escapeHtml(s);
        return s.replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function hostEvents() { return Array.isArray(fusionThreatEvents) ? fusionThreatEvents : []; }
    function hostFlights() { return Array.isArray(fusionFlights) ? fusionFlights : []; }
    function scopeLabel() {
        var sc = window.SCScope || {};
        return sc.country || sc.region || 'the watch scope';
    }
    function threatTone(ev) {
        try { return window.threatLevelForEvent(ev) || 'green'; } catch (e) { return 'green'; }
    }
    function geoOf(ev) {
        try { return window.parseActionGeo(ev); } catch (e) { return null; }
    }
    function metricsOf(evs) {
        try { return window.computeIntelMetrics(evs); } catch (e) { return null; }
    }
    function num(v) { var n = parseFloat(v); return Number.isFinite(n) ? n : null; }

    // ------------------------------------------------------------------ state
    var panel, listEl, emptyEl, statusEl, countEl, scanBtn, toggleBtn;
    var notes = loadNotes();
    var geom = loadGeom();
    var minimized = false;
    var isOpen = false;
    var scanning = false;

    function $(id) { return document.getElementById(id); }
    function uid() { return 'wn_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
    function normKey(s) { return (s || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
    function fmtTime(ts) {
        var d = new Date(ts);
        return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' +
               d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    function truncate(s, n) {
        s = String(s || '').replace(/\s+/g, ' ').trim();
        return s.length > n ? s.slice(0, n - 1).replace(/[,;:\s]+\S*$/, '') + '\u2026' : s;
    }

    function loadNotes() {
        try {
            var v = JSON.parse(localStorage.getItem(LS_NOTES));
            return Array.isArray(v) ? v.filter(Boolean) : [];
        } catch (e) { return []; }
    }
    function saveNotes() {
        try { localStorage.setItem(LS_NOTES, JSON.stringify(notes.slice(0, MAX_NOTES))); } catch (e) {}
    }
    function loadGeom() {
        try { return JSON.parse(localStorage.getItem(LS_GEOM)) || {}; } catch (e) { return {}; }
    }
    function saveGeom() {
        try {
            localStorage.setItem(LS_GEOM, JSON.stringify({
                w: parseInt(panel.style.width, 10),
                h: parseInt(panel.style.height, 10),
                right: parseInt(panel.style.right, 10),
                top: parseInt(panel.style.top, 10)
            }));
        } catch (e) {}
    }

    // --------------------------------------------------------------- geometry
    function applyGeometry() {
        var vw = window.innerWidth, vh = window.innerHeight;
        var w = clamp(geom.w || 380, 300, Math.min(vw - 16, 560));
        var h = clamp(geom.h || Math.round(vh * 0.7), 240, vh - 24);
        var right = clamp(geom.right == null ? 20 : geom.right, 8, Math.max(8, vw - w - 8));
        var top = clamp(geom.top == null ? 76 : geom.top, 8, Math.max(8, vh - 80));
        panel.style.width = w + 'px';
        if (!minimized) panel.style.height = h + 'px';
        panel.style.right = right + 'px';
        panel.style.top = top + 'px';
    }

    function initDrag() {
        var header = $('wonHeader');
        header.addEventListener('pointerdown', function (e) {
            if (e.target.closest('button') || e.button !== 0) return;
            e.preventDefault();
            var startX = e.clientX, startY = e.clientY;
            var startRight = parseInt(panel.style.right, 10) || 20;
            var startTop = parseInt(panel.style.top, 10) || 76;
            header.setPointerCapture(e.pointerId);
            function onMove(ev) {
                var vw = window.innerWidth, vh = window.innerHeight;
                var w = panel.offsetWidth;
                panel.style.right = clamp(startRight - (ev.clientX - startX), 8, Math.max(8, vw - w - 8)) + 'px';
                panel.style.top = clamp(startTop + (ev.clientY - startY), 8, Math.max(8, vh - 80)) + 'px';
            }
            function onUp() {
                header.removeEventListener('pointermove', onMove);
                header.removeEventListener('pointerup', onUp);
                saveGeom();
            }
            header.addEventListener('pointermove', onMove);
            header.addEventListener('pointerup', onUp);
        });
    }

    function initResize() {
        var handle = $('wonResizeHandle');
        handle.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            var startX = e.clientX, startY = e.clientY;
            var startW = panel.offsetWidth, startH = panel.offsetHeight;
            var startRight = parseInt(panel.style.right, 10) || 20;
            handle.setPointerCapture(e.pointerId);
            function onMove(ev) {
                var vw = window.innerWidth, vh = window.innerHeight;
                var w = clamp(startW + (startX - ev.clientX), 300, vw - 16);
                var h = clamp(startH + (ev.clientY - startY), 240, vh - 24);
                panel.style.width = w + 'px';
                panel.style.height = h + 'px';
                panel.style.right = clamp(startRight - (w - startW), 8, Math.max(8, vw - w - 8)) + 'px';
            }
            function onUp() {
                handle.removeEventListener('pointermove', onMove);
                handle.removeEventListener('pointerup', onUp);
                saveGeom();
            }
            handle.addEventListener('pointermove', onMove);
            handle.addEventListener('pointerup', onUp);
        });
    }

    // ------------------------------------------------------------ open / close
    function setOpen(v, persist) {
        isOpen = !!v;
        panel.classList.toggle('won-hidden', !isOpen);
        // Embedded mode: revealing the notepad selects the NOTES side-panel
        // feature; hiding falls back to the MAVEN layer.
        if (typeof window.__mavenSetFeature === 'function') {
            try { window.__mavenSetFeature(isOpen ? 'notes' : 'maven'); } catch (e) {}
        }
        if (persist !== false) { try { localStorage.setItem(LS_OPEN, isOpen ? '1' : '0'); } catch (e) {} }
        syncToggleBtn();
    }
    function setMinimized(v) {
        minimized = !!v;
        panel.classList.toggle('won-min', minimized);
        $('wonMinBtn').textContent = minimized ? '\u25a1' : '\u2013';
        $('wonMinBtn').title = minimized ? 'Restore' : 'Minimize';
        if (!minimized) applyGeometry(); else panel.style.height = 'auto';
        try { localStorage.setItem(LS_MIN, minimized ? '1' : '0'); } catch (e) {}
    }
    function toggle() { setOpen(!isOpen); }
    function syncToggleBtn() {
        toggleBtn = $('wonToggleBtn');
        if (toggleBtn) toggleBtn.className = 'retro-map-btn' + (isOpen ? ' retro-map-btn-active' : '');
    }

    // ---------------------------------------------------------------- rendering
    function sortedNotes() {
        return notes.slice().sort(function (a, b) {
            if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
            return (b.ts || 0) - (a.ts || 0);
        }).slice(0, MAX_NOTES);
    }
    function cardHTML(n) {
        var isScan = n.kind === 'scan';
        var facts = (n.facts || []).slice(0, 4).map(function (f) { return '<li>' + esc(f) + '</li>'; }).join('');
        return '' +
        '<article class="won-card' + (n.pinned ? ' won-card-pinned' : '') + '" data-id="' + esc(n.id) + '">' +
            '<div class="won-card-inner">' +
                '<span class="won-kind-tag won-kind-' + (isScan ? 'scan' : 'event') + '">' + (isScan ? 'SCAN' : 'EVENT') + '</span>' +
                '<h4 class="won-headline">' + esc(n.headline) + '</h4>' +
                '<ul class="won-facts">' + facts + '</ul>' +
                '<div class="won-why"><span class="won-label">Assessment</span>' +
                    '<div class="won-why-text won-editable" data-field="why" data-id="' + esc(n.id) + '" title="Click to edit">' + esc(n.why) + '</div></div>' +
                '<div class="won-angle"><span class="won-label">Recommended action</span>' +
                    '<div class="won-angle-text won-editable" data-field="angle" data-id="' + esc(n.id) + '" title="Click to edit">' + esc(n.angle) + '</div></div>' +
                '<div class="won-meta-row">' +
                    '<span>CONF <span class="won-conf" data-level="' + esc(n.confidence) + '">' + esc(n.confidence) + '</span></span>' +
                    '<span class="won-meta-src">SRC ' + esc(n.source || '\u2014') + '</span>' +
                    '<span>' + fmtTime(n.ts) + '</span>' +
                    '<span>CAMEO ' + esc(n.cameo || '\u2014') + '</span>' +
                '</div>' +
                '<div class="won-card-actions">' +
                    '<button type="button" class="won-mini-btn" data-act="copy" data-id="' + esc(n.id) + '">Copy</button>' +
                    '<button type="button" class="won-mini-btn' + (n.pinned ? ' won-pin-on' : '') + '" data-act="pin" data-id="' + esc(n.id) + '">Pin</button>' +
                    '<button type="button" class="won-mini-btn won-mini-danger" data-act="del" data-id="' + esc(n.id) + '">Del</button>' +
                '</div>' +
            '</div>' +
        '</article>';
    }
    function render() {
        var view = sortedNotes();
        countEl.textContent = notes.length + ' NOTE' + (notes.length === 1 ? '' : 'S');
        emptyEl.style.display = view.length ? 'none' : '';
        listEl.innerHTML = view.map(cardHTML).join('');
    }
    function flashCard(id) {
        requestAnimationFrame(function () {
            var el = listEl.querySelector('[data-id="' + id + '"]');
            if (!el) return;
            el.classList.add('won-flash');
            setTimeout(function () { el.classList.remove('won-flash'); }, 1000);
        });
    }
    function status(msg) { statusEl.textContent = msg; }

    // ------------------------------------------------------------- note intake
    function addNote(note) {
        note.id = note.id || uid();
        note.ts = Date.now();
        note.pinned = !!note.pinned;
        var key = normKey(note.headline);
        var existing = notes.find(function (m) { return normKey(m.headline) === key; });
        if (existing) {
            existing.ts = note.ts;
            existing.facts = note.facts;
            // manual edits survive re-scans and AI enhancement passes
            if (!(existing.edited && existing.edited.why)) existing.why = note.why;
            if (!(existing.edited && existing.edited.angle)) existing.angle = note.angle;
            existing.confidence = note.confidence;
            existing.caveat = note.caveat;
            saveNotes(); render(); flashCard(existing.id);
            return existing.id;
        }
        notes.unshift(note);
        if (notes.length > MAX_NOTES) notes.length = MAX_NOTES;
        saveNotes(); render(); flashCard(note.id);
        return note.id;
    }
    function removeNote(id) {
        notes = notes.filter(function (m) { return m.id !== id; });
        saveNotes(); render();
    }

    // --------------------------------------------- inline text editing (assessment / action)
    function startEdit(el) {
        var id = el.getAttribute('data-id');
        var field = el.getAttribute('data-field');
        var note = notes.find(function (n) { return n.id === id; });
        if (!note || el.isContentEditable) return;
        el.setAttribute('contenteditable', 'true');
        el.classList.add('won-editing');
        el.title = 'Enter to save \u00b7 Esc to cancel';
        el.focus();
        var rng = document.createRange();
        rng.selectNodeContents(el);
        rng.collapse(false);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(rng);

        function done(commit) {
            el.removeEventListener('blur', onBlur);
            el.removeEventListener('keydown', onKey);
            el.removeAttribute('contenteditable');
            el.classList.remove('won-editing');
            el.title = 'Click to edit';
            if (commit) {
                var txt = el.innerText.replace(/\s+/g, ' ').trim();
                if (txt && txt !== note[field]) {
                    note[field] = txt;
                    note.edited = note.edited || {};
                    note.edited[field] = true;
                    saveNotes();
                    status(field === 'why' ? 'Assessment updated \u2014 edit locked against AI overwrite.' : 'Recommended action updated \u2014 edit locked against AI overwrite.');
                    flashCard(note.id);
                } else {
                    el.textContent = note[field];
                }
            } else {
                el.textContent = note[field];
            }
        }
        function onBlur() { done(true); }
        function onKey(e) {
            if (e.key === 'Enter') { e.preventDefault(); el.blur(); }
            else if (e.key === 'Escape') { e.preventDefault(); done(false); }
        }
        el.addEventListener('blur', onBlur);
        el.addEventListener('keydown', onKey);
    }

    // --------------------------------------------- single-event note builders
    function buildThreatNote(ev) {
        var geo = geoOf(ev) || {};
        var tone = threatTone(ev);
        var label = (window.THREAT_LABEL && window.THREAT_LABEL[tone]) || tone.toUpperCase();
        var country = geo.country || ev.sourcecountry || 'unspecified location';
        var cameo = ev.event_code || '?';
        var title = ev.title || '';
        var arts = parseInt(ev.numMentions || ev.num_articles, 10) || 0;
        var toneVal = num(ev.avg_tone);
        var goldVal = num(ev.payload && ev.payload.GoldsteinScale);

        var headline = title
            ? truncate(title, 120)
            : label + '-flagged CAMEO ' + cameo + ' activity reported in ' + country;

        var facts = [];
        facts.push('Location: ' + country + (geo.latitude != null ?
            ' (' + (+geo.latitude).toFixed(2) + ', ' + (+geo.longitude).toFixed(2) + ')' : ''));
        if (ev.event_type) facts.push('CAMEO ' + cameo + ' \u00b7 ' + truncate(ev.event_type, 70));
        facts.push('Reported by ' + (ev.domain || 'unknown outlet') +
            (arts ? ' \u00b7 ' + arts + ' article' + (arts > 1 ? 's' : '') : ''));
        if (toneVal != null || goldVal != null) {
            var bits = [];
            if (toneVal != null) bits.push('avg tone ' + toneVal.toFixed(1));
            if (goldVal != null) bits.push('Goldstein ' + goldVal.toFixed(1));
            facts.push(bits.join(' \u00b7 '));
        }

        var why, angle, conf, caveat;
        if (tone === 'red') {
            why = 'Assessment: reporting describes violent activity inside the watch area within the current collection window. Treated as an active I&W trigger; single-cycle spikes can be noise, so corroboration is required before elevation.';
        } else if (tone === 'amber') {
            why = 'Assessment: development sits adjacent to established escalation thresholds but below conflict criteria. Assessed as pre-crisis posturing; monitor for repetition across independent sources.';
        } else {
            why = 'Assessment: activity consistent with the established baseline for this area. Retained for pattern-of-life continuity; principal value is as a reference against future deviation.';
        }
        if (arts >= 10) why += ' Broad multi-outlet pickup raises assessed reliability of core claims.';
        else if (arts > 0 && arts < 3) why += ' Thin source base \u2014 specifics remain unconfirmed pending second-source corroboration.';

        var hay = ((title || '') + ' ' + (ev.event_type || '')).toLowerCase();
        var kw = window.CONFLICT_KEYWORDS || {};
        function hasAny(list) { return (list || []).some(function (k) { return hay.indexOf(k) !== -1; }); }
        if (hasAny(kw.violence)) {
            angle = 'Handling: build an escalation timeline \u2014 ground truth versus prior baseline; attribute each claim to a named official or agency; flag anything resting on a sole source.';
        } else if (hasAny(kw.protest)) {
            angle = 'Handling: mobilization ledger \u2014 stated demands, estimated turnout, organizer affiliation; assess recurrence probability inside a seven-day window.';
        } else if (hasAny(kw.arrest)) {
            angle = 'Handling: accountability track \u2014 charges, custody status, venue; identify the prosecuting authority and the next procedural milestone.';
        } else if (hasAny(kw.coerce)) {
            angle = 'Handling: pressure mapping \u2014 actor, lever, target, stated deadline; assess whether the demand is negotiable or an ultimatum.';
        } else {
            angle = 'Handling: verify actors first, then test for repetition across the scope; single-instance reporting stays parked until a pattern emerges.';
        }

        if (geo.latitude != null && title && (arts >= 5 || toneVal != null)) {
            conf = 'High'; caveat = 'Geo-coded and sourced; details may still rest on one outlet.';
        } else if (title && (geo.latitude != null || ev.domain)) {
            conf = 'Medium'; caveat = 'Partially attributed \u2014 cross-check against a second source.';
        } else {
            conf = 'Low'; caveat = 'Thin metadata; treat as a pointer, not a story.';
        }

        return {
            kind: 'event',
            headline: headline,
            facts: facts.slice(0, 4),
            why: why,
            angle: angle,
            confidence: conf,
            caveat: caveat,
            source: ev.domain || 'GDELT',
            cameo: cameo,
            country: country,
            ref: { t: 'gdelt', i: hostEvents().indexOf(ev) }
        };
    }

    function buildAirNote(props) {
        props = props || {};
        var callsign = props.callsign || 'Unknown aircraft';
        var category = props.category || '?';
        var mil = /mil/i.test(category);
        var headline = callsign + ' (' + category + ') tracked over ' + scopeLabel();

        var facts = [];
        if (props.model) facts.push('Model: ' + props.model);
        facts.push((props.alt != null ? props.alt + ' ft' : 'Alt n/a') + ' \u00b7 ' +
                   (props.speed_knots != null ? props.speed_knots + ' kts' : 'n/a') + ' \u00b7 heading ' + (props.heading || 'n/a'));
        if (props.lat != null) facts.push('Position [' + (+props.lat).toFixed(2) + ', ' + (+props.lng).toFixed(2) + '] \u00b7 ICAO24 ' + (props.icao24 || 'n/a'));

        var why = mil
            ? 'Assessment: military-category track operating within scoped airspace. Force-posture shifts in this category frequently precede exercise or deployment activity; log for pattern-of-life.'
            : 'Assessment: routine-category track logged over scope. Value is baseline traffic density; deviation from this profile is the reportable event.';
        var angle = mil
            ? 'Handling: registry check \u2014 ICAO24, registration chain, operator history; compare current routing against this asset\u2019s observed norm before drawing conclusions.'
            : 'Handling: route provenance \u2014 origin airport, owner registry, corridor frequency; flag only if routing departs from the established pattern.';

        return {
            kind: 'event',
            headline: headline,
            facts: facts.slice(0, 4),
            why: why,
            angle: angle,
            confidence: 'High',
            caveat: 'Live transponder snapshot \u2014 verify registration before naming operators.',
            source: 'OpenSky',
            cameo: category,
            country: '',
            ref: { t: 'opensky', i: -1 }
        };
    }

    // ------------------------------------------------------------ scan engine
    function ensureDataLoaded() {
        if (hostEvents().length || hostFlights().length) return Promise.resolve();
        if (typeof window.preloadFusionData === 'function') {
            return window.preloadFusionData().catch(function () {});
        }
        return Promise.resolve();
    }

    function scanTopThreats(evs) {
        var scored = evs.map(function (ev) {
            var g = geoOf(ev);
            return { ev: ev, tone: threatTone(ev), country: (g && g.country) || ev.sourcecountry || '', arts: parseInt(ev.numMentions || ev.num_articles, 10) || 0 };
        }).filter(function (x) { return x.tone === 'red' || x.tone === 'amber'; })
          .sort(function (a, b) { return (b.tone === 'red' ? 1e6 : 0) + b.arts - ((a.tone === 'red' ? 1e6 : 0) + a.arts); });
        if (!scored.length) return null;
        var reds = scored.filter(function (x) { return x.tone === 'red'; });
        var countries = [];
        scored.forEach(function (x) { if (x.country && countries.indexOf(x.country) === -1) countries.push(x.country); });
        var lead = reds[0] || scored[0];
        return {
            kind: 'scan',
            headline: (reds.length ? 'Red-flag cluster: ' + reds.length + ' severe report' + (reds.length > 1 ? 's' : '') : 'Watch signal: ' + scored.length + ' flagged reports') +
                (countries.length ? ' centering on ' + countries.slice(0, 3).join(', ') : ''),
            facts: [
                scored.length + ' of ' + evs.length + ' events in scope are red/amber-flagged',
                'Heaviest signal: ' + truncate(lead.ev.title || lead.ev.event_type || 'CAMEO ' + (lead.ev.event_code || '?'), 90),
                'Top locations: ' + (countries.slice(0, 3).join(', ') || 'unspecified'),
                'Busiest outlet: ' + busiestDomain(evs)
            ],
            why: 'Assessment: severity concentrated inside a single watch window historically marks the day\u2019s primary escalation pocket. Direct verification effort here first; secondary fronts can wait.',
            angle: 'Handling: sweep-and-rank \u2014 independently confirm the top three flags before committing to any single narrative thread.',
            confidence: reds.length >= 3 ? 'High' : reds.length >= 1 ? 'Medium' : 'Low',
            caveat: 'Severity follows GDELT classification; treat counts as triage, not ground truth.',
            source: 'SC Fusion scan',
            cameo: (lead.ev.event_code || '\u2014')
        };
    }

    function busiestDomain(evs) {
        var m = {};
        evs.forEach(function (e) { if (e.domain) m[e.domain] = (m[e.domain] || 0) + 1; });
        var best = Object.keys(m).sort(function (a, b) { return m[b] - m[a]; })[0];
        return best ? best + ' (' + m[best] + ')' : 'n/a';
    }

    function scanToneShift(evs) {
        var tones = evs.map(function (e) { return num(e.avg_tone); }).filter(function (v) { return v != null; });
        if (tones.length < 5) return null;
        var avg = tones.reduce(function (a, b) { return a + b; }, 0) / tones.length;
        var neg = tones.filter(function (v) { return v < 0; }).length;
        var strongNeg = tones.filter(function (v) { return v < -5; }).length;
        var share = Math.round(100 * neg / tones.length);
        return {
            kind: 'scan',
            headline: 'Coverage tone averages ' + avg.toFixed(1) + ' across ' + tones.length + ' reports (' + share + '% negative)',
            facts: [
                'Average tone ' + avg.toFixed(1) + ' (negative below 0)',
                neg + ' of ' + tones.length + ' reports carry negative tone',
                strongNeg + ' sit below \u22125 \u2014 strongly adverse coverage'
            ],
            why: avg < -5
                ? 'Assessment: sustained adverse tone indicates an active coverage cycle; follow-on reporting expected within hours. Prepare holding lines now.'
                : 'Assessment: tone near neutral \u2014 retained as the reference baseline for detecting the next coverage shift.',
            angle: 'Handling: quantify the shift \u2014 current average versus weekly baseline; name the outlets driving the delta.',
            confidence: tones.length >= 25 ? 'High' : tones.length >= 8 ? 'Medium' : 'Low',
            caveat: 'Tone is machine-scored; individual outlets can skew the average.',
            source: 'SC Fusion scan',
            cameo: '\u2014'
        };
    }

    function scanAirActivity(fls) {
        if (!fls.length) return null;
        var buckets = {};
        fls.forEach(function (f) {
            var p = f.properties || {};
            if (p.lat == null) return;
            var key = Math.floor(p.lat / 3) * 3 + ',' + Math.floor(p.lng / 3) * 3;
            (buckets[key] = buckets[key] || []).push(p);
        });
        var bestKey = null;
        Object.keys(buckets).forEach(function (k) { if (!bestKey || buckets[k].length > buckets[bestKey].length) bestKey = k; });
        if (!bestKey) return null;
        var cluster = buckets[bestKey];
        var milCount = fls.filter(function (f) { return /mil/i.test((f.properties || {}).category || ''); }).length;
        var cats = {};
        fls.forEach(function (f) { var c = (f.properties || {}).category || '?'; cats[c] = (cats[c] || 0) + 1; });
        var catTop = Object.keys(cats).sort(function (a, b) { return cats[b] - cats[a]; }).slice(0, 2)
            .map(function (c) { return c + ' \u00d7' + cats[c]; }).join(', ');
        return {
            kind: 'scan',
            headline: 'Air activity: ' + fls.length + ' tracks in scope; densest cell holds ' + cluster.length + ' around [' + bestKey.split(',')[0] + '\u00b0, ' + bestKey.split(',')[1] + '\u00b0]',
            facts: [
                'Total live tracks: ' + fls.length,
                'Densest 3\u00b0 cell: ' + cluster.length + ' aircraft near [' + bestKey + ']',
                milCount ? milCount + ' military-category asset' + (milCount > 1 ? 's' : '') + ' airborne' : 'No military-category tracks flagged',
                'Category mix: ' + (catTop || 'n/a')
            ],
            why: milCount
                ? 'Assessment: military-category presence inside mixed traffic. Density changes in this cell often precede exercises, rotations, or deployments; treat as a standing watch item.'
                : 'Assessment: density figure establishes the aviation baseline; anything unusual is only definable against this number.',
            angle: 'Handling: compare today\u2019s density to the weekly norm; task registry checks on outliers before drawing conclusions.',
            confidence: 'Medium',
            caveat: 'ADS-B only \u2014 aircraft without transponders are invisible to this picture.',
            source: 'SC Fusion scan',
            cameo: 'OpenSky'
        };
    }

    function scanCoverage(evs) {
        if (evs.length < 6) return null;
        var m = {}, total = 0;
        evs.forEach(function (e) { if (e.domain) { m[e.domain] = (m[e.domain] || 0) + 1; total++; } });
        var ranked = Object.keys(m).sort(function (a, b) { return m[b] - m[a]; });
        if (!ranked.length) return null;
        var share = m[ranked[0]] / Math.max(total, 1);
        if (share < 0.25) return null;
        return {
            kind: 'scan',
            headline: 'Single-outlet dominance: ' + ranked[0] + ' drives ' + Math.round(100 * share) + '% of scoped coverage',
            facts: [
                ranked[0] + ': ' + m[ranked[0]] + ' of ' + total + ' reports',
                'Runner-up: ' + (ranked[1] ? ranked[1] + ' (' + m[ranked[1]] + ')' : 'none'),
                'Distinct outlets in scope: ' + ranked.length
            ],
            why: 'Assessment: single-outlet dominance creates framing risk \u2014 the narrative travels with that outlet\u2019s editorial line. Independent corroboration required before internal use.',
            angle: 'Handling: sourcing audit \u2014 isolate the dominant outlet\u2019s specific claims; identify which are corroborated elsewhere and which are not.',
            confidence: 'Medium',
            caveat: 'Counts mirror this query\u2019s recall, not total publication volume.',
            source: 'SC Fusion scan',
            cameo: '\u2014'
        };
    }

    function scanIndices(evs) {
        var mx = metricsOf(evs);
        if (!mx || !mx.total) return null;
        return {
            kind: 'scan',
            headline: 'Watch indices \u2014 systemic ' + mx.systemic + ' \u00b7 propagation ' + mx.propagation + ' \u00b7 sensitivity ' + mx.sensitivity,
            facts: [
                mx.total + ' events indexed (' + mx.geoCoded + ' geo-coded)',
                'Negative/flagged: ' + mx.negative + ' \u00b7 red: ' + mx.red,
                'Article volume in scope: ' + mx.articles
            ],
            why: parseFloat(mx.systemic) >= 0.6
                ? 'Assessment: elevated systemic pressure \u2014 low-grade triggers can propagate across multiple fronts today. Raise the watch condition accordingly.'
                : 'Assessment: indices provide the quantitative spine for products filed from this scope; stable values support baseline assertions.',
            angle: 'Handling: lead with numbers \u2014 three indices, one sentence each, anchored to today\u2019s event count; avoid adjectives the data cannot carry.',
            confidence: mx.total >= 25 ? 'High' : mx.total >= 8 ? 'Medium' : 'Low',
            caveat: 'Indices derive from the current scoped sample size (' + mx.total + ').',
            source: 'SC Fusion scan',
            cameo: '\u2014'
        };
    }

    function scanNow() {
        if (scanning) return;
        scanning = true;
        scanBtn.disabled = true;
        scanBtn.textContent = 'SCANNING\u2026';
        panel.classList.add('won-scanning');
        status('Pulling live state\u2026');
        ensureDataLoaded().then(function () {
            var evs = hostEvents(), fls = hostFlights();
            if (!evs.length && !fls.length) {
                status('No live data in scope yet \u2014 run GDELT/OpenSky first.');
                return;
            }
            var cands = [];
            var b;
            if ((b = scanTopThreats(evs))) cands.push(b);
            if ((b = scanToneShift(evs))) cands.push(b);
            if ((b = scanAirActivity(fls))) cands.push(b);
            if ((b = scanCoverage(evs))) cands.push(b);
            if ((b = scanIndices(evs))) cands.push(b);
            if (!cands.length) { status('Not enough signal in the current feed to build notes.'); return; }
            var added = 0;
            cands.forEach(function (note) {
                enhanceNote(note).then(function (n2) { addNote(n2); added++; status('Scan added ' + added + '/' + cands.length + ' notes.'); });
            });
        }).finally(function () {
            scanning = false;
            scanBtn.disabled = false;
            scanBtn.textContent = 'SCAN NOW';
            panel.classList.remove('won-scanning');
        });
    }

    // ------------------------------------------------ optional AI enhancement
    function aiUrl() {
        return (window.WONOTE_CFG && window.WONOTE_CFG.aiUrl) ||
               (function () { try { return localStorage.getItem(LS_AI_URL) || ''; } catch (e) { return ''; } })();
    }
    function briefOf(n) {
        return 'ANGLE HEADLINE\n' + n.headline +
            '\n\nKEY FACTS\n- ' + (n.facts || []).join('\n- ') +
            '\n\nASSESSMENT\n' + n.why +
            '\n\nRECOMMENDED ACTION\n' + n.angle;
    }
    function enhanceNote(note) {
        var url = aiUrl();
        if (!url) return Promise.resolve(note); // fully offline by default
        var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
        var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 8000) : null;
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ task: 'watch_officer_note', brief: briefOf(note) }),
            signal: ctrl ? ctrl.signal : undefined
        }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
            if (j) {
                // length caps keep a misbehaving endpoint from dumping walls of text
                if (typeof j.headline === 'string' && j.headline.trim()) note.headline = j.headline.trim().slice(0, 160);
                if (typeof j.why === 'string' && j.why.trim()) note.why = j.why.trim().slice(0, 420);
                if (typeof j.angle === 'string' && j.angle.trim()) note.angle = j.angle.trim().slice(0, 340);
                if (Array.isArray(j.facts) && j.facts.length) note.facts = j.facts.slice(0, 4).map(String).map(function (f) { return f.slice(0, 200); });
            }
            return note; // silent fallback keeps template content on any failure
        }).catch(function () { return note; }).then(function (n2) {
            if (timer) clearTimeout(timer);
            return n2;
        });
    }

    // ---------------------------------------------------------------- exports
    function plainBrief(n) {
        return n.headline + '\n\nKEY FACTS\n' +
            (n.facts || []).map(function (f) { return '- ' + f; }).join('\n') +
            '\n\nASSESSMENT\n' + n.why +
            '\n\nRECOMMENDED ACTION\n' + n.angle +
            '\n\nConfidence: ' + n.confidence + ' \u2014 ' + (n.caveat || '') +
            '\nSource: ' + (n.source || '\u2014') + ' | CAMEO ' + (n.cameo || '\u2014') + ' | ' + fmtTime(n.ts);
    }
    function download(name, text, mime) {
        var blob = new Blob([text], { type: mime });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = name;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 400);
    }
    function exportJson() {
        if (!notes.length) { status('Nothing to export.'); return; }
        var payload = {
            exported_at: new Date().toISOString(),
            scope: scopeLabel(),
            count: notes.length,
            notes: sortedNotes()
        };
        download('watch-officer-notes-' + new Date().toISOString().slice(0, 10) + '.json',
            JSON.stringify(payload, null, 2), 'application/json');
        status('Exported JSON.');
    }
    function exportMarkdown() {
        if (!notes.length) { status('Nothing to export.'); return; }
        var md = '# Watch Officer Notes \u2014 ' + scopeLabel() + '\n\n' +
            '_Exported ' + new Date().toLocaleString() + ' \u00b7 ' + notes.length + ' notes_\n\n';
        sortedNotes().forEach(function (n, i) {
            md += '## ' + (i + 1) + '. ' + n.headline + '\n\n';
            (n.facts || []).forEach(function (f) { md += '- ' + f + '\n'; });
            md += '\n**Assessment:** ' + n.why + '\n\n';
            md += '**Recommended action:** ' + n.angle + '\n\n';
            md += '> Confidence: ' + n.confidence + ' \u2014 ' + (n.caveat || '') + '  \n';
            md += '> Source: ' + (n.source || '\u2014') + ' \u00b7 CAMEO ' + (n.cameo || '\u2014') + ' \u00b7 ' + fmtTime(n.ts) + '\n\n';
        });
        download('watch-officer-notes-' + new Date().toISOString().slice(0, 10) + '.md', md, 'text/markdown');
        status('Exported Markdown.');
    }
    function copyText(t) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(t);
        }
        var ta = document.createElement('textarea');
        ta.value = t;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        ta.remove();
        return Promise.resolve();
    }

    // ------------------------------------------------------------------ wiring
    function initPanel() {
        if ($('won-panel')) return true;
        return false;
    }

    function bindEvents() {
        scanBtn.addEventListener('click', scanNow);
        $('wonExportJsonBtn').addEventListener('click', exportJson);
        $('wonExportMdBtn').addEventListener('click', exportMarkdown);
        $('wonCloseBtn').addEventListener('click', function () { setOpen(false); });
        $('wonMinBtn').addEventListener('click', function () { setMinimized(!minimized); });
        $('wonClearBtn').addEventListener('click', function () {
            var pinned = notes.filter(function (n) { return n.pinned; }).length;
            notes = notes.filter(function (n) { return n.pinned; });
            saveNotes(); render();
            status(pinned ? 'Cleared \u2014 kept ' + pinned + ' pinned.' : 'All notes cleared.');
        });

        listEl.addEventListener('click', function (e) {
            var ed = e.target.closest ? e.target.closest('.won-editable') : null;
            if (ed && !ed.isContentEditable) { startEdit(ed); return; }
            var btn = e.target.closest('[data-act]');
            if (!btn) return;
            var id = btn.getAttribute('data-id');
            var act = btn.getAttribute('data-act');
            var note = notes.find(function (n) { return n.id === id; });
            if (!note) return;
            if (act === 'del') removeNote(id);
            else if (act === 'pin') { note.pinned = !note.pinned; saveNotes(); render(); }
            else if (act === 'copy') {
                copyText(plainBrief(note)).then(
                    function () { status('Copied to clipboard.'); },
                    function () { status('Copy failed.'); }
                );
            }
        });

        // "+ Note" buttons inside map hover boxes (delegated; popups live anywhere in DOM)
        document.addEventListener('click', function (e) {
            var t = e.target.closest ? e.target.closest('[data-won-threat]') : null;
            if (t) { noteFromThreat(parseInt(t.getAttribute('data-won-threat'), 10)); return; }
            var a = e.target.closest ? e.target.closest('[data-won-air]') : null;
            if (a) { noteFromAircraft(parseInt(a.getAttribute('data-won-air'), 10)); }
        });

        // Ctrl+Shift+N toggles the notepad (Alt+Shift+N alias: some browsers
        // reserve Ctrl+Shift+N for private windows and swallow the key)
        document.addEventListener('keydown', function (e) {
            var combo = e.shiftKey && (e.key === 'N' || e.key === 'n') && (e.ctrlKey || e.metaKey || e.altKey);
            if (combo) {
                e.preventDefault();
                toggle();
            }
        });

        var resizeTimer = null;
        window.addEventListener('resize', function () {
            applyGeometry();
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(render, 150);
        });
    }

    function noteFromThreat(idx) {
        var ev = hostEvents()[idx];
        setOpen(true);
        if (!ev) { status('Event no longer in the live feed \u2014 refresh the map.'); return; }
        enhanceNote(buildThreatNote(ev)).then(function (n2) {
            addNote(n2);
            status('Note captured from map hover.');
        });
    }
    function noteFromAircraft(idx) {
        var f = hostFlights()[idx];
        setOpen(true);
        if (!f) { status('Track no longer in the live feed \u2014 refresh the map.'); return; }
        enhanceNote(buildAirNote(f.properties || {})).then(function (n2) {
            addNote(n2);
            status('Track noted.');
        });
    }

    function init() {
        panel = $('won-panel');
        if (!panel) return; // add-on markup missing \u2014 stay inert
        listEl = $('wonList');
        emptyEl = $('wonEmpty');
        statusEl = $('wonStatus');
        countEl = $('wonCount');
        scanBtn = $('wonScanBtn');

        applyGeometry();
        minimized = false;
        try { minimized = localStorage.getItem(LS_MIN) === '1'; } catch (e) {}
        setMinimized(minimized);

        bindEvents();
        initDrag();
        initResize();
        render();

        var storedOpen;
        try { storedOpen = localStorage.getItem(LS_OPEN); } catch (e) {}
        setOpen(storedOpen !== '0', false); // docked in MAVEN col: visible by default

        // public API
        window.WONote = {
            toggle: toggle,
            open: function () { setOpen(true); },
            close: function () { setOpen(false); },
            minimize: function () { setMinimized(!minimized); },
            scan: scanNow,
            fromThreat: noteFromThreat,
            fromAircraft: noteFromAircraft,
            notes: function () { return notes.slice(); },
            clear: function () { notes = []; saveNotes(); render(); },
            config: function (cfg) {
                cfg = cfg || {};
                if (cfg.aiUrl != null) { try { localStorage.setItem(LS_AI_URL, cfg.aiUrl); } catch (e) {} }
                return { aiUrl: aiUrl() };
            }
        };
        syncToggleBtn();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>

