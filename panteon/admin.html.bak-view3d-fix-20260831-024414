function filterSmmServices() {
    const q = document.getElementById('smmServiceSearch').value.toLowerCase();
    const platformFilter = document.getElementById('smmServicePlatformFilter').value;
    const refillFilter = document.getElementById('smmServiceRefillFilter').value;
    const sortFilter = document.getElementById('smmServiceSort').value;
    let filtered = smmServicesCache.filter(s => {
        const matchesSearch = (s.name || '').toLowerCase().includes(q) || String(s.service).includes(q);
        if (!matchesSearch) return false;
        if (platformFilter !== 'all' && getServicePlatform(s) !== platformFilter) return false;
        if (refillFilter === 'yes' && !s.refill) return false;
        if (refillFilter === 'no' && s.refill) return false;
        return true;
    });
    if (sortFilter === 'cheapest') {
        filtered.sort((a, b) => parseFloat(a.rate || 0) - parseFloat(b.rate || 0));
    } else if (sortFilter === 'expensive') {
        filtered.sort((a, b) => parseFloat(b.rate || 0) - parseFloat(a.rate || 0));
    } else if (sortFilter === 'popular') {
        filtered.sort((a, b) => (b.min || 0) - (a.min || 0));
    }
    smmFilteredServices = filtered;
    smmCurrentPage = 1;
    document.getElementById('smmServiceCountBadge').textContent = filtered.length + ' services';
    renderSmmServicesPage();
}

function renderSmmServicesPage() {
    const start = (smmCurrentPage - 1) * SMM_PAGE_SIZE;
    const page = smmFilteredServices.slice(start, start + SMM_PAGE_SIZE);
    renderSmmServicesTable(page);
    renderSmmPagination();
}

function renderSmmPagination() {
    const total = smmFilteredServices.length;
    const pages = Math.ceil(total / SMM_PAGE_SIZE);
    const el = document.getElementById('smmPagination');
    if (pages <= 1) { el.style.display = 'none'; return; }
    el.style.display = 'flex';
    let html = '';
    for (let i = 1; i <= pages; i++) {
        html += '<button class="btn btn-sm" onclick="goToSmmPage(' + i + ')" style="min-width:28px' + (i === smmCurrentPage ? ';background:var(--accent-purple);color:#fff' : '') + '">' + i + '</button>';
    }
    el.innerHTML = html;
}

function goToSmmPage(page) {
    smmCurrentPage = page;
    renderSmmServicesPage();
}

async function placeSmmOrder() {
    const linkId = document.getElementById('smmOrderLinkSelect').value;
    const service = parseInt(document.getElementById('smmServiceSelect').value);
    const quantity = parseInt(document.getElementById('smmQtyInput').value) || undefined;
    if (!linkId) { toast('Select a link first', 'error'); return; }
    const body = { link_id: linkId, service };
    if (quantity) body.quantity = quantity;
    if (document.getElementById('smmDripCheck').checked) {
        const runs = parseInt(document.getElementById('smmDripRuns').value);
        const interval = parseInt(document.getElementById('smmDripInterval').value);
        if (runs && interval) { body.runs = runs; body.interval = interval; }
    }
    const comments = document.getElementById('smmCommentsInput').value.trim();
    if (comments) body.comments = comments.split('\n').filter(Boolean);
    try {
        document.getElementById('smmOrderBtn').disabled = true;
        const data = await api('/smm/orders', { method: 'POST', body: JSON.stringify(body) });
        const el = document.getElementById('smmOrderResult');
        el.style.display = 'block';
        el.innerHTML = 'Order placed! Order ID: <b>' + (data.naizop_order_id || '--') + '</b>';
        toast('Order placed successfully');
        loadSmmLinks();
    } catch (e) {
        toast(e.message, 'error');
    } finally {
        document.getElementById('smmOrderBtn').disabled = false;
    }
}

