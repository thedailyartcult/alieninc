    }
    function focusResults() {
        var f = activeFilter || parseQuery(inputEl.value);
        var pts = collectPoints().filter(function (p) { return matches(p, f); });
        if (!pts.length) { statusMsg('No matching objects to frame.'); return; }
        var map = window.fusionMap;
        if (!map || !map.fitBounds) { statusMsg('Fusion map is not initialized.'); return; }
        var lamin = 90, lamax = -90, lomin = 180, lomax = -180;
        pts.forEach(function (p) {
            lamin = Math.min(lamin, p.lat); lamax = Math.max(lamax, p.lat);
            lomin = Math.min(lomin, p.lng); lomax = Math.max(lomax, p.lng);
        });
        map.fitBounds([[lomin, lamin], [lomax, lamax]], { padding: 70, maxZoom: 9, duration: 900 });
        statusMsg('Framing ' + pts.length + ' matched object' + (pts.length === 1 ? '' : 's') + '.');
    }

    // ------------------------------------------------------------------- chips
    var CHIPS = [
        { id: 'friend', label: 'Friendly assets', phrase: 'friendly assets within 500 km' },
        { id: 'fr10',   label: 'Friendly 10km',   phrase: 'friendly assets within 10 km of the scope center' },
