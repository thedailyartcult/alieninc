const AC_PLANE_BODY_D = 'M12 1.2 L13.4 4.6 L13.5 9.1 L22 14.2 L22 15.8 L13.5 13.3 L13.5 17.1 L16.3 19.3 L16.3 20.9 L12 19.7 L7.7 20.9 L7.7 19.3 L10.5 17.1 L10.5 13.3 L2 15.8 L2 14.2 L10.5 9.1 L10.6 4.6 Z';

