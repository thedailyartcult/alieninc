        };
        var m = getMap();
        if (m) { S.wiredMap = m; wireMapClicks(m); }
        wireProbe();
        var ovlBtn = $('mavenOvlBtn');
        if (ovlBtn) ovlBtn.onclick = function () { setOverlays(!S.overlays); };
        var col = $('mavenLeftCol');
        if (col) {
            col.addEventListener('dblclick', function (e) {
                if (e.target.closest('button, input, select, label, a')) return;
