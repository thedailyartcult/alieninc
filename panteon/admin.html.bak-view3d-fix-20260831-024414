                              }

                              function draggable(el, onMove, onClick) {
                                  el.addEventListener('pointerdown', function (ev) {
                                      if (ev.button !== 0) return;
                                      var sx = ev.clientX, sy = ev.clientY, ox = state.x, oy = state.y, moved = false;
                                      function mv(e) {
                                          if (!moved && Math.hypot(e.clientX - sx, e.clientY - sy) < 7) return;
                                          if (!moved) { moved = true; document.body.classList.add('hive-dragging'); }
                                          onMove(e.clientX - sx, e.clientY - sy, ox, oy);
                                      }
                                      function up() {
                                          window.removeEventListener('pointermove', mv, true);
                                          window.removeEventListener('pointerup', up, true);
                                          window.removeEventListener('pointercancel', up, true);
