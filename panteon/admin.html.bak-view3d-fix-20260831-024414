    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700">${result.archived || 0}</div><div style="font-size:11px;color:var(--text-muted)">Archived</div></div>`;
    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700">${result.compaction || 0}</div><div style="font-size:11px;color:var(--text-muted)">Tokens Compacted</div></div>`;
    html += '</div>';
    html += `<div style="font-size:11px;color:var(--text-muted)">Dry run: ${result.dry_run ? 'Yes' : 'No'} | Already consolidated: ${result.skipped_already_consolidated || 0}</div>`;
    box.innerHTML = html;
}

async function renderCMBAnalyticsSessions(box, ws) {
    if (!ws) { box.innerHTML = '<div class="empty-state">Select a workspace.</div>'; return; }
    const stats = await cmbApiGet('/stats?workspace=' + ws);
    let html = '<div style="margin-bottom:12px;font-weight:600">Session Handoff — ' + ws + '</div>';
    html += `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:16px">`;
    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700;color:var(--cyan)">${stats.sessions || 0}</div><div style="font-size:11px;color:var(--text-muted)">Total Sessions</div></div>`;
    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700">${stats.workspaces || 1}</div><div style="font-size:11px;color:var(--text-muted)">Workspaces</div></div>`;
    html += '</div>';
    html += `<div style="font-size:11px;color:var(--text-muted)">Session handoff tokens saved via bootstrap summaries. Use cmb_end_session with open_threads for context continuity.</div>`;
    box.innerHTML = html;
}

async function renderCMBAnalyticsQuality(box, ws) {
    if (!ws) { box.innerHTML = '<div class="empty-state">Select a workspace.</div>'; return; }
    const mems = await cmbApiGet('/memories?workspace=' + ws + '&limit=50');
    const sorted = mems.sort((a, b) => (b.importance || 0) - (a.importance || 0));
    const top5 = sorted.slice(0, 5);
    const bottom5 = sorted.slice(-5).reverse();
    let html = '<div style="margin-bottom:12px;font-weight:600">Quality Distribution — ' + ws + '</div>';
    html += '<div style="margin-bottom:16px"><div style="font-weight:600;margin-bottom:8px;color:var(--cyan)">Top 5 (by importance)</div>';
    top5.forEach(m => {
        html += `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:11px">
            <span>${m.pinned ? '📌 ' : ''}${m.title || 'untitled'}</span>
            <span style="color:var(--text-muted)">${(m.importance || 0).toFixed(2)}</span>
        </div>`;
    });
    html += '</div>';
    html += '<div><div style="font-weight:600;margin-bottom:8px;color:var(--red)">Bottom 5 (archive candidates)</div>';
    bottom5.forEach(m => {
        html += `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:11px">
            <span>${m.title || 'untitled'}</span>
            <span style="color:var(--text-muted)">${(m.importance || 0).toFixed(2)}</span>
        </div>`;
    });
    html += '</div>';
    box.innerHTML = html;
}

function initCMBReveal(root) {
    const scope = root || document;
    const els = scope.querySelectorAll('.cmb-reveal');
    if (!els.length) return;
    els.forEach(el => el.classList.add('hidden-reveal'));
    const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('hidden-reveal');
                obs.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    els.forEach(el => obs.observe(el));
}

document.addEventListener('DOMContentLoaded', () => initCMBReveal());
