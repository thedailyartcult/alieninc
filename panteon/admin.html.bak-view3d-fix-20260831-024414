    var mPre=getMap();
    var realB=mPre? getRealBuilding(mPre, Number(obj.lat), Number(obj.lng)) : null;
    if(realB && realB.properties) obj._featureProps=realB.properties;
    // derive ontology FIRST so floorLabels adapt (e.g., 2 vs 40 lvls)
    var ont=getBuildingOntology(obj, obj._featureProps||null);
    currentOntology=ont; try{ window.currentOntology=ont; }catch(e){}
    selectedObj=obj; activeFloor=(obj.floorLabels||ont.floorLabels)[0]||"G";
    const m=getMap(); if(m) ensureIndoorLayers();
    // resolve REAL footprint from 3D-buildings first, then stored footprint, then fallback
    let geom= realB ? realB.geometry : getRealFootprint(m, Number(obj.lat), Number(obj.lng));
    if(!geom && obj.footprint){
      try{
        if(obj.footprint.type) geom=obj.footprint;
        else{
          const isNested = Array.isArray(obj.footprint[0]) && Array.isArray(obj.footprint[0][0]) && Array.isArray(obj.footprint[0][0][0]);
          geom = isNested ? {type:'MultiPolygon',coordinates:obj.footprint} : {type:'Polygon',coordinates:Array.isArray(obj.footprint[0][0])?obj.footprint:[obj.footprint]};
        }
      }catch(e){ geom=null; }
      if(!geom && obj.footprint && obj.footprint.coordinates) geom=obj.footprint;
    }
    if(!geom && obj.footprintCoords) geom={type:'Polygon',coordinates:[obj.footprintCoords]};
    if(!geom){
      // FIX: synthesize rect around manual point object (14.5566,121.0519 h38) instead of distant OSM fallback
      if(isFinite(obj.lng) && isFinite(obj.lat)){
        var dLng=0.0004, dLat=0.00015; var cx=Number(obj.lng), cy=Number(obj.lat);
        geom={type:'Polygon',coordinates:[[[cx-dLng,cy-dLat],[cx+dLng,cy-dLat],[cx+dLng,cy+dLat],[cx-dLng,cy+dLat],[cx-dLng,cy-dLat]]]};
        console.warn('indoor: synthesized rect for point object at', obj.lat, obj.lng);
      } else {
        geom=GH_GEOM;
        console.warn('indoor: fallback GH_GEOM used — real building not found at', obj.lat, obj.lng);
      }
    } else if(geom && obj.footprint && JSON.stringify(geom).length < JSON.stringify(obj.footprint).length*0.6){
      // if real is much smaller than stored, keep stored (avoids picking tiny shed)
    }
    const h = Number(obj.height_m)|| (ont.totalFloors*ont.heightPerFloorM);
    indoorBaseGeom=geom;
    try{
      const src=m&&m.getSource('indoor-building'); if(src) src.setData({type:'FeatureCollection',features:[{type:'Feature',properties:{h},geometry:geom}]});
    }catch(e){}
    // isolate — hide every other object/marker, dim background
    isolateMap();
    document.getElementById('indoorHud')?.classList.add('visible');
    renderHud();
    // initialise panel image for this floor (keep per-floor image store, no map image source)
    if(!floorImages[activeFloor]) floorImages[activeFloor]=BLUEPRINTS[activeFloor]||BLUEPRINTS["G"];
    setFloor(activeFloor);
    // realistic textured building replaces green polygon when selected — investors see real GH, green box stays for unselected
    try{ showRealisticBuilding(geom, h); }catch(e){ console.warn('realistic show failed', e); }
    try{ if(m) m.flyTo({center:[Number(obj.lng),Number(obj.lat)], zoom:18.6, pitch:62, bearing:-12, duration:900}); }catch(e){}
    // lazy wire once + start humans if toggled on
    if(!enter._wired){ enter._wired=true; setTimeout(wireImageControls, 60); }
    if(humOn) startHumans();
  }
  function exit(){
    selectedObj=null; pendingPts=[]; isDragging=false; dragStart=null; indoorBaseGeom=null;
    const m=getMap(); if(m){
      try{ const src=m.getSource('indoor-building'); if(src) src.setData({type:'FeatureCollection',features:[]}); }catch(e){}
      try{ const fs=m.getSource('indoor-building-floor'); if(fs) fs.setData({type:'FeatureCollection',features:[]}); }catch(e){}
    }
    restoreMap();
    document.getElementById('indoorHud')?.classList.remove('visible');
  }
  function hook(){
    document.addEventListener('click', function(e){
      const flyBtn=e.target.closest('[data-ofly]'); if(flyBtn){
        const idx=parseInt(flyBtn.getAttribute('data-ofly'),10);
        try{
          const objs=(window.MAVEN&&MAVEN.state&&MAVEN.state.objects)||[];
          const o=objs[idx]; if(o){ setTimeout(()=>enter(o), 950); }
        }catch(err){}
      }
    });
    let tries=0; const iv=setInterval(()=>{
      const m=getMap(); if(!m){ if(++tries>80) clearInterval(iv); return; }
      if(!m.getLayer('maven-objs-vol')) return;
      clearInterval(iv);
      m.on('click','maven-objs-vol', (ev)=>{
        try{
          const feats=m.queryRenderedFeatures(ev.point,{layers:['maven-objs-vol','maven-objs-fill']});
          if(!feats||!feats.length) return;
          const objs=(window.MAVEN&&MAVEN.state&&MAVEN.state.objects)||[];
          let best=null, bestD=1e9;
          objs.forEach(o=>{
            const d=Math.hypot(Number(o.lng)-ev.lngLat.lng, Number(o.lat)-ev.lngLat.lat);
            if(d<bestD){ bestD=d; best=o; }
          });
          if(best && bestD<0.02) enter(best);
        }catch(err){}
      });
      m.on('mouseenter','maven-objs-vol',()=>{ try{m.getCanvas().style.cursor='pointer'}catch(e){} });
      m.on('mouseleave','maven-objs-vol',()=>{ try{if(!document.getElementById('indoorHud')?.classList.contains('visible')) m.getCanvas().style.cursor=''}catch(e){} });
    }, 600);
    document.addEventListener('keydown', (ev)=>{ if(ev.key==='Escape' && document.getElementById('indoorHud')?.classList.contains('visible')) exit(); });
    // also wire stage after DOM ready
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', wireImageControls); else setTimeout(wireImageControls, 300);
  }
  window.IndoorOps={enter, exit, setFloor, _traces:floorTraces, _images:floorImages};
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', hook); else hook();
})();
</script>
<script>
// === INDOOR 3D GH PANEL — isolated viewer (only Grand Hyatt), not MapLibre custom layer ===
(function(){
  let r=null, s=null, cam=null, ctrl=null, raf=null, model=null, badge=null, canvas=null;
  let loadedUrl=null;
  function ensure(){
    if(r) return;
    canvas = document.getElementById('indoor3D');
    badge = document.getElementById('indoor3DBadge');
    if(!canvas || typeof THREE==='undefined') { console.warn('indoor3D: no canvas or THREE'); return; }
    try{
      s = new THREE.Scene();
      s.background = new THREE.Color(0x020805);
      cam = new THREE.PerspectiveCamera(42, 900/640, 0.1, 2000);
      cam.position.set(160, 140, 160);
      r = new THREE.WebGLRenderer({canvas:canvas, antialias:true, alpha:true});
      r.setPixelRatio(window.devicePixelRatio||1);
      r.setSize(900,640,false);
      try{
        r.outputEncoding = THREE.sRGBEncoding;
        r.toneMapping = THREE.ACESFilmicToneMapping;
        r.toneMappingExposure = 1.05;
        r.physicallyCorrectLights = true;
      }catch(e){}
      // lights — bright for dark glass (was black on map)
      const dir = new THREE.DirectionalLight(0xffffff, 1.35); dir.position.set(180,220,160); s.add(dir);
      const dir2 = new THREE.DirectionalLight(0xffffff, 0.85); dir2.position.set(-120, 80, -140); s.add(dir2);
      const amb = new THREE.AmbientLight(0xffffff, 0.95); s.add(amb);
      const hemi = new THREE.HemisphereLight(0xffffff, 0x0a1e2e, 0.65); s.add(hemi);
      const point = new THREE.PointLight(0xDFF140, 0.7, 900); point.position.set(0, 180, 60); s.add(point);
      // grid helper
      try{ const grid=new THREE.GridHelper(520, 26, 0x00ffaa, 0x00ffaa); grid.material.opacity=0.12; grid.material.transparent=true; s.add(grid);}catch(e){}
      if(typeof THREE.OrbitControls !== 'undefined'){
        ctrl = new THREE.OrbitControls(cam, canvas);
        ctrl.enableDamping=true; ctrl.dampingFactor=0.08;
        ctrl.minDistance=40; ctrl.maxDistance=520; ctrl.target.set(0, 80, 0);
        ctrl.update();
      }
      // hover floor via raycast (GH 66F)
      try{
        const ray = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        let hoverPlane=null;
        function makeHoverPlane(){ if(hoverPlane) return; const g=new THREE.PlaneGeometry(520, 520); const m=new THREE.MeshBasicMaterial({color:0x00ffaa, transparent:true, opacity:0.0, side:THREE.DoubleSide, wireframe:false}); hoverPlane=new THREE.Mesh(g,m); hoverPlane.rotation.x=-Math.PI/2; hoverPlane.visible=false; s.add(hoverPlane); }
        makeHoverPlane();
        const tip=document.getElementById('indoorFloorTooltip');
        canvas.addEventListener('mousemove', function(e){
          if(!model){ if(tip) tip.style.display='none'; return; }
          const rect=canvas.getBoundingClientRect();
          mouse.x = ((e.clientX - rect.left)/rect.width)*2 -1;
          mouse.y = -((e.clientY - rect.top)/rect.height)*2 +1;
          ray.setFromCamera(mouse, cam);
          const hits = ray.intersectObject(model, true);
          if(hits && hits.length){
            const pt=hits[0].point;
            // model is centered at origin with base at 0 (after our lift), so y is height 0..180
            const h = pt.y;
            const hPer = 4.82; // GH 66F
            let idx = Math.floor(h / hPer);
            if(idx<0) idx=0; if(idx>65) idx=65;
            const ont = window.currentOntology || window.DEFAULT_ONTOLOGY || {floorLabels:['G']};
            // use GH labels (66) regardless of currentOntology if GH
            let labels = ont.floorLabels;
            // if labels <66 and is GH, use DEFAULT_ONTOLOGY 66
            if(labels.length < 66){
              try{ if(window.DEFAULT_ONTOLOGY && window.DEFAULT_ONTOLOGY.floorLabels.length===66) labels=window.DEFAULT_ONTOLOGY.floorLabels; }catch(e){}
            }
            const label = labels[idx] || ('L'+(idx+1));
            const floorY = idx * hPer;
            if(tip){ tip.textContent = label + ' · ' + floorY.toFixed(1) + 'm / 318m · HOVER — CLICK TO LOCK'; tip.style.display='block'; }
            if(hoverPlane){ hoverPlane.position.y = floorY + 0.3; hoverPlane.material.opacity=0.09; hoverPlane.visible=true; }
            canvas.style.cursor='crosshair';
          } else {
            if(tip) tip.style.display='none';
            if(hoverPlane) hoverPlane.visible=false;
            canvas.style.cursor='grab';
          }
        });
        canvas.addEventListener('mouseleave', function(){ const tp=document.getElementById('indoorFloorTooltip'); if(tp) tp.style.display='none'; if(hoverPlane) hoverPlane.visible=false; });
        canvas.addEventListener('click', function(e){
          if(!model) return;
          const rect=canvas.getBoundingClientRect();
          mouse.x = ((e.clientX - rect.left)/rect.width)*2 -1;
          mouse.y = -((e.clientY - rect.top)/rect.height)*2 +1;
          ray.setFromCamera(mouse, cam);
          const hits = ray.intersectObject(model, true);
          if(hits && hits.length){
            const pt=hits[0].point; const hPer=4.82; let idx=Math.floor(pt.y / hPer); if(idx<0) idx=0; if(idx>65) idx=65;
            const ont = window.currentOntology || window.DEFAULT_ONTOLOGY;
            let labels = ont.floorLabels; if(labels.length <66) try{ labels=window.DEFAULT_ONTOLOGY.floorLabels; }catch(e){}
            const label = labels[idx];
            if(label && typeof window.IndoorOps!=='undefined' && window.IndoorOps.setFloor){ try{ window.IndoorOps.setFloor(label); }catch(e){} }
            // also highlight map floor
            try{ if(typeof updateFloorHighlight==='function' && window.activeFloor===label) updateFloorHighlight(); }catch(e){}
          }
        });
      }catch(e){ console.warn('hover setup failed', e); }
      window.addEventListener('resize', ()=>{ try{ if(canvas && r){ const rect=canvas.getBoundingClientRect(); const w=rect.width||900, h=rect.height||640; r.setSize(w,h,false); cam.aspect=w/h; cam.updateProjectionMatrix(); }}catch(e){} });
      console.log('indoor3D: initialized');
    }catch(e){ console.warn('indoor3D ensure failed', e); }
  }
  function animate(){
    if(!r || !s || !cam) return;
    raf = requestAnimationFrame(animate);
    try{ if(ctrl) ctrl.update(); }catch(e){}
    try{ r.render(s, cam); }catch(e){}
  }
  function stop(){ if(raf) cancelAnimationFrame(raf); raf=null; }
  function show(obj){
    const isGH = obj && ((obj.name||'').toLowerCase().indexOf('grand hyatt')!==-1);
    if(!isGH){ hide(); return; }
    ensure();
    if(!r || !s) return;
    const cvs=document.getElementById('indoor3D');
    const bdg=document.getElementById('indoor3DBadge');
    if(cvs) cvs.classList.add('gh-visible');
    if(bdg) bdg.classList.add('on');
    // hide 2D blueprint behind 3D when GH (keep trace canvas below)
    try{ const img=document.getElementById('indoorImg'); if(img) img.style.opacity='0.08'; }catch(e){}
    // load GLB once
    const url='/static/models/grandhyatt.glb';
    if(model && loadedUrl===url){ if(!raf) animate(); return; }
    if(typeof THREE.GLTFLoader==='undefined'){ console.warn('indoor3D: GLTFLoader missing'); return; }
    console.log('indoor3D: loading', url);
    if(bdg) bdg.textContent='GH 3D — LOADING…';
    const loader=new THREE.GLTFLoader();
    loader.load(url, function(gltf){
      try{
        const scene=gltf.scene||gltf.scenes[0];
        if(!scene) throw new Error('no scene');
        // center + scale to ~180m tall visible (box 321 -> 180)
        const box=new THREE.Box3().setFromObject(scene);
        const size=new THREE.Vector3(); box.getSize(size);
        const center=new THREE.Vector3(); box.getCenter(center);
        const targetH=180; // requested visible GH
        const scaleFactor= targetH / (size.y||321);
        scene.position.sub(center);
        // lift base to ground: after sub(center), base = box.min.y - center.y = -size.y/2 (~ -160); after scale, base = -size.y/2 * scaleFactor (~ -90)
        // add half scaled height to put base at 0
        scene.position.y += (size.y/2 * scaleFactor);
        scene.scale.set(scaleFactor, scaleFactor, scaleFactor);
        // keep original materials bright — don't overwrite with window texture
        scene.traverse(function(o){
          if(o.isMesh && o.material){
            try{
              const mats=Array.isArray(o.material)?o.material:[o.material];
              mats.forEach(function(m){
                // true-color: preserve authored PBR, no emissive tint — only fix doubleSide for transparent
                if(m.transparent) m.side=THREE.DoubleSide;
                // keep roughness/metalness as authored; just ensure sRGB
                if(m.map) try{ m.map.encoding=THREE.sRGBEncoding; }catch(e){}
                m.needsUpdate=true;
              });
            }catch(e){}
          }
        });
        // remove old model
        if(model) try{ s.remove(model); }catch(e){}
        model=scene;
        s.add(model);
        loadedUrl=url;
        // frame camera
        try{
          const b2=new THREE.Box3().setFromObject(model);
          const sz=new THREE.Vector3(); b2.getSize(sz);
          const cen=new THREE.Vector3(); b2.getCenter(cen);
          if(ctrl){ ctrl.target.copy(cen); ctrl.target.y = sz.y*0.42; }
          cam.position.set(cen.x+ 220, cen.y + 140, cen.z + 220);
          cam.lookAt(cen);
          if(ctrl) ctrl.update();
        }catch(e){}
        if(bdg) bdg.textContent='GH 3D — DRAG TO ORBIT · SCROLL TO ZOOM';
        console.log('indoor3D: GH loaded, size', size, 'scale', scaleFactor);
        if(!raf) animate();
      }catch(e){ console.warn('indoor3D process failed', e); if(bdg) bdg.textContent='GH 3D — LOAD FAILED'; }
    }, undefined, function(err){
      console.warn('indoor3D load failed', err);
      const bdg2=document.getElementById('indoor3DBadge');
      if(bdg2) bdg2.textContent='GH 3D — FAILED (fallback to 2D)';
    });
    if(!raf) animate();
  }
  function hide(){
    const cvs=document.getElementById('indoor3D');
    const bdg=document.getElementById('indoor3DBadge');
    if(cvs) cvs.classList.remove('gh-visible');
    if(bdg) bdg.classList.remove('on');
    try{ const img=document.getElementById('indoorImg'); if(img) img.style.opacity='0.92'; }catch(e){}
    stop();
  }
  // hook into existing IndoorOps
  const origEnter = window.IndoorOps && window.IndoorOps.enter;
  const origExit = window.IndoorOps && window.IndoorOps.exit;
  if(origEnter){
    window.IndoorOps.enter = function(obj){
      try{ origEnter.call(this, obj); }catch(e){ console.warn('orig enter err', e); }
      try{ show(obj); }catch(e){ console.warn('indoor3D show err', e); }
    };
  }
  if(origExit){
    window.IndoorOps.exit = function(){
      try{ origExit.call(this); }catch(e){}
      try{ hide(); }catch(e){}
    };
  }
  // also hide map overlay realistic-gh for GH to avoid black double
  // monkey-patch showRealisticBuilding to no-op for GH (keep for other buildings if needed)
  const prevShow = window.showRealisticBuilding;
  if(typeof prevShow==='function'){
    window.showRealisticBuilding = function(geom, height){
      try{
        // if GH panel is active, skip map overlay (was black)
        const sel = window.IndoorOps && document.getElementById('indoorHud')?.classList.contains('visible');
        const isGHPanel = document.getElementById('indoor3D')?.classList.contains('gh-visible');
        if(sel && isGHPanel) { console.log('showRealisticBuilding skipped — indoor3D active'); return; }
      }catch(e){}
      return prevShow.apply(this, arguments);
    };
  }
  window._indoor3D = {show, hide, ensure};
  console.log('indoor3D: hook installed');
})();
</script>
