<script id="topbar-hill-engine">
(function(){
  const canvas=document.getElementById('topbarHill');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  let dpr=window.devicePixelRatio||1, W=0, H=0, time=0;
  let mx=0, targetMx=0;
  function resize(){
    const r=canvas.parentElement.getBoundingClientRect();
    W=r.width; H=r.height;
    canvas.width=Math.floor(W*dpr); canvas.height=Math.floor(H*dpr);
    canvas.style.width=W+'px'; canvas.style.height=H+'px';
    ctx.setTransform(1,0,0,1,0,0); ctx.scale(dpr,dpr);
  }
  resize(); window.addEventListener('resize', resize);
  const topbar=canvas.parentElement;
  topbar.addEventListener('mousemove', e=>{
    const r=topbar.getBoundingClientRect();
    targetMx=((e.clientX - r.left)/r.width -0.5)*2;
  });
  topbar.addEventListener('mouseleave', ()=>{ targetMx=0; });
  function lerp(a,b,t){return a+(b-a)*t;}
  function hillColors(){
    const mode=document.documentElement.getAttribute('data-theme');
    if(mode==='light') return {fills:['rgba(0,0,0,0.08)','rgba(0,0,0,0.04)'],strokes:['rgba(0,0,0,0.14)','rgba(0,0,0,0.08)']};
    if(mode==='constan'){
      const cs=getComputedStyle(document.documentElement);
      const acc=cs.getPropertyValue('--accent-neon').trim()||'rgb(249,138,40)';
      const m=acc.match(/\d+/g); const r=m?m[0]:249,g=m?m[1]:138,b=m?m[2]:40;
      return {fills:[`rgba(${r},${g},${b},0.14)`,`rgba(${r},${g},${b},0.06)`],strokes:[`rgba(${r},${g},${b},0.55)`,`rgba(${r},${g},${b},0.28)`]};
    }
    return {fills:['rgba(223,241,64,0.14)','rgba(223,241,64,0.06)'],strokes:['rgba(223,241,64,0.55)','rgba(223,241,64,0.28)']};
  }
  function draw(){
    time+=0.015;
    mx=lerp(mx,targetMx,0.08);
    ctx.clearRect(0,0,W,H);
    // hill water - double valley (like you imagined tree hill)
    // base hill Y 18 + two sines for water motion
    function hillY(x, phase){
      return 18 + Math.sin(x*0.012 + time*0.9 + phase)*6 + Math.sin(x*0.025 + time*0.6 + phase*0.7)*3 + mx*6;
    }
    // clip to bar bounds with rounded bottom via path
    // draw water fill layers
    const phases=[0, Math.PI*0.6];
    const {fills,strokes}=hillColors();
    for(let li=0; li<2; li++){
      const phase=phases[li];
      ctx.beginPath();
      ctx.moveTo(0, H);
      ctx.lineTo(0, hillY(0, phase) + li*6);
      for(let x=0; x<=W; x+=8){
        ctx.lineTo(x, hillY(x, phase) + li*6);
      }
      ctx.lineTo(W, H);
      ctx.closePath();
      ctx.fillStyle=fills[li];
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(0, hillY(0, phase) + li*6);
      for(let x=0; x<=W; x+=8){
        ctx.lineTo(x, hillY(x, phase) + li*6);
      }
      ctx.strokeStyle=strokes[li];
      ctx.lineWidth=1.5;
      ctx.stroke();
    }
    requestAnimationFrame(draw);
  }
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
  else {
    // static hill if reduced motion — follows current theme
    time=0; 
    const phase=0;
    const sc=hillColors();
    ctx.clearRect(0,0,W,H);
    ctx.beginPath(); ctx.moveTo(0,H); ctx.lineTo(0,18);
    for(let x=0;x<=W;x+=8) ctx.lineTo(x, 18 + Math.sin(x*0.012)*6);
    ctx.lineTo(W,H); ctx.closePath();
    ctx.fillStyle=sc.fills[1]; ctx.fill();
  }
})();
</script>

<script id="shared-hill-engine">
(function(){
  const canvas=document.getElementById('sharedHill');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  let dpr=window.devicePixelRatio||1, W=0, H=0, time=0, mx=0, targetMx=0;
  function resize(){
    const r=canvas.parentElement.getBoundingClientRect();
    W=r.width; H=r.height;
    canvas.width=Math.floor(W*dpr); canvas.height=Math.floor(H*dpr);
    canvas.style.width=W+'px'; canvas.style.height=H+'px';
    ctx.setTransform(1,0,0,1,0,0); ctx.scale(dpr,dpr);
  }
  resize(); window.addEventListener('resize', resize);
  const app=canvas.parentElement;
  app.addEventListener('mousemove', e=>{
    const r=app.getBoundingClientRect();
    targetMx=((e.clientX - r.left)/r.width -0.5)*2;
  });
  app.addEventListener('mouseleave', ()=>{ targetMx=0; });
  function lerp(a,b,t){return a+(b-a)*t;}
  function hillColors(){
    const mode=document.documentElement.getAttribute('data-theme');
    if(mode==='light') return {fills:['rgba(0,0,0,0.06)','rgba(0,0,0,0.03)'],strokes:['rgba(0,0,0,0.20)','rgba(0,0,0,0.10)']};
    if(mode==='constan'){
      const cs=getComputedStyle(document.documentElement);
      const acc=cs.getPropertyValue('--accent-neon').trim()||'rgb(249,138,40)';
      const m=acc.match(/\d+/g); const r=m?m[0]:249,g=m?m[1]:138,b=m?m[2]:40;
      return {fills:[`rgba(${r},${g},${b},0.10)`,`rgba(${r},${g},${b},0.04)`],strokes:[`rgba(${r},${g},${b},0.45)`,`rgba(${r},${g},${b},0.22)`]};
    }
    return {fills:['rgba(223,241,64,0.10)','rgba(223,241,64,0.04)'],strokes:['rgba(223,241,64,0.45)','rgba(223,241,64,0.22)']};
  }
  function hillY(x, phase, t){
    return 28 + Math.sin(x*0.012 + t*0.9 + phase)*6 + Math.sin(x*0.025 + t*0.6 + phase*0.7)*3;
  }
  function draw(){
    time+=0.015;
    mx=lerp(mx,targetMx,0.08);
    ctx.clearRect(0,0,W,H);
    // Topbar hill + pour
    // Topbar at y 12, height 72, hill at y 12+28
    const topY=12, topH=72;
    const hillBase = topY + 30; // hill baseline inside topbar
    // Draw two water layers for top hill
    const phases=[0, Math.PI*0.6];
    const {fills,strokes}=hillColors();
    // Top hill across
    for(let li=0; li<2; li++){
      const phase=phases[li];
      ctx.beginPath();
      // start at left edge of topbar hill
      const startX=24, endX=W-24;
      ctx.moveTo(startX, topY+topH);
      ctx.lineTo(startX, hillBase + Math.sin(startX*0.012 + time*0.9 + phase)*6 + Math.sin(startX*0.025 + time*0.6 + phase*0.7)*3 + mx*4 + li*5);
      for(let x=startX; x<=endX; x+=8){
        const y= hillBase + Math.sin(x*0.012 + time*0.9 + phase)*6 + Math.sin(x*0.025 + time*0.6 + phase*0.7)*3 + mx*4 + li*5;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(endX, topY+topH);
      ctx.closePath();
      ctx.fillStyle=fills[li];
      ctx.fill();
      ctx.beginPath();
      for(let x=startX; x<=endX; x+=8){
        const y= hillBase + Math.sin(x*0.012 + time*0.9 + phase)*6 + Math.sin(x*0.025 + time*0.6 + phase*0.7)*3 + mx*4 + li*5;
        if(x===startX) ctx.moveTo(x,y); else ctx.lineTo(x,y);
      }
      ctx.strokeStyle=strokes[li];
      ctx.lineWidth=1.5;
      ctx.stroke();
    }
    // Vertical river pour from hill left valley into sidebar
    // Sidebar at x 24, y 84, width 240
    const sx=24 + 12; // center of left edge channel
    const sy=topY+topH; // pour start at bottom of topbar
    const ey=H*0.85; // down to near bottom
    // Draw wavy river channel 1.5px wide
    ctx.beginPath();
    for(let y=sy; y<=ey; y+=4){
      const wx = sx + Math.sin(y*0.04 + time*0.8)*2.5 + mx*2;
      if(y===sy) ctx.moveTo(wx, y); else ctx.lineTo(wx, y);
    }
    ctx.strokeStyle=isLight() ? 'rgba(0,0,0,0.18)' : 'rgba(223,241,64,0.28)';
    ctx.lineWidth=1.5;
    ctx.stroke();
    // Branches to nav items - faint tributaries
    ctx.strokeStyle=isLight() ? 'rgba(0,0,0,0.10)' : 'rgba(223,241,64,0.14)';
    ctx.lineWidth=1;
    // draw 3 tributaries at different y
    for(let yi of [140, 210, 280]){
      if(yi>ey) continue;
      ctx.beginPath();
      const wx = sx + Math.sin(yi*0.04 + time*0.8)*2.5 + mx*2;
      ctx.moveTo(wx, yi);
      ctx.lineTo(wx+18 + Math.sin(yi*0.03+time*0.5)*2, yi);
