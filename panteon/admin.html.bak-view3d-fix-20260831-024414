// Verification-first guard for the background pull. Returns the verified query
// config or null if the query is invalid / unverified. Used by renderThreatMap
// and any other path that starts a GDELT pull.
async function gkgEnsureVerified(query, maxrecords) {
    const config = { query: query, mode: 'events', timespan: '24h', maxrecords: maxrecords || 50, api_key: '' };
    // Structural check first (no network).
    const res = validateQuerySyntax(query);
    if (res.errors.length) {
        renderGkgValidation({ valid: false, errors: res.errors, warnings: res.warnings, live: 'skipped' });
        return null;
    }
    // Live probe (cached server-side for 120s, so re-rendering is cheap).
    try {
        const result = await api('/gkg/pipeline/validate', { method: 'POST', body: JSON.stringify(config) });
        renderGkgValidation(result);
        refreshGkgBudget();
        return result.valid ? config : null;
    } catch (e) {
        renderGkgValidation({ valid: false, errors: [], warnings: [], live: 'probed', error_kind: 'generic', message: e.message || 'validate failed' });
        refreshGkgBudget();
        return null;
    }
}

// Classify an event's threat level. The active query intent is used first
// (query == classifier, since DOC 2.0 has no per-article tone/theme); tone is
// used when present; headline keywords are the last fallback.
function classifyEvent(ev) {
    if (threatQueryIntent === "attack") return "red";
    if (threatQueryIntent === "protest") return "amber";
    const tone = parseFloat(ev.avg_tone);
    if (!isNaN(tone)) {
        if (tone < -5) return "red";
        if (tone < 0) return "amber";
    }
    const title = (ev.title || "").toLowerCase();
    const evt = (ev.event_type || "").toLowerCase();
    const hay = title + " " + evt;
    if (hay.trim()) {
        for (const w of CONFLICT_KEYWORDS.violence) if (hay.includes(w)) return "red";
        for (const w of CONFLICT_KEYWORDS.coerce) if (hay.includes(w)) return "amber";
        for (const w of CONFLICT_KEYWORDS.protest) if (hay.includes(w)) return "amber";
        for (const w of CONFLICT_KEYWORDS.arrest) if (hay.includes(w)) return "amber";
    }
    return "green";
}

// Threat tier for an event, honoring tone first then headline classification.
function threatLevelForEvent(ev) {
    return classifyEvent(ev);
}

// Extract searchable bare terms from a GDELT DOC query (strip operators/quotes).
function queryTerms(query) {
    const q = (query || "").toLowerCase();
    if (!q) return [];
    const ops = q.replace(/\b(theme|sourcecountry|sourcelang|domain|domainis|tone|sourcelang|sort|mode|format|timespan|maxrecords|startdatetime|enddatetime|timelinesmooth|near|repeat|imagetag|imagewebtag|imagewebcount|imagefacetone|imagenumfaces|imageocrmeta|trans|googtrans|date)\b:[^\s]+/gi, " ");
    const cleaned = ops.replace(/[\(\)"\-\*<>]/g, " ");
    return Array.from(new Set(cleaned.split(/\s+/).filter(t => t.length > 2)));
}

// Does a stored event match the current query (term OR, case-insensitive on title/domain/country/event_type)?
function matchesQuery(ev, terms, query) {
    if (!terms || !terms.length) return true;
    const hay = [ev.title, ev.domain, ev.sourcecountry, ev.event_type, ev.url].join(" ").toLowerCase();
    return terms.some(t => hay.includes(t));
}

function computeIntelMetrics(events) {
    const geoCoded = events.filter(e => parseActionGeo(e));
    const threatEvents = events.filter(e => { const t = threatLevelForEvent(e); return t === 'red' || t === 'amber'; });
    const red = events.filter(e => threatLevelForEvent(e) === 'red');
    const total = events.length || 1;
    const articles = events.reduce((s, e) => s + (parseFloat(e.num_articles) || 0), 0);
    let geoSpread = 0;
    if (geoCoded.length >= 2) {
        const lats = geoCoded.map(e => parseActionGeo(e).latitude);
        const lngs = geoCoded.map(e => parseActionGeo(e).longitude);
        geoSpread = Math.min(1, (Math.max(...lats) - Math.min(...lats) + Math.max(...lngs) - Math.min(...lngs)) / 180);
    }
    const toneMean = events.length ? events.reduce((s, e) => s + (parseFloat(e.avg_tone) || 0), 0) / events.length : 0;
    const systemic = clamp01(0.15 + 0.6 * (threatEvents.length / total) + 0.25 * Math.min(1, events.length / 25));
    const propagation = clamp01(0.15 + 0.5 * Math.min(1, events.length / 20) + 0.35 * geoSpread);
    const sensitivity = clamp01(0.15 + 0.55 * Math.min(1, articles / 800) + 0.3 * Math.min(1, Math.abs(toneMean) / 10));
    return {
        systemic: systemic.toFixed(2),
        propagation: propagation.toFixed(2),
        sensitivity: sensitivity.toFixed(2),
        total: events.length,
        geoCoded: geoCoded.length,
        negative: threatEvents.length,
        red: red.length,
        articles: Math.round(articles),
    };
}

