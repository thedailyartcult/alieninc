async function doLogout(opts = {}) {
    const hard = opts.hard !== false; // user-initiated default
    try { if (hard) await supabaseClient.auth.signOut(); } catch (_) {}
    clearLocalSession();
    if (refreshInterval) clearInterval(refreshInterval);
