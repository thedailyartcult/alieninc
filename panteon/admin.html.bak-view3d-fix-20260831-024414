    function drawGeo() {
        ensureLayers();
        var feats = [];
        S.state.tasks.forEach(function (t) {
            if (t.aoi_lat == null) return;
            if (!isFinite(Number(t.aoi_lat)) || !isFinite(Number(t.aoi_lng))) return;
            feats.push({ type: 'Feature', properties: { name: t.name },
                geometry: { type: 'Polygon', coordinates: [circlePoly(t.aoi_lat, t.aoi_lng, t.aoi_radius_km || 25)] } });
        });
        var aoiSig = feats.map(function (f) { return f.properties.name; }).join('|');
        if (aoiSig !== drawGeo.__last) {
            drawGeo.__last = aoiSig;
            setData('maven-aoi', feats);
        }
        var orbits = [];
        S.state.assets.forEach(function (a) {
            if (a.state === 'on-station' && a.orbit_radius_deg &&
                isFinite(a.lat) && isFinite(a.lng)) {
                orbits.push({ type: 'Feature', properties: { name: a.callsign },
                    geometry: { type: 'LineString',
                        coordinates: circlePoly(a.lat, a.lng,
                            a.orbit_radius_deg * 111.32, 96) } });
            }
        });
        var orbSig = orbits.map(function (f) { return f.properties.name; }).join('|');
        if (orbSig !== (drawGeo.__orbLast || '')) {
            drawGeo.__orbLast = orbSig;
            setData('maven-orbits', orbits);
        }
        if ((drawGeo.__fovN = (drawGeo.__fovN || 0) + 1) % 3) return;
        var fov = [];
        S.state.assets.forEach(function (a) {
            if (a.state === 'transit' && a.heading_deg != null &&
                isFinite(a.lat) && isFinite(a.lng) && a.detect_radius_km)
                fov.push({ type: 'Feature', properties: {},
                    geometry: { type: 'Polygon', coordinates: [fovPoly(a.lat, a.lng, a.heading_deg, a.detect_radius_km)] } });
        });
        setData('maven-fov', fov);
    }
    function drawObjs() {
        ensureLayers();
        var feats = [];
        S.state.objects.forEach(function (o, i) {
            var g = fpGeom(o.footprint);
            if (!g) return;
            feats.push({ type: 'Feature', id: i, properties: { name: o.name || '', h: Number(o.height_m) || 15 }, geometry: g });
        });
        var sig = feats.map(function (f) { return f.id + '~' + f.properties.name; }).join('|');
        if (sig === drawObjs.__last) return;
        drawObjs.__last = sig;
        setData('maven-objs', feats);
    }

    /* --------------------------------------------------- scout (person) ---- */
    // Physics-bound scout: small dot/person spawned by PICK TARGET, walks
    // with constant speed + heading lerp, draws live viewpoint cone.
    function scoutHaversineKm(lat1, lng1, lat2, lng2) {
        var R = 6371.0088, dLat = (lat2 - lat1) * Math.PI / 180, dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
        return R * 2 * Math.asin(Math.sqrt(a));
    }
    function scoutBearingDeg(lat1, lng1, lat2, lng2) {
        var y = Math.sin((lng2 - lng1) * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180);
        var x = Math.cos(lat1 * Math.PI / 180) * Math.sin(lat2 * Math.PI / 180) - Math.sin(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.cos((lng2 - lng1) * Math.PI / 180);
        var br = Math.atan2(y, x) * 180 / Math.PI;
        return (br + 360) % 360;
    }
    function drawScoutFov() {
        if (!S.scout || !S.overlays) { try { setData('scout-fov', []); } catch (e) {} return; }
        ensureLayers();
        var pts = fovPoly(S.scout.lat, S.scout.lng, S.scout.hdg, (S.scout.radius_m || 250) / 1000);
        setData('scout-fov', [{ type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [pts] } }]);
    }
    function ensureScoutMarker() {
        var m = getMap();
        if (!m || !S.scout) return null;
        if (!S.scoutMarker) {
            var el = svgFrame('scout');
            el.style.transition = 'transform 0.12s linear';
            el.title = 'SCOUT · ' + Number(S.scout.lat).toFixed(4) + ' ' + Number(S.scout.lng).toFixed(4);
            S.scoutMarker = new maplibregl.Marker({ element: el, anchor: 'center' })
                .setLngLat([S.scout.lng, S.scout.lat]).addTo(m);
            // click scout to clear
            el.addEventListener('click', function (e) { e.stopPropagation(); clearScout(); });
        }
        return S.scoutMarker;
    }
    function updateScoutMarker() {
        if (!S.scout || !S.scoutMarker) return;
        try {
            S.scoutMarker.setLngLat([S.scout.lng, S.scout.lat]);
            var el = S.scoutMarker.getElement();
            if (el && el.firstChild) {
                // rotate heading tick to true north
                var inner = el.firstChild;
                if (inner && inner.style) inner.style.transform = 'rotate(' + S.scout.hdg + 'deg)';
                inner.style.transformOrigin = '12px 12px';
            }
            el.title = 'SCOUT ' + S.scout.hdg.toFixed(0) + '° · ' + (S.scout.moving ? 'MOVING' : 'IDLE') +
                ' · r=' + Math.round(S.scout.radius_m) + 'm · ' + Number(S.scout.lat).toFixed(4) + 'N ' + Number(S.scout.lng).toFixed(4) + 'E';
        } catch (e) {}
        drawScoutFov();
        // throttle YONO viewshed to ~1 per 900ms after motion pauses or every 2s while moving
        var now = Date.now();
        if (S.scout && now - (S._scoutLastViewshed || 0) > (S.scout.moving ? 2200 : 900)) {
            S._scoutLastViewshed = now;
            // fire-and-forget terrain viewshed (Luzon-px) — no await in tick
            try { scoutRequestYonoViewshed(); } catch (e) {}
        }
    }
    function scoutRequestYonoViewshed() {
        if (!S.scout) return;
        // Only if global TerrainFX viewshed layer exists, reuse it; also try YONO tool
        // We do lightweight fetch to geo_viewshed via backend if available — ignore failure
        var lat = S.scout.lat, lng = S.scout.lng, alt = S.scout.alt_agl || 1.7, rad = Math.min(5000, Math.max(300, S.scout.radius_m || 250));
        // Use backend ontology geo tool via fetch if endpoint exists; else skip gracefully
        try {
            if (window.YonoAgent && typeof window.YonoAgent.ask === 'function' && rad >= 300) {
                // don't spam LLM: only when scout stops
                if (S.scout.moving) return;
            }
            // direct geo_viewshed attempt (optional)
            if (typeof fetch === 'function') {
                fetch('/api/yono/geo_viewshed', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lat: lat, lon: lng, alt_agl_m: alt, radius_m: rad }) })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (j) {
                        if (j && j.directive && j.directive.polygon && window.TerrainFX && window.TerrainFX.drawViewshed) {
                            try { window.TerrainFX.drawViewshed(j.directive); } catch (e2) {}
                        }
                    }).catch(function () {});
            }
        } catch (e) {}
    }
    function startScoutTick() {
        if (S.scoutTimer) return;
        var last = Date.now();
        S.scoutTimer = setInterval(function () {
            if (!S.scout || !S.scout.moving) return;
            var now = Date.now(), dt = Math.max(0.02, Math.min(0.4, (now - last) / 1000));
            last = now;
            var distKm = scoutHaversineKm(S.scout.lat, S.scout.lng, S.scout.targetLat, S.scout.targetLng);
            if (distKm < 0.003) { // <3m snap
                S.scout.lat = S.scout.targetLat; S.scout.lng = S.scout.targetLng;
                S.scout.moving = false;
                updateScoutMarker();
                // clear moving flag UI
                var sb = document.getElementById('mavenScoutBtn');
                if (sb) sb.textContent = 'SCOUT: IDLE';
                return;
            }
            var wantHdg = scoutBearingDeg(S.scout.lat, S.scout.lng, S.scout.targetLat, S.scout.targetLng);
            var diff = ((wantHdg - S.scout.hdg + 540) % 360) - 180;
            S.scout.hdg = (S.scout.hdg + diff * Math.min(1, dt * 4.5) + 360) % 360;
            var stepKm = (S.scout.speed_mps || 1.4) * dt / 1000;
            var frac = Math.min(1, stepKm / Math.max(0.0001, distKm));
            // linear interpolate on sphere approx — good at street scale
            S.scout.lat += (S.scout.targetLat - S.scout.lat) * frac;
            S.scout.lng += (S.scout.targetLng - S.scout.lng) * frac;
            updateScoutMarker();
        }, 80);
    }
    function stopScoutTick() {
        if (S.scoutTimer) { clearInterval(S.scoutTimer); S.scoutTimer = null; }
    }
    function deployScoutAt(lat, lng, bname, bheight) {
        ensureLayers();
        var isNew = !S.scout;
        var prev = S.scout ? { lat: S.scout.lat, lng: S.scout.lng } : null;
        S.scout = S.scout || { lat: lat, lng: lng, hdg: 0, targetLat: lat, targetLng: lng, moving: false, speed_mps: 1.4, radius_m: 250, fov_deg: 60, alt_agl: 1.7 };
        if (isNew) {
            S.scout.lat = lat; S.scout.lng = lng; S.scout.hdg = 0;
            S.scout.targetLat = lat; S.scout.targetLng = lng; S.scout.moving = false;
        } else {
            // retarget — walk, don't teleport
            S.scout.targetLat = lat; S.scout.targetLng = lng;
            var dKm = scoutHaversineKm(S.scout.lat, S.scout.lng, lat, lng);
            if (dKm > 0.005) { // >5m requires walk
                S.scout.moving = true;
                S.scout.hdg = scoutBearingDeg(S.scout.lat, S.scout.lng, lat, lng);
                var sb = document.getElementById('mavenScoutBtn');
                if (sb) sb.textContent = 'SCOUT: MOVING → ' + (bname ? bname.slice(0, 14).toUpperCase() : (lat.toFixed(3) + ',' + lng.toFixed(3)));
                startScoutTick();
            } else {
                S.scout.moving = false;
            }
        }
        S.scout.alt_agl = (bheight && bheight > 4) ? Math.min(40, bheight + 1.7) : 1.7;
        ensureScoutMarker();
        updateScoutMarker();
        // also select tasks tab so user sees button
        try { if (typeof selectTab === 'function') selectTab('tasks'); } catch (e) {}
        // optional auto-ask YONO once placed
        setTimeout(function () { try { scoutRequestYonoViewshed(); } catch (e) {} }, 320);
        // if first deploy, fly to him
        if (isNew) { try { flyTo(lat, lng, 16); } catch (e) {} }
        // render id if HUD exists
        try { renderScoutHud(); } catch (e) {}
    }
    function renderScoutHud() {
        var el = document.getElementById('mavenScoutHud');
        if (!el) return;
        if (!S.scout) { el.classList.add('maven-hidden'); return; }
        el.classList.remove('maven-hidden');
        el.innerHTML = '<div class="maven-row" style="border-left:3px solid #DFF140"><b>SCOUT</b> ' +
            '<span class="maven-chip ' + (S.scout.moving ? 'medium' : 'ok') + '">' + (S.scout.moving ? 'MOVING' : 'IDLE') + '</span>' +
            '<span class="maven-chip low">' + S.scout.hdg.toFixed(0) + '°</span>' +
            '<br><span class="mv-sub">' + Number(S.scout.lat).toFixed(4) + 'N ' + Number(S.scout.lng).toFixed(4) + 'E · r=' + Math.round(S.scout.radius_m) + 'm · ' + S.scout.fov_deg + '°</span>' +
            '<div class="maven-det-actions" style="gap:4px;flex-wrap:wrap">' +
