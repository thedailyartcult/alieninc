    async function promotePlaceToObjects(p) {
        var m = getMap();
        var footprint = null, bheight = null, lat = p.lat, lng = p.lng;
        if (m) {
            try {
                var pt = m.project([p.lng, p.lat]);
                var fs = m.queryRenderedFeatures([pt.x, pt.y], { layers: ['3d-buildings'] });
                if (fs && fs.length) {
                    footprint = fs[0].geometry || null;
                    bheight = Number(fs[0].properties && (fs[0].properties.height || fs[0].properties.render_height)) || null;
                    var c = geomCentroid(footprint);
                    if (c) { lat = c.lat; lng = c.lng; }
                }
            } catch (e) {}
        }
        await api('/maven/object', { method: 'POST', body: JSON.stringify({
            name: p.name, lat: lat, lng: lng, height_m: bheight,
            footprint: footprint ? footprint.coordinates : null
        })});
        refresh();
    }
