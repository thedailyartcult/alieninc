async function runGdeltPipeline() {
    const btn = event && event.target;
    const status = document.getElementById('gdeltRunStatus');
    const q = document.getElementById('gdeltQuery').value.trim() || '("military" OR "defense" OR "security")';
    const timespan = document.getElementById('gdeltTimespan').value.trim() || '1m';
    const max = Math.min(parseInt(document.getElementById('gdeltMax').value) || 50, 250);
    const mode = document.getElementById('gdeltMode').value || 'artlist';
    if (btn) btn.disabled = true;
    status.innerHTML = '<span class="loading"></span> Running GDELT pipeline (may take a few seconds due to rate limiting)...';
    try {
        const rep = await api('/gdelt/pipeline/run', {
            method: 'POST',
            body: JSON.stringify({ query: q, mode: mode, timespan: timespan, maxrecords: max, api_key: '' }),
        });
        if (mode === 'tonechart') {
            status.innerHTML = 'Done: <b>' + rep.gdelt.records_fetched + '</b> fetched, <b>' + rep.transform.valid_count +
                '</b> valid, <b>' + rep.writeback.success_count + '</b> written (tx ' +
                rep.writeback.transaction_id.slice(0, 8) + '). Tones analyzed: sentiment, anger, fear, joy, sadness.';
        } else if (mode === 'wordcloudenglish' || mode === 'wordcloudimagetags') {
            status.innerHTML = 'Done: <b>' + rep.gdelt.records_fetched + '</b> fetched, <b>' + rep.transform.valid_count +
                '</b> valid, <b>' + rep.writeback.success_count + '</b> written (tx ' +
                rep.writeback.transaction_id.slice(0, 8) + '). Word frequencies updated.';
        } else if (mode === 'imagecollageshare') {
            status.innerHTML = 'Done: <b>' + rep.gdelt.records_fetched + '</b> fetched, <b>' + rep.transform.valid_count +
                '</b> valid, <b>' + rep.writeback.success_count + '</b> written (tx ' +
                rep.writeback.transaction_id.slice(0, 8) + '). Sharing metrics updated.';
        } else {
            status.innerHTML = 'Done: <b>' + rep.gdelt.records_fetched + '</b> fetched, <b>' + rep.transform.valid_count +
                '</b> valid, <b>' + rep.writeback.success_count + '</b> written (tx ' +
                rep.writeback.transaction_id.slice(0, 8) + '). GDELT rate-limits to ~1 req/5s.';
        }
    } catch (e) {
        status.innerHTML = '<b style="color:#ef4444">Pipeline error:</b> ' + (e.message || 'unknown') +
            '. GDELT enforces ~1 request per 5 seconds; retries are automatic.';
    } finally {
        if (btn) btn.disabled = false;
        loadGdeltSnapshot();
    }
}

