            setGhost(null);
            S._pickLastKey=null;
            try{ if(window.LZDZ) window.LZDZ.clearHover(); }catch(e){}
            if (S._hovId != null) {
                try { m.setFeatureState({ source: 'maven-objs', id: S._hovId }, { hover: false }); } catch (e) {}
