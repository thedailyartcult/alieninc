    // buttons / links / tiles / chips — synthesize from visible label
    const isHoverable = el.matches
      ? el.matches('button, a, [role="button"], select, input, textarea, .sc-hud-tile, .hive-mini, .hive-pent, .mfeat-btn, .maven-btn, .mss-mode-card, .btn, .gaia-chip, .deck-tab, .tb-tab, .nav-item, [data-mtab], [data-mfeat], [data-mss]')
      : false;
    if(isHoverable || el.closest && el.closest('button, a')){
      // try button text
      let txt=(el.textContent||'').replace(/\s+/g,' ').trim();
      // for tiles, prefer label child
      if(el.classList && el.classList.contains('sc-hud-tile')){
        const lbl=el.querySelector('.sc-hud-label, .hm-lbl');
