        if (el) el.innerHTML = result.valid
            ? '<span style="color:var(--green)">✓ GDELT query verified (' + (result.live === 'cached' ? 'cached' : 'live') + (result.sample_count != null ? ' · ' + result.sample_count + ' samples' : '') + ')</span>'
            : '<span style="color:var(--red)">✗ ' + escapeHtml((result.errors && result.errors[0] && result.errors[0].message) || result.message || 'rejected') + '</span>';
    } catch (e) {
        if (el) el.innerHTML = '<span style="color:var(--red)">✗ ' + escapeHtml(e.message || 'validate failed') + '</span>';
