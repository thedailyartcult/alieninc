<script id="terrain-addon">
(function () {
    'use strict';
    var DEM_SRC   = 'gaia-ph-dem';
    var TERRAIN_ROW = 'ph-terrain-3d';
    var terrainOn = false;
    var pending = false;

    function ensureFusionMap() {
        var m = window.fusionMap;
        if (m && m.isStyleLoaded && m.isStyleLoaded()) return m;
        return null;
    }
    function ensureDem(m) {
        if (!m.getSource(DEM_SRC)) {
            try {
                m.addSource(DEM_SRC, {
                    type: 'raster-dem',
                    tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png'],
                    tileSize: 256, encoding: 'terrarium', maxzoom: 15
                });
            } catch (e) {}
        }
        return !!m.getSource(DEM_SRC);
    }
    function bindStyleHook(m) {
        if (m.__terrainHook) return;
        m.__terrainHook = true;
        m.on('style.load', function () {
            setTimeout(function () {
                if (terrainOn) {
                    try { if (ensureDem(m)) m.setTerrain({ source: DEM_SRC, exaggeration: 1.35 }); } catch (e) {}
                }
            }, 60);
        });
    }
    function applyTerrain(want) {
        terrainOn = !!want;
        var m = ensureFusionMap();
        if (!m) { if (want) pending = true; return; }
        bindStyleHook(m);
        try {
            if (want) { ensureDem(m); m.setTerrain({ source: DEM_SRC, exaggeration: 1.35 }); }
            else { m.setTerrain(null); }
            pending = false;
        } catch (e) {}
    }

    function register(attempt) {
        if (!(window.GAIA && typeof window.GAIA.registerLayer === 'function')) {
            if (attempt < 40) setTimeout(function () { register(attempt + 1); }, 500);
            return;
        }
        window.GAIA.registerLayer({
            id: TERRAIN_ROW,
            label: 'PH 3D Terrain',
            meta: 'Terrarium DEM \u00b7 exaggerated relief',
            source: { type: 'dem', status: 'live' },
            on: function (v) { applyTerrain(v); }
        });
        setTimeout(function () {
            var rows = [];
            try { rows = (window.GAIA && window.GAIA.layers ? window.GAIA.layers() : []) || []; } catch (e) {}
            rows.forEach(function (r) { if (r.on && r.id === TERRAIN_ROW) applyTerrain(true); });
            if (pending) applyTerrain(true);
        }, 900);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { register(0); });
    else register(0);
})();
</script>


