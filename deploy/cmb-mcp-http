#!/srv/cmb/venv/bin/python3
"""CMB MCP server over Streamable HTTP, bound to localhost for SSH-tunneled use.

Remote clients (e.g. a local opencode install) reach this through an SSH tunnel:
    ssh -N -L 8765:127.0.0.1:8765 root@<server>
then opencode config: type "remote", url "http://localhost:8765/mcp".
Deploy: copy to /srv/cmb/venv/bin/cmb-mcp-http and pair with the
cmb-mcp-http.service systemd unit in this directory.
"""
import os

os.environ.setdefault("CMB_DB_PATH", "/srv/cmb/data/cmb.db")

from cmb import mcp_server

mcp_server.mcp.settings.host = "127.0.0.1"
mcp_server.mcp.settings.port = 8765
mcp_server.mcp.settings.mount_path = "/mcp"
mcp_server.mcp.run(transport="streamable-http")
