  </div>
</div>
<script>
(function(){
"use strict";
const PANEL=document.getElementById('yono-panel');
if(!PANEL||PANEL.dataset.booted)return;PANEL.dataset.booted='1';
const body=document.getElementById('yonoBody'),input=document.getElementById('yonoInput'),
      sendBtn=document.getElementById('yonoSendBtn'),chipsEl=document.getElementById('yonoChips'),
      badge=document.getElementById('yonoModelBadge'),statusEl=document.getElementById('yonoStatus');
const LS_SESSION='yono_sc_session';
let sessionId=null,busy=false,modelName='';

function apiCall(path,opts){if(typeof window.api==='function')return window.api(path,opts||{});return Promise.reject(new Error('admin api() unavailable'));}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function mdLite(t){
  const raw=String(t||'');
  try{
    if(window.marked && window.DOMPurify){
      marked.setOptions({gfm:true,breaks:true,highlight:function(code,lang){try{if(window.hljs) return hljs.highlight(code,{language:lang}).value;}catch(e){} try{if(window.hljs) return hljs.highlightAuto(code).value;}catch(e){} return code;}});
      return window.DOMPurify.sanitize(marked.parse(raw));
    }
  }catch(e){}
  let h=esc(raw);h=h.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code>$1</code>');
  return h.split('\n').map(l=>l.startsWith('- ')?'• '+l.slice(2):l).join('<br>');
}
function bubble(cls,text){
  const d=document.createElement('div');d.className='yono-msg '+cls;
  if(cls.includes('yono-msg-user')) d.textContent=text===undefined?'':text;
  else d.innerHTML='<div class="yono-md">'+mdLite(text||'')+'</div>';
  body.appendChild(d);body.scrollTop=body.scrollHeight;return d;
}
function botHtml(html){
  // html is already mdLite output — wrap in yono-md with copy bar
  const d=document.createElement('div');d.className='yono-msg yono-msg-bot';
  const inner=(String(html).includes('<')? html : mdLite(html));
  d.innerHTML='<div class="yono-md">'+inner+'</div>';
  const rawText=d.textContent||'';
  const bar=document.createElement('div');bar.style.cssText='display:flex;gap:6px;padding:6px 12px 8px;border-top:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.01)';
  const copy=document.createElement('button');copy.textContent='copy';copy.style.cssText='font-family:var(--font-mono);font-size:7px;letter-spacing:.08em;text-transform:uppercase;padding:4px 7px;border:1px solid var(--border-color);background:rgba(255,255,255,.03);color:var(--text-muted);cursor:pointer;border-radius:3px';
  copy.onclick=function(){try{navigator.clipboard.writeText(rawText).then(function(){copy.textContent='copied';setTimeout(function(){copy.textContent='copy';},1200);});}catch(e){}};
  bar.appendChild(copy);d.appendChild(bar);
  body.appendChild(d);body.scrollTop=body.scrollHeight;
  try{if(window.hljs) d.querySelectorAll('pre code').forEach(function(b){hljs.highlightElement(b);});}catch(e){}
  return d;
}

const PROP_KEYS=['classification','confidence','dominant_winner','timestamp','datetime','date','time',
  'lat','lon','latitude','longitude','location','action_geo','sourcecountry','country','source',
  'title','name','battlefield','scenarios_run','seed','theater','status'];
function propLine(props){
  if(!props)return '';
  const seen=[],p=props&&typeof props==='object'?props:{};
  for(const k of PROP_KEYS){if(k in p&&p[k]!==null&&p[k]!=='')seen.push(k+': '+(typeof p[k]==='object'?JSON.stringify(p[k]):String(p[k])));}
  for(const k in p){if(seen.length>=6)break;if(!PROP_KEYS.includes(k)&&p[k]!==null&&typeof p[k]!=='object')seen.push(k+': '+String(p[k]));}
  return seen.join(' · ');
}
function objectCards(entries,highlight){
  const out=[];const seenIds={};
  for(const e of entries){const r=e.result;if(!r||typeof r!=='object')continue;
    const lists=[r.objects,r.matches].filter(Array.isArray);
    for(const list of lists)for(const o of list){
      if(!o||!o.id||seenIds[o.id])continue;seenIds[o.id]=1;
      const hit=highlight&&highlight.some(pk=>String(o.primary_key).toLowerCase().includes(String(pk).toLowerCase()));
      out.push({html:'<div class="yono-card'+(hit?' yono-hit':'')+'"><div class="yc-type">'+esc(o.type||'object')+'</div>'
        +'<div class="yc-pk">'+esc(o.primary_key||o.id)+'</div>'
        +(propLine(o.properties)?'<div class="yc-props">'+esc(propLine(o.properties))+'</div>':'')
        +(o.updated_at?'<div class="yc-props" style="font-size:.62rem;opacity:.7">updated '+esc(o.updated_at)+'</div>':'')
        +'</div>',pk:o.primary_key});
    }
  }
  return out;
}
function collectDirectives(entries){
  const dirs=[];
  for(const e of entries){const r=e.result;if(r&&r.directive)dirs.push(r.directive);}
  return dirs;
}
function applyDirective(d){
  const map=window.fusionMap;if(!map)return false;
  try{
    if(d.op==='fly_to'){map.flyTo({center:d.center,zoom:d.zoom,duration:1200});return true;}
    if(d.op==='fit_bounds'){map.fitBounds(d.bounds,{padding:60,maxZoom:9});return true;}
    if(d.op==='toggle_layer'){
      if(d.layer==='sims-ontology'){if(window.GAIA&&typeof window.GAIA.setLayer==='function'){window.GAIA.setLayer('sims-ontology',d.visible!==false);return true;}return false;}
      if(typeof window.fusionToggleLayer==='function'){window.fusionToggleLayer(d.layer);return true;}
      return false;}
    if(d.op==='viewshed'){if(window.TerrainFX){return window.TerrainFX.drawViewshed(d);}return false;}
    if(d.op==='highlight'){
      const mv=window.MAVEN_VIEW||{};
      const pools=[];
      (mv.detections||[]).forEach(x=>pools.push({c:[x.lng,x.lat],pk:x.pk,label:x.label}));
      (mv.assets||[]).forEach(x=>pools.push({c:[x.lng,x.lat],pk:x.callsign,label:x.callsign}));
      for(const pk of (d.primary_keys||[])){
        const n=String(pk).toLowerCase();
        const hit=pools.find(v=>String(v.pk).toLowerCase().includes(n)||String(v.label||'').toLowerCase().includes(n));
        if(hit&&isFinite(hit.c[0])&&isFinite(hit.c[1])){
          map.flyTo({center:hit.c,zoom:Math.max(map.getZoom(),8),duration:1200});
          try{
            const dm=(window.__mvDetMarkers||{})[hit.pk];
            if(dm){const el=dm.getElement();el.classList.remove('mv-pulse');void el.offsetWidth;el.classList.add('mv-pulse');setTimeout(()=>el.classList.remove('mv-pulse'),6000);}
          }catch(err){}
          return true;}
      }
      const evts=(window.fusionThreatEvents||[]).concat(window.fusionFlights||[]);
      for(const pk of (d.primary_keys||[])){
        const needle=String(pk).toLowerCase();
        const ev=evts.find(v=>{const hay=((v&&(v.title||v.name||v.callsign||v.id))||'')+'';return hay.toLowerCase().includes(needle);});
        const c=ev&&(ev.coordinates||ev.coords);
        if(Array.isArray(c)&&c.length>=2&&isFinite(c[0])&&isFinite(c[1])){
          const lnglat=(Math.abs(c[0])<=90&&Math.abs(c[1])<=180)?[c[1],c[0]]:c;
          map.flyTo({center:lnglat,zoom:Math.max(map.getZoom(),7),duration:1200});
          return true;}
      }
      return false;}
  }catch(err){}
  return false;
}

function renderAssistant(resp){
  if(resp.session_id){sessionId=resp.session_id;try{localStorage.setItem(LS_SESSION,String(resp.session_id));}catch(e){}}
  if(resp.response&&resp.response.trim())botHtml(mdLite(resp.response));
  const tc=resp.tool_calls||[];
  if(!tc.length)return;
  const wrap=document.createElement('details');wrap.className='yono-tools';
  const denied=tc.filter(t=>t.denied).length,proposed=tc.filter(t=>t.proposed).length;
  wrap.innerHTML='<summary>'+tc.length+' tool call'+(tc.length>1?'s':'')
    +(denied?' · '+denied+' denied':'')+(proposed?' · '+proposed+' proposed':'')+'</summary>';
  const chipsRow=document.createElement('div');chipsRow.className='yono-toolchips';
  for(const t of tc){const c=document.createElement('span');
    c.className='yono-chip'+(t.denied?' denied':t.proposed?' proposed':'');
    c.textContent=t.tool+(t.denied?' ✕':t.proposed?' ⏳':'');chipsRow.appendChild(c);}
  wrap.appendChild(chipsRow);body.appendChild(wrap);
  let highlight=null;
  for(const t of tc){if(!t.denied&&t.args&&Array.isArray(t.args.primary_keys))highlight=t.args.primary_keys;}
  const dirs=collectDirectives(tc);
  for(const d of dirs){applyDirective(d);const c=document.createElement('span');c.className='yono-chip map';c.textContent='map: '+d.op;chipsRow.appendChild(c);}
  for(const card of objectCards(tc,highlight))body.insertAdjacentHTML('beforeend',card.html);
  for(const t of tc){if(t.proposed&&t.proposal_id)renderProposal(t);}
  body.scrollTop=body.scrollHeight;
}
function renderProposal(entry){
  const a=(entry.result&&entry.result.missing_required_parameters)||[];
  const args=(entry.args&&entry.args.parameters)||{};
  const d=document.createElement('div');d.className='yono-proposal';
  d.innerHTML='<div class="yp-head">Action proposal · '+esc(entry.args.action_name||'')+'</div>'
    +'<div>'+esc(Object.keys(args).map(k=>k+': '+args[k]).join(' · ')||'(no parameters)')+'</div>'
    +(a.length?'<div style="color:#fca5a5;font-size:.68rem;margin-top:3px">missing: '+esc(a.join(', '))+'</div>':'')
    +'<div class="yp-actions"><button class="yono-approve">Confirm</button><button class="yono-reject">Reject</button></div>';
  const st=document.createElement('div');st.className='yono-yp-status';d.appendChild(st);
  const pid=entry.proposal_id;
  d.querySelector('.yono-approve').onclick=async function(){
    this.disabled=true;d.querySelector('.yono-reject').disabled=true;
    st.textContent='executing…';
    try{const r=await apiCall('/yono/proposals/'+pid+'/confirm',{method:'POST',timeout:300000});
      st.textContent=r.status==='succeeded'?'executed':'status: '+r.status+(r.error?(' · '+r.error):'');
      if(r.status==='succeeded'&&window.renderFusionMap)setTimeout(function(){try{window.renderFusionMap();}catch(e){}},400);
    }catch(e){this.disabled=false;st.textContent='failed: '+e.message;}
  };
  d.querySelector('.yono-reject').onclick=async function(){
    this.disabled=true;d.querySelector('.yono-approve').disabled=true;
    try{await apiCall('/yono/proposals/'+pid+'/reject',{method:'POST'});st.textContent='rejected';}
    catch(e){st.textContent='reject failed: '+e.message;}
  };
  body.appendChild(d);body.scrollTop=body.scrollHeight;
}

async function send(text){
  text=(text||'').trim();if(!text||busy)return;busy=true;sendBtn.disabled=true;
  bubble('yono-msg-user',text);
  if(/^(maven[:\s]|\/maven\b)/i.test(text)){
    const cmd=text.replace(/^\/?maven[:\s]*/i,'');
    const t2=document.createElement('div');t2.className='yono-typing';t2.textContent='maven executing…';
    body.appendChild(t2);body.scrollTop=body.scrollHeight;
    try{
      const r=await apiCall('/maven/command',{method:'POST',body:JSON.stringify({text:cmd}),timeout:30000});
      t2.remove();
      botHtml('<b style="color:#DFF140">MAVEN ▸</b>\n'+mdLite(r.reply||'done'));
      if(r.directive&&applyDirective(r.directive)){
        const c=document.createElement('span');c.className='yono-chip map';c.textContent='map: '+r.directive.op;
        body.appendChild(c);
      }
      if(typeof window.__mavenRefresh==='function')window.__mavenRefresh();
    }catch(e){t2.remove();botHtml('❌ MAVEN: '+esc(e.message));}
    busy=false;sendBtn.disabled=false;input.focus();return;
  }
  const typing=document.createElement('div');typing.className='yono-typing';
  const t0=Date.now();typing.textContent='consulting ontology · 0s';body.appendChild(typing);body.scrollTop=body.scrollHeight;
  let tickOn=true;const tick=setInterval(function(){if(tickOn)typing.textContent='consulting ontology · '+Math.round((Date.now()-t0)/1000)+'s';},1000);
  const haltTick=function(){tickOn=false;clearInterval(tick);if(typing.parentNode)typing.remove();};
  let live=null,liveTools=null;
  let streamRaw='';
  const onEvt=function(evt){
    if(evt.type==='delta'){
      haltTick();
      streamRaw+=evt.text;
      if(!live){
        live=document.createElement('div');live.className='yono-msg yono-msg-bot yono-live';
        live.innerHTML='<div class="yono-md"></div>';body.appendChild(live);
      }
      const mdEl=live.querySelector('.yono-md');
      if(mdEl){
        try{
          if(window.marked && window.DOMPurify){
            marked.setOptions({gfm:true,breaks:true,highlight:function(code,lang){try{if(window.hljs) return hljs.highlight(code,{language:lang}).value;}catch(e){} return code;}});
            mdEl.innerHTML=window.DOMPurify.sanitize(marked.parse(streamRaw));
            mdEl.querySelectorAll('pre code').forEach(function(b){try{hljs.highlightElement(b);}catch(e){}});
          } else mdEl.textContent=streamRaw;
        }catch(e){mdEl.textContent=streamRaw;}
      } else live.textContent+=evt.text;
      body.scrollTop=body.scrollHeight;
    }else if(evt.type==='tool'){
      if(!live){live=document.createElement('div');live.className='yono-msg yono-msg-bot';body.appendChild(live);}
      if(!liveTools){liveTools=document.createElement('div');liveTools.className='yono-livetools';body.appendChild(liveTools);}
      const c=document.createElement('span');c.className='yono-chip'+(evt.entry.denied?' denied':evt.entry.proposed?' proposed':'');
      c.textContent=evt.entry.tool+(evt.entry.denied?' ✕':evt.entry.proposed?' ⏳':'');liveTools.appendChild(c);body.scrollTop=body.scrollHeight;
    }else if(evt.type==='status'&&tickOn){typing.textContent=evt.text+' · '+Math.round((Date.now()-t0)/1000)+'s';}
  };
  let ok=false,streamErr=null;
  try{
    if(typeof window.apiStream==='function'){
      const payload={message:text};if(sessionId)payload.session_id=sessionId;
      const resp=await window.apiStream('/yono/panel/chat/stream',{body:JSON.stringify(payload),timeout:300000},onEvt);
      haltTick();if(live)live.remove();if(liveTools)liveTools.remove();
      renderAssistant(resp);ok=true;
    }
  }catch(e){streamErr=e;}
  if(!ok){
    haltTick();
    try{
      const payload={message:text};if(sessionId)payload.session_id=sessionId;
      const resp=await apiCall('/yono/panel/chat',{method:'POST',body:JSON.stringify(payload),timeout:300000});
      if(live)live.remove();if(liveTools)liveTools.remove();
      renderAssistant(resp);
    }catch(e){
      if(live)live.remove();if(liveTools)liveTools.remove();
      bubble('yono-msg-err','YONO unavailable: '+((e&&e.message)||(streamErr&&streamErr.message)||'request failed'));
    }
  }
  busy=false;sendBtn.disabled=false;input.focus();
}

['Latest activity','Ontology overview','Show theaters and forces','Find hypersonic mentions','Run a battle simulation']
.forEach(q=>{const c=document.createElement('span');c.className='yono-schip';c.textContent=q;
