        gridEl.innerHTML = '';
        REGISTRY.forEach(function (p, i) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'ps-card' + (selected.indexOf(p.id) >= 0 ? ' sel' : '');
            b.dataset.pid = p.id;
            b.innerHTML = cardHTML(p);
            b.addEventListener('click', function () { togglePlatform(p.id); });
            b.addEventListener('focus', function () { focusIdx = i; });
            gridEl.appendChild(b);
        });
        updateBar();
    }

    function togglePlatform(id) {
        var i = selected.indexOf(id);
        if (i >= 0) selected.splice(i, 1); else selected.push(id);
        var card = gridEl.querySelector('[data-pid="' + id + '"]');
        if (card) card.classList.toggle('sel', selected.indexOf(id) >= 0);
        updateBar();
    }

    function updateBar() {
        countEl.textContent = selected.length + ' SELECTED';
        launchBtn.disabled = selected.length === 0;
    }

    function closeOverlay() {
        overlay.classList.remove('open');
        pending = null;
    }

    function launch() {
        if (!selected.length) return;
        commitSelection();
        var res = pending;   // capture BEFORE closeOverlay() clears it
        closeOverlay();
        if (res) res();
    }

    function enableAll() {
        selected = REGISTRY.map(function (p) { return p.id; });
        renderGrid();
        launch();
    }

    function openChooser(isFirstRun) {
        firstRun = !!isFirstRun;
        var stored = load();
        selected = stored ? stored.slice() : [];
        renderGrid();
        document.getElementById('psTitle').textContent = isFirstRun ? 'Select Your Platforms' : 'Modify Your Platforms';
        document.getElementById('psSub').textContent = isFirstRun
            ? 'Choose the tools this console carries. Only what you pick appears in the navigation panel \u2014 and you can change it anytime with Ctrl+K or the + Platforms button.'
            : 'Toggle the platforms carried in this console. Changes apply immediately to the navigation panel and Ctrl+K.';
        launchBtn.textContent = isFirstRun ? 'Launch Command Deck' : 'Apply Selection';
        enableAllBtn.textContent = isFirstRun ? 'Enable All' : 'Enable Everything';
        overlay.classList.add('open');
        var cards = gridEl.querySelectorAll('.ps-card');
        if (cards.length) cards[Math.min(focusIdx, cards.length - 1)].focus();
    }

    function maybeFirstRun() {
        if (load()) {           // returning user: silent filter
            var sel = load().slice();
            applyFilter(sel);
            try {
                if (window.DECK && typeof DECK.rebuildTools === 'function') DECK.rebuildTools();
            } catch (e) {}
            return Promise.resolve();
        }
        // first run for this account: gate boot on the choice
        openChooser(true);
        return new Promise(function (res) { pending = res; });
    }

    function initDom() {
        overlay = document.getElementById('platformSelectOverlay');
        gridEl = document.getElementById('psGrid');
        countEl = document.getElementById('psCount');
        launchBtn = document.getElementById('psLaunch');
        enableAllBtn = document.getElementById('psEnableAll');
        if (!overlay || !gridEl) return false;
        launchBtn.addEventListener('click', launch);
        enableAllBtn.addEventListener('click', enableAll);
        var sideBtn = document.getElementById('psSideBtn');
        if (sideBtn) sideBtn.addEventListener('click', function () { openChooser(false); });
        document.addEventListener('keydown', function (e) {
            if (!overlay.classList.contains('open')) return;
            var cards = gridEl.querySelectorAll('.ps-card');
            if (e.key === 'Escape') {
                if (!firstRun) { selected = load() || []; closeOverlay(); }
                e.preventDefault();
                return;
            }
            if (e.key === 'a' || e.key === 'A') { e.preventDefault(); enableAll(); return; }
            if (['ArrowRight', 'ArrowDown'].indexOf(e.key) >= 0) {
                e.preventDefault(); focusIdx = (focusIdx + 1) % cards.length; cards[focusIdx].focus();
            } else if (['ArrowLeft', 'ArrowUp'].indexOf(e.key) >= 0) {
                e.preventDefault(); focusIdx = (focusIdx - 1 + cards.length) % cards.length; cards[focusIdx].focus();
            } else if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('ps-card')) {
                e.preventDefault();
            }
        });
        return true;
    }

    function boot() {
        if (!initDom()) return;
        var PS = {
            open: function () { openChooser(false); },
            allowsPage: allowsPage,
            refresh: function () { var s = load(); if (s) { applyFilter(s); commitSelection(); } }
        };
        window.PLATFORM_SELECT = PS;
        // Identity: `currentUser` is let-scoped inside another script block (never on
        // window), so capture the real user object by wrapping showApp(user).
        if (typeof window.showApp === 'function') {
            var _showApp = window.showApp;
            window.showApp = function (user) {
                if (user) identity = user;
                return _showApp.apply(this, arguments);
            };
        }
        // First-run gate: the boot sequence always ends in navigate(hash) AFTER showApp,
        // so gating the first navigate() call gives us both timing and identity. The
        // chooser renders at z-index 10000, above admin's #auth-loading veil (z 9999),
        // so it stays visible while the restore flow is still pending underneath.
        if (typeof window.navigate === 'function') {
            var _navigate = window.navigate;
            var gated = false;
            window.navigate = function (page) {
                var args = arguments;
                if (!gated) {
                    gated = true;
                    try {
                        var r = maybeFirstRun();
                        if (r && typeof r.then === 'function') {
                            return r.then(function () { return _navigate.apply(this, args); });
                        }
                    } catch (err) { console.warn('platform-select:', err); }
                }
                return _navigate.apply(this, args);
            };
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>


