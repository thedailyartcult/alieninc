<script>
(function () {
    'use strict';

    // ------------------------------------------------------------------ config
    var LS_GEOM  = 'sc_gaia_geom_v1';   // drag/resize geometry
    var LS_OPEN  = 'sc_gaia_open_v1';   // panel visible flag
    var LS_MIN   = 'sc_gaia_min_v1';    // minimized flag
    var LS_STATE = 'sc_gaia_state_v1';  // per-layer {on,opacity} + lastQuery

    // --------------------------------------------------- layer registry (pluggable)
    // Host layers delegate to the EXISTING core pipeline via fusionToggleLayer().
    // Layers without a provider stay dormant ("NO FEED") until registered at
    // runtime through GAIA.registerLayer({id,label,meta,on(isOn),opacity(v)}).
    var REGISTRY = [
        { id: 'threats',   label: 'CAMEO Threat Events', meta: 'GDELT \u00b7 live feed',        host: 'threats' },
        { id: 'aviation',  label: 'Aircraft Tracks',     meta: 'OpenSky \u00b7 live feed',      host: 'aviation' },
        { id: 'drones',    label: 'Drone / Telemetry',   meta: 'SIM \u00b7 synthetic UAV feed',
          on: function (v) { providerDrones(v); },
          opacity: function (v) { droneOpacity = clamp(v, 0.2, 1); sweepAll(); } },
        { id: 'vessels',   label: 'Vessel Tracks',    meta: 'AISStream \u00b7 live feed',
          on: function (v) { providerVessels(v); },
          opacity: function (v) { vesselOpacity = clamp(v, 0.2, 1); } },
        { id: 'satellite', label: 'Satellite Imagery',   meta: 'ESRI World Imagery \u00b7 raster overlay',
          on: function (v) { providerSatellite(v); },
          opacity: function (v) { rasterOpacity('gaia-sat', v); } },
        { id: 'weather',   label: 'Weather Patterns',    meta: 'RainViewer radar \u00b7 live tiles',
          on: function (v) { providerWeather(v); },
          opacity: function (v) { rasterOpacity('gaia-wx', v); } },
        { id: 'actorheat', label: 'Actor Network Heat',  meta: 'no feed registered \u00b7 pluggable' }
    ];

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        s = s == null ? '' : String(s);
        if (typeof window.escapeHtml === 'function') return window.escapeHtml(s);
        return s.replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
    function num(v) { var n = parseFloat(v); return Number.isFinite(n) ? n : null; }
    function havKm(a, b) { // haversine, args {lat,lng}
        var R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180, dLng = (b.lng - a.lng) * Math.PI / 180;
        var s1 = Math.sin(dLat / 2), s2 = Math.sin(dLng / 2);
        var h = s1 * s1 + Math.cos(a.lat * Math.PI / 180) * Math.cos(b.lat * Math.PI / 180) * s2 * s2;
        return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
    }
    function fmtKm(km) {
        if (km == null || !Number.isFinite(km)) return '\u2014';
        return km >= 100 ? Math.round(km) + ' km' : km >= 10 ? km.toFixed(0) + ' km' : km.toFixed(1) + ' km';
    }

    // ------------------------------------------------------------------- state
    var DEFAULT_STATE = {
        threats:   { on: false, opacity: 1 },
        aviation:  { on: false, opacity: 1 },
        drones:    { on: false, opacity: 1 },
        vessels:   { on: false, opacity: 1 },
        satellite: { on: false, opacity: 1 },
        weather:   { on: false, opacity: 1 },
        actorheat: { on: false }
    };
    function loadState() {
        // Fresh map every session: persisted layer toggles are intentionally
        // NOT restored — GAIA layers appear only when manually engaged.
        var st = {};
        Object.keys(DEFAULT_STATE).forEach(function (k) {
            st[k] = st[k] && typeof st[k] === 'object' ? st[k] : {};
            st[k].on = typeof st[k].on === 'boolean' ? st[k].on : DEFAULT_STATE[k].on;
            if (DEFAULT_STATE[k].opacity != null) {
                var o = num(st[k].opacity); st[k].opacity = o == null ? DEFAULT_STATE[k].opacity : clamp(o, 0.2, 1);
            }
        });
        return st;
    }
    var state = loadState();
    function saveState() {
        try { localStorage.setItem(LS_STATE, JSON.stringify(state)); } catch (e) {}
    }

    // ---------------------------------------------------------- panel refs/state
    var panel, listEl, statusEl, metaEl, modeChip, resultsHead, samplesEl, inputEl, chipsEl;
    var minimized = false;
    var isOpen = false;
    var activeFilter = null;   // committed filter applied to map markers
    var lastParsed = null;     // latest preview parse

    function findDef(id) { for (var i = 0; i < REGISTRY.length; i++) if (REGISTRY[i].id === id) return REGISTRY[i]; return null; }
    function hasProvider(id) { var d = findDef(id); return !!(d && typeof d.on === 'function'); }

    // ------------------------------------------------------------ host layers
    function hostActive(id) { return !!(window.fusionLayers && window.fusionLayers[id]); }
    function setHostLayer(id, on) {
        if (hostActive(id) === on) return;
        // Delegate ONLY to the existing core toggle: it re-renders the layer,
        // updates KPIs/HUD/bounds exactly like a manual click on the map bar.
        if (typeof window.fusionToggleLayer === 'function') window.fusionToggleLayer(id);
        else if (window.fusionLayers) window.fusionLayers[id] = on;
    }
    function setCustomLayer(id, on) {
        var d = findDef(id);
        if (!d || typeof d.on !== 'function') return; // dormant stays dormant
        try { d.on(on); } catch (e) {}
    }
    function setLayerOpacity(id, v) {
        var st = state[id]; if (!st) return;
        st.opacity = clamp(v, 0.2, 1);
        saveState();
        var d = findDef(id);
        if (d && typeof d.opacity === 'function') { try { d.opacity(st.opacity); } catch (e) {} }
        else applyOpacities();
    }

    function toggleLayerById(id) {
        var st = state[id]; if (!st) return;
        st.on = !st.on;
        saveState();
        if (st.on) setOpen(true); // switching a layer on implies the controller is in use
        if (findDef(id) && findDef(id).host) setHostLayer(id, st.on);
        else setCustomLayer(id, st.on);
        renderRows();
        refreshStatuses();
        statusMsg((findDef(id) ? findDef(id).label : id) + ' ' + (st.on ? 'engaged.' : 'released.'));
    }


    // ------------------------------------------- point normalization (read-only)
    // Mirrors the core normalizeThreatPoint/normalizeAircraftPoint shapes WITHOUT
    // touching them — GAIA only reads host arrays and helper functions.
    function normThreat(ev) {
        var geo = null;
        try { geo = window.parseActionGeo(ev); } catch (e) {}
        if (!geo) return null;
        var tone = 'green';
        try { tone = window.threatLevelForEvent(ev) || 'green'; } catch (e) {}
        return {
            kind: 'threat', lat: num(geo.latitude), lng: num(geo.longitude),
            level: tone, label: 'CAMEO ' + (ev.event_code || '?'),
            title: ev.title || '', domain: ev.domain || '', country: geo.country || '',
            raw: ev, ts: dateOf(ev)
        };
    }
    function normAir(f) {
        var p = (f && f.properties) || {};
        var lat = num(p.lat), lng = num(p.lng);
        if (lat == null || lng == null) return null;
        return {
            kind: 'aircraft', lat: lat, lng: lng,
            cat: String(p.category || '').toLowerCase(), label: String(p.callsign || '\u2014'),
            title: [p.callsign, p.model, p.category, p.icao24].filter(Boolean).join(' '),
            domain: '', country: '', raw: f, ts: null
        };
    }
    function normObj(o) {
        if (!o || num(o.lat) == null || num(o.lng) == null) return null;
        var side = o.kind === 'cvtrack' ? '' : (o.side || '');
        return {
            kind: o.kind === 'cvtrack' ? 'cvtrack' : 'asset',
            lat: num(o.lat), lng: num(o.lng),
            side: side,
            level: side === 'hostile' ? 'red' : side === 'friendly' ? 'green' : 'amber',
            cat: '', label: o.label || (o.kind === 'cvtrack' ? 'CV TRACK' : 'ASSET'),
            title: o.note || '', domain: '', country: '',
            raw: o, ts: num(o.ts)
        };
    }
    function normDrone(d) {
        if (!d || num(d.lat) == null || num(d.lng) == null) return null;
        return {
            kind: 'drone', lat: num(d.lat), lng: num(d.lng),
            side: '', level: 'amber', cat: 'uav',
            label: d.label || 'UAV', title: 'SIM telemetry \u00b7 alt ' + Math.round(d.altM || 0) + ' m \u00b7 hdg ' + Math.round(d.heading || 0),
            domain: '', country: '', raw: d, ts: Date.now()
        };
    }
    function dateOf(ev) {
        if (!ev) return null;
        var v = ev.event_date || ev.datetime || ev.seen_date || '';
        var t = Date.parse(v);
        return Number.isFinite(t) ? t : null;
    }
    function collectPoints() {
        var out = [], i;
        var evs = Array.isArray(window.fusionThreatEvents) ? window.fusionThreatEvents : [];
        var fls = Array.isArray(window.fusionFlights) ? window.fusionFlights : [];
        for (i = 0; i < evs.length; i++) { var t = normThreat(evs[i]); if (t && t.lat != null && t.lng != null) out.push(t); }
        for (i = 0; i < fls.length; i++) { var a = normAir(fls[i]); if (a && a.lat != null && a.lng != null) out.push(a); }
        for (i = 0; i < gaiaObjects.length; i++) { var o = normObj(gaiaObjects[i]); if (o && o.lat != null && o.lng != null) out.push(o); }
        for (i = 0; i < dronePts.length; i++) { var d = normDrone(dronePts[i]); if (d && d.lat != null && d.lng != null) out.push(d); }
        return out;
    }

