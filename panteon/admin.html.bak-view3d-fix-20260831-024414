// ------------------------ fusion map layers (GAIA) ------------------------
function registerSimsGaiaLayers() {
    if (!window.GAIA || window.__simsGaiaRegistered) return;
    window.__simsGaiaRegistered = true;
    window.GAIA.registerLayer({
        id: 'sims-war', label: 'Kriegspiel Theaters', meta: 'SIMS \u00b7 war sim',
        source: { type: 'sim', status: 'live' },
        on: v => { fusionLayers.simsWar = v; renderFusionSimWarLayer(); },
    });
    window.GAIA.registerLayer({
        id: 'sims-learning', label: 'Doctrine Confidence', meta: 'SIMS \u00b7 learning overlay',
        source: { type: 'sim', status: 'live' },
        on: v => { fusionLayers.simsLearning = v; renderFusionSimLearningLayer(); },
    });
    window.GAIA.registerLayer({
        id: 'sims-ontology', label: 'War Ontology', meta: 'SIMS \u00b7 sc_objects graph',
        source: { type: 'sim', status: 'live' },
        on: v => { fusionLayers.simsOnt = v; renderFusionOntLayer(); },
    });
    window.GAIA.registerLayer({
        id: 'sims-real', label: 'Real World', meta: 'SIMS \u00b7 nations + arsenal',
        source: { type: 'sim', status: 'live' },
        on: v => { fusionLayers.simsReal = v; renderFusionRealLayer(); },
    });
    // Re-attach sims layers after any core fusion map reload (additive wrap).
    if (typeof window.renderFusionMap === 'function' && !window.renderFusionMap.__simsWrapped) {
        const origRender = window.renderFusionMap;
        window.renderFusionMap = function () {
            const res = origRender.apply(this, arguments);
            setTimeout(() => { renderFusionSimWarLayer(); renderFusionSimLearningLayer(); renderFusionOntLayer(); renderFusionRealLayer(); }, 400);
            return res;
        };
        window.renderFusionMap.__simsWrapped = true;
    }
    // Fresh-map policy: SIMS layers start OFF like every other GAIA layer.
    fusionLayers.simsWar = false;
    fusionLayers.simsOnt = false;
    fusionLayers.simsReal = false;
    // Theaters may not be fetched yet when arriving via Spinal Cracker first.
    if (!SIMS.battlefields.length) {
        loadSimsBattlefields().then(() => {
            renderFusionSimWarLayer();
            renderFusionSimLearningLayer();
        });
    }
    loadOntologyGraph();
}

function simsTerrainColor(terrain) {
    return { urban: '#a78bfa', mountain: '#94a3b8', forest: '#22c544', desert: '#f59e0b',
