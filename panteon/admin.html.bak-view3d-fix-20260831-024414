async function updateFusionMilPanel(contacts) {
    const list = Array.isArray(contacts) ? contacts : fusionMilContacts;
    const panel = document.getElementById('fusionMilPanel');
    const body = document.getElementById('fusionMilBody');
    const countEl = document.getElementById('fusionMilCount');
    if (!panel || !body || !countEl) return;
    countEl.textContent = String(list.length);
    if (!list.length) {
        panel.classList.add('sc-mil-hidden');
        body.innerHTML = '';
        return;
    }
    panel.classList.remove('sc-mil-hidden');
    body.innerHTML = '<div class="sc-mil-empty">Resolving airframe types…</div>';
    const idx = await loadAsanIndex();
    body.innerHTML = list.map((c, i) => {
        const rec = resolveMilType(c.model, idx);
        const fl = (typeof c.alt === 'number' || typeof c.alt === 'string') && c.alt !== '' && !isNaN(Number(c.alt)) ? 'FL' + Math.round(Number(c.alt) / 100) : '—';
        const kt = (c.spd != null && !isNaN(Number(c.spd))) ? Math.round(Number(c.spd)) + 'kt' : '—';
        const typeLabel = rec ? c.model + ' · ' + escapeHtml(rec.d) : escapeHtml(String(c.model));
        const origin = rec && rec.c ? '<span style="opacity:.7"> · ' + escapeHtml(rec.c) + '</span>' : '';
        return '<div class="sc-mil-row" onclick="fusionMilFocus(' + i + ')" title="Fly to contact">' +
            '<b>' + escapeHtml(c.callsign) + '</b>' +
            '<span class="sc-mil-type">' + typeLabel + origin + '</span>' +
            '<span class="sc-mil-meta">' + fl + ' ' + kt + '</span></div>';
    }).join('');
}

function renderFusionThreatLayer() {
