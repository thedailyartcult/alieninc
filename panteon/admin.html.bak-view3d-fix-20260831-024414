                          <script>
                          // Spinal Cracker hive engine: draggable pentagon launcher blooms into a
                          // connected honeycomb of every deck tile + traffic chip. Tiles drag-swap
                          // between comb slots (persisted), launcher position persists, aircraft
                          // chips idle-dim until the Aircraft layer engages. Blueprint-HUD tiles
                          // outside the hive keep their legacy sibling-reaction behavior.
                          (function () {
                              var deck = document.getElementById('fusionDeck');
                              var layer = document.getElementById('hiveLayer');
                              var pent = document.getElementById('hivePentBtn');
                              if (!deck || !layer || !pent) return;

                              var CW = 152, CH = 88, SX = 160, SY = 96, TOP = 78;
                              var ROWS = [5, 5, 4];
                              var DEFAULT_ORDER = ['threats', 'aircraft', 'bld3d', 'scope', 'notes',
                                                  'gaia', 'maven', 'theater', 'cat-commercial', 'cat-jet',
                                                  'cat-private', 'cat-military', 'mod-motion', 'mod-fov'];
                              var CHIP_KEYS = ['cat-commercial', 'cat-jet', 'cat-private', 'cat-military', 'mod-motion', 'mod-fov'];
                              var KEY = 'scHive.v1';

                              var SLOTS = [];
                              ROWS.forEach(function (n, r) {
                                  for (var c = 0; c < n; c++) {
                                      SLOTS.push({ x: c * SX + (ROWS[0] - n) * SX / 2, y: TOP + r * SY, r: r, c: c });
                                  }
                              });

                              function cells() { return Array.prototype.slice.call(layer.querySelectorAll('[data-tile]')); }
                              function cellMap() { var m = {}; cells().forEach(function (el) { m[el.getAttribute('data-tile')] = el; }); return m; }

                              var state = { x: 12, y: 12, order: DEFAULT_ORDER.slice(), expanded: false };
                              try {
                                  var saved = JSON.parse(localStorage.getItem(KEY) || '{}');
                                  if (typeof saved.x === 'number') state.x = saved.x;
                                  if (typeof saved.y === 'number') state.y = saved.y;
                                  if (Array.isArray(saved.order)) {
                                      var known = cellMap();
                                      state.order = saved.order.filter(function (k) { return known[k]; });
                                      DEFAULT_ORDER.forEach(function (k) { if (state.order.indexOf(k) === -1) state.order.push(k); });
                                      Object.keys(known).forEach(function (k) { if (state.order.indexOf(k) === -1) state.order.push(k); });
                                  }
                              } catch (e) {}

                              function save() { try { localStorage.setItem(KEY, JSON.stringify({ x: state.x, y: state.y, order: state.order })); } catch (e) {} }

                              function layout() {
                                  var m = cellMap();
                                  state.order.forEach(function (key, i) {
                                      var el = m[key]; if (!el || !SLOTS[i]) return;
                                      var s = SLOTS[i];
                                      el.style.setProperty('--tx', s.x + 'px');
                                      el.style.setProperty('--ty', s.y + 'px');
                                      el.style.setProperty('--fx', (38 - (s.x + CW / 2)) + 'px');
                                      el.style.setProperty('--fy', (35 - (s.y + CH / 2)) + 'px');
                                      el.style.setProperty('--hd', (i * 22) + 'ms');
                                      el.classList.remove('cut-tr-bl', 'cut-tl-br');
                                      el.classList.add(((s.r + s.c) % 2 === 0) ? 'cut-tr-bl' : 'cut-tl-br');
                                      el._slot = i;
                                  });
                                  if (state.expanded) {
                                      deck.style.width = (SLOTS[4].x + CW) + 'px';
                                      deck.style.height = (TOP + (ROWS.length - 1) * SY + CH) + 'px';
                                  } else {
                                      deck.style.width = ''; deck.style.height = '';
                                  }
                              }

                              function clampPos() {
                                  var wrap = deck.parentElement;
                                  if (!wrap) return;
                                  var w = deck.offsetWidth || 76, h = deck.offsetHeight || 70;
                                  state.x = Math.min(Math.max(state.x, 8), Math.max(8, wrap.clientWidth - w - 8));
                                  state.y = Math.min(Math.max(state.y, 8), Math.max(8, wrap.clientHeight - h - 8));
                                  deck.style.left = state.x + 'px';
                                  deck.style.top = state.y + 'px';
                              }

                              function suppressClick() {
                                  var kill = function (e) { e.stopPropagation(); e.preventDefault(); window.removeEventListener('click', kill, true); };
                                  window.addEventListener('click', kill, true);
