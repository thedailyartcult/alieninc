    <script>
        const header = document.getElementById('main-header');
        const scrollThreshold = window.innerHeight * 0.4;
        window.addEventListener('scroll', () => {
            if (window.scrollY >= scrollThreshold) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });
    </script>
    <!-- Terranean contour mountain — Panteon homepage point-cloud renderer -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
    <script>window.THREE||document.write('<script src="../vendor/three.r128.min.js"><\/script>')</script>
    <script>
        (function initTerraneanContourBackground() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const canvas = document.getElementById('webgl-bg-canvas');
            if (!canvas || typeof THREE === 'undefined') { if(canvas) canvas.style.display='none'; return; }
            let renderer;
            try {
                renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false, powerPreference: "high-performance" });
            } catch(e){ console.error('[Terranean] Contour WebGL failed', e); canvas.style.display='none'; return; }
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 18, 52);
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            const isDarkVariant = canvas.dataset.terrainTheme === 'dark';
            const palette = isDarkVariant
                ? { background: 0x000000, pointColor: 'vec3(1.0)' }
                : { background: 0xffffff, pointColor: 'vec3(0.08, 0.09, 0.10)' };
            renderer.setClearColor(palette.background, 1.0);
            function getTerrainHeight(x, z) {
                const r = Math.sqrt(x * x + z * z);
                const p1 = Math.exp(-Math.pow(x - 6, 2) / 280 - Math.pow(z - 4, 2) / 280) * 14.5;
                const p2 = Math.exp(-Math.pow(x + 12, 2) / 360 - Math.pow(z + 8, 2) / 320) * 18.0;
                const p3 = Math.exp(-Math.pow(x + 2, 2) / 200 - Math.pow(z - 14, 2) / 220) * 12.0;
                const ridge1 = Math.cos(x * 0.18 + z * 0.14) * Math.sin(z * 0.15 - x * 0.08) * 3.2;
                const ridge2 = Math.sin(x * 0.35 - z * 0.25) * Math.cos(z * 0.4 + x * 0.2) * 1.4;
                const decay = Math.exp(-Math.pow(r / 36, 2.2));
                return Math.max(0.0, (p1 + p2 + p3 + ridge1 + ridge2) * decay);
            }
            const positions = []; const alphas = []; const elevations = [];
            const gridSize = 140; const range = 42; const dx = (range * 2) / gridSize; const dz = (range * 2) / gridSize;
            const grid = [];
            for (let i = 0; i <= gridSize; i++) { grid[i] = []; const x = -range + i * dx; for (let j = 0; j <= gridSize; j++) { const z = -range + j * dz; grid[i][j] = getTerrainHeight(x, z); } }
            const numLevels = 85; const maxElevation = 18.0;
            for (let k = 1; k < numLevels; k++) {
                const levelY = (k / numLevels) * maxElevation;
                const levelAlpha = 0.18 + (k / numLevels) * 0.55;
                for (let i = 0; i < gridSize; i++) {
                    const x0 = -range + i * dx; const x1 = x0 + dx;
                    for (let j = 0; j < gridSize; j++) {
                        const z0 = -range + j * dz; const z1 = z0 + dz;
                        const v0 = grid[i][j]; const v1 = grid[i + 1][j]; const v2 = grid[i + 1][j + 1]; const v3 = grid[i][j + 1];
                        const crossings = [];
                        if ((v0 < levelY && v1 >= levelY) || (v0 >= levelY && v1 < levelY)) { const t = (levelY - v0) / (v1 - v0 + 1e-6); crossings.push({ x: x0 + t * dx, z: z0 }); }
                        if ((v1 < levelY && v2 >= levelY) || (v1 >= levelY && v2 < levelY)) { const t = (levelY - v1) / (v2 - v1 + 1e-6); crossings.push({ x: x1, z: z0 + t * dz }); }
                        if ((v3 < levelY && v2 >= levelY) || (v3 >= levelY && v2 < levelY)) { const t = (levelY - v3) / (v2 - v3 + 1e-6); crossings.push({ x: x0 + t * dx, z: z1 }); }
                        if ((v0 < levelY && v3 >= levelY) || (v0 >= levelY && v3 < levelY)) { const t = (levelY - v0) / (v3 - v0 + 1e-6); crossings.push({ x: x0, z: z0 + t * dz }); }
                        if (crossings.length >= 2) {
                            const pA = crossings[0]; const pB = crossings[1]; const dist = Math.hypot(pB.x - pA.x, pB.z - pA.z);
                            const steps = Math.max(2, Math.floor(dist * 2.8));
                            for (let s = 0; s <= steps; s++) { const frac = s / steps; positions.push(pA.x + (pB.x - pA.x) * frac, levelY - 4.5, pA.z + (pB.z - pA.z) * frac); alphas.push(levelAlpha); elevations.push(levelY); }
                        }
                    }
                }
            }
            for (let r = 0; r < 2400; r++) { const angle = Math.random() * Math.PI * 2; const radius = Math.sqrt(Math.random()) * 38; const sx = Math.cos(angle) * radius; const sz = Math.sin(angle) * radius; const sy = -4.8 + (Math.random() - 0.5) * 1.5; positions.push(sx, sy, sz); alphas.push(0.09 + Math.random() * 0.12); elevations.push(0.0); }
            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            geometry.setAttribute('aAlpha', new THREE.Float32BufferAttribute(alphas, 1));
            geometry.setAttribute('aElevation', new THREE.Float32BufferAttribute(elevations, 1));
            const uniforms = { uTime: { value: 0.0 }, uPixelRatio: { value: Math.min(window.devicePixelRatio, 2) }, uScroll: { value: 0.0 } };
            const vertexShader = `uniform float uTime; uniform float uPixelRatio; uniform float uScroll; attribute float aAlpha; attribute float aElevation; varying float vAlpha; varying float vDepth; void main() { vec3 pos = position; float wave = sin(pos.x * 0.12 + pos.z * 0.09 + uTime * 0.6) * 0.14; pos.y += wave * (aElevation / 18.0); vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0); gl_Position = projectionMatrix * mvPosition; gl_PointSize = (2.2 * uPixelRatio) * (45.0 / -mvPosition.z); gl_PointSize = clamp(gl_PointSize, 1.0, 7.5); vAlpha = aAlpha; vDepth = -mvPosition.z; }`;
            const fragmentShader = `varying float vAlpha; varying float vDepth; void main() { float dist = length(gl_PointCoord - vec2(0.5)); if (dist > 0.5) discard; float smoothDot = smoothstep(0.5, 0.28, dist); float depthFade = smoothstep(75.0, 25.0, vDepth); vec3 pointColor = ${palette.pointColor}; gl_FragColor = vec4(pointColor, smoothDot * vAlpha * depthFade * 0.82); }`;
            const material = new THREE.ShaderMaterial({ vertexShader, fragmentShader, uniforms, transparent: true, depthWrite: false, blending: THREE.NormalBlending });
            const pointsMesh = new THREE.Points(geometry, material);
            scene.add(pointsMesh);
            let scrollY = 0; let targetScrollY = 0; let mouseX = 0, mouseY = 0; let targetMouseX = 0, targetMouseY = 0;
            window.addEventListener('scroll', () => { const maxScroll = document.documentElement.scrollHeight - window.innerHeight; targetScrollY = maxScroll > 0 ? (window.scrollY / maxScroll) : 0; }, {passive:true});
            window.addEventListener('mousemove', (e) => { targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2; targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2; }, {passive:true});
            let isVisible = true;
            const heroObserver = new IntersectionObserver((entries)=>{ isVisible = entries[0].isIntersecting || window.scrollY < window.innerHeight; }, {threshold:0});
            const sentinel = document.getElementById('webgl-bg-canvas'); if(sentinel) heroObserver.observe(document.documentElement);
            document.addEventListener('visibilitychange', ()=>{ if(document.hidden) isVisible=false; else isVisible=true; });
            window.addEventListener('resize', () => { camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); uniforms.uPixelRatio.value = Math.min(window.devicePixelRatio, 2); });
            let clock = new THREE.Clock();
            function animate() {
                requestAnimationFrame(animate);
                if (!isVisible || document.hidden) return;
                const elapsedTime = clock.getElapsedTime();
                scrollY += (targetScrollY - scrollY) * 0.045; mouseX += (targetMouseX - mouseX) * 0.04; mouseY += (targetMouseY - mouseY) * 0.04;
                uniforms.uTime.value = elapsedTime; uniforms.uScroll.value = scrollY;
                pointsMesh.rotation.y = elapsedTime * 0.03 + scrollY * (Math.PI * 1.4) + mouseX * 0.25;
                pointsMesh.rotation.x = 0.42 + mouseY * 0.12 + Math.sin(scrollY * Math.PI) * 0.18;
                pointsMesh.position.y = -2.0 - scrollY * 6.0; pointsMesh.position.z = -scrollY * 10.0;
                camera.lookAt(0, 0, 0); renderer.render(scene, camera);
            }
            animate();
        })();
    </script>

</body>
</html>
