// ============================================================================
// Sensor footprint (FOV) cones — Maven-style wedges projected along each
// platform's heading. One GPU fill layer for the whole sky; the selected
// aircraft gets a brighter, wider cone in the accent color.
// ============================================================================

let fusionFovEnabled = false;
let fusionFovLayersAdded = false;

function ensureFusionFovLayers() {
    if (!fusionMap || fusionFovLayersAdded) return;
    fusionMap.addSource('sc-fov', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({
        id: 'sc-fov-fill', type: 'fill', source: 'sc-fov',
        paint: {
            'fill-color': ['get', 'color'],
            'fill-opacity': ['case', ['boolean', ['get', 'sel'], false], 0.24, 0.12],
        },
    });
    fusionMap.addLayer({
        id: 'sc-fov-line', type: 'line', source: 'sc-fov',
        paint: { 'line-color': ['get', 'color'], 'line-width': 1, 'line-opacity': 0.42 },
    });
    fusionFovLayersAdded = true;
}

function fovConeFeature(lngLat, headingDeg, radiusKm, halfAngleDeg, color, selected) {
    const pts = [[lngLat[0], lngLat[1]]];
    const steps = 6;
    for (let i = 0; i <= steps; i++) {
        const brg = (headingDeg - halfAngleDeg + (2 * halfAngleDeg) * (i / steps)) * Math.PI / 180;
        const dLat = (radiusKm * Math.cos(brg)) / 110.574;
        const dLng = (radiusKm * Math.sin(brg)) / (111.320 * Math.max(0.2, Math.cos(lngLat[1] * Math.PI / 180)));
        pts.push([lngLat[0] + dLng, lngLat[1] + dLat]);
    }
    pts.push(pts[0]);
    return {
        type: 'Feature',
        properties: { color: color, sel: !!selected },
        geometry: { type: 'Polygon', coordinates: [pts] },
    };
}

function updateFovLayer() {
    if (!fusionMap || !fusionFovLayersAdded) return;
    const empty = { type: 'FeatureCollection', features: [] };
    if (!fusionFovEnabled) {
        try { fusionMap.getSource('sc-fov').setData(empty); } catch (e) {}
        return;
    }
    const feats = [];
    for (const icao in fusionAircraftIndex) {
        const e = fusionAircraftIndex[icao];
        const p = (e.f && e.f.properties) || {};
        const gs = Number(p.speed_knots), hdg = Number(p.heading);
        if (!e.lngLat || !isFinite(gs) || gs < 40 || !isFinite(hdg)) continue;
        const altM = Number(p.alt);
        let rKm = isFinite(altM) && altM > 0 ? Math.min(85, Math.max(4, altM / 300)) : 18;
        const isSel = !!fusionSelectedIcao && icao === fusionSelectedIcao;
        feats.push(fovConeFeature(e.lngLat, hdg, rKm * (isSel ? 1.25 : 1), 22,
            isSel ? '#DFF140' : getColorForCategory(p.category), isSel));
    }
    try { fusionMap.getSource('sc-fov').setData({ type: 'FeatureCollection', features: feats }); } catch (e) {}
}

function fusionToggleFov() {
    fusionFovEnabled = !fusionFovEnabled;
    const btn = document.getElementById('fusionFovBtn');
    if (btn) btn.className = 'retro-map-btn' + (fusionFovEnabled ? ' retro-map-btn-active' : '');
    ensureFusionFovLayers();
    updateFovLayer();
}

// ============================================================================
// Motion engine — 1 Hz dead-reckoning: between authoritative feed refreshes
// every airborne marker glides along its ground speed and heading, so the sky
// visibly moves even while civilian ADS-B snapshots are minutes apart.
// ============================================================================

let _fusionLastMotionMs = Date.now();
let _fusionTickN = 0;

// Shared dead-reckoning interpolator: advances an entity along its velocity
// vector and exponentially converges toward the latest authoritative fix.
// Entry shape: { lngLat: [lng,lat], target: [lng,lat]|null, speed: kts, heading: deg }
// Returns true if the marker moved, false if static/uninitialized.
function smoothEntityTick(entry, dt) {
    if (!entry.lngLat) return false;
    const gs = Number(entry.speed), hdg = Number(entry.heading);
    if (!isFinite(hdg)) return false;
    if (!isFinite(gs)) { if (entry.target) entry.lngLat = entry.target; return false; }
    if (gs < 40) {
        if (entry.target && (entry.lngLat[0] !== entry.target[0] || entry.lngLat[1] !== entry.target[1])) {
            entry.lngLat = entry.target.slice();
            return true;
        }
        return false;
    }
    const km = gs * 1.852 * dt / 3600;
    const rad = hdg * Math.PI / 180;
    let lat = entry.lngLat[1] + (km * Math.cos(rad)) / 110.574;
    let lng = entry.lngLat[0] + (km * Math.sin(rad)) / (111.320 * Math.max(0.2, Math.cos(entry.lngLat[1] * Math.PI / 180)));
    if (entry.target) {
        const a = Math.min(1, dt * 2.2);
        lat += (entry.target[1] - lat) * a;
        lng += (entry.target[0] - lng) * a;
        if (Math.abs(lat - entry.target[1]) < 0.0004 && Math.abs(lng - entry.target[0]) < 0.0004) {
            lat = entry.target[1]; lng = entry.target[0];
        }
    }
    entry.lngLat = [lng, lat];
    return true;
}

// Re-anchor trail / speed-vector / route midline to the selected aircraft's
// GLIDING position every tick — without this the plane visibly detaches from
// its own lines between authoritative refreshes.
function updateSelectedTrackLive() {
    if (!fusionMap || !fusionTrackLayersAdded || !fusionSelectedIcao) return;
    const e = fusionAircraftIndex[fusionSelectedIcao];
    if (!e || !e.lngLat) return;
    const cur = e.lngLat;
    const p = (e.f && e.f.properties) || {};
    // Extend the historical trail with the live position so nose sits ON the line.
    if (fusionTrackFixes.length >= 2) {
        try {
            fusionMap.getSource('sc-track-line').setData({
                type: 'Feature', properties: {},
                geometry: { type: 'LineString', coordinates: fusionTrackFixes.concat([cur]) },
            });
        } catch (err) {}
    }
    // Speed vector anchored at the live gliding position.
    const gsKts = Number(p.speed_knots), hdg = Number(p.heading);
    if (isFinite(gsKts) && isFinite(hdg) && gsKts > 20) {
        const kmAhead = gsKts * (10 / 60) * 1.852;
        const rad = hdg * Math.PI / 180;
        const dLat = (kmAhead * Math.cos(rad)) / 110.574;
        const dLng = (kmAhead * Math.sin(rad)) / (111.320 * Math.max(0.2, Math.cos(cur[1] * Math.PI / 180)));
        try {
            fusionMap.getSource('sc-track-vector').setData({
                type: 'Feature', properties: {},
                geometry: { type: 'LineString', coordinates: [cur, [cur[0] + dLng, cur[1] + dLat]] },
            });
        } catch (err) {}
    }
    // Route line's middle vertex tracks the aircraft.
    if (fusionRouteEndpoints) {
        try {
            fusionMap.getSource('sc-route-line').setData({
                type: 'Feature', properties: {},
                geometry: { type: 'LineString', coordinates: [fusionRouteEndpoints.origin, cur, fusionRouteEndpoints.dest] },
            });
        } catch (err) {}
    }
}

let fusionMotionEnabled = true;

function fusionToggleMotion() {
    fusionMotionEnabled = !fusionMotionEnabled;
    const btn = document.getElementById('fusionMotionBtn');
    if (btn) btn.className = 'retro-map-btn' + (fusionMotionEnabled ? ' retro-map-btn-active' : '');
}

function fusionMotionTick() {
    if (document.hidden || !fusionMap) return;
    _fusionTickN++;
    if (fusionMotionEnabled) {
        const nowMs = Date.now();
        const dt = Math.min(2, Math.max(0.01, (nowMs - _fusionLastMotionMs) / 1000));
        _fusionLastMotionMs = nowMs;
        const b = fusionMap.getBounds();
        const padLat = (b.getNorth() - b.getSouth()) * 0.3;
        const padLng = (b.getEast() - b.getWest()) * 0.3;
        const nB = b.getNorth() + padLat, sB = b.getSouth() - padLat;
        const eB = b.getEast() + padLng, wB = b.getWest() - padLng;

        for (const icao in fusionAircraftIndex) {
            const e = fusionAircraftIndex[icao];
            const p = (e.f && e.f.properties) || {};
            e.speed = Number(p.speed_knots);
            e.heading = Number(p.heading);
            if (!e.lngLat || !isFinite(e.heading)) continue;
            // Viewport culling: off-screen markers freeze until they matter.
            const ll = e.lngLat;
            if (ll[0] < wB || ll[0] > eB || ll[1] < sB || ll[1] > nB) continue;
            if (smoothEntityTick(e, dt)) {
                try { e.mk.setLngLat(e.lngLat); } catch (err) {}
            }
        }
        if (fusionFovEnabled && (_fusionTickN % 2 === 0)) updateFovLayer();
        updateSelectedTrackLive();
    }
    // Follow camera: throttled short eases (~3 Hz) chain into a smooth pursuit.
    if (fusionFollow && fusionSelectedIcao && (_fusionTickN % 3 === 0)) {
        const selEntry = fusionAircraftIndex[fusionSelectedIcao];
        if (selEntry && selEntry.lngLat) {
            try { fusionMap.easeTo({ center: selEntry.lngLat, duration: 430 }); } catch (err) {}
        }
    }
}

// ============================================================================
// Track selection / trails / follow camera (Maven-style lock-on).
// Click an aircraft -> persistent selection ring + dossier card with position
// history trail, projected speed vector and adsbdb origin/destination route.
// ============================================================================

let fusionAircraftIndex = {};
let fusionSelectedIcao = null;
let fusionFollow = false;
let fusionTrackLayersAdded = false;
// Live anchors so trails/vectors stay glued to gliding aircraft between draws.
let fusionTrackFixes = [];        // authoritative history coords of selected track
let fusionRouteEndpoints = null;  // {origin:[lng,lat], dest:[lng,lat]} when route drawn

function haversineKm(lat1, lng1, lat2, lng2) {
    const R = 6371, rad = Math.PI / 180;
    const dLat = (lat2 - lat1) * rad, dLng = (lng2 - lng1) * rad;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(a));
}

function ensureFusionTrackLayers() {
    if (!fusionMap || fusionTrackLayersAdded) return;
    // Trail polyline from fix history
    fusionMap.addSource('sc-track-line', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({ id: 'sc-track-line', type: 'line', source: 'sc-track-line', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': '#DFF140', 'line-width': 2.2, 'line-opacity': 0.85 } });
    fusionMap.addSource('sc-track-dots', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({ id: 'sc-track-dots', type: 'circle', source: 'sc-track-dots', paint: { 'circle-radius': 2.6, 'circle-color': '#DFF140', 'circle-opacity': 0.75 } });
    // Projected speed vector (where it will be in ~10 min)
    fusionMap.addSource('sc-track-vector', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({ id: 'sc-track-vector', type: 'line', source: 'sc-track-vector', layout: { 'line-cap': 'round' }, paint: { 'line-color': '#22d3ee', 'line-width': 1.8, 'line-opacity': 0.9, 'line-dasharray': [2, 2] } });
    // Route origin -> aircraft -> destination
    fusionMap.addSource('sc-route-line', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({ id: 'sc-route-line', type: 'line', source: 'sc-route-line', layout: { 'line-cap': 'round' }, paint: { 'line-color': '#f59e0b', 'line-width': 1.6, 'line-opacity': 0.7, 'line-dasharray': [1.5, 2] } });
    fusionMap.addSource('sc-route-airports', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    fusionMap.addLayer({ id: 'sc-route-airports-fill', type: 'circle', source: 'sc-route-airports', paint: { 'circle-radius': 4.5, 'circle-color': '#f59e0b', 'circle-stroke-color': '#000', 'circle-stroke-width': 1.5 } });
    try {
        fusionMap.addLayer({ id: 'sc-route-airports-label', type: 'symbol', source: 'sc-route-airports', layout: { 'text-field': ['get', 'label'], 'text-font': ['Noto Sans Regular'], 'text-size': 10, 'text-offset': [0, 1.1], 'text-anchor': 'top' }, paint: { 'text-color': '#f59e0b', 'text-halo-color': '#000', 'text-halo-width': 1.2 } });
    } catch (e) { /* label font unavailable on this style — circles still render */ }
    fusionTrackLayersAdded = true;
}

function clearFusionTrackOverlays() {
    if (!fusionMap || !fusionTrackLayersAdded) return;
    ['sc-track-line', 'sc-track-dots', 'sc-track-vector', 'sc-route-line'].forEach(id => {
        try { fusionMap.getSource(id).setData({ type: 'FeatureCollection', features: [] }); } catch (e) {}
    });
    try { fusionMap.getSource('sc-route-airports').setData({ type: 'FeatureCollection', features: [] }); } catch (e) {}
    fusionTrackFixes = [];
    fusionRouteEndpoints = null;
}

function drawFusionTrack(track, flightProps, route) {
    ensureFusionTrackLayers();
    if (!fusionMap) return;
    // Switching targets must never leak the previous aircraft's lines.
    clearFusionTrackOverlays();
    const fixes = (track && track.fixes) || [];
    const empty = { type: 'FeatureCollection', features: [] };
    if (fixes.length >= 2) {
        const coords = fixes.filter(fx => fx.lat != null && fx.lng != null).map(fx => [fx.lng, fx.lat]);
        fusionTrackFixes = coords.slice();
        fusionMap.getSource('sc-track-line').setData(coords.length >= 2 ? { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: coords } } : empty);
        fusionMap.getSource('sc-track-dots').setData({ type: 'FeatureCollection', features: coords.map(c => ({ type: 'Feature', properties: {}, geometry: { type: 'Point', coordinates: c } })) });
    } else {
        fusionTrackFixes = [];
        fusionMap.getSource('sc-track-line').setData(empty);
        fusionMap.getSource('sc-track-dots').setData(empty);
    }
    // Speed vector: heading-projected 10-minute dead-reckoning line.
    const gsKts = Number(flightProps && flightProps.speed_knots);
    const hdg = Number(flightProps && flightProps.heading);
    const cur = fusionSelectedIcao ? (fusionAircraftIndex[fusionSelectedIcao] || {}).lngLat : null;
    if (cur && isFinite(gsKts) && isFinite(hdg) && gsKts > 20) {
        const kmAhead = gsKts * (10 / 60) * 1.852;
        const rad = hdg * Math.PI / 180;
        const dLat = (kmAhead * Math.cos(rad)) / 110.574;
        const dLng = (kmAhead * Math.sin(rad)) / (111.320 * Math.max(0.2, Math.cos(cur[1] * Math.PI / 180)));
        fusionMap.getSource('sc-track-vector').setData({
            type: 'Feature', properties: {},
            geometry: { type: 'LineString', coordinates: [cur, [cur[0] + dLng, cur[1] + dLat]] },
        });
    } else {
        fusionMap.getSource('sc-track-vector').setData(empty);
    }
    // Route line origin -> current -> destination + airport markers.
    const feats = [];
    const rPts = [];
    if (route && route.found && route.origin && route.origin.lat != null) {
        rPts.push(route.origin);
    }
    if (route && route.found && route.destination && route.destination.lat != null) {
        rPts.push(route.destination);
    }
    if (rPts.length === 2 && cur) {
        fusionRouteEndpoints = { origin: [route.origin.lng, route.origin.lat], dest: [route.destination.lng, route.destination.lat] };
        fusionMap.getSource('sc-route-line').setData({
            type: 'Feature', properties: {},
            geometry: { type: 'LineString', coordinates: [[route.origin.lng, route.origin.lat], cur, [route.destination.lng, route.destination.lat]] },
        });
        [route.origin, route.destination].forEach((a, i) => {
            feats.push({
                type: 'Feature',
                properties: { label: (a.icao || a.iata || '?') + (a.municipality ? ' · ' + a.municipality : '') },
                geometry: { type: 'Point', coordinates: [a.lng, a.lat] },
            });
        });
    }
    fusionMap.getSource('sc-route-airports').setData({ type: 'FeatureCollection', features: feats });
}

function ftcRow(k, v) { return '<span class="k">' + k + '</span><span class="v">' + v + '</span>'; }

function renderTrackCard(flightProps, track, route) {
    const card = document.getElementById('fusionTrackCard');
    if (!card || !flightProps) return;
    card.classList.remove('fusion-track-hidden');
    document.getElementById('ftcCallsign').textContent = flightProps.callsign || flightProps.icao24 || '—';
    const catEl = document.getElementById('ftcCat');
    catEl.textContent = flightProps.category || '?';
    catEl.style.color = getColorForCategory(flightProps.category);
    const fixes = (track && track.fixes) || [];
    const lastFix = fixes.length ? fixes[fixes.length - 1] : null;
    const ageS = lastFix ? Math.round(Date.now() / 1000 - lastFix.t) : null;
    document.getElementById('ftcGrid').innerHTML =
        ftcRow('MODEL', escapeHtml(String(flightProps.model || '?'))) +
        ftcRow('REG', escapeHtml(String(flightProps.registration || '—'))) +
        ftcRow('ALT', (flightProps.alt != null ? Number(flightProps.alt).toLocaleString() + ' ft' : '—')) +
        ftcRow('SPD', (flightProps.speed_knots != null ? Math.round(Number(flightProps.speed_knots)) + ' kts' : '—')) +
        ftcRow('HDG', (flightProps.heading != null ? Number(flightProps.heading) + '°' : '—')) +
        ftcRow('SQUAWK', escapeHtml(String(flightProps.squawk || '—'))) +
        ftcRow('ICAO24', escapeHtml(String(flightProps.icao24 || '—'))) +
        ftcRow('FIXES', String(fixes.length)) +
        ftcRow('POS', ((flightProps.lat != null ? Number(flightProps.lat).toFixed(3) : '—') + ', ' + (flightProps.lng != null ? Number(flightProps.lng).toFixed(3) : '—'))) +
        ftcRow('AGE', (ageS != null ? ageS + 's ago' : '—'));
    // Route block. undefined = lookup still in flight; false-y found = none filed.
    const rEl = document.getElementById('ftcRoute');
    const cs = String(flightProps.callsign || '').trim();
    if (route === null || route === undefined) {
        rEl.innerHTML = cs ? 'Resolving route&hellip;' : 'No callsign — route lookup not possible.';
    } else if (route && route.found && route.origin && route.destination) {
        const fmt = a => [a.icao || a.iata || '?', a.municipality || a.name || '', a.country || ''].filter(Boolean).join(' · ');
        let etaTxt = '';
        try {
            const dist = haversineKm(Number(flightProps.lat), Number(flightProps.lng), Number(route.destination.lat), Number(route.destination.lng));
            const gs = Number(flightProps.speed_knots);
            if (gs > 40) {
                const h = dist / (gs * 1.852);
                etaTxt = ' · ETA ' + (h >= 1 ? Math.floor(h) + 'h ' : '') + Math.round((h % 1) * 60) + 'm';
            }
            etaTxt += ' · ' + Math.round(dist) + ' km to go';
        } catch (e) {}
        rEl.innerHTML = '<b>DEP</b> ' + escapeHtml(fmt(route.origin)) + '<br><b>ARR</b> ' + escapeHtml(fmt(route.destination)) + escapeHtml(etaTxt);
    } else if (route && route.reason === 'lookup_unavailable') {
        rEl.innerHTML = 'Route lookup temporarily unavailable.';
    } else {
        rEl.innerHTML = 'No filed route for this callsign (GA / military traffic often has none).';
    }
}

let _fusionSelectSeq = 0;

async function selectFusionAircraft(icao24Raw) {
    const icao24 = String(icao24Raw || '').toLowerCase();
    if (!icao24 || !fusionMap) return;
    const selToken = ++_fusionSelectSeq;
    fusionSelectedIcao = icao24;
    // Re-stamp highlight without a full re-render.
    fusionAviationMarkers.forEach(mk => {
        const el = mk.getElement() && mk.getElement().firstChild;
        if (!el) return;
        el.classList.remove('ac-glyph-selected');
    });
    const entry = fusionAircraftIndex[icao24];
    if (entry) {
        const el = entry.mk.getElement().firstChild;
        if (el) el.classList.add('ac-glyph-selected');
    }
    const props = entry ? (entry.f.properties || {}) : {};
    renderTrackCard(props, { fixes: [] }, undefined); // "Resolving…" skeleton
    try { fusionMap.flyTo({ center: (entry && entry.lngLat) || fusionMap.getCenter(), zoom: Math.max(fusionMap.getZoom(), 6.5), duration: 550 }); } catch (e) {}

    let lastTrack = { fixes: [] };
    let lastProps = props;
    let lastRoute = null; // null = still resolving, false-y .found = none filed
    const repaint = () => {
        if (selToken !== _fusionSelectSeq) return; // user picked another plane meanwhile
        renderTrackCard(lastProps, lastTrack, lastRoute);
        drawFusionTrack(lastTrack, lastProps, lastRoute);
    };

    // Trail + dossier first — no adsbdb dependency, paints instantly.
    api('/opensky/flights/track/' + encodeURIComponent(icao24) + '?with_route=false').then(d => {
        if (!d || d.error || selToken !== _fusionSelectSeq) return;
        lastTrack = d.track || { fixes: [] };
        lastProps = Object.assign({}, props, d.flight || {});
        repaint();
    }).catch(() => {});

    // Route enrichment in parallel so it never blocks the trail.
    const cs = String(props.callsign || '').trim();
    if (cs) {
        api('/opensky/flights/route/' + encodeURIComponent(cs)).then(r => {
            if (!r || selToken !== _fusionSelectSeq) return;
            lastRoute = r;
            repaint();
        }).catch(() => {});
    }
}

function deselectFusionAircraft() {
    fusionSelectedIcao = null;
    setFusionFollow(false);
    fusionAviationMarkers.forEach(mk => {
        const el = mk.getElement() && mk.getElement().firstChild;
        if (el) el.classList.remove('ac-glyph-selected');
    });
    const card = document.getElementById('fusionTrackCard');
    if (card) card.classList.add('fusion-track-hidden');
    clearFusionTrackOverlays();
}

function setFusionFollow(on) {
    fusionFollow = !!on;
    const btn = document.getElementById('ftcFollowBtn');
    if (btn) {
        btn.textContent = 'Follow: ' + (fusionFollow ? 'on' : 'off');
        btn.className = 'retro-map-btn' + (fusionFollow ? ' retro-map-btn-active' : '');
