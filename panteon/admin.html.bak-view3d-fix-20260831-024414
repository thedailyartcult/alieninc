/* --- MSS MODE GATEWAY (Manual → full deck, Automatic → YONO-only) — sea/terrain scan language --- */
.mss-hidden{display:none !important;}
.mss-mode-toggle{cursor:pointer;flex:none;font-family:var(--font-mono);font-size:8px;letter-spacing:.1em;
  border:1px solid rgba(223,241,64,.35);border-radius:0;padding:3px 6px;color:var(--accent-neon);user-select:none;}
.mss-mode-toggle:hover{border-color:rgba(223,241,64,.7);background:rgba(223,241,64,.08);}
.mss-gateway{position:relative;display:flex;flex-direction:column;gap:0;padding:0;flex:1;min-height:0;overflow:hidden;overflow-y:auto;isolation:isolate;background:var(--bg-card);transition:background-color 0.4s ease,border-color 0.4s ease}
.mss-gateway.mss-hidden{display:none !important;}
.mss-gateway-shell{position:relative;z-index:1;display:flex;flex-direction:column;gap:22px;padding:28px 18px 20px;flex:1;min-height:0;background:var(--bg-panel);margin:10px;border:1px solid var(--border-color);max-width:720px;width:calc(100% - 20px);align-self:center;box-shadow:0 12px 40px rgba(0,0,0,0.28);overflow:hidden;transition:background-color 0.4s ease,border-color 0.4s ease,color 0.4s ease}[data-theme="light"] .mss-gateway-shell{background:rgba(255,255,255,0.96);border-color:rgba(0,0,0,0.12);box-shadow:0 12px 40px rgba(0,0,0,0.12)}
.mss-gateway-shell::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(520px 180px at 78% 4%, rgba(223,241,64,0.08), transparent 62%), radial-gradient(420px 160px at 12% 92%, rgba(128,224,255,0.06), transparent 60%);animation:mss-wash-drift 12s ease-in-out infinite alternate}
@keyframes mss-wash-drift{0%{transform:translateX(0)}100%{transform:translateX(-10px)}}
.mss-gateway-shell > *{position:relative;z-index:1}
.mss-art-ghost{position:absolute;right:-6px;top:14px;z-index:0;pointer-events:none;font-family:var(--font-tech);font-weight:700;font-size:88px;line-height:1;letter-spacing:-0.04em;color:rgba(255,255,255,0.06);transform:rotate(0.5deg);user-select:none;transition:color 0.4s ease}[data-theme="light"] .mss-art-ghost{color:rgba(0,0,0,0.045)}
.mss-art-rule{height:1px;display:flex;gap:0;margin-top:6px}
.mss-art-rule span{flex:1;height:1px;background:var(--border-color);opacity:0.55;transition:background-color 0.4s ease}[data-theme="light"] .mss-art-rule span{background:rgba(0,0,0,0.09);opacity:1}
.mss-art-rule span.mss-art-rule--neon{flex:0 0 84px;background:var(--accent-neon);opacity:0.9}
.mss-gateway-shell .section-header-bar{position:relative;z-index:1}
.dimension-transition-overlay{position:absolute;inset:0;z-index:3;pointer-events:none;background:var(--bg-dark,#000);transition:opacity 0.8s cubic-bezier(0.16,1,0.3,1),transform 0.8s cubic-bezier(0.16,1,0.3,1);display:flex;align-items:center;justify-content:center;opacity:1;transform:scale(1)}
.dimension-transition-overlay.dim-passed{opacity:0;transform:scale(1.08);pointer-events:none}
.dimension-transition-overlay .dim-grid-line{position:absolute;background:rgba(223,241,64,0.14)}
.dimension-transition-overlay .dim-grid-v{width:1px;top:0;bottom:0;left:50%}
.dimension-transition-overlay .dim-grid-h{height:1px;left:0;right:0;top:50%}
.section-header-bar{max-width:720px;width:100%;padding:0 0 14px;border-bottom:1px solid var(--border-color);margin:0;transition:border-color 0.4s ease}
.section-header-bar .section-badge{display:inline-flex;font-family:var(--font-mono);font-size:10.4px;letter-spacing:0.08em;text-transform:uppercase;background:var(--text);color:var(--bg);padding:6px 14px;transition:background-color 0.4s ease,color 0.4s ease}[data-theme="light"] .section-header-bar .section-badge{background:#000;color:#fff}
.section-header-bar h2{font-family:var(--font-tech);font-weight:300;font-size:1.65rem;letter-spacing:-0.02em;line-height:1.15;margin:10px 0 8px;color:var(--text);overflow:hidden;transition:color 0.4s ease}
.section-header-bar p{font-family:var(--font-sans);font-size:13px;line-height:1.6;color:var(--text-muted);margin:0;max-width:44em;overflow:hidden;transition:color 0.4s ease}
.reveal-text-line{display:block;overflow:hidden}
.reveal-text-line .reveal-inner{display:block;transform:translate3d(0,115%,0) scale(1.02);filter:blur(6px);opacity:0;transition:transform 1.1s cubic-bezier(0.16,1,0.3,1),filter 1.1s,opacity 1.1s;will-change:transform,filter,opacity}
.reveal-text-line.revealed .reveal-inner{transform:translate3d(0,0,0) scale(1);filter:blur(0);opacity:1}
.software-grid-matrix{display:grid;grid-template-columns:1fr 1fr;gap:18px;width:100%}
.software-grid-matrix.mss-gw-cards{display:grid}
@media (max-width:520px){.software-grid-matrix{grid-template-columns:1fr}}
.mss-gateway-shell .mss-mode-card{background:var(--bg-card);border:1px solid var(--border-color);color:var(--text);box-shadow:none;transition:background-color 0.4s ease,border-color 0.4s ease,color 0.4s ease}
.mss-gateway-shell .mss-mc-title{color:var(--text)}
.mss-gateway-shell .mss-mc-desc{color:var(--text-muted)}
.mss-gateway-shell .mss-mc-meta{color:var(--text-muted)}
.mss-gateway-shell .mss-mc-mark{color:var(--text)}
.mss-gateway-shell .mss-mc-cta{border-color:var(--border-color);color:var(--text)}
.mss-gateway-shell .mss-mc-cta:hover{background:var(--text);color:var(--bg)}
.mss-gateway-shell .mss-mc-icon--manual{border-color:var(--border-color)}
.mss-gateway-shell .mss-gw-foot{border-top:1px solid var(--border-color);padding-top:10px;margin-top:8px}
.mss-gateway-shell .mss-gw-hint{color:var(--text-muted)}
.mss-gateway-shell .mss-gw-model{border-color:var(--border-color);color:var(--text-muted)}
[data-theme="light"] .mss-gateway-shell .mss-mode-card{background:#fff;border-color:rgba(0,0,0,0.12);color:#000}
[data-theme="light"] .mss-gateway-shell .mss-mc-title{color:#000}
[data-theme="light"] .mss-gateway-shell .mss-mc-desc{color:#555658}
[data-theme="light"] .mss-gateway-shell .mss-mc-meta{color:#71717a}
[data-theme="light"] .mss-gateway-shell .mss-mc-mark{color:#000}
[data-theme="light"] .mss-gateway-shell .mss-mc-cta{border-color:#000;color:#000}
[data-theme="light"] .mss-gateway-shell .mss-mc-cta:hover{background:#000;color:#fff}
[data-theme="light"] .mss-gateway-shell .mss-mc-icon--manual{border-color:rgba(0,0,0,0.12)}
[data-theme="light"] .mss-gateway-shell .mss-gw-foot{border-top-color:rgba(0,0,0,0.12)}
[data-theme="light"] .mss-gateway-shell .mss-gw-model{border-color:rgba(0,0,0,0.15)}
/* WebGL terrain/sea canvas — gateway-only, behind cards, above bg-card (isolation) */
#mssWebglCanvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;display:block;opacity:1;transition:opacity .5s ease;}
#mssWebglCanvas.mss-webgl-hidden{opacity:0;pointer-events:none;}
/* CSS fallback scan — hidden when WebGL is live, shown when THREE missing or reduced-motion */
.mss-scan-bg{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.0;
  background:
    repeating-linear-gradient(0deg, transparent 0 14px, rgba(223,241,64,.07) 14px 15px),
    repeating-linear-gradient(90deg, transparent 0 28px, rgba(128,224,255,.045) 28px 29px),
    radial-gradient(120% 70% at 50% 0%, rgba(223,241,64,.07), transparent 60%);transition:opacity .4s;}
.mss-scan-bg.mss-fallback-on{opacity:.42;}
.mss-scan-line{position:absolute;left:0;right:0;height:48px;z-index:0;pointer-events:none;opacity:0;
  background:linear-gradient(180deg, transparent, rgba(223,241,64,.16), transparent);
  transform:translateY(-120%);animation:mss-scan 3.2s linear infinite;mix-blend-mode:screen;}
.mss-scan-line.mss-fallback-on{opacity:.9;}
@keyframes mss-scan{0%{transform:translateY(-28%)}100%{transform:translateY(360%)}}
.mss-gw-kicker{position:relative;z-index:1;font-family:var(--font-mono);font-size:8px;letter-spacing:.14em;color:var(--text-muted);display:flex;align-items:center;gap:7px;}
.mss-gw-q{position:relative;z-index:1;font-family:var(--font-tech);font-weight:300;font-size:18px;letter-spacing:.06em;color:var(--text);line-height:1.1;transition:color 0.4s ease;}
.mss-gw-sub{position:relative;z-index:1;font-family:var(--font-sans);font-size:11px;line-height:1.5;color:var(--text-muted);max-width:32em;}
.mss-gw-cards{position:relative;z-index:1;display:flex;gap:8px;margin-top:4px;}
.mss-mode-card{flex:1;display:flex;flex-direction:column;gap:5px;text-align:left;padding:12px 10px;
  background:rgba(255,255,255,.04);border:1px solid var(--border-color);border-radius:0;cursor:pointer;
  transition:border-color .18s,background .18s,transform .22s cubic-bezier(0.16,1,0.3,1),box-shadow .22s,filter .22s;will-change:transform;}
.mss-mode-card:active{transform:none;}
.mss-mode-card:focus-visible{outline:1px solid var(--accent-neon);outline-offset:2px;}
.mss-mode-card[data-mss="manual"]:hover{border-color:var(--border-color) !important;background:var(--bg-panel) !important;transform:none !important;box-shadow:none !important;filter:none !important}[data-theme="light"] .mss-mode-card[data-mss="manual"]:hover{border-color:rgba(0,0,0,0.16) !important;background:#fff !important}
.mss-mode-card[data-mss="automatic"]:hover{border-color:rgba(128,224,255,0.55) !important;background:rgba(128,224,255,0.08) !important;transform:translateY(-5px) scale(1.015) !important;box-shadow:0 14px 28px rgba(0,0,0,0.32) !important;filter:drop-shadow(0 0 8px rgba(128,224,255,0.22)) !important}[data-theme="light"] .mss-mode-card[data-mss="automatic"]:hover{background:#f0fbff !important;box-shadow:0 14px 28px rgba(0,0,0,0.16) !important}
.mss-mode-card[data-mss="automatic"]:hover .mss-mc-cta{transform:translateX(2px);}
.mss-mode-card[data-mss="manual"]:hover .mss-mc-cta{transform:none;}
.mss-mode-card.is-selecting{transform:scale(.97) !important;border-color:var(--accent-neon) !important;background:rgba(223,241,64,.13) !important;transition-duration:.12s !important;}
.mss-mc-icon{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;flex:none;margin-bottom:6px;padding:4px;border:1px solid rgba(255,255,255,0.06);background:rgba(0,0,0,0.28);position:relative;overflow:hidden;transition:background-color 0.4s ease,border-color 0.4s ease}[data-theme="light"] .mss-mc-icon{background:rgba(0,0,0,0.04);border-color:rgba(0,0,0,0.08)}
.mss-mc-icon--manual{border-color:rgba(223,241,64,0.22);box-shadow:inset 0 0 0 1px rgba(223,241,64,0.06), 0 0 14px rgba(223,241,64,0.10)}
.mss-mc-icon--auto{border-color:rgba(128,224,255,0.22);box-shadow:inset 0 0 0 1px rgba(128,224,255,0.06), 0 0 14px rgba(128,224,255,0.10)}
.mss-mode-card:hover .mss-mc-icon--manual{border-color:rgba(223,241,64,0.55);box-shadow:inset 0 0 0 1px rgba(223,241,64,0.12), 0 0 18px rgba(223,241,64,0.16)}
.mss-mode-card:hover .mss-mc-icon--auto{border-color:rgba(128,224,255,0.55);box-shadow:inset 0 0 0 1px rgba(128,224,255,0.12), 0 0 18px rgba(128,224,255,0.16)}
.mss-icon-reticle{transform-origin:21px 21px}
.mss-mc-icon--manual .mss-icon-reticle{animation:none}
.mss-orbit-outer,.mss-orbit-inner{transform-origin:21px 21px}
.mss-orbit-outer{animation:mss-orbit-spin 7s linear infinite}
.mss-orbit-inner{animation:mss-orbit-spin-rev 11s linear infinite}
.mss-mode-card[data-mss="automatic"]:hover .mss-orbit-outer{animation-duration:3.2s}
.mss-mode-card[data-mss="automatic"]:hover .mss-orbit-inner{animation-duration:5s}
@keyframes mss-orbit-spin{to{transform:rotate(360deg)}}
@keyframes mss-orbit-spin-rev{to{transform:rotate(-360deg)}}
.mss-art-ghost{animation:mss-ghost-drift 14s ease-in-out infinite alternate}
@keyframes mss-ghost-drift{0%{transform:translateX(0) rotate(0.5deg)}100%{transform:translateX(-6px) rotate(0deg)}}
@media (prefers-reduced-motion:reduce){.mss-orbit-outer,.mss-orbit-inner,.mss-art-ghost{animation:none !important}}
.mss-mode-card:nth-child(1){--mss-hd:40ms} .mss-mode-card:nth-child(2){--mss-hd:110ms}
/* entrance — dimension reveal + hive bloom stagger (index.html:87 reveal-text-line + hive-layer 0.38s) */
.mss-gateway.mss-enter .mss-gw-kicker{transition:transform .55s cubic-bezier(0.16,1,0.3,1) 0ms,opacity .45s 0ms,filter .55s 0ms}
.mss-gateway.mss-enter .mss-gw-q{transition:transform .6s cubic-bezier(0.16,1,0.3,1) 80ms,opacity .45s 80ms,filter .6s 80ms}
.mss-gateway.mss-enter .mss-gw-sub{transition:transform .55s cubic-bezier(0.16,1,0.3,1) 140ms,opacity .45s 140ms,filter .55s 140ms}
.mss-gateway.mss-enter .mss-gw-cards{transition:opacity .3s 180ms}
.mss-gateway.mss-enter .mss-gw-foot{transition:transform .5s cubic-bezier(0.16,1,0.3,1) 320ms,opacity .4s 320ms}
#mssGateway.mss-enter-pre > *:not(.mss-scan-bg):not(.mss-scan-line){opacity:0;transform:translate3d(0,14px,0);filter:blur(6px)}
#mssGateway.mss-enter > *:not(.mss-scan-bg):not(.mss-scan-line){opacity:1;transform:none;filter:none}
#mssGateway.mss-enter-pre .mss-mode-card{opacity:0;transform:translateY(10px) scale(.98)}
