function initFusionMap() {
    if (fusionMapInitialized) { if (fusionMap) fusionMap.resize(); return fusionMap; }
    if (typeof maplibregl === 'undefined' || !document.getElementById('fusionMap')) return null;
    fusionMap = new maplibregl.Map({
        container: 'fusionMap',
        style: 'https://tiles.openfreemap.org/styles/dark',
        center: [20, 18],
        zoom: 1.6,
        pitch: 0,
        bearing: 0,
        maxPitch: 85,
        attributionControl: { compact: true },
        canvasContextAttributes: { antialias: true, preserveDrawingBuffer: true },
    });
    window.fusionMap = fusionMap;
    window.map = fusionMap;
    fusionMap.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'bottom-left');
    (function guardRenderLoop() {
        var lastMsg = '';
        function probeOnce(msg) {
            if (msg === lastMsg) return;
            lastMsg = msg;
            console.error('[MV PROBE]', msg);
        }
        var tq = fusionMap._renderTaskQueue;
        if (tq && !tq.__mvPatched) {
            tq.__mvPatched = true;
            var origRun = tq.run;
            tq.run = function (t) {
                if (this._currentlyRunning) {
                    this._currentlyRunning = false;
                    this._cleared = false;
                    probeOnce('TASK QUEUE WAS WEDGED (maplibre #6093) \u2014 auto-healed, painting resumed');
                }
                try {
                    return origRun.call(this, t);
                } catch (err) {
                    this._currentlyRunning = false;
                    this._cleared = false;
                    probeOnce('RENDER TASK THREW:\n' + (err && err.message || err) +
                        '\n' + String((err && err.stack) || '').split('\n').slice(1, 5).join('\n'));
                    return;
                }
            };
        }
        var origRender = fusionMap._render;
        fusionMap._render = function () {
            try {
                return origRender.apply(this, arguments);
            } catch (err) {
                try { this._renderTaskQueue._currentlyRunning = false; this._renderTaskQueue._cleared = false; } catch (e2) {}
                probeOnce('RENDER FRAME THREW:\n' + (err && err.message || err) +
                    '\n' + String((err && err.stack) || '').split('\n').slice(1, 5).join('\n'));
                return null;
            }
        };
    })();
    fusionMap.on('style.load', () => {
        if (!fusionMap || fusionMap.getLayer('3d-buildings')) return;
        fusionMap.addLayer({
            id: '3d-buildings',
            source: 'openmaptiles',
            'source-layer': 'building',
            type: 'fill-extrusion',
            minzoom: 13,
            paint: {
                'fill-extrusion-color': BUILDING_HEIGHT_RAMP,
                'fill-extrusion-height': ['interpolate', ['linear'], ['zoom'], 13, 0, 14, ['get', 'render_height']],
                'fill-extrusion-base': ['case', ['>=', ['get', 'zoom'], 16], ['get', 'render_min_height'], 0],
                'fill-extrusion-opacity': 0.75
            }
        });
        fusion3dAdded = true;
        fusionMap.setLayoutProperty('3d-buildings', 'visibility', fusionLayers['3d'] ? 'visible' : 'none');
        const b = document.getElementById('fusionLayer3d');
        if (b) b.className = 'retro-map-btn' + (fusionLayers['3d'] ? ' retro-map-btn-active' : '');
    });
    fusionMapInitialized = true;
    // Load router layer data
    loadRouterData();
    return fusionMap;
}

// Normalize both sources to a common point shape for the unified renderer.
// {lat, lng, source, type, label, color, popup, raw}
function normalizeThreatPoint(ev, wonIdx) {
    const geo = parseActionGeo(ev);
    if (!geo) return null;
    const tone = threatLevelForEvent(ev);
    return {
        lat: geo.latitude, lng: geo.longitude, source: 'gdelt', type: 'threat',
        label: 'CAMEO ' + (ev.event_code || '?'),
        color: tone === 'red' ? '#ef4444' : tone === 'amber' ? '#f59e0b' : '#22c544',
        popup: '<b>' + THREAT_LABEL[tone] + '</b> · CAMEO ' + (ev.event_code || '?') + ' · ' + (ev.event_type || '') +
            '<br>COUNTRY: ' + (geo.country || '-') +
            '<br>TITLE: ' + (ev.title ? (ev.title.length > 90 ? ev.title.slice(0, 90) + '…' : ev.title) : ' — ') +
            '<br>SOURCE: ' + (ev.domain || '-') +
            '<br>DATE: ' + (ev.event_date || '') +
            (wonIdx != null ? '<br><button type="button" class="won-note-btn" data-won-threat="' + wonIdx + '">+ Note</button>' : ''),
    };
}

function normalizeAircraftPoint(f, wonIdx) {
    const props = f.properties || {};
    const lat = props.lat, lng = props.lng;
    if (lat == null || lng == null) return null;
    const icaoSafe = String(props.icao24 || '').replace(/[^a-zA-Z0-9]/g, '');
    return {
        lat: lat, lng: lng, source: 'opensky', type: 'aviation',
        label: (props.callsign || '—') + ' [' + (props.category || '?') + ']',
        color: getColorForCategory(props.category),
        popup: '<b>' + (props.callsign || '—') + '</b> · ' + (props.category || '?') +
            '<br>MODEL: ' + (props.model || '?') +
            '<br>ALT: ' + (props.alt || '?') + ' ft' +
            '<br>SPEED: ' + (props.speed_knots || '?') + ' kts' +
            '<br>HEADING: ' + (props.heading || '?') +
            '<br>ICAO24: ' + (props.icao24 || '?') +
            '<br>COORD: [' + lat + ', ' + lng + ']' +
            (icaoSafe ? '<br><button type="button" class="won-note-btn" onclick="selectFusionAircraft(\'' + icaoSafe + '\')">&#9678; Track</button>' : '') +
            (wonIdx != null ? ' <button type="button" class="won-note-btn" data-won-air="' + wonIdx + '">+ Note</button>' : ''),
    };
}

