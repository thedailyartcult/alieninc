            text-align: left;
            padding: 12px 8px;
            color: #041E42;
            border-bottom: 2px solid #e5e7eb;
        }
        td {
            padding: 12px 8px;
            color: #425363;
            border-bottom: 1px solid #e5e7eb;
        }
