async function performOSINTLookup() {
    const query = document.getElementById('osintQuery').value.trim();
    if (!query) return;

    const resultsDiv = document.getElementById('osintResults');
    resultsDiv.innerHTML = '<div class="empty-state"><span class="loading"></span> Analyzing...</div>';

    try {
        let result;
        const isIP = /^(\d{1,3}\.){3}\d{1,3}$/.test(query);
        const isDomain = /^[a-zA-Z0-9][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/.test(query);

        if (isIP) {
            result = await api(`/crackerbox/ip?ip=${encodeURIComponent(query)}`);
            resultsDiv.innerHTML = renderIPResult(result);
        } else if (isDomain) {
            result = await api(`/crackerbox/whois?domain=${encodeURIComponent(query)}`);
            resultsDiv.innerHTML = renderDomainResult(result);
        } else {
            result = await api(`/crackerbox/sanctions?query=${encodeURIComponent(query)}&limit=10`);
            resultsDiv.innerHTML = renderSanctionsResult(result);
        }
    } catch (e) {
        resultsDiv.innerHTML = `<div class="empty-state" style="color:var(--red)">Error: ${e.message}</div>`;
    }
}

function renderIPResult(data) {
    let html = '<div style="display:grid;gap:16px">';
    
    if (data.sanctions_match && data.sanctions_match.hits.length > 0) {
        html += '<div style="background:rgba(244,63,94,0.1);border:1px solid var(--red);padding:16px;border-radius:8px">';
        html += '<div style="font-weight:600;color:var(--red);margin-bottom:8px">⚠ SANCTIONS MATCH DETECTED</div>';
        data.sanctions_match.hits.forEach(hit => {
            html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px">Matched: ${hit.matched_value}</div>`;
            hit.entries.forEach(entry => {
                html += `<div style="padding:8px;background:var(--bg);border-radius:4px;margin-top:4px;font-size:11px">`;
                html += `<div style="font-weight:500">${entry.name}</div>`;
                html += `<div style="color:var(--text-muted)">${entry.schema} · ${entry.countries.join(', ')}</div>`;
                html += `</div>`;
            });
        });
        html += '</div>';
    }

    if (data.geo) {
        html += '<div class="grid grid-3">';
        html += `<div class="card"><div class="card-title">Country</div><div style="font-size:14px;font-weight:500;margin-top:4px">${data.geo.country || '--'}</div></div>`;
        html += `<div class="card"><div class="card-title">City</div><div style="font-size:14px;font-weight:500;margin-top:4px">${data.geo.city || '--'}</div></div>`;
        html += `<div class="card"><div class="card-title">ISP</div><div style="font-size:14px;font-weight:500;margin-top:4px">${data.geo.isp || '--'}</div></div>`;
        html += '</div>';
    }

    if (data.reputation) {
        html += '<div class="card"><div class="card-title">Reputation</div>';
        html += '<div style="display:flex;gap:8px;margin-top:8px">';
        if (data.reputation.is_proxy) html += '<span class="tag tag-red">Proxy</span>';
        if (data.reputation.is_hosting) html += '<span class="tag tag-amber">Hosting</span>';
        if (data.reputation.is_mobile) html += '<span class="tag">Mobile</span>';
        html += `<span class="tag ${data.reputation.risk_level === 'HIGH' ? 'tag-red' : data.reputation.risk_level === 'MEDIUM' ? 'tag-amber' : ''}">${data.reputation.risk_level} Risk</span>`;
        html += '</div></div>';
    }

    html += '</div>';
    return html;
}

function renderDomainResult(data) {
    let html = '<div style="display:grid;gap:16px">';
    
    if (data.sanctions_match && data.sanctions_match.hits.length > 0) {
        html += '<div style="background:rgba(244,63,94,0.1);border:1px solid var(--red);padding:16px;border-radius:8px">';
        html += '<div style="font-weight:600;color:var(--red);margin-bottom:8px">⚠ SANCTIONS MATCH DETECTED</div>';
        data.sanctions_match.hits.forEach(hit => {
            html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px">Matched: ${hit.matched_value}</div>`;
        });
        html += '</div>';
    }

    if (data.rdap) {
        html += '<div class="card"><div class="card-title">Registration Data</div>';
        html += '<div style="display:grid;gap:8px;margin-top:8px;font-size:12px">';
        if (data.registration) html += `<div><span style="color:var(--text-muted)">Registered:</span> ${new Date(data.registration).toLocaleDateString()}</div>`;
        if (data.expiration) html += `<div><span style="color:var(--text-muted)">Expires:</span> ${new Date(data.expiration).toLocaleDateString()}</div>`;
        if (data.rdap.entities && data.rdap.entities.length > 0) {
            html += '<div style="margin-top:8px"><span style="color:var(--text-muted)">Entities:</span></div>';
            data.rdap.entities.forEach(ent => {
                html += `<div style="padding:6px;background:var(--bg);border-radius:4px;margin-top:4px">${ent.name || ent.org || '--'} ${ent.roles ? '(' + ent.roles.join(', ') + ')' : ''}</div>`;
            });
        }
        html += '</div></div>';
    }

    if (data.security_score) {
        const gradeColor = data.security_score.grade === 'A' ? 'var(--green)' : data.security_score.grade === 'B' ? 'var(--cyan)' : data.security_score.grade === 'C' ? 'var(--amber)' : 'var(--red)';
        html += '<div class="card"><div class="card-title">Security Score</div>';
        html += `<div style="display:flex;align-items:center;gap:12px;margin-top:8px">`;
        html += `<div style="font-size:32px;font-weight:700;color:${gradeColor}">${data.security_score.grade}</div>`;
        html += `<div><div style="font-size:14px;font-weight:500">${data.security_score.score}/${data.security_score.max}</div><div style="font-size:11px;color:var(--text-muted)">Security headers implemented</div></div>`;
        html += '</div></div>';
    }

    html += '</div>';
    return html;
}

function renderSanctionsResult(data) {
    if (!data.matches || data.matches.length === 0) {
        return '<div class="empty-state">No matches found</div>';
    }

    let html = '<div style="display:grid;gap:8px">';
    html += `<div style="font-size:12px;color:var(--text-muted);margin-bottom:8px">${data.total} match${data.total !== 1 ? 'es' : ''} found</div>`;
    
    data.matches.forEach(match => {
        html += '<div style="padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:6px">';
        html += `<div style="font-weight:500;font-size:13px">${match.name}</div>`;
        html += `<div style="font-size:11px;color:var(--text-muted);margin-top:4px">${match.schema} · ${match.countries.join(', ')}</div>`;
        html += `<div style="font-size:11px;color:var(--text-dim);margin-top:4px">${match.sanctions}</div>`;
        if (match.aliases && match.aliases.length > 0) {
            html += `<div style="font-size:10px;color:var(--text-dim);margin-top:4px">Aliases: ${match.aliases.slice(0, 3).join(', ')}${match.aliases.length > 3 ? '...' : ''}</div>`;
        }
        html += '</div>';
    });
    
    html += '</div>';
    return html;
}

