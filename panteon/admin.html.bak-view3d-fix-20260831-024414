            m.fitBounds([[b.lomin, b.lamin], [b.lomax, b.lamax]],
                { padding: 40, duration: 1400, maxZoom: 12 });
        } catch (e) {}
    }
        var ps = $('mavenPlaceSearch');
        if (ps) {
            var pt2 = null;
            ps.addEventListener('input', function () {
                S.placeSearch = ps.value;
                clearTimeout(pt2);
                pt2 = setTimeout(renderPlaces, 180);
