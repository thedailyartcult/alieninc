                        <!-- HUD Command Line Navigation Help -->
                        <div class="retro-map-hint-banner">
                            <div class="retro-map-hint-text">[ DRAG: PAN • SCROLL: ZOOM • SHIFT+DRAG: TILT 3D • CLICK COORDINATES ]</div>
                        </div>


                        <!-- Command Preset Toolbar Sector Presets -->
                        <div class="retro-map-toolbar">
                            <button onclick="filterDataCenters('foundry')" id="filter-btn-foundry" class="retro-map-btn retro-map-btn-filter">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="2" x2="9" y2="4"/><line x1="15" y1="2" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="22"/><line x1="15" y1="20" x2="15" y2="22"/><line x1="20" y1="9" x2="22" y2="9"/><line x1="20" y1="14" x2="22" y2="14"/><line x1="2" y1="9" x2="4" y2="9"/><line x1="2" y1="14" x2="4" y2="14"/></svg>
                                Silicon Fabrication
                            </button>
                            <button onclick="filterDataCenters('hyperscale')" id="filter-btn-hyperscale" class="retro-map-btn retro-map-btn-filter">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                                Cloud &amp; Edge
                            </button>
                            <button onclick="filterDataCenters('colocation')" id="filter-btn-colocation" class="retro-map-btn retro-map-btn-filter">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                                Network &amp; Colo
                            </button>
                            <button onclick="filterDataCenters('all')" id="filter-btn-all" class="retro-map-btn retro-map-btn-filter active">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                All Facilities
                            </button>
                            <button onclick="resetMapView()" class="retro-map-btn retro-map-btn-reset">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                                Reset Array
                            </button>
                        </div>

                        <!-- Custom Terminal Inspector Sidebar Panel -->
                        <div id="node-inspector" class="retro-map-inspector closed">
                            <div class="retro-map-inspector-header">
                                <h2 class="retro-map-inspector-title">COMPANY PROFILE</h2>
                                <button onclick="toggleInspector(false)" class="retro-map-inspector-close">&times;</button>
                            </div>
                            <div id="inspector-content" class="retro-map-inspector-content">
                                <p style="color: rgba(74, 222, 128, 0.6); text-align: center; margin-top: 15px;">SELECT A NETWORK MARKER OR SECTOR TO VIEW ITS OPERATING PROFILE.</p>
                            </div>
                        </div>

                    </div>
                <p style="font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.6; margin-top: 3rem; text-align: center; max-width: 48rem; margin-left: auto; margin-right: auto;">
                    Every subsidiary under ALIEN.INC operates as its own signal — distinct, self-contained, transmitting from a strategic node within the Luzon Economic Corridor. This is where they broadcast from.
                </p>

                <!-- CTA Action Link styled exactly to declassified visual specifications -->
                <div class="wp-block-buttons is-content-justification-center aliens-cta-button">
                    <div class="wp-block-button">
                        <a class="wp-block-button__link wp-element-button" href="https://alieninc.tech" target="_blank" rel="noreferrer noopener">
                            EXPLORE THE NETWORK → VISIT ALIENINC.TECH
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Declassified Addendum Panel -->
        <section id="reveal" class="section">
            <div class="aliens-addendum-box">
                <p class="aliens-addendum-label">CLASSIFIED ADDENDUM • DECLASSIFIED 2026</p>
                <h2 class="aliens-reveal-headline">THIS WASN'T A DISAPPEARANCE.</h2>
                <p class="aliens-yellow-warning">
                    alien.inc didn't vanish — it relocated. The name held since 2016 needed a domain that couldn't be mistaken for anyone else's territory. alieninc.tech is that domain. Same origin. New coordinates. No conflict left unresolved.
                </p>
            </div>
        </section>

        <!-- Newsletter Registration/Opt-In panel matching WH styled components -->
        <section class="email-form section">
            <h3>Stay Informed of Transmissions From the Network</h3>
            <form id="optin-form" onsubmit="handleForm(event)">
                <div style="text-align: left; margin-bottom: 1.5rem;">
                    <label class="whitehouse-form__label" for="email">
                        Email Address <span class="whitehouse-form__required">* Required</span>
                    </label>
                    <input class="whitehouse-form__field" type="email" id="email" required placeholder="name@domain.com">
                </div>
                <input type="submit" value="JOIN THE SIGNAL" class="whitehouse-form__button">
            </form>
            <div id="form-msg" style="margin-top: 1rem; display: none;" class="neon-cyan"></div>
        </section>

        <!-- Footer block -->
        <footer class="aliens-footer">
            ALIEN.INC © 2026 • ALIENINC.TECH
        </footer>

    </div>

    <!-- Active scripts (Starfield + Typing Loop + Split Flaps mechanics + Network Map) -->
    <script src="../data/network-map-data.js?v=5"></script>
    <script>
  // ── ALIEN.INC Network Map Data ──────────────────────────────────
  // Node, district, and city data is loaded from the ecosystem JSON
  // single source of truth (networkMap section) via network-map-data.js.
  // No financial data is rendered on this map.
  // GeoJSON Networks (fable Custom Railway Grids & Highway Segments)
  const luzonRailwaysGeoJSON = {
      "type": "FeatureCollection",
      "features": [
          {
              "type": "Feature",
              "properties": { "name": "North-South Commuter Railway (NSCR)", "type": "nscr" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [121.0500, 14.5500], // BGC
                      [121.0244, 14.5547], // Makati
                      [120.9842, 14.5995], // Manila Tutuban
                      [120.9800, 14.6100], // Caloocan
                      [120.9100, 14.7500], // Meycauayan
                      [120.8100, 14.8700], // Malolos
                      [120.6000, 15.0200], // San Fernando
                      [120.5518, 15.1761], // Clark Centra
                      [120.5429, 15.3377]  // NCC
                  ]
              }
          },
          {
              "type": "Feature",
              "properties": { "name": "Subic-Clark Rail Link", "type": "subic-clark" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [120.2833, 14.8250], // Subic
                      [120.4500, 14.9700], // Dinalupihan
                      [120.5200, 15.0500], // Floridablanca
                      [120.5518, 15.1761]  // Clark
                  ]
              }
          },
          {
              "type": "Feature",
              "properties": { "name": "Metro Manila Subway Grid", "type": "subway" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [121.0400, 14.6500], // North Ave
                      [121.0600, 14.5900], // Ortigas
                      [121.0500, 14.5500], // BGC
                      [121.0190, 14.5560], // Makati
                      [121.0100, 14.5100]  // FTI
                  ]
              }
          }
      ]
  };

  const luzonHighwaysGeoJSON = {
      "type": "FeatureCollection",
      "features": [
          {
              "type": "Feature",
              "properties": { "name": "EDSA Corridor", "status": "severe" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [120.9950, 14.5467], // Pasay
                      [121.0244, 14.5547], // Makati
                      [121.0333, 14.5833], // Mandaluyong
                      [121.0350, 14.6100], // Ortigas
                      [121.0400, 14.6500]  // Quezon City
                  ]
              }
          },
          {
              "type": "Feature",
              "properties": { "name": "North Luzon Expressway (NLEX)", "status": "moderate" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [120.9800, 14.6100], // Caloocan
                      [120.9600, 14.7000], // Valenzuela
                      [120.8700, 14.8300], // Marilao
                      [120.8100, 14.8700], // Malolos
                      [120.7100, 14.9800], // Apalit
                      [120.6900, 15.0300], // San Fernando
                      [120.5900, 15.1500]  // Angeles
                  ]
              }
          },
          {
              "type": "Feature",
              "properties": { "name": "SCTEX Corridor", "status": "fluid" },
              "geometry": {
                  "type": "LineString",
                  "coordinates": [
                      [120.2833, 14.8250], // Subic
                      [120.4500, 14.9700], // Dinalupihan
                      [120.5200, 15.0500], // Floridablanca
                      [120.5518, 15.1761], // Clark
                      [120.5429, 15.3377]  // NCC
                  ]
              }
          }
      ]
  };

  let activeMapInstance = null;
  let minimapInstance = null;
  let boundsInstance = null;
  let mapMarkers = [];
  let activeFilter = 'all';
  let districtMarkers = [];
  let searchMarkerInstance = null;

  // Real building-height color ramp (meters, from OpenMapTiles render_height).
  const BUILDING_HEIGHT_RAMP = [
      'interpolate', ['linear'], ['get', 'render_height'],
      0, '#062d18',      // Ground level
      30, '#0f5132',     // Low-rise
      100, '#198754',    // Mid-rise
      250, '#4ade80',    // High-rise
      500, '#22d3ee'     // Skyline peaks
  ];

  // --- GRID FLOW: alieninc "live-grid" connection animation ---
  // Original implementation in the threat-map design language: each connection is
  // ONE static SVG <path> in an overlay <svg> over the map, drawn with the
  // stroke-dasharray/stroke-dashoffset trick, then slid forward while fading out.
  // The naming (agf = alieninc grid flow) and the control-point sweep are ours.
  const AGF_DRAW_MS = 1000;         // draw the dash over this long
  const AGF_FADE_DELAY_MS = 1250;   // hold, then start the fade
  const AGF_FADE_MS = 2000;         // slide + fade length
  const AGF_THICKNESS = 2;          // 2px lines
  const AGF_COLORS = ['#ffb72d', '#ff1d24', '#b81fff'];  // amber / red / violet
  const AGF_SPAWN_MS = 140;         // one new path every 140ms (~30 concurrent)
  const AGF_MAX_ACTIVE = 30;

  // ease-in-out == cubic-bezier(0.42, 0, 0.58, 1) — smooth, non-linear draw/slide
  function agfEase(x) {
      return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2;
  }

  // alieninc signature sweep: same S-curve as the design language, but the control
  // point is pulled in a touch more (32/22) with a faint downward baseline bias, so
  // the arc family reads as ours. Same-point (self-circling) nodes get a small loop.
  function agfPath(sx, sy, dx, dy) {
      if (sx === dx && sy === dy) {
          const d = 24 + 11 * 3 * Math.random();
          return 'M ' + sx + ' ' + sy + ' c ' + d + ' ' + (-d) + ' ' + (-d) + ' ' + (-d) + ' 0 0';
      }
      const jx = 3 * Math.random();
      const jy = 3 * Math.random();
      const cx = (sx + dx) / 2 + 32 * jx - 2;
      const cy = Math.abs((sy + dy) / 2 - 22 * jy) + 4;
      return 'M ' + sx + ' ' + sy + ' S ' + cx + ' ' + cy + ' ' + dx + ' ' + dy;
  }

  let agfArcs = null;    // [{from, to, color}] company->company connections
  let agfLoops = [];     // [{node, color}] self-circling data-center loops

  // Build the connection set from the live network nodes: hub-spoke from ALIEN.INC
  // HQ (amber) + nearest-2 mesh (red/violet), plus self-circling loops on the HQ and
  // every third data center so the "ping the node itself" loops show up too.
  // Authentic bloc coloring for the GRID FLOW animation: arcs are tinted by the
  // facility operator's allegiance so the live grid reflects the Pax Silica
  // (yellow, matching the Alien Inc. HQ) vs WAICO (red) split among the newly
  // created facilities. Operators not matched fall back to the neutral mesh color.
  const AGF_PAX = '#ffd400';
  const AGF_WAICO = '#f87171';
  const AGF_PAX_OPS = ['GOOGLE','MICROSOFT','AMAZON','AWS','META','APPLE','TSMC','SAMSUNG','SK HYNIX','MICRON','INTEL','GLOBALFOUNDRIES','ASML','UMC','ST MICRO','TEXAS INSTRUMENTS','IBM','EQUINIX','DIGITAL REALTY','CORESITE','SWITCH','NTT','KDDI','TELEHOUSE','NEXTDC','ST TELEMEDIA','ADANICONNEX','CTRLS','NAVER','IRON MOUNTAIN','BAHNHOF','NSA','CERN','ORACLE','YOTTA'];
  const AGF_WAICO_OPS = ['ALIBABA','TENCENT','BAIDU','HUAWEI','BYTEDANCE','SMIC','YMTC','CXMT','HUA HONG','CHINA'];

  function agfBlocColor(node) {
      if (!node || !node.name) return AGF_COLORS[0];
      const nm = node.name.toUpperCase();
      if (AGF_WAICO_OPS.some(o => nm.indexOf(o) === 0)) return AGF_WAICO;
      if (AGF_PAX_OPS.some(o => nm.indexOf(o) === 0)) return AGF_PAX;
      return AGF_COLORS[0];
  }

  function agfBuild() {
      const nodes = (window.aliensNetworkNodes || []).filter(n => n && n.lat != null && n.lng != null);
      agfArcs = [];
      agfLoops = [];
      if (nodes.length < 2) return;
      const hq = nodes.find(n => n.name === 'ALIEN.INC') || nodes[0];
      const seen = new Set();
      const key = (a, b) => {
          const ia = nodes.indexOf(a), ib = nodes.indexOf(b);
          return ia < ib ? ia + ':' + ib : ib + ':' + ia;
      };
      const add = (from, to, color) => {
          const k = key(from, to);
          if (seen.has(k)) return;
          seen.add(k);
          agfArcs.push({ from, to, color });
      };
      nodes.forEach(n => { if (n !== hq) add(hq, n, agfBlocColor(n)); });
      const others = nodes.filter(n => n !== hq);
      others.forEach(n => {
          const nearest = others
              .filter(m => m !== n)
              .map(m => ({ m, d: (m.lng - n.lng) ** 2 + (m.lat - n.lat) ** 2 }))
              .sort((a, b) => a.d - b.d)
              .slice(0, 2);
          nearest.forEach((entry, i) => add(n, entry.m, agfBlocColor(entry.m)));
      });
      nodes.forEach((n, i) => {
          if (i % 3 === 0) agfLoops.push({ node: n, color: agfBlocColor(n) });
      });
  }

  let agfOverlay = null;
  let agfPaths = [];
  let agfActive = 0;
  let agfSpawnTimer = null;
  let agfRunning = false;
  let agfEnabled = false;
  let agfArcCursor = 0;
  let agfLoopCursor = 0;
  let agfTick = 0;
  let agfEventsBound = false;

  function agfEnsureOverlay() {
      if (agfOverlay && agfOverlay.isConnected) return agfOverlay;
      const mapEl = document.getElementById('aliens-network-map');
      if (!mapEl) return null;
      agfOverlay = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      agfOverlay.setAttribute('class', 'alieninc-gridflow-overlay');
      mapEl.appendChild(agfOverlay);
      return agfOverlay;
  }

  // Arc lifecycle: dashoffset len->0 over 1000ms (draw), hold to 1250ms, then
  // dashoffset 0->-len while opacity->0 over 2000ms — the line slides forward past
  // the target as it fades out.
  function agfAnimate(el, len) {
      agfActive++;
      el.style.strokeDasharray = len + ' ' + len;
      el.style.strokeDashoffset = len;
      el.style.opacity = '1';
      const t0 = performance.now();
      const drawEnd = AGF_DRAW_MS;
      const fadeStart = AGF_FADE_DELAY_MS;
      const total = AGF_FADE_DELAY_MS + AGF_FADE_MS;
      function tick(now) {
          const t = now - t0;
          if (t < drawEnd) {
              const e = agfEase(t / drawEnd);
              el.style.strokeDashoffset = (len * (1 - e)).toFixed(2);
          } else if (t < fadeStart) {
              el.style.strokeDashoffset = '0';
          } else if (t < total) {
              const e = agfEase((t - fadeStart) / AGF_FADE_MS);
              el.style.strokeDashoffset = (-len * e).toFixed(2);
              el.style.opacity = (1 - e).toFixed(3);
          } else {
              if (el.parentNode) el.parentNode.removeChild(el);
              const idx = agfPaths.indexOf(el);
              if (idx !== -1) {
                  agfPaths.splice(idx, 1);
                  agfActive = Math.max(0, agfActive - 1);
              }
              return;
          }
          requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
  }

  function agfClear() {
      if (agfOverlay) {
          while (agfOverlay.firstChild) agfOverlay.removeChild(agfOverlay.firstChild);
      }
      agfPaths = [];
      agfActive = 0;
  }

  function agfSpawnPath(d, color) {
      const svg = agfEnsureOverlay();
      if (!svg) return;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', d);
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', color);
      path.setAttribute('stroke-width', String(AGF_THICKNESS));
      svg.appendChild(path);
      agfPaths.push(path);
      agfAnimate(path, path.getTotalLength());
  }

  // Every 3rd spawn is a self-circling loop so those keep appearing between the
  // cross-site arcs; the rest round-robin the hub/mesh connections.
  function agfSpawn() {
      if (!agfRunning || !activeMapInstance) return;
      if (agfActive >= AGF_MAX_ACTIVE) return;
      let d = null, color = null;
      if (agfLoops.length && (agfTick % 3 === 0)) {
          const c = agfLoops[agfLoopCursor % agfLoops.length];
          agfLoopCursor++;
          const p = activeMapInstance.project([c.node.lng, c.node.lat]);
          d = agfPath(p.x, p.y, p.x, p.y);
          color = c.color;
      } else if (agfArcs.length) {
          const c = agfArcs[agfArcCursor % agfArcs.length];
          agfArcCursor++;
          const a = activeMapInstance.project([c.from.lng, c.from.lat]);
          const b = activeMapInstance.project([c.to.lng, c.to.lat]);
          d = agfPath(a.x, a.y, b.x, b.y);
          color = c.color;
      }
      agfTick++;
      if (d) agfSpawnPath(d, color);
  }

  function agfPause() {
      if (!agfRunning) return;
      agfRunning = false;
      if (agfSpawnTimer) { clearInterval(agfSpawnTimer); agfSpawnTimer = null; }
      agfClear();
  }

  function agfResume() {
      if (agfEnabled && !agfRunning && activeMapInstance) agfStart();
  }

  function agfBindEvents() {
      if (agfEventsBound || !activeMapInstance) return;
      agfEventsBound = true;
      activeMapInstance.on('movestart', agfPause);
      activeMapInstance.on('moveend', agfResume);
      activeMapInstance.on('zoomstart', agfPause);
      activeMapInstance.on('zoomend', agfResume);
      activeMapInstance.on('resize', () => {
          if (agfEnabled) {
              if (agfRunning) agfPause();
              agfStart();
          }
      });
  }

  function agfStart() {
      if (agfRunning || !activeMapInstance) return;
      agfArcs = null; // rebuild fresh each session (nodes may have changed)
      agfBuild();
      if (!agfArcs.length && !agfLoops.length) return;
      agfRunning = true;
      agfBindEvents();
      agfEnsureOverlay();
      agfSpawn();
      agfSpawnTimer = setInterval(agfSpawn, AGF_SPAWN_MS);
  }

  function agfStop() {
      agfRunning = false;
      if (agfSpawnTimer) { clearInterval(agfSpawnTimer); agfSpawnTimer = null; }
      agfClear();
  }

  // Applies real group numbers from the ecosystem source of truth to the HUD.
  // The DATABASE STATUS card was removed; only the sector-count write remains.
  function applyEcosystemSummary() {
      const summary = window.ecosystemSummary;
      if (!summary) return;

      const sectorsEl = document.getElementById('retro-focus-stat1-val');
      if (sectorsEl && summary.nodeCount && sectorsEl.textContent.trim().indexOf('SECTORS') !== -1) {
          sectorsEl.textContent = `${summary.nodeCount} SECTORS`;
      }
  }

  // Company search: backed by /api/techstack — searches the global_tech_stack
  // database (SQLite) server-side. Featured data centers return their tech
  // stack publicly; non-featured companies (S&P 500 / scraped) return
  // locked=true unless the caller is authenticated (teaser-then-lock).
  function initSearch() {
      const input = document.getElementById('retro-company-search');
      const resultsEl = document.getElementById('retro-search-results');
      if (!input || !resultsEl) return;

      let debounceTimer = null;
      let lastQuery = '';

      const close = () => resultsEl.classList.remove('retro-map-search-open');

      input.addEventListener('input', () => {
          const q = input.value.trim();
          if (q === lastQuery) return;
          lastQuery = q;
          clearTimeout(debounceTimer);
          if (!q) { resultsEl.innerHTML = ''; close(); return; }
          debounceTimer = setTimeout(() => fetchSearchResults(q, resultsEl, close), 200);
      });

      input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
              close();
              input.blur();
          }
      });

      resultsEl.addEventListener('pointerdown', (e) => e.preventDefault());

      document.addEventListener('click', (e) => {
          const panel = input.closest('.retro-map-search');
          if (panel && panel.contains(e.target)) return;
          close();
      });
  }

  function fetchSearchResults(query, resultsEl, close) {
      fetch('/api/techstack?q=' + encodeURIComponent(query) + '&limit=8')
          .then((res) => res.json())
          .then((data) => renderSearchResults(data, resultsEl, close))
          .catch((err) => {
              console.warn('[TechStack] search failed:', err);
              resultsEl.innerHTML = `<div class="retro-map-search-empty">SEARCH SERVICE UNAVAILABLE</div>`;
              resultsEl.classList.add('retro-map-search-open');
          });
  }

  function renderSearchResults(data, resultsEl, close) {
      resultsEl.innerHTML = '';
      const top = data.results || [];
      if (!top.length) {
          resultsEl.innerHTML = `<div class="retro-map-search-empty">NO MATCHES — CHECK THE SOURCE OF TRUTH</div>`;
          resultsEl.classList.add('retro-map-search-open');
          return;
      }

      top.forEach((item) => {
          const subLine = `${item.city || '—'} • ${item.sector || '—'}`;
          let stackLine;
          if (item.locked) {
              stackLine = '▶ INTELLIGENCE LOCKED';
          } else if (item.techStack && item.techStack.length) {
              stackLine = item.techStack.slice(0, 5).map((t) => t.name).join(' / ');
          } else {
              stackLine = 'Not yet ready to share';
          }
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'retro-map-search-item' + (item.locked ? ' retro-map-search-item-locked' : '');
          btn.innerHTML = `
              <div class="retro-map-search-item-title">${item.name}</div>
              <div class="retro-map-search-item-sub">${subLine}</div>
              <div class="retro-map-search-item-stack">${stackLine}</div>`;
          btn.addEventListener('click', () => {
              openSearchResult(item);
              close();
          });
          resultsEl.appendChild(btn);
      });

      resultsEl.classList.add('retro-map-search-open');
  }

  function openSearchResult(item) {
      placeSearchMarker(item);

      // If the result matches a node already on the map, use the full
      // inspector (which includes the group company record if present).
      const matchedNode = (window.aliensNetworkNodes || []).find(
          (n) => n.name === item.name || (Math.abs(n.lng - item.lng) < 0.01 && Math.abs(n.lat - item.lat) < 0.01)
      );
      if (matchedNode && !item.locked) {
          inspectNode(matchedNode, true);
          return;
      }

      if (!activeMapInstance) return;
      activeMapInstance.flyTo({
          center: [item.lng, item.lat],
          zoom: 14.5,
          pitch: 55,
          bearing: 5,
          duration: 2000
      });

      updateHUD(item.name, 'GRID ACCESS GRANTED', `LAT/LNG: ${item.lat.toFixed(4)} / ${item.lng.toFixed(4)}`);

      toggleInspector(true);
      const inspectorContent = document.getElementById('inspector-content');
      inspectorContent.innerHTML = `<p style="color: #22d3ee; animation: aliens-blink 1s step-end infinite; text-align: center; margin-top: 20px;">[ RETRIEVING COMPANY PROFILE... ]</p>`;

      setTimeout(() => {
          inspectorContent.innerHTML = renderApiProfile(item);
      }, 550);
  }

  // Profile panel for an API-returned tech-stack entry.
  function renderApiProfile(item) {
      const latHemi = item.lat >= 0 ? 'N' : 'S';
      const lngHemi = item.lng >= 0 ? 'E' : 'W';

      let stackHtml;
      if (item.locked) {
          stackHtml = `
              <div class="retro-lock-panel retro-lock-panel__scanline">
                  <div class="retro-lock-panel__header">
                      <div class="retro-lock-panel__icon"></div>
                      <div class="retro-lock-panel__title">Access Restricted</div>
                  </div>
                  <div class="retro-lock-panel__msg">Technology stack intelligence requires authenticated access. This data is classified under the Alien Inc. partner program.</div>
                  <a href="/api/login" class="retro-lock-panel__btn" >▶ Authenticate</a>
              </div>`;
      } else if (item.techStack && item.techStack.length) {
          stackHtml = item.techStack.map((t) =>
              `<div class="retro-map-inspector-stack-row"><span>${t.name}</span><em>${t.role || ''}</em></div>`
          ).join('');
      } else {
          stackHtml = '<div class="retro-map-inspector-stack-row"><span>Not yet ready to share</span></div>';
      }

      const rows = `
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">COMPANY NAME</dt>
              <dd class="retro-map-inspector-dd">${item.name}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">CITY</dt>
              <dd class="retro-map-inspector-dd">${item.city || '—'}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">SECTOR</dt>
              <dd class="retro-map-inspector-dd">${item.sector || '—'}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">COORDINATES</dt>
              <dd class="retro-map-inspector-dd">${Math.abs(item.lat).toFixed(4)}${latHemi}, ${Math.abs(item.lng).toFixed(4)}${lngHemi}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">TECH STACK</dt>
              <dd class="retro-map-inspector-dd">${stackHtml}</dd>
          </div>`;

      const footer = item.locked
          ? `<div class="retro-map-inspector-intel" style="border-top-color:rgba(245,158,11,0.15);color:#f59e0b;"><strong>INTEL GATE:</strong><br>Full technology stack available to authenticated partners only. Location data is public; stack intelligence requires access clearance.</div>`
          : '';

      return `<dl>${rows}</dl>${footer}`;
  }

  // Search selection pin: a company-style dot with the searched company's name.
  function placeSearchMarker(item) {
      if (!activeMapInstance) return;
      if (searchMarkerInstance) searchMarkerInstance.remove();

      const el = document.createElement('div');
      el.className = 'retro-map-node-marker retro-map-search-marker';
      el.innerHTML = `
          <div class="retro-map-marker-tag">${item.name}</div>
          <div class="retro-map-marker-line"></div>
          <div class="retro-map-marker-glow"></div>`;

      searchMarkerInstance = new maplibregl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat([item.lng, item.lat])
          .addTo(activeMapInstance);
  }

  function clearSearchMarker() {
      if (searchMarkerInstance) {
          searchMarkerInstance.remove();
          searchMarkerInstance = null;
      }
  }

  function initNetworkMap() {
      const mapEl = document.getElementById('aliens-network-map');
      if (!mapEl || typeof maplibregl === 'undefined') return;

      applyEcosystemSummary();
      // Snap HUD to the real default state immediately — don't leave the
      // static "NETWORK STANDBY" placeholder visible while tiles load,
      // and don't wait for the first `move` event to refresh it.
      (function applyInitialFocusHUD() {
          const sectors = (window.ecosystemSummary && window.ecosystemSummary.nodeCount) || (window.aliensNetworkNodes || []).length || 13;
          const titleEl = document.getElementById('retro-focus-title');
          const valEl = document.getElementById('retro-focus-stat1-val');
          const lblEl = document.getElementById('retro-focus-stat1-lbl');
          const metaEl = document.getElementById('retro-focus-stat2');
          if (titleEl) titleEl.textContent = 'GLOBAL GRID';
          if (valEl) valEl.textContent = `${sectors} SECTORS`;
          if (lblEl) lblEl.textContent = 'CONNECTED';
          if (metaEl) metaEl.textContent = 'WORLD GRID ACTIVE';
      })();
      initSearch();

      // Integrates OpenFreeMap Dark style to serve vector tiles natively
      activeMapInstance = new maplibregl.Map({
          container: 'aliens-network-map',
          style: 'https://tiles.openfreemap.org/styles/dark',
          center: [10, 20],
          zoom: 1.4,
          pitch: 0,
          bearing: 0,
          attributionControl: { compact: true },
          canvasContextAttributes: { antialias: true }
      });

      // Initialize Synchronized Radar Minimap (clone style to avoid shared object issues)
      minimapInstance = new maplibregl.Map({
          container: 'retro-compass-radar-map',
          style: 'https://tiles.openfreemap.org/styles/dark',
          center: [10, 20],
          zoom: 1.0,
          interactive: false,
          attributionControl: false
      });

      activeMapInstance.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');

      boundsInstance = new maplibregl.LngLatBounds();

      // Setup layers after style is parsed
      activeMapInstance.on('style.load', () => {
          // Adds cybernetic 3D building extrusions natively colored by height
          activeMapInstance.addLayer({
              'id': '3d-buildings',
              'source': 'openmaptiles',
              'source-layer': 'building',
              'type': 'fill-extrusion',
              'minzoom': 13,
              'paint': {
                  'fill-extrusion-color': BUILDING_HEIGHT_RAMP,
                  'fill-extrusion-height': [
                      'interpolate',
                      ['linear'],
                      ['zoom'],
                      13, 0,
                      14, ['get', 'render_height']
                  ],
                  'fill-extrusion-base': [
                      'case',
                      ['>=', ['get', 'zoom'], 16],
                      ['get', 'render_min_height'],
                      0
                  ],
                  'fill-extrusion-opacity': 0.75
              }
          });

          // GRID FLOW arcs run as an SVG overlay (see the agf* functions) so the
          // dash-draw + slide-while-fade animation is preserved over the canvas.

          // PAX SILICA vs WAICO — country-bloc overlay (hidden until 'silicrack').
          // A Natural Earth 110m admin_0 GeoJSON (served same-origin from data/,
          // allowed by CSP 'self') provides country polygons. Each is colored blue
          // (Pax Silica), red (WAICO) or neutral by ADM0_A3. Facility nodes & the 4
          // filter options remain untouched and sit above this fill (DOM markers).
          // Note: Singapore is too small for the 110m dataset and renders neutral.
          try {
              activeMapInstance.addSource('world-countries', {
                  'type': 'geojson',
                  'data': '../data/world-countries.geojson'
              });
              activeMapInstance.addLayer({
                  'id': 'country-bloc',
                  'source': 'world-countries',
                  'type': 'fill',
                  'paint': {
                      'fill-color': 'transparent',
                      'fill-opacity': 0.55,
                      'fill-outline-color': 'rgba(255,255,255,0.08)'
                  },
                  'layout': { 'visibility': 'none' }
              }, 'boundary_country_z0-4');
          } catch (e) {
              console.warn('[Silicrack] country overlay init failed:', e);
          }


          // Generate fable District labels
          fableDistricts.forEach(dist => {
              const el = document.createElement('div');
              el.className = 'retro-map-district-tag';
              el.textContent = dist.name;

              const marker = new maplibregl.Marker({ element: el, clickTolerance: 0 })
                  .setLngLat(dist.coords)
                  .addTo(activeMapInstance);

              districtMarkers.push(marker);
          });

          // Hide district tags on zoomed out bounds to prevent cluttering
          function updateDistrictLabels() {
              const zoom = activeMapInstance.getZoom();
              districtMarkers.forEach(m => {
                  m.getElement().style.opacity = zoom >= 13 ? '1' : '0';
              });
          }
          activeMapInstance.on('zoom', updateDistrictLabels);
          updateDistrictLabels();
          activeMapInstance.resize();
          if (minimapInstance) minimapInstance.resize();
      });

      // Monitor map centering to update HUD Sector name dynamically based on nearest LGU
      activeMapInstance.on('move', () => {
          const center = activeMapInstance.getCenter();

          // Track minimap coordinates
          minimapInstance.setCenter(center);
          minimapInstance.setZoom(Math.max(4.5, activeMapInstance.getZoom() - 3.8));

          let nearestLgu = null;
          let minDistance = Infinity;

          fableLgus.forEach(lgu => {
              const dx = center.lng - lgu.coords[0];
              const dy = center.lat - lgu.coords[1];
              const distance = Math.sqrt(dx * dx + dy * dy);
              if (distance < minDistance) {
                  minDistance = distance;
                  nearestLgu = lgu;
              }
          });

          // Zoomed in enough to specify structures
          if (activeMapInstance.getZoom() > 9.5 && nearestLgu && minDistance < 0.25) {
                document.getElementById('retro-focus-title').textContent = nearestLgu.name.toUpperCase();
                document.getElementById('retro-focus-stat1-val').textContent = Number(nearestLgu.population).toLocaleString('en-US');
                document.getElementById('retro-focus-stat1-lbl').textContent = "RESIDENTS";
                document.getElementById('retro-focus-stat2').textContent = `CENSUS ${nearestLgu.censusYear || 2020}`;
          } else {
              const sectors = (window.ecosystemSummary && window.ecosystemSummary.nodeCount) || aliensNetworkNodes.length || 13;
              document.getElementById('retro-focus-title').textContent = "GLOBAL GRID";
              document.getElementById('retro-focus-stat1-val').textContent = `${sectors} SECTORS`;
              document.getElementById('retro-focus-stat1-lbl').textContent = "CONNECTED";
              document.getElementById('retro-focus-stat2').textContent = "WORLD GRID ACTIVE";
          }
      });

      aliensNetworkNodes.forEach(node => {
          const el = document.createElement('div');
          el.className = 'retro-map-node-marker';
          el.innerHTML = `
              <div class="retro-map-marker-tag">${node.name}</div>
              <div class="retro-map-marker-line"></div>
              <div class="retro-map-marker-glow"></div>
          `;

          // Data center nodes carry their own accent color; the ALIEN.INC HQ
          // keeps its default yellow (design language #ffd400) untouched.
          if (node.markerColor) {
              const c = node.markerColor;
              const tag = el.querySelector('.retro-map-marker-tag');
              const line = el.querySelector('.retro-map-marker-line');
              const glow = el.querySelector('.retro-map-marker-glow');
              if (tag) {
                  tag.style.color = c;
                  tag.style.borderColor = c;
                  tag.style.boxShadow = '0 0 10px ' + c + '33';
              }
              if (line) line.style.background = c + '80';
              if (glow) {
                  glow.style.background = c;
                  glow.style.boxShadow = '0 0 10px ' + c + ', 0 0 20px ' + c + '99';
              }
          }

          // Custom marker interaction triggers
          el.addEventListener('click', (e) => {
              e.stopPropagation();
              clearSearchMarker();
              inspectNode(node);
          });

          var marker = new maplibregl.Marker({ element: el, anchor: 'bottom' })
              .setLngLat([node.lng, node.lat])
              .addTo(activeMapInstance);

          mapMarkers.push({ marker: marker, node: node });
          boundsInstance.extend([node.lng, node.lat]);
      });

      // Initial fitting bound alignment on map load
      activeMapInstance.once('load', () => {
          activeMapInstance.fitBounds(boundsInstance, { 
              padding: { top: 120, bottom: 120, left: 60, right: 60 }, 
              maxZoom: 4,
              pitch: 0,
              bearing: 0
          });
      });
  }

  // Map view toggle: DEFAULT shows height-colored buildings, GRID FLOW animates
  // the exact Check Point ThreatMap arcs (SVG overlay, dash-draw + slide-fade).
  function toggleDataLayer(mode) {
      if (!activeMapInstance) return;

      const isFlow = mode === 'flow';
      agfEnabled = isFlow;
      document.querySelectorAll('.retro-map-view-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById(`layer-btn-${mode}`);
      if (activeBtn) activeBtn.classList.add('active');

      if (isFlow) {
          // Dim base buildings so the connection arcs pop
          if (activeMapInstance.getLayer('3d-buildings')) {
              activeMapInstance.setPaintProperty('3d-buildings', 'fill-extrusion-color', '#0b1520');
              activeMapInstance.setPaintProperty('3d-buildings', 'fill-extrusion-opacity', 0.5);
          }
          agfStart();
      } else {
          agfStop();
          if (activeMapInstance.getLayer('3d-buildings')) {
              activeMapInstance.setPaintProperty('3d-buildings', 'fill-extrusion-color', BUILDING_HEIGHT_RAMP);
              activeMapInstance.setPaintProperty('3d-buildings', 'fill-extrusion-opacity', 0.75);
          }
      }
  }

  // Sector Preset action focusing
  function focusSector(lngLat, zoom, sectorName) {
      if (!activeMapInstance) return;
      activeMapInstance.flyTo({
          center: lngLat,
          zoom: zoom,
          pitch: 55,
          bearing: 15,
          duration: 2200,
          essential: true
      });

      // If coordinates match a registered subsidiary, inspect it automatically
      const matchedNode = aliensNetworkNodes.find(n => Math.abs(n.lng - lngLat[0]) < 0.01 && Math.abs(n.lat - lngLat[1]) < 0.01);
      if (matchedNode) {
          inspectNode(matchedNode, false); // Focus sector HUD update only
      } else {
          updateHUD(sectorName, "SCANNING SECTOR", `COORDS: ${lngLat[1].toFixed(4)} / ${lngLat[0].toFixed(4)}`);
      }
  }

  // Category definitions for the filter buttons
  var DC_CATEGORIES = {
      foundry: {
          label: 'SILICON FABRICATION',
          sectors: ['Semiconductor Foundry', 'Memory Manufacturing', 'EUV Lithography HQ', 'Analog Semiconductor Fab']
      },
      hyperscale: {
          label: 'CLOUD & EDGE',
          sectors: ['Hyperscale Data Center', 'Cloud Region / Edge POP', 'Cloud Region / Sovereign Cloud']
      },
      colocation: {
          label: 'NETWORK & COLO',
          sectors: ['Internet Exchange / Colocation', 'Carrier-Neutral Colocation', 'Hyperscale Colocation', 'Underground Data Center', 'Scientific Computing', 'Government Intelligence']
      }
  };

  // Filter visible data center markers by category
  function filterDataCenters(category) {
      if (!activeMapInstance) return;
      activeFilter = category;

      // Update button active states
      document.querySelectorAll('.retro-map-btn-filter').forEach(btn => btn.classList.remove('active'));
      var activeBtn = document.getElementById('filter-btn-' + category);
      if (activeBtn) activeBtn.classList.add('active');

      var visibleBounds = new maplibregl.LngLatBounds();
      var visibleCount = 0;

      mapMarkers.forEach(function (entry) {
          var node = entry.node;
          var show = false;

          // ALIEN.INC HQ is always visible
          if (!node.markerColor) {
              show = true;
          } else if (category === 'all') {
              show = true;
          } else {
              var cat = DC_CATEGORIES[category];
              if (cat && cat.sectors.indexOf(node.sector) !== -1) {
                  show = true;
              }
          }

          if (show) {
              entry.marker.addTo(activeMapInstance);
              visibleBounds.extend([node.lng, node.lat]);
              visibleCount++;
          } else {
              entry.marker.remove();
          }
      });

      // Re-fit bounds to show only visible markers
      if (!visibleBounds.isEmpty()) {
          activeMapInstance.fitBounds(visibleBounds, {
              padding: { top: 120, bottom: 120, left: 60, right: 60 },
              maxZoom: 4,
              pitch: 0,
              bearing: 0,
              duration: 1500
          });
      }

      // Update HUD
      var hudLabel = (category === 'all') ? 'GLOBAL GRID' : (DC_CATEGORIES[category] ? DC_CATEGORIES[category].label : 'GLOBAL GRID');
      updateHUD(hudLabel, visibleCount + ' FACILITIES', category === 'all' ? 'WORLD GRID ACTIVE' : 'CATEGORY FILTER');
      toggleInspector(false);
      clearSearchMarker();
  }

  // Reset the main map back to its overall cluster viewpoint
  function resetMapView() {
      if (!activeMapInstance || !boundsInstance) return;
      // Reset filter to show all markers
      if (activeFilter !== 'all') {
          filterDataCenters('all');
          return;
      }
      activeMapInstance.fitBounds(boundsInstance, {
          padding: { top: 120, bottom: 120, left: 60, right: 60 },
          maxZoom: 4,
          pitch: 0,
          bearing: 0,
          duration: 2000
      });
      updateHUD("GLOBAL GRID", "MONITORING SYSTEM", "WORLD GRID BOUNDS");
      toggleInspector(false);
      clearSearchMarker();
  }

  // ── PAX SILICA vs WAICO — country-bloc map overlay (activated by 'silicrack') ──
  // Recolors each country polygon by bloc allegiance: blue for Pax Silica (US-led),
  // red for WAICO (China-led), neutral for everyone else. Facility nodes and the
  // four filter buttons keep working — this is a background country fill only.
  var SILICRACK_ACTIVE = false;

  function applySilicrack() {
      if (!activeMapInstance || !activeMapInstance.getLayer('country-bloc')) return;
      activeMapInstance.setPaintProperty('country-bloc', 'fill-color', [
          'match', ['get', 'ADM0_A3'],
          ['USA','GBR','AUS','ISR','JPN','KOR','SGP','NLD','QAT','ARE','IND','SWE','FIN','PHL','NOR','DEU','GRC','ITA','ARG','CHL','CRI','SLV','PAN','EST','KAZ','CAN','TWN'],
          '#38bdf8',
          ['CHN','RUS','BRA','IDN','IRN','ZAF','DZA','BLR','KHM','CMR','COG','CUB','ETH','KEN','KGZ','LAO','LSO','MYS','MOZ','MMR','NIC','OMN','PAK','SEN','SRB','TJK','UZB','VEN','ZMB'],
          '#f87171',
          'rgba(15,23,42,0.25)'
      ]);
      activeMapInstance.setPaintProperty('country-bloc', 'fill-opacity', 0.55);
      activeMapInstance.setLayoutProperty('country-bloc', 'visibility', 'visible');
      SILICRACK_ACTIVE = true;
      updateHUD('PAX SILICA VS WAICO', 'BLOC OVERLAY ACTIVE', 'BLUE=PAX SILICA · RED=WAICO');
  }

  function clearSilicrack() {
      if (!activeMapInstance || !activeMapInstance.getLayer('country-bloc')) return;
      activeMapInstance.setLayoutProperty('country-bloc', 'visibility', 'none');
      SILICRACK_ACTIVE = false;
  }

  // Company profile inspector (real data from the ecosystem source of truth)
  function inspectNode(node, shouldFly = true) {
      if (shouldFly && activeMapInstance) {
          activeMapInstance.flyTo({
              center: [node.lng, node.lat],
              zoom: 14.5,
              pitch: 55,
              bearing: 5,
              duration: 2000
          });
      }

      // Update top sector HUD metrics dynamically
      updateHUD(node.name, "GRID ACCESS GRANTED", `LAT/LNG: ${node.lat.toFixed(4)} / ${node.lng.toFixed(4)}`);

      // Display loading state while the profile is assembled
      toggleInspector(true);
      const inspectorContent = document.getElementById('inspector-content');
      inspectorContent.innerHTML = `<p style="color: #22d3ee; animation: aliens-blink 1s step-end infinite; text-align: center; margin-top: 20px;">[ RETRIEVING COMPANY PROFILE... ]</p>`;

      setTimeout(() => {
          inspectorContent.innerHTML = renderCompanyProfile(node);
      }, 550);
  }

  // Builds the real company profile panel for a network node.
  function renderCompanyProfile(node) {
      const company = node.company;
      const hc = company ? company.headcount : null;
      const headcount2026 = (hc && typeof hc['2026F'] === 'number') ? Number(hc['2026F']).toLocaleString('en-US') : '—';
      const headcountFt = (hc && typeof hc.fullTime === 'number') ? Number(hc.fullTime).toLocaleString('en-US') : '—';
      const clients = (company && typeof company.clientCount === 'number') ? company.clientCount : '—';
      const projects = (company && typeof company.activeProjectCount === 'number') ? company.activeProjectCount : '—';
      const established = company ? (company.foundingDate || company.yearFounded || '—') : '—';
      const category = company ? (company.category || '—') : (node.markerColor ? (node.sector || '—') : 'Group headquarters');
      const mission = company ? company.mission : null;

      const stack = (node.techStack && node.techStack.length)
          ? node.techStack.map(t => `<div class="retro-map-inspector-stack-row"><span>${t.name}</span><em>${t.role}</em></div>`).join('')
          : '<div class="retro-map-inspector-stack-row"><span>Not yet ready to share</span></div>';

      const latHemi = node.lat >= 0 ? 'N' : 'S';
      const lngHemi = node.lng >= 0 ? 'E' : 'W';

      let rows = `
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">SECTOR LOCATION</dt>
              <dd class="retro-map-inspector-dd">${node.sector}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">COORDINATES</dt>
              <dd class="retro-map-inspector-dd">${Math.abs(node.lat).toFixed(4)}${latHemi}, ${Math.abs(node.lng).toFixed(4)}${lngHemi}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">CATEGORY</dt>
              <dd class="retro-map-inspector-dd">${category}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">ESTABLISHED</dt>
              <dd class="retro-map-inspector-dd">${established}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">HEADCOUNT 2026F</dt>
              <dd class="retro-map-inspector-dd">${headcount2026} (${headcountFt} FULL-TIME)</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">CLIENT COUNT</dt>
              <dd class="retro-map-inspector-dd">${clients}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">ACTIVE PROJECTS</dt>
              <dd class="retro-map-inspector-dd">${projects}</dd>
          </div>
          <div class="retro-map-inspector-row">
              <dt class="retro-map-inspector-dt">TECH STACK</dt>
              <dd class="retro-map-inspector-dd">${stack}</dd>
          </div>`;

      let footer = '';
      if (mission) {
          footer = `<div class="retro-map-inspector-intel">
              <strong>MISSION:</strong><br>
              ${mission}
          </div>`;
      }

      return `<dl>${rows}</dl>${footer}`;
  }

  // Sector HUD values update utility
  function updateHUD(name, status, telemetry) {
      const nameEl = document.getElementById('retro-focus-title');
      const statusEl = document.getElementById('retro-focus-stat1-lbl');
      const telemetryEl = document.getElementById('retro-focus-stat2');

      if (nameEl) nameEl.textContent = name.toUpperCase();
      if (statusEl) statusEl.textContent = status;
      if (telemetryEl) telemetryEl.textContent = telemetry;
  }

  // Show/Hide Right Terminal Inspector panel
  function toggleInspector(show) {
      const panel = document.getElementById('node-inspector');
      if (!panel) return;
      if (show) {
          panel.classList.remove('closed');
      } else {
          panel.classList.add('closed');
      }
  }

  // ── Global Network Node Set (API-backed) ───────────────────────
  // The map shows ALIEN.INC (HQ, design intact) plus the featured data
  // centers / semiconductor fabs from the global_tech_stack database
  // (served by /api/techstack?featured=1). The dataset lives in SQLite,
  // NOT hardcoded here — so it can scale to S&P 500 + scraped companies
  // without bloating this file. The search bar hits /api/techstack?q=...
  // directly; non-featured company tech stacks are auth-gated server-side.

  // Replace the public map nodes: keep only the ALIEN.INC HQ (its design
  // stays intact), then fetch featured data centers from the API.
  // Non-HQ subsidiaries (KMT, ROUSSEAU, CENTRA, PANTEON, TDAC, Alcantara)
  // are NEVER shown on the map — only ALIEN.INC HQ and datacenter facilities.
  function applyGlobalNetworkNodes(callback) {
    var all = window.aliensNetworkNodes || [];
    var hq = null;
    for (var i = 0; i < all.length; i++) {
      var n = all[i];
      if (n && (n.name === 'ALIEN.INC' || ((n.companyId === null || n.companyId === undefined) && n.sector && /HQ/.test(n.sector)))) {
        hq = n;
        break;
      }
    }

    // Immediately strip to HQ-only so non-facility companies never render
    // even if the techstack fetch below fails or is slow.
    window.aliensNetworkNodes = hq ? [hq] : [];
    if (window.ecosystemSummary) {
      window.ecosystemSummary.nodeCount = window.aliensNetworkNodes.length;
    }

    fetch('/api/techstack?featured=1')
      .then(function (res) { return res.json(); })
      .then(function (data) {
        var merged = [];
        if (hq) merged.push(hq);
        (data.results || []).forEach(function (r) {
          merged.push({
            name: r.name,
            city: r.city,
            sector: r.sector,
            lat: r.lat,
            lng: r.lng,
            markerColor: r.markerColor,
            techStack: r.techStack || []
          });
        });
        window.aliensNetworkNodes = merged;
        if (window.ecosystemSummary) {
          window.ecosystemSummary.nodeCount = merged.length;
        }
        if (callback) callback();
      })
      .catch(function (err) {
        console.warn('[TechStack] featured load failed:', err);
        if (callback) callback();
      });
  }
(function () {
  function startMapWhenVisible() {
    var section = document.getElementById('network-map');
    if (!section || typeof maplibregl === 'undefined') return;
    var started = false;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !started) {
            started = true;
            NetworkMapData.load(function () {
              applyGlobalNetworkNodes(function () {
                initNetworkMap();
              });
            });
            io.disconnect();
          }
        });
      }, { threshold: 0.05 });
      io.observe(section);
    } else {
      NetworkMapData.load(function () {
        applyGlobalNetworkNodes(function () {
          initNetworkMap();
        });
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startMapWhenVisible);
  } else {
    startMapWhenVisible();
  }
})();

        // Starfield Canvas Renderer
        const canvas = document.querySelector('#star-container canvas');
        const ctx = canvas.getContext('2d');
        let stars = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        for (let i = 0; i < 400; i++) {
            stars.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 2,
                speed: Math.random() * 0.4 + 0.1
            });
        }

        function drawStars() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#22d3ee';
            stars.forEach(s => {
                ctx.globalAlpha = Math.random() * 0.7 + 0.3;
                ctx.fillRect(s.x, s.y, s.size, s.size);
                s.y += s.speed;
                if (s.y > canvas.height) {
                    s.y = 0;
                    s.x = Math.random() * canvas.width;
                }
            });
            requestAnimationFrame(drawStars);
        }
        drawStars();

        // Sequential Typewriter Logic
        const paragraphs = [
            document.getElementById('p1'),
            document.getElementById('p2'),
            document.getElementById('p3'),
            document.getElementById('p4'),
            document.getElementById('p5'),
            document.getElementById('p6'),
            document.getElementById('p7'),
            document.getElementById('p8'),
            document.getElementById('p9')
        ];
        let currentPara = 0;

        function typeParagraph() {
            if (currentPara >= paragraphs.length) {
                document.getElementById('rest-of-page').style.opacity = '1';
                if (activeMapInstance) activeMapInstance.resize();
                if (minimapInstance) minimapInstance.resize();
                initSplitFlaps();
                return;
            }
            const el = paragraphs[currentPara];
            if (!el) return;
            const text = el.getAttribute('data-text');
            let i = 0;
            el.textContent = '';
            el.classList.add('typewriter');
            
            function type() {
                if (i < text.length) {
                    el.classList.add('typewriter-start');
                    el.textContent += text.charAt(i++);
                    setTimeout(type, 35);
                } else {
                    el.classList.remove('typewriter-start');
                    el.classList.add('typewriter-done');
                    currentPara++;
                    if (el.id === 'p8') {
                        document.querySelector('.aliens-moment-log').classList.add('visible');
                    }
                    setTimeout(typeParagraph, 600);
                }
            }
            type();
        }

        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(typeParagraph, 800);
        });

        // Split-Flap board animation sequence
        function initSplitFlaps() {
            const flipSpeed = 2000;
            const introSteps = 20;
            const introInterval = 160;

            document.querySelectorAll('.num-container').forEach(container => {
                const targetValue = parseInt(container.dataset.count, 10);
                const digitsCount = targetValue.toString().length;
                let value = 0;

                // Build digits starting at 0
                for (let i = 0; i < digitsCount; i++) {
                    const staticTop = document.createElement('div');
                    staticTop.className = 'static-top';
                    const staticTopSpan = document.createElement('span');
                    staticTopSpan.textContent = '0';
                    staticTop.appendChild(staticTopSpan);

                    const staticBottom = document.createElement('div');
                    staticBottom.className = 'static-bottom';
                    const staticBottomSpan = document.createElement('span');
                    staticBottomSpan.textContent = '0';
                    staticBottom.appendChild(staticBottomSpan);

                    const digit = document.createElement('div');
                    digit.className = 'digit';
                    digit.appendChild(staticTop);
                    digit.appendChild(staticBottom);
                    container.appendChild(digit);

                    const remaining = digitsCount - 1 - i;
                    if (remaining > 0 && remaining % 3 === 0) {
                        const mark = document.createElement('div');
                        mark.className = 'mark';
                        const markSpan = document.createElement('span');
                        markSpan.textContent = ',';
                        mark.appendChild(markSpan);
                        container.appendChild(mark);
                    }
                }

                const digits = container.querySelectorAll('.digit');

                function update(newVal, fast) {
                    const str = newVal.toString().padStart(digitsCount, '0');

                    digits.forEach((digit, index) => {
                        const topEl = digit.querySelector('.static-top span');
                        if (!topEl) return;
                        const current = topEl.textContent;
                        const next = str[index];

                        if (current !== next) {
                            const flipTop = document.createElement('div');
                            flipTop.className = fast ? 'flip-top fast' : 'flip-top';

                            const topSpan = document.createElement('span');
                            topSpan.textContent = current;
                            flipTop.appendChild(topSpan);

                            const flipBottom = document.createElement('div');
                            flipBottom.className = fast ? 'flip-bottom fast' : 'flip-bottom';

                            const bottomSpan = document.createElement('span');
                            bottomSpan.textContent = next;
                            flipBottom.appendChild(bottomSpan);

                            digit.appendChild(flipTop);
                            topEl.textContent = next;

                            flipTop.addEventListener('animationend', () => {
                                digit.appendChild(flipBottom);
                            });

                            flipBottom.addEventListener('animationend', () => {
                                const bottomEl = digit.querySelector('.static-bottom span');
                                if (bottomEl) bottomEl.textContent = next;
                                flipTop.remove();
                                flipBottom.remove();
                            });
                        }
                    });
                }

                // Intro: flip quickly from 0 up to targetValue
                const step = Math.max(1, Math.floor(targetValue / introSteps));
                const introTimer = setInterval(() => {
                    value = Math.min(value + step, targetValue);
                    update(value, true);
                    if (value >= targetValue) {
                        clearInterval(introTimer);
                    }
                }, introInterval);
            });
        }

        // Scroll reveal controller
        const sectionObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });
        
        document.querySelectorAll('.section').forEach(s => sectionObserver.observe(s));

        // Opt-in Submission
        function handleForm(e) {
            e.preventDefault();
            const input = document.getElementById('email');
            const msg = document.getElementById('form-msg');
            msg.style.display = "block";
            msg.textContent = `TRANSMISSION SECURED: ${input.value} LOGGED INTO SIGNAL ARRAY.`;
            input.value = "";
        }
    </script>
</body>
</html>

