// MIL contacts rail (bottom-right map overlay, Maven-style) — lists live
// military platforms with type-code enrichment from the a-san airframe index.
// ============================================================================

let fusionMilContacts = [];
let _asanIndexPromise = null;
const _asanTypeCache = {};

function loadAsanIndex() {
    if (!_asanIndexPromise) {
        _asanIndexPromise = fetch('/static/a-san-aircraft-index.json')
            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .catch(() => null);
    }
    return _asanIndexPromise;
}

// Resolve an ADS-B model/type code ("C130J", "K35R") to an a-san airframe record.
function resolveMilType(model, idx) {
    if (!idx || !idx.types || !model) return null;
    const norm = String(model).toLowerCase().replace(/[^a-z0-9]/g, '');
    if (!norm || norm.length > 8) return null;
    if (_asanTypeCache[norm] !== undefined) return _asanTypeCache[norm];
    const types = idx.types;
    let hit = types[norm] || null;                                   // exact: c130j
    if (!hit && /[a-z]$/.test(norm)) hit = types[norm.replace(/[a-z]+$/, '')] || null; // kc135r -> kc135
    if (!hit) {                                                      // prefix relax: a400 -> a400m
        const keys = Object.keys(types);
        for (const k of keys) { if (k.length > norm.length && k.startsWith(norm)) { hit = types[k]; break; } }
    }
    _asanTypeCache[norm] = hit;
    return hit;
}

