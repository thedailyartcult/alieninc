}

// Auto-logout: session looks dead from THIS tab's view. Clean local state
// only — never a global signOut(), which used to nuke sibling tabs that
// still held valid tokens.
let autoLogoutAt = 0;
function autoLogout(reason) {
    console.warn('[auth] auto-logout:', reason);
    const now = Date.now();
    if (now - autoLogoutAt < 2000) return;
    autoLogoutAt = now;
    doLogout({ hard: false });
}

if (AUTH_CHANNEL) AUTH_CHANNEL.onmessage = (ev) => {
    const m = ev.data || {};
    if (m.type === 'signed-out') {
