        setInterval(function () { if (isOpen) refreshStatuses(); }, 4000);

        // Feed budget poll: fetches /api/v1/feed-budget every 30s and attaches
        // budget info to matching GAIA layer source objects.
        var _lastBudgetPoll = 0;
        function pollFeedBudget() {
            var now = Date.now();
            if (now - _lastBudgetPoll < 28000) return;
            _lastBudgetPoll = now;
            fetch('/api/v1/feed-budget').then(function (r) { return r.json(); }).then(function (data) {
                if (!data || typeof data !== 'object') return;
                REGISTRY.forEach(function (d) {
                    if (!d.source) return;
                    var feed = data[d.id] || data[(d.id || '').replace('sims-', '')];
                    if (feed) {
                        d.source.budget = { used: feed.used, max: feed.max, remaining: feed.remaining };
                    }
