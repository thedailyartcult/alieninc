        { id: 'red',    label: 'Red threats',     phrase: 'red threats last 24 hours' },
        { id: 'mil',    label: 'Military air',    phrase: 'military aircraft' },
        { id: 'jets',   label: 'Jets',            phrase: 'jet aircraft' },
        { id: 't7d',    label: 'Events 7d',       phrase: 'conflict events last 7 days' },
