            '<b>' + cls.military + '</b> military, ' +
            '<b>' + cls.gps_jamming_count + '</b> GPS jamming suspects ' +
            '(tx ' + (rep.writeback.transaction_id || '').slice(0, 8) + '). ' +
            'Source: ' + (rep.opensky.source || 'unknown') + '. ' +
            'OpenSky auth: ' + (prov.opensky_auth ? 'enabled' : 'anonymous') + '.';
        document.getElementById('aviationJammingCount').textContent = cls.gps_jamming_count > 0 ? cls.gps_jamming_count : '—';
