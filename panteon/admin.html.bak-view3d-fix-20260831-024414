          tag: 'Dashboards, schedules, data quality and semantic search.' }
    ];

    var LS_PREFIX = 'panteon_platforms_v1:';
    var overlay = null, gridEl = null, countEl = null, launchBtn = null, enableAllBtn = null;
    var firstRun = false;
    var pending = null;   // Promise resolve when first-run completes
    var selected = [];
    var focusIdx = 0;
    var identity = null;  // {id,email} captured from showApp(user) — `currentUser` is let-scoped, not on window

    function userKey() {
        return LS_PREFIX + (identity && (identity.id || identity.email) ? (identity.id || identity.email) : 'anon');
    }
    function load() {
        try {
            var raw = JSON.parse(localStorage.getItem(userKey()) || 'null');
            if (raw && Array.isArray(raw.selected)) return raw.selected.filter(function (id) {
                return REGISTRY.some(function (p) { return p.id === id; });
            });
        } catch (e) {}
        return null;
    }
    function save(sel) {
        try { localStorage.setItem(userKey(), JSON.stringify({ v: 1, selected: sel, ts: Date.now() })); } catch (e) {}
    }

    function allowsPage(page) {
        if (!page || page === 'overview') return true;
        var item = document.querySelector('.nav-item[data-page="' + page + '"]');
        if (!item) return true; // non-nav pages (maven feature gate etc.) pass through
        var sec = item.closest('.nav-section');
        if (!sec || !sec.dataset.platform) return true; // core sections always allowed
        return !sec.classList.contains('ps-off');
    }

    function applyFilter(sel) {
        document.querySelectorAll('.nav-section[data-platform]').forEach(function (sec) {
            sec.classList.toggle('ps-off', sel.indexOf(sec.dataset.platform) < 0);
        });
    }

    function commitSelection() {
        save(selected);
        applyFilter(selected);
        try {
            if (window.DECK && typeof DECK.rebuildTools === 'function') DECK.rebuildTools();
        } catch (e) {}
        // never let the deep-link check block the first-run resolver
        try {
            var hash = (window.location && window.location.hash || '').slice(1);
            if (hash && !allowsPage(hash) && typeof window.navigate === 'function') navigate('overview');
        } catch (e) {}
    }

    function cardHTML(p) {
        var media;
        if (p.img) {
            media = '<div class="ps-media"><img src="' + p.img + '" alt="" loading="lazy">' +
                    '<span class="ps-badge">' + p.badge + '</span></div>';
        } else {
            media = '<div class="ps-media mono" style="background:linear-gradient(135deg,' + p.mono[2] + ',' + p.mono[1] + '22)">' +
                    '<span class="ps-mono-glyph">' + p.mono[0] + '</span>' +
                    '<span class="ps-badge">' + p.badge + '</span></div>';
        }
        return media + '<span class="ps-corner tl"></span><span class="ps-corner br"></span>' +
               '<span class="ps-check"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 8.5l4 4L14 4"/></svg></span>' +
