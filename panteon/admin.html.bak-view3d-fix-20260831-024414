};

// Single-flight refresh: a burst of parallel 401s must rotate the session
// ONCE, not stampede Supabase with N concurrent refresh-token grants
// (concurrent reuse of one refresh token can get the family revoked).
let refreshInFlight = null;
async function refreshAccessToken() {
    if (!refreshInFlight) {
        const p = (async () => {
            try {
                const { data } = await supabaseClient.auth.refreshSession();
                return (data && data.session && data.session.access_token) ? data.session.access_token : null;
            } catch (_) {
                return null;
            }
        })();
        refreshInFlight = p;
        // Share only while PENDING: once settled, the next 401 must be able
        // to start a genuinely fresh rotation instead of reusing a stale one.
        p.then(() => { if (refreshInFlight === p) refreshInFlight = null; },
               () => { if (refreshInFlight === p) refreshInFlight = null; });
    }
    return refreshInFlight;
}

async function api(path, opts = {}) {
    const url = API_BASE.replace(/\/+$/, '') + '/' + String(path).replace(/^\/+/, '');
    const headers = { 'Content-Type': 'application/json', ...opts.headers };
    if (!authToken) {
        const { data } = await supabaseClient.auth.getSession();
        if (data.session) authToken = data.session.access_token;
    }
    if (authToken) headers['Authorization'] = 'Bearer ' + authToken;
    const controller = new AbortController();
    const timeoutMs = opts.timeout || 15000;
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
        let res = await fetch(url, { headers, ...opts, signal: controller.signal });
        if (res.status === 401) {
            // Self-heal: rotate once via the shared lock and retry. Only a
            // retry that is ALSO 401 (or a failed rotation) may end the
            // session — timeouts, 5xx and network blips must not log the
            // user out of an otherwise valid session.
            const tok = await refreshAccessToken();
            if (tok) {
                authToken = tok;
                headers['Authorization'] = 'Bearer ' + tok;
                res = await fetch(url, { headers, ...opts, signal: controller.signal });
                if (res.status !== 401) {
                    if (!res.ok) { const err = await res.json().catch(() => ({ detail: res.statusText })); throw new Error(err.detail || 'HTTP ' + res.status); }
                    return await res.json();
                }
            }
            autoLogout('401 after refresh on ' + path);
            throw new Error('Session expired');
        }
        if (!res.ok) { const err = await res.json().catch(() => ({ detail: res.statusText })); throw new Error(err.detail || 'HTTP ' + res.status); }
        return await res.json();
    } catch (e) {
        if (e.name === 'AbortError') throw new Error('Request timed out after ' + (timeoutMs / 1000) + 's');
        throw e;
    } finally {
        clearTimeout(timer);
    }
}

// SSE streaming companion to api(): POSTs and invokes onEvent(evt) for every
// server-sent JSON event; resolves with the final {"type":"done"} payload.
// Auth errors throw so callers can fall back to api()'s self-healing path.
window.apiStream = async function(path, opts = {}, onEvent) {
    const url = API_BASE.replace(/\/+$/, '') + '/' + String(path).replace(/^\/+/, '');
    const headers = { 'Content-Type': 'application/json' };
    if (authToken) headers['Authorization'] = 'Bearer ' + authToken;
    const controller = new AbortController();
    const timeoutMs = opts.timeout || 300000;
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    let res;
    try {
        res = await fetch(url, { method: 'POST', headers, body: opts.body, signal: controller.signal });
    } catch (e) {
        clearTimeout(timer);
        if (e.name === 'AbortError') throw new Error('Request timed out after ' + (timeoutMs / 1000) + 's');
        throw e;
    }
    if (!res.ok || !res.body) { clearTimeout(timer); throw new Error('HTTP ' + res.status); }
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '', payload = null;
    try {
        for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            let idx;
            while ((idx = buf.indexOf('\n\n')) >= 0) {
                const frame = buf.slice(0, idx); buf = buf.slice(idx + 2);
                const line = frame.split('\n').find(l => l.startsWith('data: '));
                if (!line) continue;
                const evt = JSON.parse(line.slice(6));
                if (evt.type === 'error') throw new Error(evt.message || 'stream error');
                if (evt.type === 'done') payload = evt.payload;
                else if (onEvent) onEvent(evt);
            }
        }
    } catch (e) {
        clearTimeout(timer);
        if (e.name === 'AbortError') throw new Error('Request timed out after ' + (timeoutMs / 1000) + 's');
        throw e;
    } finally {
        clearTimeout(timer);
        try { reader.releaseLock(); } catch (_) {}
    }
    if (!payload) throw new Error('stream ended without result');
    return payload;
}

