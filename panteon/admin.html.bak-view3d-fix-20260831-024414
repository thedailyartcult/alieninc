    function seedDrones() {
        if (dronePts.length) return;
        var c = scopeCenter(), i, names = ['DR-01', 'DR-02', 'DR-03', 'DR-04'];
        for (i = 0; i < names.length; i++) {
            dronePts.push({
                id: 'drn' + i, label: names[i], cx: c.lat, cy: c.lng,
                rKm: 12 + i * 14, phase: i * Math.PI / 2, speed: 0.05 + i * 0.02,
                altM: 120 + i * 40, heading: 90, lat: c.lat, lng: c.lng
            });
        }
        stepDrones(0);
    }
    function stepDrones(dtMs) {
        var now = Date.now(), degPerKm = 1 / 111;
        dronePts.forEach(function (d) {
            d.phase += d.speed * ((dtMs || 4000) / 1000);
            d.lat = d.cx + Math.cos(d.phase) * d.rKm * degPerKm;
            d.lng = d.cy + Math.sin(d.phase) * d.rKm * degPerKm / Math.max(0.2, Math.cos(d.cx * Math.PI / 180));
            d.heading = ((d.phase * 180 / Math.PI) % 360 + 360) % 360;
            d.ts = now;
        });
    }
