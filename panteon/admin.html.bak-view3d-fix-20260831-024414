async function renderCMBAnalyticsSavings(box, ws) {
    if (!ws) { box.innerHTML = '<div class="empty-state">Select a workspace to view token savings.</div>'; return; }
    const savings = await cmbApiGet('/context-savings?workspace=' + ws);
    const counters = savings.by_token_counter || [];
    let html = '<div style="margin-bottom:12px;font-weight:600">Token Savings — ' + ws + '</div>';
    counters.forEach(c => {
        const ratio = (c.savings_ratio * 100).toFixed(1);
        html += `<div style="margin-bottom:10px">
            <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px">
                <span>${c.token_counter}</span><span>${ratio}% saved</span>
            </div>
            <div style="height:20px;background:var(--bg);border-radius:4px;overflow:hidden;position:relative">
                <div style="height:100%;width:${ratio}%;background:var(--cyan);border-radius:4px"></div>
                <span style="position:absolute;right:8px;top:2px;font-size:10px;color:var(--text-muted)">${c.saved_tokens} saved / ${c.source_tokens} source</span>
            </div>
        </div>`;
    });
    html += `<div style="margin-top:12px;font-size:11px;color:var(--text-muted)">
        Receipts: ${savings.receipt_count} | Chain valid: ${savings.receipt_chain_valid ? 'Yes' : 'No'}</div>`;
    box.innerHTML = html;
}

async function renderCMBAnalyticsPortfolio(box, ws) {
    if (!ws) { box.innerHTML = '<div class="empty-state">Select a workspace.</div>'; return; }
    const stats = await cmbApiGet('/stats?workspace=' + ws);
    const byType = stats.by_type || {};
    let html = '<div style="margin-bottom:12px;font-weight:600">Memory Portfolio — ' + ws + '</div>';
    html += `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:16px">`;
    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700;color:var(--cyan)">${stats.memories || 0}</div><div style="font-size:11px;color:var(--text-muted)">Total Memories</div></div>`;
    html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700;color:var(--purple)">${stats.sessions || 0}</div><div style="font-size:11px;color:var(--text-muted)">Sessions</div></div>`;
    Object.entries(byType).forEach(([type, count]) => {
        html += `<div class="card" style="padding:12px;text-align:center"><div style="font-size:24px;font-weight:700">${count}</div><div style="font-size:11px;color:var(--text-muted)">${type}</div></div>`;
    });
    html += '</div>';
    // Fetch memories for importance distribution
    try {
        const mems = await cmbApiGet('/memories?workspace=' + ws + '&limit=50');
        const pinned = mems.filter(m => m.pinned).length;
        const avgImportance = mems.length ? (mems.reduce((s, m) => s + (m.importance || 0), 0) / mems.length).toFixed(2) : '0';
        html += `<div style="font-size:11px;color:var(--text-muted)">Pinned: ${pinned} | Avg importance: ${avgImportance}</div>`;
    } catch {}
    box.innerHTML = html;
}

async function renderCMBAnalyticsConsolidation(box, ws) {
    if (!ws) { box.innerHTML = '<div class="empty-state">Select a workspace.</div>'; return; }
    // Run a dry consolidation to get current state
    const result = await cmbApiPost('/consolidate', { workspace: ws, dry_run: true });
