PANTEON_DEBUG=true
DATABASE_URL=postgresql+asyncpg://panteon:panteon@localhost:5432/panteon
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- YONO Functions (Spinal Craker -> YONO bridge) --
# Shared secret for HMAC signature verification
ONO_FUNCTION_SHARED_SECRET=generate-a-long-random-secret-here
# Execution mode: subprocess (opencode CLI) or native (YONO LLM orchestrator)
ONO_FUNCTION_EXEC_MODE=subprocess
ONO_FUNCTION_EXECUTABLE=opencode
ONO_FUNCTION_MODEL=
ONO_FUNCTION_TIMEOUT=120
ONO_FUNCTION_RATE_LIMIT=20
ONO_FUNCTION_AUDIT_DIR=audit-logs

# -- Spinal Cracker GKG auto-pull (fusion map freshness) --
# Seconds between scheduled GDELT pulls. 0 disables the scheduler entirely.
# Default 21600 (6h). Guard rails: skips while a run is in flight or a GDELT
# cooldown is active — never bursts the API.
GKG_AUTOPULL_INTERVAL_S=21600
# Delay after boot before the first auto-pull (min 15s, default 90s).
GKG_AUTOPULL_FIRST_DELAY_S=90
