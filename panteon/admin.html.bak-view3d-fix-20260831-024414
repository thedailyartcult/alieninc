                                      var nx = s.x + dx + CW / 2, ny = s.y + dy + CH / 2;
                                      var best = -1, bd = 1e9;
                                      SLOTS.forEach(function (sl, i) {
                                          var d = Math.hypot(sl.x + CW / 2 - nx, sl.y + CH / 2 - ny);
                                          if (d < bd) { bd = d; best = i; }
                                      });
                                      cells().forEach(function (c) { c.classList.remove('hive-drop'); });
                                      el._drop = (best !== -1 && best !== el._slot && bd < 120) ? best : -1;
                                      if (el._drop >= 0) {
                                          var host = cellMap()[state.order[el._drop]];
                                          if (host) host.classList.add('hive-drop');
                                      }
                                  }, null);
                                  el.addEventListener('pointerup', function () {
                                      requestAnimationFrame(function () {
                                          if (el._drop != null && el._drop >= 0 && el._slot != null) {
                                              var tmp = state.order[el._slot];
                                              state.order[el._slot] = state.order[el._drop];
                                              state.order[el._drop] = tmp;
                                              save();
                                          }
                                          el._drop = -1;
                                          el.classList.remove('hive-grab');
                                          cells().forEach(function (c) { c.classList.remove('hive-drop'); });
                                          layout();
                                      });
                                  });
                              });

                              // connected-comb reaction: neighbors light up in slot space
                              layer.addEventListener('mouseover', function (ev) {
                                  var el = ev.target.closest ? ev.target.closest('[data-tile]') : null;
                                  if (!el || el._slot == null) return;
                                  var s = SLOTS[el._slot];
                                  cells().forEach(function (c) {
                                      var cs = SLOTS[c._slot];
                                      c.classList.toggle('neighbor-active', c !== el && Math.abs(cs.r - s.r) <= 1 && Math.abs(cs.c - s.c) <= 1);
                                  });
                              });
                              layer.addEventListener('mouseout', function (ev) {
                                  if (ev.target.closest && ev.target.closest('[data-tile]'))
                                      cells().forEach(function (c) { c.classList.remove('neighbor-active'); });
                              });

                              // legacy blueprint tiles outside the hive keep sibling reaction
                              Array.prototype.forEach.call(document.querySelectorAll('.sc-hud-tile'), function (t) {
                                  if (t.closest('#hiveLayer')) return;
                                  t.addEventListener('mouseenter', function () {
                                      var p = t.previousElementSibling, n = t.nextElementSibling;
                                      if (p && p.classList.contains('sc-hud-tile')) p.classList.add('neighbor-active');
                                      if (n && n.classList.contains('sc-hud-tile')) n.classList.add('neighbor-active');
                                  });
                                  t.addEventListener('mouseleave', function () {
                                      Array.prototype.forEach.call(document.querySelectorAll('.sc-hud-tile.neighbor-active'), function (x) { x.classList.remove('neighbor-active'); });
                                  });
                              });

                              // panel-opening tools fold the hive back to the
                              // pentagon as soon as their surface is up — the
                              // operator never chases a bloomed comb twice
                              var PANEL_TILES = { maven:1, scope:1, notes:1, gaia:1, theater:1 };
                              layer.addEventListener('click', function (ev) {
                                  var el = ev.target && ev.target.closest ? ev.target.closest('[data-tile]') : null;
                                  if (!el || !PANEL_TILES[el.getAttribute('data-tile')]) return;
                                  setTimeout(function () { if (state.expanded) setExpanded(false); }, 140);
                              });

                              // traffic chips idle until Aircraft engages
                              var avi = document.getElementById('fusionLayerAviation');
                              function syncChips() {
                                  var on = avi && avi.classList.contains('retro-map-btn-active');
                                  var m = cellMap();
                                  CHIP_KEYS.forEach(function (k) { if (m[k]) m[k].classList.toggle('hive-dim', !on); });
                              }
                              if (avi && window.MutationObserver) new MutationObserver(syncChips).observe(avi, { attributes: true, attributeFilter: ['class'] });

                              // pentagon mirrors live threat count
                              var tc = document.getElementById('fusionThreatCount'), pc = document.getElementById('hivePentCount');
                              if (tc && pc && window.MutationObserver) new MutationObserver(function () { pc.textContent = tc.textContent; }).observe(tc, { childList: true, characterData: true, subtree: true });

                              document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && state.expanded) setExpanded(false); });
                              window.addEventListener('resize', clampPos);

                              layout(); clampPos(); syncChips();
                          })();

                          </script>

                          
</div>
