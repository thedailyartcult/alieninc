let SCScope = {
    region: 'Worldwide',      // key into SC_REGION_BBOXES
    country: '',              // country name (overrides region if set)
    zone: '',                 // sub-national conflict zone (overrides region bbox)
    island: '',               // PH island group — Luzon/Visayas/Mindanao (overrides country when Philippines)
    city: '',                 // PH city — Makati/Taguig/BGC (finest, overrides island)
    preset: 'Conflicts',      // QUERY_PRESETS name
    timeWindow: '24h',        // 24h | 72h | 7d
    query: '(military OR war OR battle OR conflict OR offensive)',  // derived from preset
};

function scBbox() {
    // Finest → coarsest: PH city > PH island > conflict zone > country > region
    if (SCScope.city && PH_CITIES[SCScope.city]) {
        const c = PH_CITIES[SCScope.city];
        return { lamin: c.lamin, lomin: c.lomin, lamax: c.lamax, lomax: c.lomax };
    }
    if (SCScope.island && PH_ISLAND_GROUPS[SCScope.island]) {
        const g = PH_ISLAND_GROUPS[SCScope.island];
        return { lamin: g.lamin, lomin: g.lomin, lamax: g.lamax, lomax: g.lomax };
    }
    // Sub-national zone wins over everything (finest scope first).
    if (SCScope.zone && SC_CONFLICT_ZONES[SCScope.zone]) {
        const z = SC_CONFLICT_ZONES[SCScope.zone];
        return { lamin: z.lamin, lomin: z.lomin, lamax: z.lamax, lomax: z.lomax };
    }
    if (SCScope.country) {
        const cap = COUNTRY_CAPITALS[SCScope.country];
        if (cap) {
            // Derive a ~5° bbox around the capital as a reasonable country scope.
            return { lamin: cap[1] - 5, lomin: cap[0] - 7, lamax: cap[1] + 5, lomax: cap[0] + 7 };
        }
    }
    const r = SC_REGION_BBOXES[SCScope.region];
    if (r) return { lamin: r.lamin, lomin: r.lomin, lamax: r.lamax, lomax: r.lomax };
    return null; // Worldwide
}

function scCountryFips() {
    if (SCScope.country) return COUNTRY_FIPS[SCScope.country] || '';
    return '';
}

function scScopeComplete() {
    return !!SCScope.preset && !!SCScope.region;
}

function scSelectRegion(btn) {
    SCScope.region = btn.dataset.scopeRegion;
    SCScope.country = ''; // region resets country
    SCScope.zone = '';
    document.querySelectorAll('[data-scope-region]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const sel = document.getElementById('scCountrySelect');
    if (sel) sel.value = '';
    const zsel = document.getElementById('scZoneSelect');
    if (zsel) zsel.value = '';
    scPopulateCountries();
    scPopulateZones();
    scUpdateEmptyState();
}

function scSelectCountry(sel) {
    SCScope.country = sel.value || '';
    if (SCScope.country) {
        document.querySelectorAll('[data-scope-region]').forEach(b => b.classList.remove('active'));
        SCScope.zone = '';
        const zsel = document.getElementById('scZoneSelect');
        if (zsel) zsel.value = '';
    } else if (SCScope.region) {
        // re-highlight the active region
        document.querySelectorAll('[data-scope-region]').forEach(b => {
            if (b.dataset.scopeRegion === SCScope.region) b.classList.add('active');
        });
    }
    scUpdateEmptyState();
}

// Sub-national drill-down: conflict zones relevant to the active scope.
function scPopulateZones() {
    const sel = document.getElementById('scZoneSelect');
    if (!sel) return;
    let zones = Object.keys(SC_CONFLICT_ZONES);
    if (SCScope.region && SCScope.region !== 'Worldwide') {
        zones = zones.filter(z => !SC_CONFLICT_ZONES[z].regions || SC_CONFLICT_ZONES[z].regions.includes(SCScope.region));
    }
    sel.innerHTML = '<option value="">-- Zone --</option>' +
        zones.map(z => '<option value="' + z.replace(/"/g, '&quot;') + '">' + escapeHtml(z) + '</option>').join('');
}

function scSelectZone(sel) {
    SCScope.zone = sel.value || '';
    if (SCScope.zone) {
        // A zone narrows the country scope too.
        SCScope.country = '';
        const csel = document.getElementById('scCountrySelect');
        if (csel) csel.value = '';
        document.querySelectorAll('[data-scope-region]').forEach(b => b.classList.remove('active'));
    } else if (SCScope.region) {
        document.querySelectorAll('[data-scope-region]').forEach(b => {
            if (b.dataset.scopeRegion === SCScope.region) b.classList.add('active');
        });
    }
    scUpdateEmptyState();
}

function scSelectWindow(btn) {
