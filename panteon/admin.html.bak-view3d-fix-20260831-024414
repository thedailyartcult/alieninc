        },
        {
            // Panel IV: Deep Oxblood / Slate Lapis / Scarlet Core
            bg: [31, 14, 14],
            bgCard: [43, 20, 20],
            bgPanel: [36, 16, 16],
            bgInput: [23, 10, 10],
            borderColor: [63, 92, 124],
            borderHover: [86, 127, 168],
            accentNeon: [242, 46, 32],
            accentCyan: [78, 130, 183],
            text: [236, 231, 230],
            textMuted: [159, 136, 136]
        }
    ];
    function lerp(a, b, t) { return Math.round(a + (b - a) * t); }
    function lerpColor(c1, c2, t) {
        return [ lerp(c1[0], c2[0], t), lerp(c1[1], c2[1], t), lerp(c1[2], c2[2], t) ];
    }
    function evaluateSpectrum(pos) {
        pos = Math.max(0, Math.min(3, pos));
        const index = Math.floor(pos);
        const nextIndex = Math.min(3, index + 1);
        const t = pos - index;
        const p1 = BERNARDO_PANELS[index];
        const p2 = BERNARDO_PANELS[nextIndex];
        return {
            bg: lerpColor(p1.bg, p2.bg, t),
            bgCard: lerpColor(p1.bgCard, p2.bgCard, t),
            bgPanel: lerpColor(p1.bgPanel, p2.bgPanel, t),
            bgInput: lerpColor(p1.bgInput, p2.bgInput, t),
            borderColor: lerpColor(p1.borderColor, p2.borderColor, t),
            borderHover: lerpColor(p1.borderHover, p2.borderHover, t),
            accentNeon: lerpColor(p1.accentNeon, p2.accentNeon, t),
            accentCyan: lerpColor(p1.accentCyan, p2.accentCyan, t),
            text: lerpColor(p1.text, p2.text, t),
            textMuted: lerpColor(p1.textMuted, p2.textMuted, t)
        };
    }
    function applyBernardoTokens(pos) {
        const p = evaluateSpectrum(pos);
        const root = document.documentElement;
        root.style.setProperty('--bg', `rgb(${p.bg.join(',')})`);
        root.style.setProperty('--bg-card', `rgb(${p.bgCard.join(',')})`);
        root.style.setProperty('--bg-panel', `rgb(${p.bgPanel.join(',')})`);
        root.style.setProperty('--bg-sidebar', `rgb(${p.bg.join(',')})`);
        root.style.setProperty('--bg-topbar', `rgba(${p.bg.join(',')}, 0.78)`);
        root.style.setProperty('--bg-input', `rgb(${p.bgInput.join(',')})`);
        root.style.setProperty('--border-color', `rgba(${p.borderColor.join(',')}, 0.38)`);
        root.style.setProperty('--border-hover', `rgba(${p.borderHover.join(',')}, 0.75)`);
        root.style.setProperty('--border-light', `rgba(${p.borderColor.join(',')}, 0.25)`);
        root.style.setProperty('--accent-neon', `rgb(${p.accentNeon.join(',')})`);
        root.style.setProperty('--accent-cyan', `rgb(${p.accentCyan.join(',')})`);
        root.style.setProperty('--accent-purple', `rgb(${p.accentNeon.join(',')})`);
        root.style.setProperty('--text', `rgb(${p.text.join(',')})`);
        root.style.setProperty('--text-primary', `rgb(${p.text.join(',')})`);
        root.style.setProperty('--text-muted', `rgb(${p.textMuted.join(',')})`);
        root.style.setProperty('--text-dim', `rgba(${p.textMuted.join(',')}, 0.6)`);
        const labelEl = document.getElementById('constanPanelLabel');
        if (labelEl) {
            const panelNum = Math.min(4, Math.floor(pos) + 1);
            labelEl.textContent = `P${panelNum}`;
        }
    }
    function clearBernardoInlineTokens() {
        const root = document.documentElement;
        const tokens = [
            '--bg', '--bg-card', '--bg-panel', '--bg-sidebar', '--bg-topbar', '--bg-input',
            '--border-color', '--border-hover', '--border-light',
            '--accent-neon', '--accent-cyan', '--accent-purple',
            '--text', '--text-primary', '--text-muted', '--text-dim'
        ];
        tokens.forEach(t => root.style.removeProperty(t));
    }
    function initThemeSuite() {
        const root = document.documentElement;
        const slider = document.getElementById('constanSpectrumSlider');
        const modeButtons = document.querySelectorAll('.theme-mode-btn');
        const savedMode = localStorage.getItem('panteon-admin-theme') || 'dark';
        const savedPos = parseFloat(localStorage.getItem('panteon-constan-pos') || '0.0');
        function setMode(mode) {
            root.setAttribute('data-theme', mode);
            localStorage.setItem('panteon-admin-theme', mode);
            modeButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.mode === mode);
            });
            if (mode === 'constan') {
                applyBernardoTokens(parseFloat(slider.value));
            } else {
                clearBernardoInlineTokens();
            }
        }
        modeButtons.forEach(btn => {
            btn.addEventListener('click', () => setMode(btn.dataset.mode));
        });
        if (slider) {
            slider.value = savedPos;
            slider.addEventListener('input', (e) => {
                const pos = parseFloat(e.target.value);
                localStorage.setItem('panteon-constan-pos', pos);
                if (root.getAttribute('data-theme') === 'constan') {
                    applyBernardoTokens(pos);
                }
            });
        }

        // Initialize state
        setMode(savedMode);
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeSuite);
    } else {
        initThemeSuite();
    }
    // subtle scroll progress like index
    const bar=document.getElementById('admin-scroll-progress');
    const content=document.querySelector('.content');
    function upd(){
        if(!bar||!content) return;
        const st=content.scrollTop;
        const max=content.scrollHeight - content.clientHeight;
        bar.style.width = max>0 ? (st/max*100)+'%' : '0%';
    }
    const c=document.querySelector('.content');
    if(c) c.addEventListener('scroll', upd);
    window.addEventListener('resize', upd);
})();
</script>

