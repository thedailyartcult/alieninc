    const svg = document.getElementById('lineageSvg');
    const W = svg.clientWidth || 900, H = svg.clientHeight || 600;
    const colors = { external_source: '#3b82f6', pipeline: '#a855f7', pipeline_stage: '#f59e0b', object_type: '#10b981', object: '#ef4444' };
    const nodeMap = {};
    data.nodes.forEach((n, i) => { nodeMap[n.id] = i; });
    const inDeg = {};
    data.nodes.forEach(n => { inDeg[n.id] = 0; });
    data.edges.forEach(e => { if (inDeg[e.downstream_node_id] !== undefined) inDeg[e.downstream_node_id]++; });
    const layers = [];
    const placed = new Set();
    let remaining = data.nodes.map(n => n.id);
    while (remaining.length > 0) {
        const layer = remaining.filter(id => !placed.has(id) && (inDeg[id] === 0 || data.edges.every(e => e.downstream_node_id !== id || placed.has(e.upstream_node_id))));
        if (layer.length === 0) { layer.push(...remaining.filter(id => !placed.has(id))); }
        layers.push(layer);
        layer.forEach(id => placed.add(id));
        remaining = remaining.filter(id => !placed.has(id));
    }
    const positions = {};
    const padX = 80, padY = 50;
    const layerW = (W - padX * 2) / Math.max(layers.length - 1, 1);
    layers.forEach((layer, li) => {
        const x = padX + li * layerW;
        const nodeH = (H - padY * 2) / Math.max(layer.length + 1, 2);
        layer.forEach((id, ni) => { positions[id] = { x: x, y: padY + (ni + 1) * nodeH }; });
    });
    let svgContent = '';
    data.edges.forEach(e => {
        const from = positions[e.upstream_node_id], to = positions[e.downstream_node_id];
        if (from && to) {
            const cx1 = from.x + (to.x - from.x) * 0.4, cx2 = from.x + (to.x - from.x) * 0.6;
            svgContent += '<path d="M' + from.x + ',' + from.y + ' C' + cx1 + ',' + from.y + ' ' + cx2 + ',' + to.y + ' ' + to.x + ',' + to.y + '" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>';
        }
    });
    data.nodes.forEach(n => {
        const pos = positions[n.id];
        if (!pos) return;
        const col = colors[n.node_type] || '#83858c';
        const label = (n.name || n.node_id).slice(0, 24);
        svgContent += '<g class="lineage-node" data-id="' + n.id + '" style="cursor:pointer" onclick="selectLineageNode(\'' + n.id + '\')"><rect x="' + (pos.x - 55) + '" y="' + (pos.y - 18) + '" width="110" height="36" rx="8" fill="' + col + '22" stroke="' + col + '" stroke-width="1.5"/><circle cx="' + (pos.x - 40) + '" cy="' + pos.y + '" r="5" fill="' + col + '"/><text x="' + (pos.x - 28) + '" y="' + (pos.y + 4) + '" fill="white" font-size="11" font-family="var(--font-sans)">' + label + '</text></g>';
    });
    svg.innerHTML = svgContent;
}

function selectLineageNode(nodeId) {
    if (!lineageGraphData) return;
