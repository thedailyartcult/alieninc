        else if (el && s.error) el.innerHTML = '<span style="color:var(--red)">✗ ' + escapeHtml(s.error) + '</span>';
    });
    if (el && st && st.report && st.report.gkg) el.innerHTML = '<span style="color:var(--green)">✓ GDELT: ' + st.report.gkg.events_written + ' events written</span>';
