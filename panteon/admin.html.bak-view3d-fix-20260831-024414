            '<div class="retro-map-marker-line"></div><div class="retro-map-marker-glow"></div>';
        const popup = new maplibregl.Popup({ closeButton: false, offset: 8 }).setHTML(
            '<b>' + THREAT_LABEL[tone] + '</b> · CAMEO ' + (ev.event_code || '?') + ' · ' + (ev.event_type || '') +
