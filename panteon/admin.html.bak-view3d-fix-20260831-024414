async function cmbApi(path) {
    const res = await fetch('/api/cmb' + path, {
        headers: { 'Authorization': 'Bearer ' + CMB_API_TOKEN, 'Content-Type': 'application/json' }
    });
    if (!res.ok) throw new Error('CMB API ' + res.status);
    return await res.json();
}

