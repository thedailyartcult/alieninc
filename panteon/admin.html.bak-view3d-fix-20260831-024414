        }
        setInterval(function () { if (isOpen) pollFeedBudget(); }, 30000);
    }

    // Sidebar "GAIA" is a panel trigger, not a page — intercept the click in the
    // capture phase so the app's navigate() handler never sees it, then land on
    // the fusion page (left column hosts the GEO tab; map stays popup-free).
    document.addEventListener('click', function (e) {
        var t = e.target.closest ? e.target.closest('#gaiaNavItem') : null;
