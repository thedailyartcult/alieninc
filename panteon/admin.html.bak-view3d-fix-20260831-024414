async function sendChatMessage(e) {
    e.preventDefault();
    const agentId = document.getElementById('chatAgentSelect').value;
    if (!agentId) { toast('Select a department first', 'error'); return; }
    const input = document.getElementById('chatInput');
    const msg = input.value.trim();
    if (!msg) return;
    const msgs = document.getElementById('chatMessages');
    msgs.innerHTML += '<div style="align-self:flex-end;background:var(--accent-cyan);color:#fff;padding:8px 14px;border-radius:12px;max-width:70%;font-size:14px">' + msg + '</div>';
    input.value = '';
    msgs.scrollTop = msgs.scrollHeight;
    try {
        const body = { agent_id: agentId, message: msg };
        if (chatSessionId) body.session_id = chatSessionId;
        const res = await api('/yono/agents/chat', { method: 'POST', body: JSON.stringify(body) });
        chatSessionId = res.session_id;

        // Show tool calls if any
        if (res.tool_calls && res.tool_calls.length > 0) {
            let toolsHtml = '<div style="align-self:flex-start;background:rgba(223,241,64,0.1);border:1px solid rgba(223,241,64,0.3);padding:8px 14px;border-radius:12px;max-width:80%;font-size:12px;margin-top:4px">';
            toolsHtml += '<div style="color:var(--accent-purple);font-weight:600;margin-bottom:4px">Ontology Tools Called (' + res.tool_calls.length + ')</div>';
            res.tool_calls.forEach(tc => {
                const icon = tc.denied ? '&#10007;' : '&#10003;';
                const color = tc.denied ? 'var(--red)' : 'var(--green)';
                toolsHtml += '<div style="display:flex;align-items:center;gap:6px;margin:3px 0">';
                toolsHtml += '<span style="color:' + color + '">' + icon + '</span>';
                toolsHtml += '<span style="color:var(--accent-cyan);font-family:var(--font-mono)">' + tc.tool + '</span>';
                if (tc.args && tc.args.type_name) toolsHtml += '<span style="color:var(--text-muted)">(' + tc.args.type_name + ')</span>';
                if (tc.denied) toolsHtml += '<span style="color:var(--red);font-size:11px">DENIED: ' + (tc.reason || '') + '</span>';
                toolsHtml += '</div>';
            });
            toolsHtml += '</div>';
            msgs.innerHTML += toolsHtml;
        }

        // Show iterations info
        if (res.iterations && res.iterations > 1) {
            msgs.innerHTML += '<div style="align-self:flex-start;font-size:11px;color:var(--text-dim);padding:2px 8px">Reasoning iterations: ' + res.iterations + '</div>';
        }

        // Show response
        msgs.innerHTML += '<div style="align-self:flex-start;background:var(--bg-light);border:1px solid var(--border-light);padding:8px 14px;border-radius:12px;max-width:70%;font-size:14px">' + (res.response || '--') + '</div>';
        msgs.scrollTop = msgs.scrollHeight;
    } catch (e) { msgs.innerHTML += '<div style="align-self:flex-start;color:var(--red);font-size:13px">Error: ' + e.message + '</div>'; }
}

