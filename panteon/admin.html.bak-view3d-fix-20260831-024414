<script>
(function () {
    'use strict';

    var LS_LAYOUT = 'sc_deck_layout_v1';
    var LS_WS     = 'sc_deck_workspaces_v1';
    var LS_AWS    = 'sc_deck_ws_active_v1';
    var LS_RAIL   = 'sc_deck_rail_v1';      // {mode:'rail'|'full', hidden:[ids]}
    var LS_WFOCUS = 'sc_deck_ws_focus_v1';  // {wsName: lastFocusedToolId}
    var MAX_SIDE = 2, MAX_BOTTOM = 1;

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        s = s == null ? '' : String(s);
        if (typeof window.escapeHtml === 'function') return window.escapeHtml(s);
        return s.replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
