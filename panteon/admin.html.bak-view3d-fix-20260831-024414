    // ------------------------------------------------------------------ tools
    var TOOLS = {};          // id -> {id,title,label,icon,el,home,parent,index,loaded,win,platform}
    var PLATFORM_ORDER = [];
    var PREF_ZONE = { 'sc-fusion': 'S', 'lineage-graph': 'S', 'crackerbox-threatmap': 'S', 'overview': 'S' };

    function labelOf(item) {
        var l = item.querySelector('.nav-label');
        return (l ? l.textContent : item.textContent).trim();
    }
    function buildTools() {
        PLATFORM_ORDER.length = 0;
        document.querySelectorAll('.nav-section').forEach(function (sec) {
            var tEl = sec.querySelector('.nav-section-title');
            var plat = tEl ? tEl.textContent.trim() : 'Platform';
            if (sec.classList.contains('ps-off')) return; // platform disabled via Mission Select
            if (PLATFORM_ORDER.indexOf(plat) < 0) PLATFORM_ORDER.push(plat);
            sec.querySelectorAll('.nav-item').forEach(function (item) {
                var pg = item.dataset.page;
                var iconSvg = item.querySelector('svg');
                var icon = iconSvg ? iconSvg.outerHTML : '';
                var label = labelOf(item);
                if (pg) {
                    if (!TOOLS[pg]) TOOLS[pg] = {
                        id: pg, title: (window.PAGES && PAGES[pg]) || label, label: label,
                        icon: icon, el: $('page-' + pg), win: null
                    };
                    TOOLS[pg].platform = plat;
                } else if (item.id === 'gaiaNavItem') {
                    TOOLS.gaia = { id: 'gaia', title: 'GAIA Geo Controller', label: label || 'GAIA', icon: icon, el: null, win: 'gaia', platform: plat };
                } else if (item.id === 'wonNavItem') {
                    TOOLS.won = { id: 'won', title: 'Watch Notes', label: label || 'Watch Notes', icon: icon, el: null, win: 'won', platform: plat };
                }
            });
        });
        if (!TOOLS.won) {
            TOOLS.won = { id: 'won', title: 'Watch Notes', label: 'Watch Notes', icon: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2h10v12H3z"/><path d="M5.5 5h5M5.5 8h5M5.5 11h3"/></svg>', el: null, win: 'won', platform: 'Controllers' };
        } else if (!TOOLS.won.platform) TOOLS.won.platform = 'Controllers';
        Object.keys(TOOLS).forEach(function (id) {
            var t = TOOLS[id];
            if (!t.platform) t.platform = 'Controllers';
            if (t.el) { t.parent = t.el.parentNode; t.index = Array.prototype.indexOf.call(t.parent.children, t.el); }
        });
    }
    function findTool(id) { return TOOLS[id] || null; }

    // ------------------------------------------------------------------ state
    function freshState() {
        return { sizes: { l: 20, r: 24, b: 26 }, zones: { L: [], R: [], B: [], S: [] },
                 floats: {}, mode: {}, collapsed: {}, maximized: null, tabOrder: [], zsplits: { L: 50, R: 50 } };
    }
    var S = freshState();
    var root, grid, floatsEl, stageBody, tabsEl, topbarEl;
    var focusZ = 10;
    var silentFocus = false;   // suppress per-focus persistence while (re)building a layout

    // Chrome-style platform tabs: per-platform state that must survive
    // applyLayout()'s freshState() reset. One platform visible at a time.
    var PLAT = { stash: {}, focus: {}, stack: [] };
    var switching = false;     // true while a platform switch tears down panels

    function persist() { store(LS_LAYOUT, { v: 1, sizes: S.sizes, zones: S.zones, floats: S.floats, mode: S.mode, collapsed: S.collapsed, tabOrder: S.tabOrder, zsplits: S.zsplits, plat: PLAT }); }

    // ------------------------------------------------------------------- dom
    function ensureDom() {
        if ($('deck-root')) return;
        root = document.createElement('div');
        root.id = 'deck-root';
        root.hidden = true;
        root.innerHTML =
            '<div class="deck-grid">' +
                '<section class="deck-zone" data-zone="L"></section>' +
                '<div class="deck-split" data-split="L" title="Drag to resize"></div>' +
                '<section class="deck-stage">' +
                    '<div class="deck-stage-body"></div>' +
                '</section>' +
                '<div class="deck-split" data-split="R" title="Drag to resize"></div>' +
                '<section class="deck-zone" data-zone="R"></section>' +
                '<div class="deck-split" data-split="B" title="Drag to resize"></div>' +
                '<section class="deck-zone" data-zone="B"></section>' +
            '</div>' +
            '<div id="deck-floats"></div>';
        var main = document.querySelector('.main-container');
        main.insertBefore(root, main.firstChild);
        grid = root.querySelector('.deck-grid');
        floatsEl = root.querySelector('#deck-floats');
        stageBody = root.querySelector('.deck-stage-body');
        tabsEl = root.querySelector('.deck-tabs');

        grid.querySelectorAll('.deck-split').forEach(bindSplitter);
        bindFloatLayer();
        tabsDelegate();
    }

    function zoneEl(z) { return grid.querySelector('.deck-zone[data-zone="' + z + '"]'); }
    function panelByTool(id) { return root.querySelector('.deck-panel[data-tool="' + id + '"]'); }

    function applySizes() {
        var hasL = S.zones.L.length > 0, hasR = S.zones.R.length > 0, hasB = S.zones.B.length > 0;
        var l = hasL ? S.sizes.l : 0, r = hasR ? S.sizes.r : 0, b = hasB ? S.sizes.b : 0;
        var mid = Math.max(30, 100 - l - r);
        var top = Math.max(20, 100 - b);
        grid.style.setProperty('--deck-lw', l + 'fr');
        grid.style.setProperty('--deck-rw', r + 'fr');
        grid.style.setProperty('--deck-bh', b + 'fr');
        grid.style.setProperty('--deck-sl', hasL ? '6px' : '0px');
        grid.style.setProperty('--deck-sr', hasR ? '6px' : '0px');
        grid.style.setProperty('--deck-sb', hasB ? '6px' : '0px');
        grid.style.gridTemplateRows = 'minmax(0,' + top + 'fr) ' + (hasB ? '6px' : '0px') + ' minmax(0,' + b + 'fr)';
    }

    function scheduleMapResize() {
        clearTimeout(scheduleMapResize._t);
        scheduleMapResize._t = setTimeout(function () {
            ['fusionMap', 'aviationMap', 'threatMap'].forEach(function (k) {
                try { if (window[k] && typeof window[k].resize === 'function') window[k].resize(); } catch (e) {}
            });
            try { window.dispatchEvent(new Event('deck-layout')); } catch (e) {}
        }, 260);
    }

    // ---------------------------------------------------------------- panels
    function panelHTML(t) {
        return '<header class="deck-phead">' +
            '<span class="deck-pdot"></span>' +
            '<span class="deck-ptitle">' + esc(t.title) + '</span>' +
            '<span class="deck-ptag"></span>' +
            '<nav class="deck-pbtns">' +
                '<button type="button" data-act="page" title="Open as full page">&#8618;</button>' +
                '<button type="button" data-act="max" title="Maximize">&#9633;</button>' +
                '<button type="button" data-act="collapse" title="Collapse">&ndash;</button>' +
                '<button type="button" data-act="close" title="Close" class="deck-x">&times;</button>' +
            '</nav>' +
        '</header>' +
        '<div class="deck-pbody"></div>' +
        ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'].map(function (d) {
            return '<span class="deck-rh deck-rh-' + d + '" data-dir="' + d + '"></span>';
        }).join('');
    }

    function createPanel(t, zone) {
        var p = document.createElement('section');
        p.className = 'deck-panel';
        p.dataset.tool = t.id;
        p.innerHTML = panelHTML(t);
        p.querySelector('.deck-pbody').appendChild(t.el);
        t.el.classList.add('deck-live');
        if (zone === 'F') { floatsEl.appendChild(p); setMode(p, 'float'); }
        else if (zone === 'S') { stageBody.appendChild(p); setMode(p, 'stage'); }
        else { zoneEl(zone).appendChild(p); setMode(p, zone === 'B' ? 'docked-b' : 'docked'); }
        bindPanel(p, t);
        syncPanelChrome(p);
        if (zone === 'L' || zone === 'R') applyZoneSplit(zone);
        focusPanel(p);
        return p;
    }

    function setMode(p, m) {
        var t = findTool(p.dataset.tool);
        p.classList.toggle('deck-float', m === 'float');
        p.classList.remove('deck-max');
        if (t) S.mode[t.id] = m;
        if (m !== 'float') {
            delete p.style.left; delete p.style.top; delete p.style.width; delete p.style.height; delete p.style.zIndex;
        }
    }

    function placeFloat(p, geo) {
        var r = root.getBoundingClientRect();
        var g = geo || S.floats[p.dataset.tool] || {};
        var w = clamp(g.w || 560, 320, Math.max(320, r.width - 40));
        var h = clamp(g.h || Math.round(r.height * 0.72), 200, Math.max(200, r.height - 30));
        var x = g.x != null ? g.x : Math.max(10, r.width - w - 30);
        var y = g.y != null ? g.y : 18;
        p.style.width = w + 'px'; p.style.height = h + 'px';
        p.style.left = clamp(x, 0, Math.max(0, r.width - w)) + 'px';
        p.style.top = clamp(y, 0, Math.max(0, r.height - 60)) + 'px';
        S.floats[p.dataset.tool] = { x: parseFloat(p.style.left), y: parseFloat(p.style.top), w: w, h: h };
    }

    function focusPanel(p) {
        root.querySelectorAll('.deck-panel').forEach(function (x) { x.classList.remove('deck-focus'); });
        p.classList.add('deck-focus');
        focusZ += 1;
        p.style.zIndex = focusZ;
        S.focus = p.dataset.tool;
        if (!silentFocus) wsFocusSet(wsActiveName(), p.dataset.tool);
        var t = findTool(p.dataset.tool);
        if (t) $('topbarTitle').textContent = t.title;
        if (t && t.platform) {
            PLAT.focus[t.platform] = p.dataset.tool;
        }
        if (p.classList.contains('deck-float')) { placeFloat(p, S.floats[p.dataset.tool]); p.style.zIndex = focusZ; }
        renderTopbarTabs();
    }

    // mount/unmount ----------------------------------------------------------
    function unmountTool(t) {
        if (!t.parent || !t.el) return;
        try {
            t.parent.insertBefore(t.el, t.parent.children[t.index] || null);
        } catch (e) { t.parent.appendChild(t.el); }
        t.el.classList.remove('deck-live');
        var hash = (window.location.hash || '').slice(1);
        if (hash === t.id && !switching && typeof window.navigate === 'function') navigate(t.id);
    }

    function removeFromState(id) {
        ['L', 'R', 'B', 'S'].forEach(function (z) {
            var i = S.zones[z].indexOf(id);
            if (i >= 0) S.zones[z].splice(i, 1);
        });
        var ti = S.tabOrder.indexOf(id);
        if (ti >= 0) S.tabOrder.splice(ti, 1);
        delete S.collapsed[id];
        if (S.maximized === id) S.maximized = null;
    }

    // public-ish ops ---------------------------------------------------------
    function open(id, opts) {
        opts = opts || {};
        var t = findTool(id);
        if (!t) return false;
        if (typeof window.revealNavSection === 'function') window.revealNavSection(id);
        // Platform exclusivity: opening a tool from another platform switches
        // the whole stage to that platform (Chrome-tab semantics).
        if (!t.win && rootVisible()) {
            var tp = t.platform || 'Controllers';
            var ap = activePlatform();
            if (ap && tp !== ap) switchPlatform(tp);
        }
        if (t.win) { runWindowTool(t); return true; }
        if (!t.el) return false;
        var existing = panelByTool(id);
        if (existing) {
            if (!rootVisible()) showRoot(true);
            focusPanel(existing);
            if (existing.classList.contains('deck-collapse')) toggleCollapse(existing);
            return true;
        }
        var zone = opts.zone || PREF_ZONE[id] || 'R';
        if (zone === 'B' && S.zones.B.length >= MAX_BOTTOM) zone = 'S';
        else if ((zone === 'L' || zone === 'R') && S.zones[zone].length >= MAX_SIDE) zone = 'S';
        S.zones[zone].push(id);
        if (S.tabOrder.indexOf(id) < 0) S.tabOrder.push(id);
        if (!rootVisible()) showRoot(true);
        createPanel(t, zone);
        loadToolData(t);
        applySizes(); persist(); scheduleMapResize();
        return true;
    }

    function close(id) {
        var t = findTool(id); var p = panelByTool(id);
        if (!t || !p) return;
        p.querySelector('.deck-pbody').appendChild(t.el); // keep node alive while moving
        removeFromState(id);
        p.remove();
        applyZoneSplit('L'); applyZoneSplit('R');
        unmountTool(t);
        if (!anyPanels()) showRoot(false);
        applySizes(); persist(); renderTopbarTabs(); scheduleMapResize();
    }

    function anyPanels() { return !!root.querySelector('.deck-panel'); }
    function rootVisible() { return !root.hidden; }
    function showRoot(v) {
        root.hidden = !v;
        var content = document.querySelector('.main-container .content');
        if (content) content.style.display = v ? 'none' : '';
        var bar = document.querySelector('.topbar');
        if (bar) bar.classList.toggle('has-deck', !!v);
        if (!v) {
            var hash = (window.location.hash || '').slice(1);
            $('topbarTitle').textContent = (window.PAGES && PAGES[hash]) || 'Overview';
        }
        renderTopbarTabs();
        scheduleMapResize();
    }
    function exitDeck() { // close everything, return classic
        Object.keys(TOOLS).forEach(function (id) { if (panelByTool(id)) close(id); });
        showRoot(false);
    }

    function loadToolData(t) {
        if (t.loaded) return;
        t.loaded = true;
        if (typeof window.loadPageData === 'function') {
            try { loadPageData(t.id); } catch (e) {}
        }
        if (typeof window.initCMBReveal === 'function') { try { initCMBReveal(t.el); } catch (e) {} }
    }

    function runWindowTool(t) {
        // GAIA / Watch Notes are embedded controllers of the fusion page's left
        // column — launching them lands on Spinal Cracker and opens their tab.
        if (t.win === 'gaia' && window.GAIA) {
            try { if (typeof window.navigate === 'function') window.navigate('sc-fusion'); } catch (e) {}
            GAIA.open();
            return;
        }
        if (t.win === 'won' && window.WONote) {
            try { if (typeof window.navigate === 'function') window.navigate('sc-fusion'); } catch (e) {}
            WONote.open();
            try { if (typeof window.__mavenSetFeature === 'function') window.__mavenSetFeature('notes'); } catch (e) {}
            return;
        }
    }

    // interactions ------------------------------------------------------------
    function toggleCollapse(p) {
        p.classList.toggle('deck-collapse');
        S.collapsed[p.dataset.tool] = p.classList.contains('deck-collapse');
        persist(); scheduleMapResize();
    }

    function toggleMax(p) {
        if (p.classList.contains('deck-max')) {
            p.classList.remove('deck-max'); S.maximized = null;
        } else {
            root.querySelectorAll('.deck-panel').forEach(function (x) { x.classList.remove('deck-max'); });
            p.classList.add('deck-max'); S.maximized = p.dataset.tool;
        }
        persist(); scheduleMapResize();
    }

    function undockToFloating(p, px, py) {
        var id = p.dataset.tool;
        removeFromState(id);
        floatsEl.appendChild(p);
        setMode(p, 'float');
        syncPanelChrome(p);
        applyZoneSplit('L'); applyZoneSplit('R');
        placeFloat(p, { x: px - 120, y: py - 15 });
        applySizes(); persist(); renderTopbarTabs(); scheduleMapResize();
    }

    function dockPanel(p, zone) {
        var id = p.dataset.tool;
        if ((zone === 'L' || zone === 'R') && S.zones[zone].length >= MAX_SIDE) zone = 'S';
        if (zone === 'B' && S.zones.B.length >= MAX_BOTTOM) zone = 'S';
        removeFromState(id);
        if (zone === 'S') stageBody.appendChild(p);
        else zoneEl(zone).appendChild(p);
        setMode(p, zone === 'S' ? 'stage' : zone === 'B' ? 'docked-b' : 'docked');
        S.zones[zone].push(id);
        if (S.tabOrder.indexOf(id) < 0) S.tabOrder.push(id);
        syncPanelChrome(p);
        if (zone === 'L' || zone === 'R') applyZoneSplit(zone);
        applySizes(); persist(); renderTopbarTabs(); scheduleMapResize();
    }

    function dropZoneFor(px, py) {
        var r = grid.getBoundingClientRect();
        if (px < r.left || px > r.right || py < r.top || py > r.bottom) return null;
        var rx = (px - r.left) / r.width, ry = (py - r.top) / r.height;
        if (rx < 0.16) return 'L';
        if (rx > 0.84) return 'R';
        if (ry > 0.72) return 'B';
        return 'S';
    }

    function clearHints() { grid.classList.remove('deck-drop-l', 'deck-drop-r', 'deck-drop-b', 'deck-drop-s'); }

    function bindPanel(p, t) {
        var head = p.querySelector('.deck-phead');
        head.addEventListener('pointerdown', function (e) {
            if (e.target.closest('button')) return;
            if (e.button !== 0) return;
            e.preventDefault();
            focusPanel(p);
            var startX = e.clientX, startY = e.clientY;
            var floating = p.classList.contains('deck-float');
            var startLeft = parseFloat(p.style.left) || 0, startTop = parseFloat(p.style.top) || 0;
            var moved = false;
            head.setPointerCapture(e.pointerId);
            function onMove(ev) {
                if (!moved && !floating) {
                    if (Math.abs(ev.clientX - startX) + Math.abs(ev.clientY - startY) < 7) return;
                    moved = true;
                    undockToFloating(p, ev.clientX, ev.clientY);
                    startLeft = parseFloat(p.style.left) || 0; startTop = parseFloat(p.style.top) || 0;
                }
                moved = true;
                var rr = root.getBoundingClientRect();
                p.style.left = clamp(startLeft + (ev.clientX - startX), 0, rr.width - 80) + 'px';
                p.style.top = clamp(startTop + (ev.clientY - startY), 0, rr.height - 40) + 'px';
                var dz = dropZoneFor(ev.clientX, ev.clientY);
                clearHints();
                if (dz === 'L') grid.classList.add('deck-drop-l');
                else if (dz === 'R') grid.classList.add('deck-drop-r');
                else if (dz === 'B') grid.classList.add('deck-drop-b');
                else if (dz === 'S') grid.classList.add('deck-drop-s');
            }
            function onUp(ev) {
                head.removeEventListener('pointermove', onMove);
                head.removeEventListener('pointerup', onUp);
                clearHints();
                if (moved) {
                    var dz = dropZoneFor(ev.clientX, ev.clientY);
                    if (dz) {
                        dockPanel(p, dz);
                        applySizes(); renderTopbarTabs(); scheduleMapResize();
                    } else {
                        S.floats[p.dataset.tool] = { x: parseFloat(p.style.left), y: parseFloat(p.style.top), w: parseFloat(p.style.width), h: parseFloat(p.style.height) };
                        persist();
                    }
                }
            }
            head.addEventListener('pointermove', onMove);
            head.addEventListener('pointerup', onUp);
        });

        p.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-act]');
            if (!b) return;
            var act = b.dataset.act;
            if (act === 'close') close(p.dataset.tool);
            else if (act === 'collapse') toggleCollapse(p);
            else if (act === 'max') toggleMax(p);
            else if (act === 'page') { var id = p.dataset.tool; close(id); navigate(id); }
        });

        p.addEventListener('pointerdown', function () { focusPanel(p); }, true);

        p.querySelectorAll('.deck-rh').forEach(function (rh) {
            rh.addEventListener('pointerdown', function (e) {
                e.preventDefault(); e.stopPropagation();
                var dir = rh.dataset.dir;
                var sx = e.clientX, sy = e.clientY;
                var w0 = p.offsetWidth, h0 = p.offsetHeight, l0 = parseFloat(p.style.left) || 0, t0 = parseFloat(p.style.top) || 0;
                rh.setPointerCapture(e.pointerId);
                function mv(ev) {
                    var dx = ev.clientX - sx, dy = ev.clientY - sy;
                    var rr = root.getBoundingClientRect();
                    var w = w0, h = h0, l = l0, tp = t0;
                    if (dir.indexOf('e') >= 0) w = clamp(w0 + dx, 300, rr.width - l0 - 4);
                    if (dir.indexOf('s') >= 0) h = clamp(h0 + dy, 160, rr.height - t0 - 4);
                    if (dir.indexOf('w') >= 0) { w = clamp(w0 - dx, 300, l0 + w0 - 4); l = l0 + w0 - w; }
                    if (dir.indexOf('n') >= 0) { h = clamp(h0 - dy, 160, t0 + h0 - 4); tp = t0 + h0 - h; }
                    p.style.width = w + 'px'; p.style.height = h + 'px';
                    p.style.left = l + 'px'; p.style.top = tp + 'px';
                }
                function up() {
                    rh.removeEventListener('pointermove', mv);
                    rh.removeEventListener('pointerup', up);
                    S.floats[p.dataset.tool] = { x: parseFloat(p.style.left), y: parseFloat(p.style.top), w: p.offsetWidth, h: p.offsetHeight };
                    persist(); scheduleMapResize();
                }
                rh.addEventListener('pointermove', mv);
                rh.addEventListener('pointerup', up);
            });
        });
    }

    // splitters ----------------------------------------------------------------
    function bindSplitter(sp) {
        sp.addEventListener('pointerdown', function (e) {
            e.preventDefault();
            var which = sp.dataset.split;
            var r = grid.getBoundingClientRect();
            sp.classList.add('active');
