    if(pg){
      const lbl=(el.textContent||'').replace(/\s+/g,' ').trim().slice(0,48);
      const mp=PAGES_MAP[pg];
      if(mp) return enrich(mp + (lbl && lbl!==mp ? ' — ' + lbl : ''));
      if(lbl) return enrich(lbl);
    }
    if(el.classList && el.classList.contains('nav-item')){
      const tx=(el.textContent||'').replace(/\s+/g,' ').trim();
      if(tx) return enrich(tx);
    }
    // id-based help for selects/inputs without titles
    if(el.id && ID_HELP[el.id]) return ID_HELP[el.id];
