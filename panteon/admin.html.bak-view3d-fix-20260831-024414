  }
  // richer button-text → help mapping so the bar says more than the label itself
  const BTN_HELP={
    'MAVEN':'MAVEN — Smart Layer: tasks, assets, COA, objects & places',
    'GEO':'GEO — GAIA Geo Controller, terrain & overlays',
    'NOTES':'NOTES — Watch Notes for this AOI',
    'AGENT':'AGENT — YONO ontology chat (Ctrl+Shift+Y)',
    'PICK TARGET ON MAP':'Pick Target — click map to set Maven task target',
    'SCOUT: OFF':'Scout — spawn physics-bound scout with live viewpoint cone',
    'SCOUT: ON':'Scout — physics-bound scout active, click map to move, click scout to clear',
    'Run GDELT':'Run GDELT — query GDELT Doc 2.0 for current scope & time window',
    'Run OpenSky':'Run OpenSky — fetch live aircraft for current scope',
    'Validate':'Validate — check GDELT query & scope before running',
    'Refresh':'Refresh — re-render fusion map with current layers',
    'OVERLAYS ON':'Overlays — all markers, rings & towers visible',
    'OVERLAYS OFF':'Overlays — markers, rings & towers hidden',
    'REGISTER OBJECT':'+ Register Object — create a new ontology object',
    'WARGAME ANALYSIS · 3 POSTURES':'Wargame — campaign posture comparison scored by SIMS'
