async function startGkgPipeline(config, onUpdate) {
    // Verification-first: never send an unverified query to the background pull.
    const verified = await gkgEnsureVerified(config.query, config.maxrecords);
    if (!verified) {
        const lv = window._lastGkgValidation;
        const msg = (lv && lv.errors && lv.errors.length) ? lv.errors[0].message
                  : (lv && lv.message) ? lv.message
                  : 'query rejected by verification';
        if (onUpdate) onUpdate({ error: '✗ ' + msg });
        return null;
    }
    try {
        const startResp = await api('/gkg/pipeline/run', { method: 'POST', body: JSON.stringify(config) });
        if (startResp && startResp.status === 'rejected') {
            renderGkgValidation(startResp.verification || { valid: false, errors: [], warnings: [], live: 'skipped' });
            if (onUpdate) onUpdate({ error: 'query rejected by verification — see status above' });
            refreshGkgBudget();
            return null;
        }
    } catch (e) {
        if (onUpdate) onUpdate({ error: e.message || 'pipeline failed to start' });
        refreshGkgBudget();
        return null;
    }
    const t0 = Date.now();
    while (Date.now() - t0 < 900000) {
        await new Promise(r => setTimeout(r, 3000));
        let st;
        try { st = await api('/gkg/pipeline/status'); } catch (e) { continue; }
        if (onUpdate) onUpdate(st);
        if (st.status !== 'running') return st;
    }
    if (onUpdate) onUpdate({ error: 'pipeline status timed out' });
    return null;
}

