async function fusionValidate() {
    const q = (document.getElementById('fusionQuery').value || '').trim() || SCScope.query;
    const config = { query: q, mode: 'events', timespan: SCScope.timeWindow, maxrecords: 50, api_key: '', country_code: scCountryFips() };
