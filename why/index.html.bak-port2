                            </div>
                        </div>

                        <!-- HUD: Company search (BGC directory + group companies from the source of truth) -->
                        <div class="retro-map-hud-panel retro-map-hud-center retro-map-search">
                            <input id="retro-company-search" class="retro-map-search-input" type="text" autocomplete="off" spellcheck="false" placeholder="help me find the tech stack of this company" aria-label="Search BGC directory and group companies">
                            <div id="retro-search-results" class="retro-map-search-results"></div>
                        </div>

                        <!-- DATABASE STATUS panel removed: the beehive FOCUS SECTOR deck now
                             carries the live sector telemetry, and the static company-count
                             card had a stale "7 COMPANIES" placeholder that never refreshed
                             after the API-backed node list loaded. -->

                        <!-- MAP VIEWS deck removed: DEFAULT / GRID FLOW now live as clickable
                             honeycomb tiles in the FOCUS SECTOR beehive above. The building-
                             height spectral legend was retired alongside the corridor-based
                             grid flow, which is now a company-connection arc view. -->

                        <!-- Map Render Port -->

                        <div id="aliens-network-map" style="height: 100%; width: 100%;"></div>

                        <!-- Circular Radar-masked Minimap (fable Minimap adapted) -->
                        <div class="retro-map-radar-frame">
                            <div id="retro-compass-radar-map" class="retro-map-radar-viewport"></div>
                            <div class="retro-map-radar-overlay">
                                <div class="retro-map-radar-sweep"></div>
                                <div class="retro-map-radar-scope"></div>
                            </div>
