            const col = pct >= 55 ? 'var(--green)' : pct <= 45 ? 'var(--red)' : 'var(--amber)';
            return `<td style="color:${col}" title="${cell.samples} samples">${pct}%<span style="color:var(--text-dim)">/${cell.samples}</span></td>`;
