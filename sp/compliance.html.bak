<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Intelligence Dashboard | Statute & Precedent</title>
    <link href="https://fonts.googleapis.com/css?family=Playfair+Display:400,400i,700,700i|Rubik:300,300i,400,500,700,700i&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #f8f9fa;
            font-family: 'Rubik', sans-serif;
            color: #1a1a2e;
            min-height: 100vh;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #0a0e1c 0%, #16213e 100%);
            color: #ffffff;
            padding: 32px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dashboard-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 500;
            letter-spacing: 1px;
        }

        .dashboard-header .subtitle {
            font-size: 0.82rem;
            color: #888;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 4px;
        }

        .header-actions {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .scan-btn {
            background-color: #00cfc1;
            color: #0a0e1c;
            border: none;
            padding: 12px 24px;
            border-radius: 4px;
            font-family: 'Rubik', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .scan-btn:hover { background-color: #00e6d6; }
        .scan-btn:disabled { background-color: #666; cursor: not-allowed; }

        .last-scan {
            font-size: 0.75rem;
            color: #888;
            text-align: right;
        }

        .dashboard-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 48px;
        }

        /* Summary Cards */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 48px;
        }

        .summary-card {
            background: #ffffff;
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            border-left: 4px solid #00cfc1;
        }

        .summary-card.warning { border-left-color: #f39c12; }
        .summary-card.danger { border-left-color: #e74c3c; }
        .summary-card.success { border-left-color: #27ae60; }

        .summary-card .label {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #888;
            margin-bottom: 8px;
        }

        .summary-card .value {
            font-size: 2.4rem;
            font-weight: 700;
            color: #1a1a2e;
            line-height: 1;
        }

        .summary-card .detail {
            font-size: 0.8rem;
            color: #666;
            margin-top: 8px;
        }

        /* Company Grid */
        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 400;
            margin-bottom: 24px;
            color: #1a1a2e;
        }

        .company-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 24px;
            margin-bottom: 48px;
        }

        .company-card {
            background: #ffffff;
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .company-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .company-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .company-type {
            font-size: 0.68rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #888;
            background: #f0f0f0;
            padding: 4px 8px;
            border-radius: 3px;
        }

        .compliance-score {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .score-bar {
            flex: 1;
            height: 8px;
            background: #eee;
            border-radius: 4px;
            overflow: hidden;
        }

        .score-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        .score-fill.high { background: #27ae60; }
        .score-fill.medium { background: #f39c12; }
        .score-fill.low { background: #e74c3c; }

        .score-value {
            font-size: 1.4rem;
            font-weight: 700;
            min-width: 50px;
            text-align: right;
        }

        .check-list {
            list-style: none;
        }

        .check-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #f5f5f5;
            font-size: 0.82rem;
        }

        .check-item:last-child { border-bottom: none; }

        .check-icon {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            flex-shrink: 0;
        }

        .check-icon.pass { background: #d4edda; color: #155724; }
        .check-icon.fail { background: #f8d7da; color: #721c24; }

        .risk-badge {
            display: inline-block;
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 2px 6px;
            border-radius: 3px;
            margin-left: auto;
        }

        .risk-badge.critical { background: #f8d7da; color: #721c24; }
        .risk-badge.high { background: #fff3cd; color: #856404; }
        .risk-badge.medium { background: #d1ecf1; color: #0c5460; }

        /* Alerts Section */
        .alerts-section {
            background: #ffffff;
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            margin-bottom: 48px;
        }

        .alert-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 16px 0;
            border-bottom: 1px solid #f5f5f5;
        }

        .alert-item:last-child { border-bottom: none; }

        .alert-severity {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .alert-severity.critical { background: #e74c3c; }
        .alert-severity.high { background: #f39c12; }

        .alert-message {
            font-size: 0.85rem;
            line-height: 1.5;
            flex: 1;
        }

        .alert-date {
            font-size: 0.72rem;
            color: #888;
            white-space: nowrap;
        }

        /* Financial Impact */
        .risk-section {
            background: #ffffff;
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .risk-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f5f5f5;
        }

        .risk-item:last-child { border-bottom: none; }

        .risk-company {
            font-weight: 500;
        }

        .risk-amount {
            font-size: 0.82rem;
            color: #e74c3c;
            font-weight: 600;
        }

        /* Loading State */
        .loading {
            text-align: center;
            padding: 60px;
            color: #888;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #eee;
            border-top-color: #00cfc1;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 16px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* No Data */
        .no-data {
            text-align: center;
            padding: 40px;
            color: #888;
            font-size: 0.9rem;
        }

        .no-data p { margin-top: 8px; font-size: 0.8rem; }

        @media (max-width: 1024px) {
            .summary-grid { grid-template-columns: repeat(2, 1fr); }
            .dashboard-content { padding: 24px; }
        }

        @media (max-width: 768px) {
            .summary-grid { grid-template-columns: 1fr; }
            .company-grid { grid-template-columns: 1fr; }
            .dashboard-header { flex-direction: column; gap: 16px; }
        }
    </style>
</head>
<body>
    <header class="dashboard-header">
        <div>
            <h1>Legal Intelligence Dashboard</h1>
            <div class="subtitle">Statute & Precedent — Continuous Compliance Monitoring</div>
        </div>
        <div class="header-actions">
            <div class="last-scan" id="lastScan">Last scan: Never</div>
            <button class="scan-btn" id="scanBtn" onclick="runScan()">Run Compliance Scan</button>
        </div>
    </header>

    <main class="dashboard-content">
        <!-- Summary Cards -->
        <div class="summary-grid" id="summaryGrid">
            <div class="summary-card">
                <div class="label">Overall Compliance</div>
                <div class="value" id="overallScore">—</div>
                <div class="detail">Across all 7 companies</div>
            </div>
            <div class="summary-card danger">
                <div class="label">Critical Alerts</div>
                <div class="value" id="criticalAlerts">—</div>
                <div class="detail">Immediate action required</div>
            </div>
            <div class="summary-card warning">
                <div class="label">High Priority</div>
                <div class="value" id="highAlerts">—</div>
                <div class="detail">Review within 48 hours</div>
            </div>
            <div class="summary-card success">
                <div class="label">Companies Compliant</div>
                <div class="value" id="compliantCount">—</div>
                <div class="detail">Score ≥ 80%</div>
            </div>
        </div>

        <!-- Company Compliance Cards -->
        <h2 class="section-title">Company Compliance Status</h2>
        <div class="company-grid" id="companyGrid">
            <div class="loading">
                <div class="loading-spinner"></div>
                Loading compliance data...
            </div>
        </div>

        <!-- Active Alerts -->
        <h2 class="section-title">Active Alerts</h2>
        <div class="alerts-section" id="alertsSection">
            <div class="no-data" id="noAlerts">
                No active alerts. Run a compliance scan to check status.
            </div>
        </div>

        <!-- Financial Risk Exposure -->
        <h2 class="section-title">Financial Risk Exposure</h2>
        <div class="risk-section" id="riskSection">
            <div class="no-data">
                Risk data populates after compliance scan.
            </div>
        </div>
    </main>

    <script>
        const API_BASE = '/api/compliance';

        async function runScan() {
            const btn = document.getElementById('scanBtn');
            btn.disabled = true;
            btn.textContent = 'Scanning...';

            try {
                const res = await fetch(API_BASE + '/scan', { method: 'POST' });
                if (res.ok) {
                    await loadDashboard();
                }
            } catch (e) {
                console.error('Scan failed:', e);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Run Compliance Scan';
            }
        }

        async function loadDashboard() {
            try {
                const res = await fetch(API_BASE + '/report');
                if (!res.ok) throw new Error('No data');
                const data = await res.json();
                renderDashboard(data);
            } catch (e) {
                console.log('No scan data available. Running initial scan...');
                document.getElementById('companyGrid').innerHTML = `
                    <div class="no-data">
                        <p>No compliance data found. Click "Run Compliance Scan" to begin monitoring.</p>
                    </div>
                `;
            }
        }

        function renderDashboard(report) {
            const o = report.overall;

            // Summary cards
            document.getElementById('overallScore').textContent = o.compliance_rate + '%';
            document.getElementById('criticalAlerts').textContent = o.critical_alerts;
            document.getElementById('highAlerts').textContent = o.high_alerts;
            document.getElementById('compliantCount').textContent = o.compliant_companies + '/' + o.total_companies;

            // Last scan
            document.getElementById('lastScan').textContent = 'Last scan: ' + new Date(report.report_date).toLocaleString();

            // Company cards
            const grid = document.getElementById('companyGrid');
            grid.innerHTML = '';

            for (const [id, company] of Object.entries(report.companies)) {
                const scoreClass = company.compliance_score >= 80 ? 'high' : company.compliance_score >= 50 ? 'medium' : 'low';
                const card = document.createElement('div');
                card.className = 'company-card';
                card.innerHTML = `
                    <div class="company-card-header">
                        <div class="company-name">${company.name}</div>
                        <div class="company-type">${company.type}</div>
                    </div>
                    <div class="compliance-score">
                        <div class="score-bar">
                            <div class="score-fill ${scoreClass}" style="width: ${company.compliance_score}%"></div>
                        </div>
                        <div class="score-value">${company.compliance_score}%</div>
                    </div>
                    <div style="font-size:0.75rem; color:#888; margin-bottom:12px;">
                        ${company.passed} passed / ${company.failed} failed of ${company.total_checks} checks
                    </div>
                    ${company.active_risks.length > 0 ? `
                        <div style="margin-top:12px;">
                            <div style="font-size:0.7rem; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:#888; margin-bottom:8px;">Active Risks</div>
                            ${company.active_risks.map(r => `
                                <div style="font-size:0.78rem; color:#666; padding:4px 0; border-bottom:1px solid #f5f5f5;">
                                    <span class="risk-badge ${r.severity}">${r.severity}</span>
                                    ${r.rule}: ${r.risk}
                                </div>
                            `).join('')}
                        </div>
                    ` : ''}
                `;
                grid.appendChild(card);
            }

            // Alerts
            const alertsEl = document.getElementById('alertsSection');
            if (report.alerts.length === 0) {
                alertsEl.innerHTML = '<div class="no-data">No active alerts. All systems compliant.</div>';
            } else {
                alertsEl.innerHTML = report.alerts.map(a => `
                    <div class="alert-item">
                        <div class="alert-severity ${a.severity}"></div>
                        <div class="alert-message">${a.message}</div>
                        <div class="alert-date">${new Date(a.date).toLocaleDateString()}</div>
                    </div>
                `).join('');
            }

            // Risk section
            const riskEl = document.getElementById('riskSection');
            const riskCompanies = Object.entries(report.companies).filter(([,c]) => c.active_risks.length > 0);
            if (riskCompanies.length === 0) {
                riskEl.innerHTML = '<div class="no-data">No financial risks identified.</div>';
            } else {
                riskEl.innerHTML = riskCompanies.map(([id, c]) => `
                    <div class="risk-item">
                        <div class="risk-company">${c.name}</div>
                        <div class="risk-amount">${c.active_risks.length} active risk(s)</div>
                    </div>
                `).join('');
            }
        }

        // Load on page ready
        loadDashboard();
    </script>
</body>
</html>
