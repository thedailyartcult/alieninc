<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALIEN.INC - DECLASSIFIED</title>
    
    <!-- Google Fonts import for VT323 terminal look -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

    <!-- MapLibre GL -->
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

    <style>
        /* Retro Terminal Styling Rules mapped to the declassified WH design */
        body {
            font-family: 'VT323', 'Courier New', Courier, monospace;
            -webkit-font-smoothing: none;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: geometricPrecision;
            background-color: #000000;
            color: #4ade80;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Starfield background */
        .aliens-star-canvas canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
        }

        /* Scanline Overlay for retro-CRT aesthetic */
        body::before {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 999;
            background-size: 100% 4px, 3px 100%;
            pointer-events: none;
        }

        /* Green glow — used on titles, counters, nav logo */
        .neon-cyan {
            color: #4ade80;
            text-shadow: 0 0 10px #22d3ee, 0 0 20px #22d3ee, 0 0 40px #22d3ee;
        }

        /* Scroll-reveal CSS */
        body:not(.wp-admin) .section {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 1s ease, transform 1s ease;
        }
        body:not(.wp-admin) .section.visible { 
            opacity: 1; 
            transform: translateY(0); 
        }

        /* Typewriter text formatting rules */
        .typewriter {
            overflow: hidden;
            white-space: normal;
            letter-spacing: normal;
        }
        .typewriter-start::after {
            content:'_';
            animation: aliens-blink 1s step-end infinite;
            color: #22d3ee;
        }
        .typewriter-done::after { 
            border-right: none; 
        }
        @keyframes aliens-blink {
            from, to { opacity: 0; }
            50%       { opacity: 1; }
        }

        /* rest-of-page reveals sequentially post typing completion */
        body:not(.wp-admin) #rest-of-page { 
            opacity: 0; 
            transition: opacity 1.2s ease; 
        }

        /* Top Announcement Banner */
        .top-banner {
            background-color: #ffffff;
            color: #000000;
            text-align: center;
            font-size: 0.85rem;
            letter-spacing: 0.25em;
            padding: 8px 10px;
            font-weight: bold;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(74, 222, 128, 0.3);
        }

        /* Glassmorphic Navbar Component */
        .aliens-nav {
            position: sticky;
            top: 0;
            width: 100%;
            z-index: 100;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(34, 211, 238, 0.3);
        }
        .aliens-nav-inner {
            max-width: 80rem;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            box-sizing: border-box;
        }
        .aliens-nav-logo { 
            font-size: 1.875rem; 
            font-weight: 700; 
            letter-spacing: 0.15em; 
        }
        .aliens-nav-tagline { 
            font-size: 0.75rem; 
            text-transform: uppercase; 
            letter-spacing: 4px; 
        }

        /* Hero Container */
        .aliens-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 6rem;
            padding-bottom: 8rem;
            position: relative;
            box-sizing: border-box;
        }
        .aliens-hero-inner { 
            max-width: 64rem; 
            padding: 0 1.5rem; 
            text-align: center; 
        }
        .aliens-hero-title {
            font-size: clamp(3rem, 8vw, 7rem);
            font-weight: 700;
            letter-spacing: 0.2em;
            margin-bottom: 4rem;
            text-transform: uppercase;
        }
        .aliens-typewriter-block {
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            font-size: clamp(1.35rem, 2.5vw, 2rem);
            line-height: 1.8;
            max-width: 56rem;
            margin: 0 auto;
            text-align: center;
        }
        .aliens-hero-kicker { 
            font-size: clamp(1.8rem, 3vw, 2.5rem); 
            font-weight: 700; 
            margin-top: 2rem; 
        }

        /* Moment log — static terminal readout, revealed after the rendezvous line */
        .aliens-moment-log {
            font-size: clamp(1rem, 1.6vw, 1.35rem);
            line-height: 1.9;
            border: 1px solid rgba(34, 211, 238, 0.4);
            padding: 1rem 1.5rem;
            color: #4ade80;
            opacity: 0;
            transition: opacity 0.8s ease;
        }
        .aliens-moment-log.visible {
            opacity: 1;
        }
        .aliens-moment-log-punchline {
            display: inline-block;
            margin-top: 0.75rem;
            color: #22d3ee;
        }

        /* Flourish interactive map section block */
        .aliens-map-section {
            padding: 6rem 0;
            background: rgba(0, 0, 0, 0.9);
            border-top: 1px solid rgba(34, 211, 238, 0.3);
            border-bottom: 1px solid rgba(34, 211, 238, 0.3);
        }
        .aliens-map-inner { 
            max-width: 72rem; 
            margin: 0 auto; 
            padding: 0 1.5rem; 
        }
        .aliens-map-label-wrap { 
            text-align: center; 
            margin-bottom: 2rem; 
        }
        .aliens-clearance-badge {
            display: inline-block;
            padding: 0.75rem 2rem;
            background: rgba(220, 38, 38, 0.2);
            color: #ef4444;
            font-size: 1rem;
            letter-spacing: 0.15em;
            border: 1px solid #ef4444;
            font-weight: bold;
        }
        .aliens-map-title { 
            font-family: 'VT323', 'Courier New', Courier, monospace; 
            font-size: clamp(2rem, 5vw, 3.75rem); 
            text-align: center; 
            margin-bottom: 3rem; 
        }
        .aliens-scroll-hint { 
            text-align: center; 
            margin-top: 2rem; 
            color: rgba(34, 211, 238, 0.7); 
            font-size: 1.125rem; 
            letter-spacing: 4px;
        }

        /* Split-Flap board mechanics */
        .aliens-metrics-section { 
            padding: 6rem 0; 
        }
        .aliens-metrics-grid {
            max-width: 72rem;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            justify-content: center;
            gap: 5rem;
            flex-wrap: wrap;
        }
        .aliens-metric { 
            text-align: center; 
        }
        .aliens-metric-label { 
            font-size: 1.5rem; 
            margin-top: 1.5rem; 
            letter-spacing: 0.15em; 
            color: #22d3ee;
        }

        .num-container {
            position: relative;
            display: flex;
            justify-content: center;
            gap: 20px;
        }
        .digit {
            position: relative;
            width: 140px;
            height: 200px;
            overflow: hidden;
            border-radius: 5px;
            filter: drop-shadow(0 0 10px #000a);
        }
        .mark {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            font-size: 90px;
            width: 30px;
            color: #1c1c1c;
        }

        .static-top,
        .static-bottom,
        .flip-top,
        .flip-bottom {
            position: absolute;
            width: 100%;
            height: 50%;
            overflow: hidden;
            left: 0;
            backface-visibility: hidden;
        }
        .static-top,
        .flip-top {
            top: 0;
            transform-origin: bottom;
            background: #0d132d;
            border-bottom: 1px solid #333;
        }
        .static-bottom,
        .flip-bottom {
            bottom: 0;
            transform-origin: top;
            background: #0d132d;
            border-top: 1px solid #000;
        }

        .static-top span,
        .flip-top span {
            position: absolute;
            width: 100%;
            height: 200%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 160px;
            color: #eee;
            top: 0;
        }
        .static-bottom span,
        .flip-bottom span {
            position: absolute;
            width: 100%;
            height: 200%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 160px;
            color: #eee;
            top: -100%;
        }

        .flip-top {
            animation-iteration-count: 1;
            animation: flipTop 0.5s linear forwards;
            z-index: 5;
        }
        .flip-bottom {
            animation-iteration-count: 1;
            animation: flipBottom 0.5s linear forwards;
            z-index: 4;
        }
        .flip-top.fast {
            animation: flipTop 0.08s linear forwards;
        }
        .flip-bottom.fast {
            animation: flipBottom 0.08s linear forwards;
        }

        @keyframes flipTop {
            0%   { transform: rotateX(0deg); }
            100% { transform: rotateX(-90deg); }
        }
        @keyframes flipBottom {
            0%   { transform: rotateX(90deg); }
            100% { transform: rotateX(0deg); }
        }

        /* Action/CTA button styled to match ICE Tip Button */
        .aliens-cta-button {
            margin-top: 3.5rem;
            margin-bottom: 3.5rem;
            text-align: center;
        }
        .aliens-cta-button .wp-block-button__link {
            display: inline-block;
            background-color: #dc2626 !important;
            color: #ffffff !important;
            font-family: inherit !important;
            font-size: clamp(1.3rem, 2.5vw, 1.85rem) !important;
            font-weight: 700 !important;
            letter-spacing: 0.15em !important;
            padding: 1.5rem 3rem !important;
            border-radius: 0 !important;
            text-decoration: none;
            transition: background-color 0.2s ease, transform 0.2s ease;
            box-shadow: 0 0 15px rgba(220, 38, 38, 0.6);
            cursor: pointer;
            border: none;
        }
        .aliens-cta-button .wp-block-button__link:hover {
            background-color: #b91c1c !important;
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(220, 38, 38, 0.9);
        }

        /* Addendum Panel Block */
        .aliens-addendum-box {
            max-width: 56rem;
            margin: 6rem auto 3rem auto;
            padding: 2.5rem;
            border: 1px solid rgba(239, 68, 68, 0.5);
            background: rgba(69, 10, 10, 0.25);
            border-radius: 1.5rem;
            text-align: center;
            box-sizing: border-box;
        }
        .aliens-addendum-label {
            color: #f87171;
            font-size: 1rem;
            letter-spacing: 8px;
            margin-bottom: 1.5rem;
            font-weight: bold;
        }
        .aliens-reveal-headline {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 700;
            line-height: 1.1;
            margin: 1rem 0;
            color: #4ade80;
        }
        .aliens-yellow-warning { 
            margin-top: 2rem; 
            font-size: clamp(1.25rem, 2.5vw, 1.6rem); 
            line-height: 1.5;
            color: #4ade80; 
        }

        /* Email Registration Form section styling */
        .email-form {
            max-width: 32rem;
            margin: 4rem auto;
            padding: 2rem;
            border: 1px solid rgba(74, 222, 128, 0.3);
            background: rgba(0, 0, 0, 0.8);
            border-radius: 8px;
            text-align: center;
            box-sizing: border-box;
        }
        .email-form h3 {
            font-size: 1.75rem;
            margin-bottom: 1.5rem;
            color: #4ade80;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .whitehouse-form__label {
            display: block;
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
            text-align: left;
            color: #4ade80;
        }
        .whitehouse-form__required {
            color: #ef4444;
        }
        .whitehouse-form__field {
            width: 100%;
            box-sizing: border-box;
            background-color: #000000;
            border: 1px solid #4ade80;
            color: #4ade80;
            padding: 0.75rem;
            font-family: inherit;
            font-size: 1.25rem;
            outline: none;
        }
        .whitehouse-form__field:focus {
            border-color: #22d3ee;
            box-shadow: 0 0 10px rgba(34, 211, 238, 0.5);
        }
        .whitehouse-form__button {
            width: 100%;
            background-color: transparent;
            border: 1px solid #4ade80;
            color: #4ade80;
            padding: 1rem;
            font-family: inherit;
            font-size: 1.4rem;
            cursor: pointer;
            transition: all 0.25s ease;
            margin-top: 1.5rem;
        }
        .whitehouse-form__button:hover {
            background-color: #4ade80;
            color: #000000;
            box-shadow: 0 0 15px rgba(74, 222, 128, 0.5);
        }

        /* Footer block */
        .aliens-footer {
            padding: 4rem 1.5rem;
            text-align: center;
            border-top: 1px solid rgba(74, 222, 128, 0.15);
            font-size: 1.1rem;
            letter-spacing: 0.15em;
            color: #4ade80;
        }

        /* ─────────────────────────────────────────────────────────────
    /* ─────────────────────────────────────────────────────────────
       Integrated fable Obscured Map Components
       ───────────────────────────────────────────────────────────── */

    
    /* GRID FLOW live-grid overlay: one static <path> per connection, animated with
       the stroke-dasharray/stroke-dashoffset trick. alieninc-original class. */
    .alieninc-gridflow-overlay {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 5;
        overflow: visible;
    }

    /* Unified HUD Panels */
    .retro-map-hud-panel {
        background: rgba(0, 0, 0, 0.9);
        border: 1px solid rgba(34, 211, 238, 0.35);
        border-radius: 4px;
        padding: 10px 14px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
        pointer-events: auto;
        box-sizing: border-box;
    }

    .retro-map-hud-left {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        width: 300px;
    }

    /* ── Beehive FOCUS SECTOR HUD ──────────────────────────────────
       Alieninc adaptation of panteon admin.html sc-hud-container
       design language: tessellated honeycomb tiles with alternating
       cut-corner clip-paths, blueprint grid backdrop, wireframe
       status pips, mono tags, and a bottom check line. Recolored to
       the alieninc cyber palette (cyan #22d3ee / emerald #4ade80 on
       pure black) and typeset in VT323 to match the existing map HUD. */

    .retro-map-hive {
        font-family: 'VT323', Courier, monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .retro-map-hive-kicker {
        font-size: 0.78rem;
        color: #4ade80;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0 0 6px 2px;
        text-shadow: 0 0 4px rgba(74, 222, 128, 0.4);
    }

    .retro-map-hive-grid {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
    }

    .retro-map-hive-row {
        display: flex;
        gap: 6px;
        justify-content: center;
        transition: transform 0.3s ease;
    }

    .retro-map-hive-tile {
        position: relative;
        width: 140px;
        height: 112px;
        background-color: rgba(34, 211, 238, 0.45);
        padding: 1.5px;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Alternating cut corners produce the honeycomb tessellation */
    .retro-map-hive-tile.cut-tr-bl { clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 22px 100%, 0 calc(100% - 22px)); }
    .retro-map-hive-tile.cut-tr-bl .retro-map-hive-inner { clip-path: polygon(0 0, calc(100% - 21px) 0, 100% 21px, 100% 100%, 21px 100%, 0 calc(100% - 21px)); }
    .retro-map-hive-tile.cut-tl-br { clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px); }
    .retro-map-hive-tile.cut-tl-br .retro-map-hive-inner { clip-path: polygon(21px 0, 100% 0, 100% calc(100% - 21px), calc(100% - 21px) 100%, 0 100%, 0 21px); }

    .retro-map-hive-tile.tile-cyan { background-color: rgba(34, 211, 238, 0.55); }
    .retro-map-hive-tile.tile-emerald { background-color: rgba(74, 222, 128, 0.55); }

    .retro-map-hive-inner {
        background-color: #000;
        width: 100%;
        height: 100%;
        padding: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        position: relative;
        transition: background-color 0.2s ease;
    }

    .retro-map-hive-wires {
        display: flex;
        gap: 3px;
        position: absolute;
        top: 8px;
        left: 12px;
    }

    .retro-map-wire-box {
        width: 8px;
        height: 8px;
        border: 1px solid rgba(74, 222, 128, 0.55);
        border-radius: 1px;
        transition: all 0.2s ease;
    }

    .retro-map-wire-box.active {
        background-color: #4ade80;
        border-color: #4ade80;
        box-shadow: 0 0 4px rgba(74, 222, 128, 0.8);
    }

    .retro-map-hive-tag {
        font-size: 0.78rem;
        color: rgba(74, 222, 128, 0.75);
        position: absolute;
        top: 6px;
        right: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .retro-map-hive-value {
        font-size: 1.2rem;
        color: #ffffff;
        line-height: 1.05;
        margin-top: 6px;
        text-align: center;
        letter-spacing: 1px;
        text-shadow: 0 0 6px rgba(34, 211, 238, 0.5);
        text-transform: uppercase;
        word-break: break-word;
        max-width: 100%;
    }

    .retro-map-hive-tile.tile-cyan .retro-map-hive-value {
        color: #22d3ee;
        text-shadow: 0 0 6px rgba(34, 211, 238, 0.55);
    }
    .retro-map-hive-tile.tile-emerald .retro-map-hive-value {
        color: #4ade80;
        text-shadow: 0 0 6px rgba(74, 222, 128, 0.55);
    }

    .retro-map-hive-label {
        font-size: 0.72rem;
        color: rgba(34, 211, 238, 0.7);
        text-transform: uppercase;
        letter-spacing: 1px;
        text-align: center;
    }

    .retro-map-hive-tile.tile-emerald .retro-map-hive-label { color: rgba(74, 222, 128, 0.75); }

    .retro-map-hive-check {
        position: absolute;
        bottom: 4px;
        left: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        color: rgba(74, 222, 128, 0.85);
        text-transform: uppercase;
        letter-spacing: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .retro-map-hive-check b {
        color: #4ade80;
        font-weight: normal;
        text-shadow: 0 0 4px rgba(74, 222, 128, 0.8);
    }

    /* MAP VIEW — merged into ONE honeycomb tile; DEFAULT / GRID FLOW toggle,
       exactly one active at a time (toggleDataLayer enforces radio behavior) */
    .retro-map-hive-view-toggle {
        display: flex;
        width: 100%;
        flex: 1;
        gap: 5px;
        margin-top: 18px;
        align-items: stretch;
    }
    .retro-map-hive-view-toggle .retro-map-view-btn {
        flex: 1;
        font-family: 'VT323', Courier, monospace;
        font-size: 0.8rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(34, 211, 238, 0.7);
        background: rgba(0, 0, 0, 0.55);
        border: 1px solid rgba(34, 211, 238, 0.35);
        border-radius: 2px;
        cursor: pointer;
        padding: 6px 2px;
        transition: all 0.2s ease;
    }
    .retro-map-hive-view-toggle .retro-map-view-btn:hover {
        background: rgba(34, 211, 238, 0.12);
    }
    .retro-map-hive-view-toggle .retro-map-view-btn.active#layer-btn-default {
        background: rgba(34, 211, 238, 0.22);
        border-color: #22d3ee;
        color: #22d3ee;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.5), inset 0 0 8px rgba(34, 211, 238, 0.15);
        text-shadow: 0 0 6px rgba(34, 211, 238, 0.8);
    }
    .retro-map-hive-view-toggle .retro-map-view-btn.active#layer-btn-flow {
        background: rgba(74, 222, 128, 0.22);
        border-color: #4ade80;
        color: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.5), inset 0 0 8px rgba(74, 222, 128, 0.15);
        text-shadow: 0 0 6px rgba(74, 222, 128, 0.8);
    }

    @media screen and (max-width: 900px) {
        .retro-map-hud-left { width: calc(100% - 30px); }
        .retro-map-hive-row { flex-wrap: wrap; }
        .retro-map-deck { top: 380px; }
    }

    .retro-map-hud-kicker {
        font-size: 0.85rem;
        color: #4ade80;
        letter-spacing: 2px;
        margin: 0;
        text-transform: uppercase;
    }

    .retro-map-hud-heading {
        font-size: 1.4rem;
        color: #ffffff;
        margin: 4px 0 2px 0;
        letter-spacing: 1px;
        text-shadow: 0 0 5px rgba(255,255,255,0.3);
        text-transform: uppercase;
    }

    .retro-map-hud-stat {
        display: flex;
        align-items: baseline;
        gap: 6px;
    }

    .retro-map-hud-num {
        font-size: 1.25rem;
        color: #22d3ee;
        font-weight: bold;
    }

    .retro-map-hud-sub {
        font-size: 0.85rem;
        color: rgba(34, 211, 238, 0.7);
        text-transform: uppercase;
    }

    .retro-map-hud-meta {
        font-size: 0.8rem;
        color: rgba(74, 222, 128, 0.6);
        margin: 4px 0 0 0;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Center Search Bar */
    .retro-map-hud-center {
        position: absolute;
        top: 15px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        width: 400px;
    }
    @media screen and (max-width: 900px) {
        .retro-map-hud-center { display: none; }
    }

    .retro-map-search {
        display: block;
        border-radius: 4px;
        padding: 8px;
    }

    .retro-map-search-input {
        width: 100%;
        box-sizing: border-box;
        background: #000;
        border: 1px solid rgba(34, 211, 238, 0.4);
        border-radius: 4px;
        color: #e5e5e5;
        font-family: 'VT323', Courier, monospace;
        font-size: 0.95rem;
        padding: 8px 10px;
        outline: none;
    }
    .retro-map-search-input::placeholder {
        color: rgba(34, 211, 238, 0.45);
    }

    .retro-map-search-results {
        position: absolute;
        top: calc(100% + 4px);
        left: 8px;
        right: 8px;
        display: none;
        max-height: 330px;
        overflow-y: auto;
        background: rgba(0, 0, 0, 0.95);
        border: 1px solid rgba(34, 211, 238, 0.35);
        border-radius: 4px;
    }
    .retro-map-search-results.retro-map-search-open {
        display: block;
    }

    .retro-map-search-item {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid rgba(34, 211, 238, 0.12);
        color: #d1d5db;
        font-family: 'VT323', Courier, monospace;
        padding: 8px 10px;
        cursor: pointer;
    }
    .retro-map-search-item:last-child {
        border-bottom: none;
    }
    .retro-map-search-item:hover {
        background: rgba(34, 211, 238, 0.12);
    }
    .retro-map-search-item-title {
        color: #ffffff;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .retro-map-search-item-sub {
        color: rgba(34, 211, 238, 0.7);
        font-size: 0.8rem;
    }
    .retro-map-search-item-stack {
        color: #4ade80;
        font-size: 0.78rem;
    }
    .retro-map-search-empty {
        padding: 10px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
    }
    .retro-map-search-item-locked .retro-map-search-item-stack {
        color: #f59e0b;
        font-style: italic;
    }

    /* ── Auth-gate lock panel (retro-terminal aesthetic) ── */
    .retro-lock-panel {
        border: 1px solid rgba(245, 158, 11, 0.35);
        background: rgba(245, 158, 11, 0.06);
        padding: 10px 12px;
        margin-top: 6px;
        font-family: 'VT323', Courier, monospace;
    }
    .retro-lock-panel__header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }
    .retro-lock-panel__icon {
        width: 14px;
        height: 14px;
        border: 1.5px solid #f59e0b;
        border-radius: 2px;
        position: relative;
        flex-shrink: 0;
    }
    .retro-lock-panel__icon::before {
        content: '';
        position: absolute;
        top: -7px;
        left: 50%;
        transform: translateX(-50%);
        width: 8px;
        height: 7px;
        border: 1.5px solid #f59e0b;
        border-bottom: none;
        border-radius: 8px 8px 0 0;
    }
    .retro-lock-panel__icon::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 5px;
        background: #f59e0b;
    }
    .retro-lock-panel__title {
        color: #f59e0b;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: bold;
    }
    .retro-lock-panel__msg {
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.75rem;
        line-height: 1.3;
        margin-bottom: 8px;
    }
    .retro-lock-panel__btn {
        display: inline-block;
        padding: 4px 14px;
        border: 1px solid #f59e0b;
        background: transparent;
        color: #f59e0b;
        font-family: 'VT323', Courier, monospace;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .retro-lock-panel__btn:hover {
        background: #f59e0b;
        color: #000000;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
    }
    .retro-lock-panel__blurred {
        filter: blur(3px);
        opacity: 0.3;
        user-select: none;
        pointer-events: none;
    }
    .retro-lock-panel__scanline {
        position: relative;
        overflow: hidden;
    }
    .retro-lock-panel__scanline::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: rgba(245, 158, 11, 0.4);
        animation: retro-lock-scan 3s linear infinite;
    }
    @keyframes retro-lock-scan {
        0% { top: 0; }
        100% { top: 100%; }
    }

    .retro-map-hud-right { display: none; }

    /* Left-side Drawer: Map Active Spectras */
    .retro-map-deck {
        position: absolute;
        top: 215px;
        left: 15px;
        z-index: 10;
        width: 180px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .retro-map-deck-title {
        font-size: 0.85rem;
        color: #4ade80;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: bold;
        margin-bottom: 4px;
        border-bottom: 1px solid rgba(74, 222, 128, 0.2);
        padding-bottom: 4px;
    }

    .retro-map-deck-btn {
        background: rgba(0, 0, 0, 0.85);
        border: 1px solid rgba(34, 211, 238, 0.3);
        color: #22d3ee;
        padding: 6px 10px;
        border-radius: 3px;
        font-size: 0.9rem;
        text-align: left;
        cursor: pointer;
        text-transform: uppercase;
        transition: all 0.2s ease;
        font-family: 'VT323', Courier, monospace;
    }

    .retro-map-deck-btn:hover {
        background: rgba(34, 211, 238, 0.15);
        border-color: #22d3ee;
    }

    .retro-map-deck-btn.active {
        background: rgba(74, 222, 128, 0.2);
        border-color: #4ade80;
        color: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.4);
    }

    /* Legend component styled like fable's spectral gauge */
    .retro-map-legend {
        margin-top: 6px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .retro-map-legend-bar {
        height: 8px;
        width: 100%;
        border-radius: 2px;
        background: linear-gradient(to right, #4ade80, #f59e0b, #ef4444); /* emerald -> amber -> rose */
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .retro-map-legend-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(74, 222, 128, 0.6);
        letter-spacing: 1px;
    }

    /* Map interactive help controls banner */

    /* Terminal — store.palantir.com pattern */
    .retro-map-terminal {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 380px;
        height: 200px;
        z-index: 20;
        letter-spacing: 0;
        overflow: hidden;
        flex-shrink: 0;
    }
    .retro-map-terminal .xterm {
        height: 200px;
        max-height: 200px;
    }
    .retro-map-terminal .xterm .xterm-screen {
        height: 100% !important;
        max-height: 100% !important;
    }
    .retro-map-terminal canvas {
        display: block;
    }
    .retro-map-terminal:after {
        content: "";
        position: absolute;
        top: 0;
        height: 100%;
        width: 100%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
        pointer-events: none;
    }
    .retro-map-terminal .xterm {
        padding: 0;
    }
    .retro-map-terminal .xterm .xterm-viewport {
        overflow: hidden;
    }
    .retro-map-terminal .xterm .xterm-selection > div {
        background-color: transparent !important;
    }
    .retro-map-terminal.mono {
        font-family: 'VT323', monospace;
        font-size: 1.4rem;
    }
    @keyframes blink_outline_1 {
        0% { opacity: 0; }
        50% { opacity: 1; }
    }
    .xterm-dom-renderer-owner-1 .xterm-cursor.xterm-cursor-outline {
        animation: blink_outline_1 1s step-end infinite;
    }

    .retro-map-hint-banner {
        position: absolute;
        bottom: 75px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        width: 90%;
        max-width: 440px;
        text-align: center;
        pointer-events: none;
    }
    @media screen and (max-width: 768px) {
.retro-map-hint-banner { bottom: 65px; }
    }

    .retro-map-hint-text {
        background: rgba(0,0,0,0.9);
        border: 1px solid rgba(34, 211, 238, 0.3);
        border-radius: 4px;
        padding: 4px 12px;
        color: #4ade80;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        box-shadow: 0 4px 10px rgba(0,0,0,0.6);
    }

    /* Preset controls command dock */
    .retro-map-toolbar {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 25;
        background: rgba(0, 0, 0, 0.95);
        border: 1px solid rgba(34, 211, 238, 0.2);
        border-radius: 6px;
        padding: 6px;
        display: flex;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.7);
        pointer-events: auto;
        max-width: 95%;
        overflow-x: auto;
        scrollbar-width: none;
    }
    .retro-map-toolbar::-webkit-scrollbar { display: none; }

    .retro-map-btn {
        background: transparent;
        border: 1px solid rgba(34, 211, 238, 0.3);
        color: #22d3ee;
        padding: 4px 10px;
        border-radius: 3px;
        font-size: 0.95rem;
        letter-spacing: 1px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        text-transform: uppercase;
        transition: all 0.2s ease;
        white-space: nowrap;
        font-family: 'VT323', Courier, monospace;
    }

    .retro-map-btn:hover {
        background: rgba(34, 211, 238, 0.15);
        border-color: #22d3ee;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.3);
    }

    .retro-map-btn-reset {
        color: #4ade80;
        border-color: rgba(74, 222, 128, 0.3);
    }

    .retro-map-btn-reset:hover {
        background: rgba(74, 222, 128, 0.15);
        border-color: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.3);
    }

    .retro-map-btn-filter.active {
        background: rgba(34, 211, 238, 0.2);
        border-color: #22d3ee;
        color: #ffffff;
        box-shadow: 0 0 10px rgba(34, 211, 238, 0.35);
    }

    .retro-map-btn svg {
        width: 12px;
        height: 12px;
        stroke: currentColor;
    }

    /* Radar circular Mask minimap */
    .retro-map-radar-frame {
        position: absolute;
        bottom: 80px;
        right: 15px;
        z-index: 10;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 2px solid rgba(34, 211, 238, 0.4);
        background: #000;
        overflow: hidden;
        box-shadow: 0 0 15px rgba(34, 211, 238, 0.3);
        pointer-events: auto;
    }

    .retro-map-radar-viewport {
        width: 100%;
        height: 100%;
        border-radius: 50%;
    }

    /* Radial Scanning sweep and sweeping target grids */
    .retro-map-radar-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 50%;
        pointer-events: none;
        background: radial-gradient(circle, rgba(34, 211, 238, 0.05) 0%, transparent 70%);
        border: 1px dashed rgba(34, 211, 238, 0.2);
        box-sizing: border-box;
    }

    .retro-map-radar-sweep {
        position: absolute;
        top: 50%; left: 50%;
        width: 100%;
        height: 100%;
        background: conic-gradient(from 0deg at 0% 0%, rgba(34, 211, 238, 0.25) 0deg, rgba(34, 211, 238, 0) 90deg, transparent 360deg);
        transform-origin: 0% 0%;
        animation: radar-sweep-spin 4s linear infinite;
    }

    @keyframes radar-sweep-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .retro-map-radar-scope {
        position: absolute;
        top: 50%; left: 50%;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ef4444;
        border: 1px solid #fff;
        transform: translate(-50%, -50%);
        box-shadow: 0 0 8px #ef4444;
    }

    /* Dynamic Node Decrypter inspector panel */
    .retro-map-inspector {
        position: absolute;
        bottom: 80px;
        right: 170px;
        z-index: 20;
        width: 290px;
        max-height: 55%;
        background: rgba(0, 0, 0, 0.95);
        border: 1px solid rgba(34, 211, 238, 0.3);
        border-radius: 4px;
        padding: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        pointer-events: auto;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        opacity: 1;
        transform: translateY(0);
    }
    @media screen and (max-width: 768px) {
        .retro-map-inspector {
            width: calc(100% - 24px);
            left: 12px;
            bottom: 160px;
            max-height: 35%;
        }
    }

    .retro-map-inspector.closed {
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
    }

    .retro-map-inspector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(34, 211, 238, 0.2);
        padding-bottom: 6px;
        margin-bottom: 8px;
    }

    .retro-map-inspector-title {
        font-size: 1.15rem;
        color: #22d3ee;
        letter-spacing: 2px;
        margin: 0;
        text-transform: uppercase;
    }

    .retro-map-inspector-close {
        background: none;
        border: none;
        color: #22d3ee;
        font-size: 1.5rem;
        cursor: pointer;
        line-height: 1;
        padding: 0;
    }
    .retro-map-inspector-close:hover {
        color: #4ade80;
    }

    .retro-map-inspector-content {
        font-size: 0.95rem;
        color: #4ade80;
        line-height: 1.4;
        overflow-y: auto;
        flex-grow: 1;
    }

    .retro-map-inspector-content dl {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .retro-map-inspector-row {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed rgba(74, 222, 128, 0.15);
        padding-bottom: 2px;
    }

    .retro-map-inspector-dt {
        color: rgba(74, 222, 128, 0.6);
        text-transform: uppercase;
    }

    .retro-map-inspector-dd {
        color: #ffffff;
        margin: 0;
        font-weight: bold;
    }

    .retro-map-inspector-intel {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid rgba(74, 222, 128, 0.15);
        color: #4ade80;
        font-size: 0.9rem;
    }

    .retro-map-inspector-stack-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 0.78rem;
        line-height: 1.35;
    }
    .retro-map-inspector-stack-row span {
        color: #22d3ee;
        white-space: nowrap;
    }
    .retro-map-inspector-stack-row em {
        color: rgba(255, 255, 255, 0.75);
        font-style: normal;
        text-align: right;
    }

    /* Spatial HTML Custom 3D Marker Nodes */
    .retro-map-node-marker {
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.2s ease;
    }

    .retro-map-marker-tag {
        font-family: 'VT323', Courier, monospace;
        text-transform: uppercase;
        font-size: 0.95rem;
        color: #ffd400;
        border: 1px solid rgba(255, 212, 0, 0.4);
        background: rgba(0, 0, 0, 0.9);
        padding: 1px 8px;
        border-radius: 3px;
        box-shadow: 0 0 10px rgba(255, 212, 0, 0.2);
        white-space: nowrap;
        transition: all 0.2s ease;
    }
    .retro-map-node-marker:hover .retro-map-marker-tag {
        color: #4ade80;
        border-color: #4ade80;
        box-shadow: 0 0 12px rgba(74, 222, 128, 0.3);
        transform: scale(1.05);
    }

    .retro-map-marker-line {
        width: 1px;
        height: 15px;
        background: rgba(255, 212, 0, 0.5);
    }
    .retro-map-node-marker:hover .retro-map-marker-line {
        background: rgba(74, 222, 128, 0.7);
    }

    .retro-map-marker-glow {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ffd400;
        border: 2px solid #000000;
        box-shadow: 0 0 10px #ffd400, 0 0 20px rgba(255, 212, 0, 0.6);
        animation: retro-pulsing-marker 2s infinite ease-in-out;
    }
    .retro-map-node-marker:hover .retro-map-marker-glow {
        background: #4ade80;
        box-shadow: 0 0 10px #4ade80, 0 0 20px rgba(74, 222, 128, 0.6);
    }

    /* Search selection pin — always green so the searched company stands out */
    .retro-map-search-marker .retro-map-marker-tag {
        color: #4ade80;
        border-color: #4ade80;
        box-shadow: 0 0 12px rgba(74, 222, 128, 0.4);
    }
    .retro-map-search-marker .retro-map-marker-line {
        background: rgba(74, 222, 128, 0.8);
    }
    .retro-map-search-marker .retro-map-marker-glow {
        background: #4ade80;
        box-shadow: 0 0 10px #4ade80, 0 0 24px rgba(74, 222, 128, 0.7);
    }

    @keyframes retro-pulsing-marker {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.2); opacity: 0.8; }
    }

    /* Obscured District Spatial labels */
    .retro-map-district-tag {
        font-family: 'VT323', Courier, monospace;
        font-size: 0.72rem;
        color: rgba(148, 163, 184, 0.55);
        background: rgba(0, 0, 0, 0.5);
        padding: 0 4px;
        border-radius: 2px;
        letter-spacing: 1px;
        pointer-events: none;
        text-transform: uppercase;
        white-space: nowrap;
        transition: opacity 0.3s ease;
    }
/* Homepage full-size network map zone */
    .network-map-zone {
      background: #000;
    }
    .network-map-zone .retro-map-wrapper {
      position: relative;
      overflow: hidden;
      height: calc(100vh - var(--header-height));
      min-height: 620px;
      max-height: 1200px;
      border: none;
      border-radius: 0;
      box-shadow: none;
      border-top: 1px solid rgba(34, 211, 238, 0.3);
      border-bottom: 1px solid rgba(34, 211, 238, 0.3);
    }
    @media screen and (max-width: 768px) {
      .network-map-zone .retro-map-wrapper {
        height: 68vh;
        min-height: 480px;
      }
    }
    /* why page: contained map height inside the declassified layout column */
    #network-map.network-map-zone .retro-map-wrapper {
      height: 700px;
      min-height: 620px;
      max-height: 900px;
    }
    @media screen and (max-width: 768px) {
      #network-map.network-map-zone .retro-map-wrapper {
        height: 62vh;
        min-height: 480px;
      }
    }

    </style>
</head>
<body class="wp-singular page-template page-template-wp-custom-template-full-width">

    <!-- Active Twinkling Canvas Star Backdrop -->
    <div id="star-container" class="aliens-star-canvas"><canvas></canvas></div>

    <!-- Top Announcement Banner -->
    <div class="top-banner">
        CLASSIFIED // STATUS: DECLASSIFIED — ALIEN.INC INTERNAL RECORDS
    </div>

    <!-- Navigation Header -->
    <nav class="aliens-nav">
        <div class="aliens-nav-inner">
            <div class="aliens-nav-logo neon-cyan">ALIEN.INC</div>
            <div class="aliens-nav-tagline">DECLASSIFIED</div>
        </div>
    </nav>

    <!-- Hero Introduction Block (Typewriter sequential animation) -->
    <section id="hero" class="aliens-hero">
        <div class="aliens-hero-inner">
            <h1 class="aliens-hero-title neon-cyan">ONE SMALL STEP<br>ONE NEW COORDINATE</h1>
            <div id="text-blocks" class="aliens-typewriter-block">
                <!-- Data paragraph blocks containing user custom text -->
                <p id="p1" class="typewriter" data-text="For over a decade, ALIEN.INC has operated quietly under a single registered name."></p>
                <p id="p2" class="typewriter" data-text="Seven subsidiaries, one origin point, one domain — held since Dec 2016."></p>
                <p id="p3" class="typewriter" data-text="Then came the conflict. A separate registry, unrelated to us, claimed ground adjacent to our name."></p>
                <p id="p4" class="typewriter" data-text="Rather than share airspace with confusion, we made contact with a new coordinate: alieninc.tech."></p>
                <p id="p5" class="typewriter" data-text="The transition wasn't a retreat. It was a correction of orbit."></p>
                <p id="p6" class="typewriter" data-text="On July 21, 1969, at 02:56:15 UTC, Neil Armstrong set his foot on the Moon — the first human footprint off-world."></p>
                <p id="p7" class="typewriter" data-text="We set ours at the same hour, fifty-seven years later."></p>
                <p id="p8" class="typewriter" data-text="Not a coincidence. A rendezvous."></p>
                <div class="aliens-moment-log">
                    MOMENT LOG<br>
                    1969-07-21&nbsp;&nbsp;&nbsp;02:56:15 UTC&nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp;first human step, off-world<br>
                    2026-07-21&nbsp;&nbsp;&nbsp;02:56:15 UTC&nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp;alieninc.tech, live<br>
                    <span class="aliens-moment-log-punchline">57 years apart. same second.</span>
                </div>
                <p id="p9" class="typewriter aliens-hero-kicker neon-cyan" data-text="We call it: the exit, and the landing."></p>
            </div>
        </div>
    </section>

    <!-- Rest of Document reveal container post text-typing completion -->
    <div id="rest-of-page">
        
        <p class="aliens-scroll-hint">↓ SCROLL FOR TRANSMISSION DETAILS ↓</p>

        <!-- Mechanical Split-Flap Active Transmissions Metrics Panel -->
        <section class="aliens-metrics-section section">
            <h2 class="aliens-map-title neon-cyan" style="letter-spacing:12px">ACTIVE TRANSMISSIONS</h2>
            <div class="aliens-metrics-grid">
                <div class="aliens-metric">
                    <!-- Configured to automatically flip to 07 -->
                    <div class="num-container" data-count="7"></div>
                    <div class="aliens-metric-label">SUBSIDIARIES</div>
                </div>
                <div class="aliens-metric">
                    <!-- Configured to automatically flip to 01 -->
                    <div class="num-container" data-count="1"></div>
                    <div class="aliens-metric-label">ORIGIN</div>
                </div>
            </div>
        </section>

        <!-- Interactive Map Coordinates Visualization Section -->
        <section id="network-map" class="aliens-map-section network-map-zone">
            <div class="aliens-map-inner">
                <div class="aliens-map-label-wrap">
                    <span class="aliens-clearance-badge">TOP SECRET RECORDS</span>
                </div>
                <h2 class="aliens-map-title neon-cyan" style="letter-spacing: 8px; margin-bottom: 1rem;">COORDINATES</h2>
                <h3 class="aliens-map-title neon-cyan" style="font-size: 1.85rem; letter-spacing: 4px; margin-bottom: 3rem;">ALIEN.INC NETWORK MAP • LIVE</h3>
                    <!-- ALIEN.INC Network Map with fable HUD Overlays (ported from index.html) -->
                    <div class="retro-map-wrapper">

                        <!-- HUD: FOCUS SECTOR (honeycomb deck — floating tessellated tiles, no wrapper box;
                             VIEW DEFAULT / GRID FLOW merged into ONE toggle tile, exactly one active at a time) -->
                        <div class="retro-map-hud-left retro-map-hive">
                            <div class="retro-map-hive-kicker">FOCUS SECTOR</div>
                            <div class="retro-map-hive-grid">
                                <div class="retro-map-hive-row">
                                    <div class="retro-map-hive-tile cut-tr-bl tile-cyan">
                                        <div class="retro-map-hive-inner">
                                            <div class="retro-map-hive-wires">
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box"></span>
                                            </div>
                                            <span class="retro-map-hive-tag">FOCUS-01</span>
                                            <div id="retro-focus-title" class="retro-map-hive-value">NETWORK STANDBY</div>
                                            <div class="retro-map-hive-label">SECTOR LOCK</div>
                                            <div class="retro-map-hive-check"><b>&#10003;</b> <span id="retro-focus-stat2">AWAITING DATA STREAM</span></div>
                                        </div>
                                    </div>
                                    <div class="retro-map-hive-tile cut-tl-br tile-emerald">
                                        <div class="retro-map-hive-inner">
                                            <div class="retro-map-hive-wires">
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box active"></span>
                                            </div>
                                            <span class="retro-map-hive-tag">FOCUS-02</span>
                                            <div id="retro-focus-stat1-val" class="retro-map-hive-value">&mdash; SECTORS</div>
                                            <div class="retro-map-hive-label"><span id="retro-focus-stat1-lbl">STANDBY</span></div>
                                            <div class="retro-map-hive-check"><b>&#10003;</b> GRID SYNC</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Row 2: MAP VIEW — ONE honeycomb tile, DEFAULT / GRID FLOW toggle inside -->
                                <div class="retro-map-hive-row">
                                    <div class="retro-map-hive-tile cut-tr-bl tile-cyan retro-map-hive-view">
                                        <div class="retro-map-hive-inner">
                                            <div class="retro-map-hive-wires">
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box active"></span>
                                                <span class="retro-map-wire-box"></span>
                                            </div>
                                            <span class="retro-map-hive-tag">VIEW</span>
                                            <div class="retro-map-hive-view-toggle">
                                                <button onclick="toggleDataLayer('default')" id="layer-btn-default" class="retro-map-view-btn active" type="button">DEFAULT</button>
                                                <button onclick="toggleDataLayer('flow')" id="layer-btn-flow" class="retro-map-view-btn" type="button">GRID FLOW</button>
                                            </div>
                                        </div>
