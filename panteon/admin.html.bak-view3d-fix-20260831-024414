        }
        var pinsBtn = $('mavenPinsBtn');
        if (pinsBtn) pinsBtn.onclick = function () {
            S.placesOnMap = !S.placesOnMap;
            pinsBtn.textContent = 'MAP PINS: ' + (S.placesOnMap ? 'ON' : 'OFF');
            drawPlaces();
        };
        var clearCovBtn = $('mavenClearCoverageBtn');
        if (clearCovBtn) clearCovBtn.onclick = function () {
            var m = getMap();
            if (m && m.getSource('maven-coverage')) {
                m.getSource('maven-coverage').setData({ type: 'FeatureCollection', features: [] });
            }
