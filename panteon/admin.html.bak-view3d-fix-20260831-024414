}

function fusionToggleFollow() {
    setFusionFollow(!fusionFollow);
    if (fusionFollow) fusionFlyToSelected(true);
}

function fusionFlyToSelected(zoomIn) {
    if (!fusionMap || !fusionSelectedIcao) return;
    const entry = fusionAircraftIndex[fusionSelectedIcao];
    if (entry && entry.lngLat) {
        try {
            fusionMap.flyTo({ center: entry.lngLat, zoom: Math.max(fusionMap.getZoom(), zoomIn ? 7.5 : fusionMap.getZoom()), duration: 900 });
        } catch (e) {}
    }
}

// ============================================================================
// LIVE loop — 30s auto-refresh + opportunistic pipeline auto-run.
// The badge proves freshness ("LIVE · updated 12s · next 18s") instead of
// claiming liveness. Pauses when the tab is hidden.
// ============================================================================

const FUSION_LIVE_INTERVAL_MS = 30000;
let fusionLiveTimer = null;
let fusionCountdownTimer = null;
let fusionMotionTimer = null;
let fusionNextRefreshAt = 0;
let fusionLastRefreshAt = 0;
let fusionFeedMeta = null;
let fusionAutoRunAt = 0;


async function fusionRefreshFlights() {
    if (!scScopeComplete()) return;
    fusionNextRefreshAt = Date.now() + FUSION_LIVE_INTERVAL_MS;
    let flData = null;
    try {
        flData = await api('/opensky/flights?limit=2000');
    } catch (e) { /* keep previous frame on transient errors */ }
    if (flData && Array.isArray(flData.flights)) {
        let flights = flData.flights;
        fusionFeedMeta = flData.meta || fusionFeedMeta;
        const bbox = scBbox();
        if (bbox) {
            flights = flights.filter(f => {
                const p = normalizeAircraftPoint(f);
                if (!p) return false;
                return p.lat >= bbox.lamin && p.lat <= bbox.lamax &&
                       p.lng >= bbox.lomin && p.lng <= bbox.lomax;
            });
        }
        fusionFlights = flights;
        window.fusionFlights = fusionFlights;
        updateFusionKpis();
        renderFusionAviationLayer();
        // Keep lock-on through authoritative refreshes too.
        if (fusionFollow && fusionSelectedIcao) {
            const se = fusionAircraftIndex[fusionSelectedIcao];
            if (se && se.lngLat) {
                try { fusionMap.easeTo({ center: se.lngLat, duration: 800 }); } catch (e) {}
            }
        }
        const hud = document.getElementById('fusionMapHud');
        if (hud) hud.textContent = fusionThreatMarkers.length + ' threats · ' + fusionAviationMarkers.length + ' aircraft plotted';
    }
    // Opportunistic auto-run: when the fast lane is due and idle, fire the
    // backend pull so positions keep advancing without any manual button.
    const meta = fusionFeedMeta;
    const nowMs = Date.now();
    if (meta && meta.can_pull_adsb_now && !_fusionRunPending() && nowMs - fusionAutoRunAt > FUSION_LIVE_INTERVAL_MS * 0.9) {
        fusionAutoRunAt = nowMs;
        api('/opensky/pipeline/run', { method: 'POST', body: JSON.stringify({ fetch_military: true }) }).catch(() => {});
    }
}

function _fusionRunPending() {
    // Cheap guard: the backend also rejects double runs; this just avoids spam.
    return Date.now() - fusionAutoRunAt < 8000;
}

function startFusionLiveLoop() {
    stopFusionLiveLoop();
    fusionRefreshFlights();
    fusionLiveTimer = setInterval(() => {
        if (document.hidden) return;
        fusionRefreshFlights();
    }, FUSION_LIVE_INTERVAL_MS);
    fusionCountdownTimer = setInterval(() => {
        if (!document.hidden) { }
    }, 1000);
    _fusionLastMotionMs = Date.now();
    fusionMotionTimer = setInterval(fusionMotionTick, 150);
}

function stopFusionLiveLoop() {
    if (fusionLiveTimer) { clearInterval(fusionLiveTimer); fusionLiveTimer = null; }
    if (fusionCountdownTimer) { clearInterval(fusionCountdownTimer); fusionCountdownTimer = null; }
    if (fusionMotionTimer) { clearInterval(fusionMotionTimer); fusionMotionTimer = null; }
}

function fitFusionBounds() {
    if (!fusionMap) return;
    // Prefer the scope bbox — the map frames YOUR region, not data clusters.
    const sb = scBbox();
    if (sb) {
        fusionMap.fitBounds([[sb.lomin, sb.lamin], [sb.lomax, sb.lamax]], { padding: 60, maxZoom: 7, duration: 1200 });
        return;
    }
    const pts = [];
    if (fusionLayers.threats) fusionThreatEvents.forEach(ev => { const g = parseActionGeo(ev); if (g) pts.push(g); });
    if (fusionLayers.aviation) fusionFlights.forEach(f => { const p = normalizeAircraftPoint(f); if (p) pts.push({ latitude: p.lat, longitude: p.lng }); });
    if (!pts.length) { fusionMap.flyTo({ center: [20, 20], zoom: 1.5, duration: 1000 }); return; }
    const b = pts.reduce((bb, p) => ({
        minX: Math.min(bb.minX, p.longitude), maxX: Math.max(bb.maxX, p.longitude),
        minY: Math.min(bb.minY, p.latitude), maxY: Math.max(bb.maxY, p.latitude),
    }), { minX: 180, maxX: -180, minY: 90, maxY: -90 });
    fusionMap.fitBounds([[b.minX, b.minY], [b.maxX, b.maxY]], { padding: 60, maxZoom: 7, duration: 1200 });
}

async function refreshFusionBqStatus() {
    const dot = document.getElementById('fusionBqDot');
    if (!dot) return;
    try {
        const s = await api('/gkg/bigquery/status');
        if (s.available) {
            dot.textContent = 'BQ: ON';
            dot.style.background = 'var(--green)';
            dot.style.color = '#000';
            dot.title = 'GDELT BigQuery is active — production backend (no per-IP throttle)';
        } else {
            dot.textContent = 'BQ: OFF';
            dot.style.background = 'var(--amber)';
            dot.style.color = '#000';
            dot.title = 'Using DOC 2.0 API only — set GDELT_BQ_CREDENTIALS for the production backend';
        }
    } catch (e) { dot.textContent = 'BQ: ?'; }
}

async function refreshFusionRateMeter() {
    const el = document.getElementById('fusionRateMeter');
    if (!el) return;
    try {
        const [g, o] = await Promise.all([
            api('/gkg/pipeline/rate').catch(() => null),
            api('/opensky/pipeline/rate').catch(() => null),
        ]);
        const parts = [];
        if (g) {
            const gc = g.cooldown_active ? '<span style="color:var(--red)">⏸ GDELT ' + Math.ceil(g.cooldown_seconds_left) + 's</span>' : '<span style="color:var(--green)">● GDELT ready</span>';
            parts.push('<span>GDELT: ' + g.total_requests + ' reqs · ' + gc + '</span>');
        }
        if (o) {
            const oc = o.cooldown_active ? '<span style="color:var(--red)">⏸ OpenSky ' + Math.ceil(o.cooldown_seconds_left) + 's</span>'
                : !o.can_pull_now ? '<span style="color:var(--amber)">⏳ OpenSky ' + Math.ceil(o.anon_seconds_left) + 's</span>'
                : '<span style="color:var(--green)">● OpenSky ready</span>';
            parts.push('<span>OpenSky: ' + o.total_pulls + ' pulls · ' + oc + '</span>');
            if (!o.can_pull_now || o.cooldown_active) {
                parts.push('<button class="btn btn-secondary btn-sm" style="font-size:9px;padding:1px 6px" onclick="resetFusionOpenSkyCooldown()">Reset OpenSky</button>');
            }
        }
        el.innerHTML = parts.join(' ') || '<span>rate status unavailable</span>';
    } catch (e) { el.innerHTML = ''; }
}

async function resetFusionOpenSkyCooldown() {
    try { await api('/opensky/pipeline/cooldown/reset', { method: 'POST' }); } catch (e) {}
    refreshFusionRateMeter();
}

function updateFusionKpis() {
    const m = computeIntelMetrics(fusionThreatEvents);
    document.getElementById('fusionThreatCount').textContent = fusionThreatMarkers.length;
    let military = 0;
    const cats = { commercial: 0, private: 0, jet: 0, military: 0 };
    fusionFlights.forEach(f => { const c = (f.properties || {}).category || '?'; if (cats[c] != null) cats[c]++; if (c === 'military') military++; });
    const intelCountT = document.getElementById('intelCountThreats'); if (intelCountT) intelCountT.textContent = m.total;
    const intelCountA = document.getElementById('intelCountAircraft'); if (intelCountA) intelCountA.textContent = military;
    document.getElementById('fusionAircraftCount').textContent = fusionAviationMarkers.length;
    // BigQuery-enhanced metrics: avg tone + Goldstein scale
    // Goldstein from payload (BigQuery stores it); fallback to tone-derived estimate
    // Tactical metrics
    (document.getElementById('fusionMetricSystemic')||{}).textContent = m.systemic || '--';
    (document.getElementById('fusionMetricPropagation')||{}).textContent = m.propagation || '--';
    // Event momentum: avg NumMentions (from BigQuery) or fallback to event count
    const mentions = fusionThreatEvents.map(e => (e.payload && e.payload.NumMentions) || null).filter(Boolean);
    const momentum = mentions.length ? (mentions.reduce((a, b) => a + b, 0) / mentions.length).toFixed(0) : m.total;
    (document.getElementById('fusionMetricMomentum')||{}).textContent = momentum;
    // Recent threat events table (with real tone + actors)
    (document.getElementById('fusionThreatTable')||{}).innerHTML = fusionThreatEvents.slice(0, 20).map(ev => {
        const g = parseActionGeo(ev); const tone = threatLevelForEvent(ev);
        const c = tone === 'red' ? 'var(--red)' : tone === 'amber' ? 'var(--amber)' : 'var(--green)';
        const toneStr = ev.avg_tone ? ev.avg_tone.toFixed(1) : '--';
        return '<div style="margin-bottom:3px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.05)">' +
            '<span style="color:' + c + '">[' + (g ? g.country : '-') + '] ' + (ev.event_type || 'GDELT') + '</span>' +
            ' <span style="color:var(--text-muted)">tone:' + toneStr + '</span>' +
            (ev.title ? '<div style="font-size:9px;color:var(--text-muted)">' + (ev.title.length > 70 ? ev.title.slice(0, 70) + '...' : ev.title) + '</div>' : '') +
            '</div>';
    }).join('') || '<div class="empty-state">No threat events - run the GDELT pipeline</div>';
    // Military aircraft table
    (document.getElementById('fusionAircraftTable')||{}).innerHTML = fusionFlights
        .filter(f => (f.properties || {}).category === 'military').slice(0, 20).map(f => {
            const p = f.properties || {};
            return '<div style="margin-bottom:3px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.05)">' +
                '<span style="color:var(--red)">' + (p.callsign || '---') + ' - ' + (p.model || '?') + '</span>' +
                '<div style="font-size:9px;color:var(--text-muted)">' + (p.alt || '?') + 'ft - ' + (p.speed_knots || '?') + 'kts - [' + (p.lat || '?') + ', ' + (p.lng || '?') + ']</div></div>';
        }).join('') || '<div class="empty-state">No military aircraft - run the OpenSky pipeline</div>';
    // Actor network table (from GDELT actors)
    const actors = fusionThreatEvents.map(ev => {
        const title = ev.title || '';
        const parts = title.split(' -> ');
        return { actor1: parts[0] || '', actor2: parts[1] || '', type: ev.event_type || '', country: (parseActionGeo(ev) || {}).country || '' };
    }).filter(a => a.actor1);
    const actorCounts = {};
    actors.forEach(a => { actorCounts[a.actor1] = (actorCounts[a.actor1] || 0) + 1; });
    const topActors = Object.entries(actorCounts).sort((a, b) => b[1] - a[1]).slice(0, 20);
    const intelCountAc = document.getElementById('intelCountActors'); if (intelCountAc) intelCountAc.textContent = topActors.length;
    (document.getElementById('fusionActorTable')||{}).innerHTML = topActors.map(([name, count]) =>
        '<div style="margin-bottom:3px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.05)">' +
        '<span style="color:var(--accent-neon)">' + escapeHtml(name) + '</span>' +
        ' <span style="color:var(--text-muted)">(' + count + ' events)</span></div>'
    ).join('') || '<div class="empty-state">No actors extracted - run the GDELT pipeline</div>';
}

