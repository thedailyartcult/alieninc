    // ------------------------------------------- core render hooks (additive)
    // Wrap the existing global render functions so GAIA re-applies opacity and
    // filter overlays AFTER each core re-render. The originals run unchanged.
    var hooksInstalled = false;
    function installRenderHooks() {
        if (hooksInstalled) return;
        ['renderFusionThreatLayer', 'renderFusionAviationLayer'].forEach(function (fn) {
            var orig = window[fn];
            if (typeof orig !== 'function' || orig.__gaiaWrapped) return;
            var wrapped = function () {
                var r = orig.apply(this, arguments);
                try { sweepAll(); } catch (e) {}
                return r;
            };
            wrapped.__gaiaWrapped = true;
            window[fn] = wrapped;
        });
        hooksInstalled = true;
    }

    // ------------------------------------------------------------------ wiring
    function bindEvents() {
        $('gaiaCloseBtn').addEventListener('click', function () { setOpen(false); });
        $('gaiaMinBtn').addEventListener('click', function () { setMinimized(!minimized); });
        $('gaiaGoBtn').addEventListener('click', updateResults);
        $('gaiaApplyBtn').addEventListener('click', applyFilter);
        $('gaiaClearBtn').addEventListener('click', clearFilter);
        $('gaiaFocusBtn').addEventListener('click', focusResults);
        $('gaiaPlaceBtn').addEventListener('click', function () { if (placing) cancelPlacing(); else startPlacing(); });
        $('gaiaObjClearBtn').addEventListener('click', clearAllObjects);

        inputEl.addEventListener('input', updateResults);
        inputEl.addEventListener('keydown', function (e) {
