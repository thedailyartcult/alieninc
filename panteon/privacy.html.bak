            border-top: 1px solid #e5e7eb;
            padding: 24px 0;
            text-align: center;
            font-size: 0.75rem;
            color: #999;
            background: #ffffff;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
            font-size: 0.85rem;
        }
