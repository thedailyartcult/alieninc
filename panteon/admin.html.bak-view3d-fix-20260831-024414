    // ------------------------------------------------------------- query parser
    var STOPWORDS = 'show|me|all|the|a|an|of|in|on|for|from|with|within|and|or|to|is|are|was|were|detected|last|minutes|minute|min|hours|hour|hrs|days|day|weeks|week|km|kilometers|miles|meters|around|near|only|please|map|filter|assets|asset|objects|object|feed|feeds|tracks|track|radius|ring|circle|area'.split('|');

    function geocode(name) {
        name = (name || '').toLowerCase().replace(/\s+/g, ' ').trim();
        if (!name) return null;
        var regions = window.SC_REGION_BBOXES || {};
        var keys = Object.keys(regions);
        var i, k;
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (k && k.toLowerCase() === name) {
                var r = regions[k];
                if (r) return { lat: (r.lamin + r.lamax) / 2, lng: (r.lomin + r.lomax) / 2, label: k };
            }
        }
        var caps = window.COUNTRY_CAPITALS || {};
        keys = Object.keys(caps);
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (k && (k.toLowerCase() === name || k.toLowerCase().indexOf(name) === 0)) {
                var c = caps[k]; // [lng, lat]
                return { lat: c[1], lng: c[0], label: k };
            }
        }
        return null;
    }
    function scopeCenter() {
        try {
            if (typeof window.scBbox === 'function') {
                var b = window.scBbox();
                if (b) return { lat: (b.lamin + b.lamax) / 2, lng: (b.lomin + b.lomax) / 2, label: (window.SCScope && (window.SCScope.country || window.SCScope.region)) || 'scope' };
            }
        } catch (e) {}
        try { if (window.fusionMap && window.fusionMap.getCenter) { var c = window.fusionMap.getCenter(); return { lat: c.lat, lng: c.lng, label: 'map view' }; } } catch (e) {}
        return { lat: 20, lng: 20, label: 'default' };
    }

    function parseQuery(raw) {
        var f = { types: ['threat', 'aircraft'], levels: null, airCats: null, sides: null, keywords: [], center: null, radiusKm: null,
                  sinceTs: null, notes: [], parts: [] };
        var q = ' ' + String(raw || '').toLowerCase().replace(/\s+/g, ' ').trim() + ' ';
        if (!q.trim()) return f;

        function eat(re) { var m = q.match(re); if (m) { q = q.replace(m[0], ' '); return m; } return null; }
        function pushType(t) { if (f.types.indexOf(t) < 0) f.types.push(t); }

        // radius — "within 10km", "within a 50 km radius", "500 mile ring"
        var m = eat(/\bwithin\s+(?:a\s+)?([\d.,]+)\s*(km|kilometers?|kilometres?|m|meters?|metres?|mi|mi\.|miles?)\b/);
        if (m) {
            var v = parseFloat(m[1].replace(',', '.'));
            var u = m[2];
            var km = /^k/.test(u) ? v : (/^mi/.test(u) ? v * 1.60934 : v / 1000);
            if (Number.isFinite(km) && km > 0) { f.radiusKm = km; f.parts.push('within ' + fmtKm(km)); }
        }
        // time window — "last 30 minutes", "last 7 days"
        m = eat(/\blast\s+([\d.]+)\s*(minutes?|mins?|hours?|hrs?|days?|weeks?)\b/);
        if (m) {
            var n = parseFloat(m[1]), unit = m[2];
            var mult = /min/.test(unit) ? 6e4 : /h/.test(unit) ? 36e5 : /d/.test(unit) ? 864e5 : 6048e5;
            if (Number.isFinite(n) && n > 0) {
                f.sinceTs = Date.now() - n * mult;
                f.parts.push('last ' + n + ' ' + unit.replace(/s$/, '') + (n === 1 ? '' : 's'));
                f.notes.push('time filter applies to dated events, placed objects and CV tracks \u00b7 aircraft are live positions');
            }
        }
        // threat levels
        var lv = [];
        if (/\bred\b|\bcritical\b|\bsevere\b|\bhigh\s+threat/.test(q)) lv.push('red');
        if (/\bamber\b|\bmedium\b|\belevated\b/.test(q)) lv.push('amber');
        if (/\bgreen\b|\blow\s+threat|\bcalm\b/.test(q)) lv.push('green');
        if (lv.length) { q = q.replace(/\bred\b|\bamber\b|\bgreen\b|\bcritical\b|\bsevere\b|\bmedium\b|\belevated\b|\bcalm\b|\b(high|low)\s+threat/g, ' '); f.levels = lv; f.parts.push('threat level ' + lv.join('/')); }
        // aviation categories
        var ac = [];
        if (/\bmilitary\b|\bmil\b/.test(q)) { ac.push('military'); q = q.replace(/\bmilitary\b|\bmil\b/g, ' '); }
        if (/\bjets?\b/.test(q)) { ac.push('jet'); q = q.replace(/\bjets?\b/g, ' '); }
        if (/\bprivate\b/.test(q)) { ac.push('private'); q = q.replace(/\bprivate\b/g, ' '); }
        if (/\bcommercial\b|\bairliners?\b/.test(q)) { ac.push('commercial'); q = q.replace(/\bcommercial\b|\bairliners?\b/g, ' '); }
        if (ac.length) { f.airCats = ac; f.parts.push('air: ' + ac.join('/')); }
        // friendly / hostile profiles
        if (/\bfriendly\b|\ballied\b|\bnato\b/.test(q)) {
            if (!f.levels || !f.levels.length) f.levels = ['green'];
            f.airCats = ['commercial', 'jet', 'private'];
            f.sides = ['friendly']; pushType('asset');
            q = q.replace(/\bfriendly\b|\ballied\b|\bnato\b/g, ' ');
            f.parts.push('friendly profile');
        } else if (/\bhostile\b|\benemy\b|\badversar/.test(q)) {
            f.levels = ['red']; f.airCats = ['military'];
            f.sides = ['hostile']; pushType('asset');
            q = q.replace(/\bhostile\b|\benemy\b|\badversar\w*/g, ' ');
            f.parts.push('hostile profile');
        }
        // object types
        if (/\b(computer[\s\-]*vision|cv)\b/.test(q)) {
            f.types = ['cvtrack'];
            q = q.replace(/\bcomputer[\s\-]*vision\b|\bcv\b|\bdetections?\b|\bdetected\b|\bscans?\b/g, ' ');
            f.parts.push('CV tracks only');
        } else if (/\bdrones?\b|\buavs?\b|\btelemetry\b/.test(q)) {
            f.types = ['drone'];
            q = q.replace(/\bdrones?\b|\buavs?\b|\btelemetry\b/g, ' ');
            f.parts.push('drones only');
        }
        if (/\baircraft\b|\bplanes?\b|\bflights?\b|\bairspace\b|\baviation\b/.test(q)) { f.types = ['aircraft']; q = q.replace(/\baircraft\b|\bplanes?\b|\bflights?\b|\bairspace\b|\baviation\b/g, ' '); f.parts.push('aircraft only'); }
        else if (/\bthreats?\b|\bevents?\b|\bnews\b|\bcameo\b|\bprotests?\b|\bconflicts?\b|\barticles?\b/.test(q)) { f.types = ['threat']; q = q.replace(/\bthreats?\b|\bevents?\b|\bnews\b|\bcameo\b|\bprotests?\b|\bconflicts?\b|\barticles?\b/g, ' '); f.parts.push('threats only'); }
        // place — "around Kyiv", "near Ukraine", "of the scope center"
        m = eat(/(?:\baround|\bnear|\bover|\babove)\s+((?:[a-z][a-z'\-]*)(?:\s+[a-z][a-z'\-]*){0,2})/);
        if (!m) m = eat(/\bof\s+(?:the\s+)?(scope\s+center|map\s+view)\b/);
        if (m) {
            var words = (m[1] || '').split(/\s+/).filter(Boolean);
            var g = null, cand = '', L;
            for (L = Math.min(words.length, 3); L >= 1 && !g; L--) {
                cand = words.slice(0, L).join(' ');
                if (/^(scope|center|map|red|amber|green|military|jet|jets|private|commercial)$/.test(cand)) continue;
                g = geocode(cand);
            }
            if (/^scope\s+(center)?$|^map$/.test(words.join(' ')) || /\bscope\s+center\b|\bmap\s+view\b/.test(m[0])) {
                f.center = scopeCenter(); f.parts.push('ring on ' + f.center.label);
            } else if (g) { f.center = g; f.parts.push('near ' + g.label); }
            else {
                f.notes.push('unknown place "' + words.slice(0, 3).join(' ') + '" \u2014 using scope center');
                f.center = scopeCenter(); f.parts.push('ring on ' + f.center.label);
            }
        }
        if (f.radiusKm != null && f.center == null) { f.center = scopeCenter(); f.parts.push('ring on ' + f.center.label); }
        // leftover tokens become keywords
        var words = q.split(/[^a-z0-9\u00c0-\u024f\-']+/).filter(function (w) { return w.length >= 2 && STOPWORDS.indexOf(w) < 0; });
        f.keywords = words.filter(function (w, i) { return words.indexOf(w) === i; }).slice(0, 6);
        if (f.keywords.length) f.parts.push('kw: ' + f.keywords.join(', '));
        return f;
    }


    // ------------------------------------------------------------ results / UI
    var lastHitCount = 0;
    function countMatches(f) {
        var pts = collectPoints(), hits = [], i;
        for (i = 0; i < pts.length; i++) if (matches(pts[i], f)) hits.push(pts[i]);
        return { total: pts.length, hits: hits };
    }
    function updateResults() {
        lastParsed = parseQuery(inputEl.value);
        var q = inputEl.value.trim();
        if (!q) {
            resultsHead.innerHTML = activeFilter
                ? '<span class="gaia-r-num">' + lastHitCount + '</span> objects highlighted on map \u2014 type to refine or Clear Filters.'
                : 'Type a query or pick a quick filter.';
            samplesEl.innerHTML = '';
            syncChips();
            return;
        }
        var r = countMatches(lastParsed);
        var KIND_TAG = { threat: 'thr', aircraft: 'air', asset: 'obj', cvtrack: 'cv', drone: 'drn' };
        var cnts = {};
        r.hits.forEach(function (p) { cnts[p.kind] = (cnts[p.kind] || 0) + 1; });
        var brk = Object.keys(KIND_TAG).filter(function (k) { return cnts[k]; })
            .map(function (k) { return cnts[k] + ' ' + KIND_TAG[k]; }).join(' \u00b7 ');
        var head = r.total === 0
            ? 'Map is empty \u2014 run a scoped investigation or place objects first.'
            : '<span class="gaia-r-num">' + r.hits.length + '</span> of ' + r.total + ' match \u00b7 ' + (brk || '0');
        resultsHead.innerHTML = head;
        var notesHtml = lastParsed.notes.map(function (n) { return '<div class="gaia-r-notes">\u25b8 ' + esc(n) + '</div>'; }).join('');
        var sampleHtml = '';
        if (!lastParsed.parts.length && !lastParsed.keywords.length) {
            notesHtml += '<div class="gaia-r-notes">\u25b8 no criteria recognized yet</div>';
        }
        r.hits.slice(0, 3).forEach(function (p) {
            var d = lastParsed.center ? fmtKm(havKm({ lat: p.lat, lng: p.lng }, lastParsed.center))
                : (p.side ? p.side.toUpperCase() : p.kind === 'threat' ? p.level.toUpperCase() : (p.cat || '\u2014'));
            sampleHtml += '<div class="gaia-r-sample"><b>' + esc(p.label) + '</b><span>' + esc(d) + '</span></div>';
        });
        samplesEl.innerHTML = notesHtml + sampleHtml;
        syncChips();
    }
    function applyFilter() {
        activeFilter = parseQuery(inputEl.value);
        sweepAll();
        refreshStatuses();
        var n = countMatches(activeFilter).hits.length;
        lastHitCount = n;
        statusMsg('FILTER APPLIED \u2014 ' + n + ' object' + (n === 1 ? '' : 's') + ' highlighted.');
        updateResults();
    }
    function clearFilter() {
        activeFilter = null;
