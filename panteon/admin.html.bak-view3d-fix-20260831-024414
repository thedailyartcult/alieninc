async function arsenalSearch(offset) {
    const q = (document.getElementById('arsenalQ') || {}).value || '';
    const country = (document.getElementById('arsenalCountry') || {}).value || '';
    const category = (document.getElementById('arsenalCategory') || {}).value || '';
    const st = document.getElementById('arsenalStatus');
    const panel = document.getElementById('arsenalPanel');
    if (!panel) return;
    _arsenalOffset = Math.max(0, offset);
    const limit = 25;
    const params = new URLSearchParams({ limit: String(limit), offset: String(_arsenalOffset) });
    if (q.trim()) params.set('q', q.trim());
    if (country) params.set('country', country);
    if (category) params.set('category', category);
    const reqUrl = 'arsenal/items?' + params.toString();
    st.textContent = 'Querying catalog…';
    let r;
    try {
        r = await api(reqUrl);
    } catch (e) {
        // one silent retry for transient aborts (restart windows, CF blips)
        if (e.message && e.message.includes('timed out')) {
            try { r = await api(reqUrl); }
            catch (e2) {
                st.innerHTML = 'Catalog query failed: ' + simsEsc(e2.message) +
                    ' &nbsp;<button class="btn btn-secondary btn-sm" onclick="arsenalSearch(' + _arsenalOffset + ')">RETRY</button>';
                return;
            }
        } else {
            st.innerHTML = 'Catalog query failed: ' + simsEsc(e.message) +
                ' &nbsp;<button class="btn btn-secondary btn-sm" onclick="arsenalSearch(' + _arsenalOffset + ')">RETRY</button>';
            return;
        }
    }
    try {
        if (r.error) throw new Error(r.error);
        if (Array.isArray(r.categories) && r.categories.length &&
            (!SIMS.arsenalCats || !SIMS.arsenalCats.length)) {
            SIMS.arsenalCats = r.categories;
            const sel = document.getElementById('arsenalCategory');
            if (sel && sel.options.length <= 1) {
                sel.innerHTML = '<option value="">All categories</option>';
                r.categories.forEach(k => {
                    const o = document.createElement('option');
                    o.value = k; o.textContent = arsenalCatLabel(k);
                    sel.appendChild(o);
                });
            }
        }
        document.getElementById('arsenalTotals').textContent =
            `${(r.catalog_totals?.entries ?? 0).toLocaleString()} entries · ${r.catalog_totals?.categories ?? 0} categories`;
        st.textContent = `${r.total_matched_estimate} match(es)` +
            (r.total_matched_estimate > _arsenalOffset + limit
                ? ` — showing ${_arsenalOffset + 1}–${_arsenalOffset + r.entries.length}` : '');
        if (!r.entries.length) {
            panel.innerHTML = '<div class="empty-state">No systems matched.</div>';
            return;
        }
        panel.innerHTML =
            '<div class="table-wrap" style="max-height:420px;overflow:auto"><table>' +
            '<thead><tr><th>Designation</th><th>Nation</th><th>Manufacturer</th><th>Specs / Description</th></tr></thead><tbody>' +
            r.entries.map(e =>
                `<tr><td style="color:var(--text);max-width:220px"><div>${arsIconFor(e.category_key || '')}${simsEsc(e.designation || '')}</div>` +
                (e.alt_names && e.alt_names.length
                    ? `<div style="color:var(--text-dim);font-size:9px">aka ${simsEsc(e.alt_names.slice(0, 3).join(', '))}</div>` : '') +
                `<div style="font-family:var(--font-mono);font-size:8px;color:var(--accent-purple);margin-top:2px">${simsEsc(arsenalCatLabel(e.category || ''))}${e.fetched_at ? ' · ' + simsEsc(String(e.fetched_at).slice(0, 10)) : ''}</div></td>` +
                `<td style="font-size:11px">${simsEsc(e.country || '--')}</td>` +
                `<td style="font-size:11px;color:var(--text-muted)">${simsEsc(e.manufacturer || '--')}</td>` +
                `<td style="max-width:340px;font-size:10px;color:var(--text-dim)">` +
                (Object.keys(e.specs_parsed || {}).length
                    ? '<div style="font-family:var(--font-mono);font-size:9px">' + Object.entries(e.specs_parsed).slice(0, 5).map(([k, v]) => `${simsEsc(k.replace(/_/g, ' '))}: <span style="color:var(--text)">${simsEsc(String(v))}</span>`).join('<br>') + '</div>' : '') +
                (e.description ? `<div style="margin-top:2px">${simsEsc(String(e.description).slice(0, 160))}${String(e.description).length > 160 ? '…' : ''}</div>` : '') +
                '</td></tr>'
            ).join(' ') +
            '</tbody></table></div>' +
            '<div style="display:flex;gap:8px;margin-top:8px;justify-content:flex-end">' +
            `<button class="btn btn-secondary btn-sm" onclick="arsenalSearch(${Math.max(0, _arsenalOffset - limit)})"${_arsenalOffset === 0 ? ' disabled' : ''}>← PREV</button>` +
            `<button class="btn btn-secondary btn-sm" onclick="arsenalSearch(${_arsenalOffset + limit})"${_arsenalOffset + limit >= r.total_matched_estimate ? ' disabled' : ''}>NEXT →</button>` +
            '</div>';
    } catch (e) {
        st.innerHTML = 'Arsenal render failed: ' + simsEsc(e.message) +
            ' &nbsp;<button class="btn btn-secondary btn-sm" onclick="arsenalSearch(' + _arsenalOffset + ')">RETRY</button>';
    }
}

function renderFusionRealLayer() {
    fusionSimRealMarkers.forEach(m => {
        try { m.remove(); } catch (e) {}
        try { m._el && m._el.remove(); } catch (e) {}
    });
    fusionSimRealMarkers = [];
    if (!fusionMap || !fusionLayers.simsReal || !SIMS.ont || !Array.isArray(SIMS.ont.nodes)) return;

    // nations -> theaters via edges, for popup context
    SIMS.ont.nodes.forEach(n => {
        if (n.type !== 'world_country') return;
        const p = n.properties || {};
        const c = ontNodeCoords(n);
        if (!c) return;
        const parties = [];
        SIMS.ont.edges.forEach(e => {
            if (e.source !== n.id || e.link_type !== 'ks_parties_to') return;
            const t = SIMS.ont.nodes.find(x => x.id === e.target);
            if (t && t.properties && t.properties.name) parties.push(t.properties.name);
        });
        const troops = p.armed_forces_personnel || 0;
        const sizeCls = troops > 1e6 ? 'sz-xl' : troops > 300e3 ? 'sz-l' : troops > 50e3 ? 'sz-m' : 'sz-s';
        const el = document.createElement('div');
        el.className = 'sims-real-marker ' + sizeCls;
        el.title = `${p.name} — ${simsFmtNum(troops)} active troops`;
        el.innerHTML = `<span class="sims-real-tag">${simsEsc(p.name || p.iso3)} · ${simsFmtNum(troops)}</span>`;
        const rows = [
            ['Population', simsFmtNum(p.population) + (p.population_year ? ` ('${String(p.population_year).slice(2)})` : '')],
            ['Active personnel', simsFmtNum(troops) + (p.troops_year ? ` ('${String(p.troops_year).slice(2)})` : '')],
            ['Mil. expenditure', p.military_expenditure_usd ? '$' + simsFmtNum(p.military_expenditure_usd) : '--'],
            ['Source', p.source || '--'],
        ].map(([k, v]) => `<tr><td style="color:var(--text-muted);padding-right:10px">${simsEsc(k)}</td><td style="color:var(--text);text-align:right">${simsEsc(v)}</td></tr>`).join('');
        const popupHtml = `<b>REAL NATION</b> · ${simsEsc(p.name || p.iso3)}<br>` +
            `<table style="margin-top:6px;font-size:10px;font-family:var(--font-mono)">${rows}</table>` +
            (parties.length ? `<div style="margin-top:4px;font-family:var(--font-mono);font-size:9px;color:var(--accent-neon)">PARTIES TO: ${simsEsc(parties.join(', '))}</div>` : '');
        const popup = new maplibregl.Popup({ closeButton: false, offset: 8 }).setHTML(popupHtml);
        const mk = new maplibregl.Marker({ element: el }).setLngLat(c).setPopup(popup).addTo(fusionMap);
        mk._el = el;
        fusionSimRealMarkers.push(mk);
    });
}
