            // Simplified: just hover any building — tells if LZ/DZ possible (no radius)
            if (!S.aoiMode) { enterAoiMode(); }
            else { exitAoiMode(); S.pending = null; renderTasks(); }
        };
        var scoutBtn = $('mavenScoutBtn');
        if (scoutBtn) scoutBtn.onclick = function () {
            if (S.scoutMode) {
                S.scoutMode = false;
