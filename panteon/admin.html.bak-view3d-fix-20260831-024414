async function loadCMBSavings() {
    const box = document.getElementById('cmbWsSavings');
    const total = document.getElementById('cmbWsSavingsTotal');
    if (!box) return;
    try {
        const ws = await cmbApi('/workspaces');
        const list = ws.workspaces || [];
        const rows = [];
        for (const w of list) {
            try {
                const s = await cmbApi('/context-savings?workspace=' + encodeURIComponent(w.name));
                const tc = (s.by_token_counter || [])[0];
                rows.push({
                    name: w.name,
                    src: tc ? tc.source_tokens : 0,
                    ctx: tc ? tc.context_tokens : 0,
                    saved: tc ? tc.saved_tokens : 0,
                    ratio: tc && tc.source_tokens > 0 ? Math.round(tc.savings_ratio * 100) : 0
                });
            } catch (e) { rows.push({ name: w.name, src: 0, ctx: 0, saved: 0, ratio: 0 }); }
        }
        const totSrc = rows.reduce((a, r) => a + r.src, 0);
        const totSaved = rows.reduce((a, r) => a + r.saved, 0);
        const totRatio = totSrc > 0 ? Math.round(totSaved / totSrc * 100) : 0;
        total.textContent = totSrc + ' tokens sourced · ' + totSaved + ' saved (' + totRatio + '%)';
        if (!rows.length) {
            box.innerHTML = '<div style="font-size:11px;color:var(--text-muted)">No savings data yet</div>';
            return;
        }
        const max = Math.max.apply(null, rows.map(r => r.src));
        box.innerHTML = rows.map(r => `
            <div>
                <div style="display:flex;justify-content:space-between;font-size:11px;font-family:var(--font-mono);color:var(--text-muted);margin-bottom:4px">
                    <span>${r.name}</span>
                    <span>${r.src} → ${r.ctx} tokens · ${r.saved} saved · ${r.ratio}%</span>
                </div>
                <div style="height:6px;border-radius:3px;background:rgba(255,255,255,0.06);overflow:hidden">
                    <div style="height:100%;width:${max ? Math.max(2, Math.round(r.src / max * 100)) : 0}%;background:var(--cyan);opacity:.85"></div>
                </div>
            </div>`).join('');
    } catch (e) {
        box.innerHTML = `<div style="font-size:11px;color:var(--red)">Savings unavailable: ${e.message}</div>`;
    }
}

function cmbHistFmt(ts) {
    if (!ts) return 'now';
    const d = new Date(ts * 1000);
    return d.getUTCFullYear() + '-' + String(d.getUTCMonth() + 1).padStart(2, '0') + '-' + String(d.getUTCDate()).padStart(2, '0') + ' ' + String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0');
}

async function loadCMBHistoryInit() {
    const sel = document.getElementById('cmbHistWs');
    if (sel && !sel.options.length) {
        try {
            const ws = await cmbApi('/workspaces');
            (ws.workspaces || []).forEach(w => {
                const o = document.createElement('option');
                o.value = w.name;
                o.textContent = w.name;
                sel.appendChild(o);
            });
            sel.value = 'alieninc';
        } catch (e) {}
    }
    if (!document.getElementById('cmbHistQuery').value) {
        document.getElementById('cmbHistQuery').value = 'branding policy';
    }
    loadCMBHistory();
}

async function loadCMBHistory() {
    const box = document.getElementById('cmbHistory');
    const title = document.getElementById('cmbHistTitle');
    const q = document.getElementById('cmbHistQuery').value.trim();
    const ws = document.getElementById('cmbHistWs').value;
    const withWhy = document.getElementById('cmbHistWhy').checked;
    if (!q) return;
    box.innerHTML = '<div class="empty-state" style="padding:18px 0"><span class="loading"></span></div>';
    title.textContent = 'History: ' + q;
    try {
        const tl = await cmbApi('/timeline?q=' + encodeURIComponent(q) + '&workspace=' + encodeURIComponent(ws) + '&limit=20');
        const hist = tl.history || [];
        if (!hist.length) {
            box.innerHTML = '<div class="empty-state" style="padding:18px 0">No history found for "' + q + '" in ' + ws + '.</div>';
            return;
        }
        const rows = hist.map(h => `
            <div style="display:flex;gap:12px;padding:8px 0">
                <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0">
                    <div style="width:10px;height:10px;border-radius:50%;background:${h.valid_to ? 'var(--amber)' : 'var(--cyan)'};margin-top:4px;flex-shrink:0"></div>
                    <div style="width:2px;flex:1;background:var(--border);margin:4px 0"></div>
                </div>
                <div style="flex:1;padding-bottom:8px;border-bottom:1px solid var(--border)">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
                        <span style="font-weight:600;color:var(--text)">${h.title || '(untitled)'}</span>
                        <span style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted)">${cmbHistFmt(h.valid_from)} → ${h.valid_to ? cmbHistFmt(h.valid_to) : '<b style="color:var(--green)">current</b>'}</span>
                    </div>
                    ${h.pinned ? '<span style="font-size:9px;padding:1px 6px;border-radius:3px;background:rgba(240,173,78,.15);color:var(--amber);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.06em">pinned</span> ' : ''}
                    ${h.claim_kind ? '<span style="font-size:9px;padding:1px 6px;border-radius:3px;background:var(--accent-cyan)22;color:var(--accent-cyan);font-family:var(--font-mono)">' + h.claim_kind + '</span> ' : ''}
                    <div style="margin-top:4px;color:var(--text-muted);line-height:1.5;white-space:pre-wrap">${(h.content || '').slice(0, 400)}${(h.content || '').length > 400 ? '…' : ''}</div>
                </div>
            </div>`).join('');
        let extra = '';
        if (withWhy) {
            const why = await cmbApi('/why?q=' + encodeURIComponent(q) + '&workspace=' + encodeURIComponent(ws) + '&k=5');
            const sup = why.supersedes || [];
            if (sup.length) {
                extra = `<div style="margin-top:14px;padding-top:10px;border-top:1px solid var(--border)">
                    <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;color:var(--amber);text-transform:uppercase;margin-bottom:6px">Superseded versions (why)</div>
                    ${sup.map(s => `<div style="display:flex;gap:10px;align-items:baseline;padding:4px 0;color:var(--text-muted)"><span style="color:var(--amber);font-family:var(--font-mono);font-size:10px">${cmbHistFmt(s.valid_from)}</span><span>${s.title || '(untitled)'}</span></div>`).join('')}
                </div>`;
            }
        }
        box.innerHTML = rows + extra;
    } catch (e) {
        box.innerHTML = `<div class="empty-state" style="padding:18px 0;color:var(--red)">Timeline unavailable: ${e.message}</div>`;
    }
}

async function createCMBWorkspace() {
    const name = (prompt('New workspace name (lowercase, no spaces):') || '').trim();
    if (!name) return;
    try {
        await cmbApiPost('/workspaces/create', { workspace: name, description: '', visibility: 'personal', confirmed: true });
        toast('Workspace created: ' + name);
        loadCMBWorkspaces();
    } catch (e) { toast(e.message, 'error'); }
}

async function cmbWsRename(name) {
    const newName = (prompt('New name for "' + name + '":', name) || '').trim();
    if (!newName || newName === name) return;
    try {
        await cmbApiPost('/workspaces/rename', { workspace: name, new_name: newName });
        toast('Renamed to ' + newName);
        loadCMBWorkspaces();
    } catch (e) { toast(e.message, 'error'); }
}

async function cmbWsDescribe(name) {
    const desc = prompt('Description for "' + name + '":');
    if (desc === null) return;
    try {
        await cmbApiPost('/workspaces/describe', { workspace: name, description: desc });
        toast('Description updated');
        loadCMBWorkspaces();
    } catch (e) { toast(e.message, 'error'); }
}

async function cmbWsCopy(name) {
    try {
        await cmbApiPost('/workspaces/copy', { workspace: name });
        toast('Workspace duplicated');
        loadCMBWorkspaces();
    } catch (e) { toast(e.message, 'error'); }
}

async function cmbWsDelete(name) {
    if (!confirm('Delete workspace "' + name + '" and its memories? This cannot be undone.')) return;
    try {
        await cmbApiPost('/workspaces/delete', { workspace: name });
        toast('Deleted ' + name);
        loadCMBWorkspaces();
    } catch (e) { toast(e.message, 'error'); }
}

