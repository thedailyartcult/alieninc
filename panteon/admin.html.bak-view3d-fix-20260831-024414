function renderFusionAviationLayer() {
    // Category chips always show FULL feed counts (pre-filter), so the analyst
    // sees what a chip would reveal before enabling it.
    const catCounts = { commercial: 0, jet: 0, private: 0, military: 0 };
    fusionFlights.forEach(f => {
        const c = (f.properties || {}).category;
        if (c in catCounts) catCounts[c]++;
    });
    [['commercial', 'fcatCommercial'], ['jet', 'fcatJet'], ['private', 'fcatPrivate'], ['military', 'fcatMilitary']].forEach(([c, id]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(catCounts[c]);
    });
    fusionMilContacts = [];

    if (!fusionMap || !fusionLayers.aviation) {
        Object.values(fusionAircraftIndex).forEach(e => { try { e.mk.remove(); } catch (err) {} });
        fusionAircraftIndex = {};
        fusionAviationMarkers = [];
        updateFusionMilPanel();
        updateFovLayer();
        return 0;
    }

    // DIFF UPDATE — reuse existing markers instead of tearing down ~2000 DOM
    // nodes every cycle (the old rebuild froze the UI mid-click).
    const seen = new Set();
    let plotted = 0;
    fusionFlights.forEach((f, wonIdx) => {
        const props = f.properties || {};
        if (props.category && fusionCatFilter[props.category] === false) return; // chip-filtered
        const p = normalizeAircraftPoint(f, wonIdx);
        if (!p) return;
        const icaoSafe = String(props.icao24 || '').replace(/[^a-zA-Z0-9]/g, '');
        const key = icaoSafe.toLowerCase();
        seen.add(key);
        const existing = key ? fusionAircraftIndex[key] : null;
        if (existing) {
            existing.f = f;
            // Authoritative fix becomes a TARGET, not an instant snap: the
            // motion tick converges the gliding marker onto it (no teleports).
            const np = [p.lng, p.lat];
            const prevT = existing.target || existing.lngLat;
            const jumpDeg = Math.abs(np[0] - prevT[0]) + Math.abs(np[1] - prevT[1]);
            if (jumpDeg > 0.12 || !isFinite(Number((f.properties || {}).speed_knots))) {
                // Genuine relocation (reappeared track / static airframe): snap.
                existing.lngLat = np.slice();
                try { existing.mk.setLngLat(existing.lngLat); } catch (err) {}
            }
            existing.target = np.slice();
            existing.lastTick = null;
            try { if (existing.popup) existing.popup.setHTML(p.popup); } catch (err) {}
            plotted++;
            if (props.category === 'military') {
                fusionMilContacts.push({ callsign: props.callsign || '---', model: props.model || '?', alt: props.alt, spd: props.speed_knots, lng: p.lng, lat: p.lat, mk: existing.mk });
            }
            return;
        }
        const el = aircraftGlyphEl(p.color, props.category);
        if (fusionSelectedIcao && key === fusionSelectedIcao) {
            el.classList.add('ac-glyph-selected');
        }
        el.addEventListener('click', (ev) => {
            ev.stopPropagation();
            if (icaoSafe) selectFusionAircraft(icaoSafe);
        });
        const popup = new maplibregl.Popup({ closeButton: false, offset: 6 }).setHTML(p.popup);
        const mk = aircraftMarker(el, props).setLngLat([p.lng, p.lat]).setPopup(popup).addTo(fusionMap);
        if (key) fusionAircraftIndex[key] = { mk: mk, popup: popup, f: f, lngLat: [p.lng, p.lat], target: [p.lng, p.lat], lastTick: null };
        plotted++;
        if (props.category === 'military') {
            fusionMilContacts.push({ callsign: props.callsign || '---', model: props.model || '?', alt: props.alt, spd: props.speed_knots, lng: p.lng, lat: p.lat, mk: mk });
        }
    });

    // Drop aircraft that vanished from the feed or got chip-filtered out.
    Object.keys(fusionAircraftIndex).forEach(k => {
        if (!seen.has(k)) {
            try { fusionAircraftIndex[k].mk.remove(); } catch (err) {}
            delete fusionAircraftIndex[k];
        }
    });
    fusionAviationMarkers = Object.values(fusionAircraftIndex).map(e => e.mk);
    updateFusionMilPanel();
    updateFovLayer();
    return plotted;
}

