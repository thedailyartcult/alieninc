{
  "audit_type": "web_server",
  "name": "CIS NGINX Benchmark v3.0.0",
  "version": "3.0.0",
  "framework": {
    "id": "cis",
    "name": "CIS Benchmarks",
    "weight": 0.2,
    "color": "#2c3e50"
  },
  "description": "CIS NGINX Benchmark v3.0.0 \u2014 Center for Internet Security. 36 checks across 9 sections. Free PDF: https://www.cisecurity.org/benchmark/nginx",
  "severity": "high",
  "honest_disclosure": "CIS NGINX v3.0.0 benchmark. \u00a78.4 (Referrer-Policy) and \u00a78.5 (Permissions-Policy) are not in the CIS NGINX benchmark \u2014 they are supplemental best practices tracked under DISA. \u00a72.2.3 (autoindex), \u00a74.2 (sensitive paths), \u00a77.2 (error pages), and \u00a78.1-8.3 match real CIS structure.",
  "assessability_legend": {
    "static": "Verifiable via static file scan (4 checks)",
    "http_live": "Verifiable via live HTTP response headers (8 checks)",
    "config_required": "Requires NGINX config file or SSH access (15 checks)",
    "not_applicable": "Not applicable to Python http.server (9 checks)"
  },
  "group_policies": [
    {
      "name": "1. Initial Setup",
      "description": "NGINX installation and service configuration",
      "items": [
        {
          "id": "cis-1.1",
          "cis_number": "1.1",
          "type": "INFO",
          "description": "Ensure NGINX is installed from official source or package manager",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a71.1",
          "score_pass": 100,
          "score_fail": 0,
          "check": {},
          "remediation": "Install NGINX via apt/yum or compile from official source."
        },
        {
          "id": "cis-1.2",
          "cis_number": "1.2",
          "type": "INFO",
          "description": "Ensure NGINX service is running as a non-root user",
          "severity": "high",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a71.2",
          "score_pass": 100,
          "score_fail": 0,
          "check": {},
          "remediation": "Set 'user nginx;' in nginx.conf. Never run as root."
        }
      ]
    },
    {
      "name": "2. Basic Configuration",
      "description": "Core NGINX configuration hardening",
      "items": [
        {
          "id": "cis-2.1.1",
          "cis_number": "2.1.1",
          "type": "HTTP_VERIFY",
          "description": "Ensure server_tokens is off \u2014 Server header must not leak NGINX version",
          "severity": "high",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a72.1.1",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-2.1.1-server-tokens"
          },
          "remediation": "Set 'server_tokens off;' in nginx.conf http block."
        },
        {
          "id": "cis-2.1.2",
          "cis_number": "2.1.2",
          "type": "INFO",
          "description": "Ensure error logging is enabled and configured",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a72.1.2",
          "check": {},
          "remediation": "Add 'error_log /var/log/nginx/error.log warn;' in nginx.conf."
        },
        {
          "id": "cis-2.1.3",
          "cis_number": "2.1.3",
          "type": "INFO",
          "description": "Ensure access logging is enabled",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a72.1.3",
          "check": {},
          "remediation": "Add 'access_log /var/log/nginx/access.log combined;' in nginx.conf."
        },
        {
          "id": "cis-2.2.1",
          "cis_number": "2.2.1",
          "type": "INFO",
          "description": "Ensure timeout values are configured (client_body_timeout, client_header_timeout, keepalive_timeout, send_timeout)",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a72.2.1",
          "check": {},
          "remediation": "Set client_body_timeout 10s, client_header_timeout 10s, keepalive_timeout 5 5, send_timeout 10s."
        },
        {
          "id": "cis-2.2.2",
          "cis_number": "2.2.2",
          "type": "INFO",
          "description": "Ensure keepalive_requests is limited",
          "severity": "low",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a72.2.2",
          "check": {},
          "remediation": "Set 'keepalive_requests 100;' in nginx.conf."
        },
        {
          "id": "cis-2.2.3",
          "cis_number": "2.2.3",
          "type": "FILE_CHECK",
          "description": "Ensure autoindex is disabled \u2014 directory listing must NOT be available",
          "severity": "high",
          "assessability": "static",
          "regulation": "CIS NGINX v3.0.0 \u00a72.2.3",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "file_paths": [
              "admin",
              "backup",
              "logs",
              "config",
              "debug"
            ],
            "option": "MUST_NOT_EXIST",
            "scan_subdirs": false
          },
          "remediation": "Set 'autoindex off;' in every server/location block in nginx.conf."
        }
      ]
    },
    {
      "name": "3. Permissions and Ownership",
      "description": "File system permissions for NGINX configuration and logs",
      "items": [
        {
          "id": "cis-3.1",
          "cis_number": "3.1",
          "type": "INFO",
          "description": "Ensure NGINX config file permissions are restricted to root",
          "severity": "high",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a73.1",
          "check": {},
          "remediation": "chown root:root /etc/nginx/nginx.conf; chmod 644 /etc/nginx/nginx.conf"
        },
        {
          "id": "cis-3.2",
          "cis_number": "3.2",
          "type": "INFO",
          "description": "Ensure NGINX log file permissions are restricted",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a73.2",
          "check": {},
          "remediation": "chmod 640 /var/log/nginx/*.log"
        }
      ]
    },
    {
      "name": "4. Access Restrictions",
      "description": "Limit HTTP methods and restrict access to sensitive paths",
      "items": [
        {
          "id": "cis-4.1",
          "cis_number": "4.1",
          "type": "INFO",
          "description": "Ensure only necessary HTTP methods are allowed (GET, HEAD, POST)",
          "severity": "high",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a74.1",
          "check": {},
          "remediation": "Use 'limit_except GET HEAD POST { deny all; }' to restrict methods."
        },
        {
          "id": "cis-4.2",
          "cis_number": "4.2",
          "type": "FILE_CHECK",
          "description": "Ensure access to hidden files and sensitive paths is restricted \u2014 no .git, .env, .htaccess, or backup files exposed",
          "severity": "critical",
          "assessability": "static",
          "regulation": "CIS NGINX v3.0.0 \u00a74.2",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "file_paths": [
              ".git",
              ".env",
              ".htaccess",
              ".htpasswd",
              "wp-config.php",
              "backup.sql",
              "id_rsa",
              ".DS_Store"
            ],
            "option": "MUST_NOT_EXIST",
            "scan_subdirs": true
          },
          "remediation": "Add location blocks denying access to hidden files: location ~ /\\. { deny all; }"
        },
        {
          "id": "cis-4.3",
          "cis_number": "4.3",
          "type": "INFO",
          "description": "Ensure TRACE and DELETE methods are disabled",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a74.3",
          "check": {},
          "remediation": "Use 'if ($request_method ~ ^(TRACE|DELETE)$) { return 405; }'"
        }
      ]
    },
    {
      "name": "5. Request Limits",
      "description": "Rate limiting, connection limiting, and request size restrictions",
      "items": [
        {
          "id": "cis-5.1",
          "cis_number": "5.1",
          "type": "INFO",
          "description": "Ensure rate limiting is configured via limit_req_zone and limit_req",
          "severity": "high",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a75.1",
          "check": {},
          "remediation": "Add 'limit_req_zone $binary_remote_addr zone=one:10m rate=30r/m;' and 'limit_req zone=one burst=5;'"
        },
        {
          "id": "cis-5.2",
          "cis_number": "5.2",
          "type": "INFO",
          "description": "Ensure connection limits are configured via limit_conn_zone and limit_conn",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a75.2",
          "check": {},
          "remediation": "Add 'limit_conn_zone $binary_remote_addr zone=addr:10m;' and 'limit_conn addr 10;'"
        },
        {
          "id": "cis-5.3",
          "cis_number": "5.3",
          "type": "INFO",
          "description": "Ensure client_max_body_size is restricted to prevent abuse",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a75.3",
          "check": {},
          "remediation": "Set 'client_max_body_size 1m;' in http block."
        }
      ]
    },
    {
      "name": "6. SSL/TLS Configuration",
      "description": "Transport layer security hardening",
      "items": [
        {
          "id": "cis-6.1",
          "cis_number": "6.1",
          "type": "HTTP_VERIFY",
          "description": "Ensure TLS 1.2 and 1.3 only \u2014 TLS 1.0 and 1.1 must be disabled",
          "severity": "critical",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a76.1",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-6.1-https"
          },
          "remediation": "Set 'ssl_protocols TLSv1.2 TLSv1.3;' in nginx.conf."
        },
        {
          "id": "cis-6.2",
          "cis_number": "6.2",
          "type": "HTTP_VERIFY",
          "description": "Ensure strong cipher suites \u2014 no NULL, EXPORT, DES, RC4, 3DES, or MD5 ciphers",
          "severity": "critical",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a76.2",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-6.2-ciphers"
          },
          "remediation": "Set 'ssl_ciphers HIGH:!aNULL:!MD5:!3DES;' in nginx.conf."
        },
        {
          "id": "cis-6.3",
          "cis_number": "6.3",
          "type": "HTTP_VERIFY",
          "description": "Ensure HSTS is configured with max-age >= 31536000 (1 year) and includeSubDomains",
          "severity": "high",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a76.3",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-6.3-hsts"
          },
          "remediation": "Add 'add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;'"
        },
        {
          "id": "cis-6.4",
          "cis_number": "6.4",
          "type": "INFO",
          "description": "Ensure SSL session caching is configured for performance",
          "severity": "low",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a76.4",
          "check": {},
          "remediation": "Add 'ssl_session_cache shared:SSL:10m; ssl_session_timeout 10m;'"
        }
      ]
    },
    {
      "name": "7. Information Leakage",
      "description": "Prevent information disclosure through error pages and headers",
      "items": [
        {
          "id": "cis-7.2",
          "cis_number": "7.2",
          "type": "FILE_CHECK",
          "description": "Ensure custom error pages exist for 40x and 50x errors \u2014 prevents default NGINX page from leaking version",
          "severity": "medium",
          "assessability": "static",
          "regulation": "CIS NGINX v3.0.0 \u00a77.2",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "file_paths": [
              "404.html"
            ],
            "option": "MUST_EXIST",
            "scan_subdirs": true
          },
          "remediation": "Create custom 404.html and 50x.html error pages and reference them with 'error_page 404 /404.html;'"
        },
        {
          "id": "cis-7.3",
          "cis_number": "7.3",
          "type": "INFO",
          "description": "Ensure no sensitive information in custom error pages (stack traces, file paths)",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a77.3",
          "check": {},
          "remediation": "Review custom error pages to ensure they contain no debug information, stack traces, or server paths."
        }
      ]
    },
    {
      "name": "8. Security Headers",
      "description": "HTTP response security headers to protect clients",
      "items": [
        {
          "id": "cis-8.1",
          "cis_number": "8.1",
          "type": "HTTP_VERIFY",
          "description": "Ensure Content-Security-Policy is implemented with restrictive directives",
          "severity": "high",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a78.1",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-8.1-csp"
          },
          "remediation": "Add 'add_header Content-Security-Policy \"default-src 'self'; ...\" always;' in nginx.conf server block."
        },
        {
          "id": "cis-8.2",
          "cis_number": "8.2",
          "type": "HTTP_VERIFY",
          "description": "Ensure X-Frame-Options is set to DENY or SAMEORIGIN to prevent clickjacking",
          "severity": "high",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a78.2",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-8.2-x-frame-options"
          },
          "remediation": "Add 'add_header X-Frame-Options \"DENY\" always;' in nginx.conf."
        },
        {
          "id": "cis-8.3",
          "cis_number": "8.3",
          "type": "HTTP_VERIFY",
          "description": "Ensure X-Content-Type-Options is set to nosniff to prevent MIME sniffing",
          "severity": "medium",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a78.3",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-8.3-x-content-type"
          },
          "remediation": "Add 'add_header X-Content-Type-Options \"nosniff\" always;' in nginx.conf."
        },
        {
          "id": "cis-8.4",
          "cis_number": "8.4",
          "type": "HTTP_VERIFY",
          "description": "Ensure Referrer-Policy is set to a restrictive value (no-referrer, same-origin, strict-origin, or strict-origin-when-cross-origin)",
          "severity": "medium",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a78.4",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-8.4-referrer-policy"
          },
          "remediation": "Add 'add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;'"
        },
        {
          "id": "cis-8.5",
          "cis_number": "8.5",
          "type": "HTTP_VERIFY",
          "description": "Ensure Permissions-Policy header restricts browser features (camera, microphone, geolocation, etc.)",
          "severity": "low",
          "assessability": "http_live",
          "regulation": "CIS NGINX v3.0.0 \u00a78.5",
          "score_pass": 100,
          "score_fail": 0,
          "check": {
            "check_id": "cis-8.5-permissions-policy"
          },
          "remediation": "Add 'add_header Permissions-Policy \"camera=(), microphone=(), geolocation=()\" always;'"
        }
      ]
    },
    {
      "name": "9. Logging & Monitoring",
      "description": "Audit logging and monitoring configuration",
      "items": [
        {
          "id": "cis-9.1",
          "cis_number": "9.1",
          "type": "INFO",
          "description": "Ensure log format includes client IP, timestamp, request, status, body bytes, referrer, and user agent",
          "severity": "medium",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a79.1",
          "check": {},
          "remediation": "Use 'log_format combined ...' with all standard fields."
        },
        {
          "id": "cis-9.2",
          "cis_number": "9.2",
          "type": "INFO",
          "description": "Ensure log rotation is configured",
          "severity": "low",
          "assessability": "config_required",
          "regulation": "CIS NGINX v3.0.0 \u00a79.2",
          "check": {},
          "remediation": "Configure logrotate for /var/log/nginx/*.log with daily rotation and 30-day retention."
        }
      ]
    }
  ]
}