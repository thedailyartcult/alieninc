    async function submitPending() {
        if (!S.pending) return;
        var name = ($('mavenTaskName') || {}).value || '';
        var pri = ($('mavenTaskPri') || {}).value || 'medium';
        var region = 'Global';
        try {
            var bboxes = (typeof SC_REGION_BBOXES !== 'undefined') ? SC_REGION_BBOXES : {};
            Object.keys(bboxes).forEach(function (k) {
                var b = bboxes[k];
                if (!b) return;
                if (S.pending.lat >= b.lamin && S.pending.lat <= b.lamax &&
                    S.pending.lng >= b.lomin && S.pending.lng <= b.lomax) region = k;
            });
        } catch (e) {}
