        .retro-map-node-marker.tone-amber { --mk: #d1913b; --mk-dim: rgba(209, 145, 59, 0.14); --mk-ring: rgba(209, 145, 59, 0.38); }
        .retro-map-node-marker.tone-green { --mk: #3fa97c; --mk-dim: rgba(63, 169, 124, 0.14); --mk-ring: rgba(63, 169, 124, 0.38); }
        .retro-map-marker-tag {
            font-family: var(--font-mono);
            text-transform: uppercase;
            font-size: 9px;
            letter-spacing: 0.09em;
            line-height: 1;
            color: #c8cfd6;
            background: rgba(7, 10, 15, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-left: 2px solid var(--mk, var(--accent-cyan));
            padding: 3px 7px 2px 5px;
            white-space: nowrap;
            transition: color 0.15s ease, border-color 0.15s ease;
        }
        .retro-map-marker-line { width: 1px; height: 9px; margin: 1px 0; background: linear-gradient(to bottom, var(--mk-ring, rgba(255,255,255,.25)), transparent); }
        .retro-map-marker-glow { width: 13px; height: 13px; position: relative; }
        .retro-map-marker-glow::before {
            content: '';
            position: absolute; inset: 2px;
            transform: rotate(45deg);
            background: var(--mk-dim, rgba(255, 255, 255, 0.08));
            border: 1.5px solid var(--mk, var(--accent-cyan));
            animation: mk-halo 2.4s ease-in-out infinite;
        }
        .retro-map-marker-glow::after {
            content: '';
            position: absolute; left: 50%; top: 50%;
            width: 3px; height: 3px; margin: -1.5px 0 0 -1.5px;
            background: var(--mk, #fff); border-radius: 1px;
        }
        .retro-map-node-marker:hover .retro-map-marker-tag { color: var(--mk); border-color: var(--mk-ring); background: rgba(7, 10, 15, 0.95); }
        .retro-map-node-marker:hover .retro-map-marker-line { background: var(--mk-ring); }
        .retro-map-node-marker:hover .retro-map-marker-glow::before { background: var(--mk); animation-play-state: paused; }
        @keyframes mk-halo {
            0%, 100% { box-shadow: 0 0 0 1px rgba(0,0,0,.55), 0 1px 4px rgba(0,0,0,.45), 0 0 0 0 var(--mk-ring); opacity: 0.92; }
            50%      { box-shadow: 0 0 0 1px rgba(0,0,0,.55), 0 1px 4px rgba(0,0,0,.45), 0 0 0 4px transparent; opacity: 1; }
        }

        /* ── Spinal Cracker fusion dashboard ── */
        .sc-control-rail { margin-bottom: 10px; }
        .sc-preset-bar { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
        .sc-preset-btn {
            font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
            padding: 3px 10px; border: 1px solid var(--border-color); border-radius: 0px;
            background: var(--bg-card); color: var(--text-muted); cursor: pointer; transition: all 0.15s;
            clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
        }
        .sc-preset-btn:hover { border-color: var(--accent-neon); color: var(--text); }
        .sc-preset-btn.active { background: var(--accent-neon); color: #000; border-color: var(--accent-neon); }
        .sc-query-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .sc-query-input {
            flex: 1; min-width: 200px; padding: 6px 10px; font-size: 12px;
            background: var(--bg-input); color: var(--text); border: 1px solid var(--border-color);
            border-radius: 0px; font-family: var(--font-mono);
        }
        .sc-query-input:focus { outline: none; border-color: var(--accent-neon); }
        .sc-rate-meter {
            display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
            font-family: var(--font-mono); font-size: 9px; margin-bottom: 8px; color: var(--text-muted);
        }

        /* Investigation Builder — intent-first scoping (WHERE/WHAT/WHEN) */
        .sc-scope-builder { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
        .sc-scope-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
        .sc-scope-step {
            font-family: var(--font-mono); font-size: 9px; text-transform: uppercase;
            color: var(--text-muted); letter-spacing: 0.08em; min-width: 48px;
        }
        .sc-scope-btn {
            font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
            padding: 5px 12px; border: 1px solid var(--border-color); border-radius: 0;
            background: rgba(0, 0, 0, 0.6); color: var(--text-muted); cursor: pointer;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
        }
        #fusionScopeBuilder .sc-scope-btn:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); transform: translateY(-1px); }
        #fusionScopeBuilder .sc-scope-btn.active {
            background: rgba(34, 211, 232, 0.14); color: #67e8f9; border-color: rgba(34, 211, 232, 0.65);
            filter: drop-shadow(0 0 8px rgba(34, 211, 232, 0.25));
        }
        .scope-wing[open] > .scope-wing-body > * { animation: hive-pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards; }
        .scope-wing[open] > .scope-wing-body > *:nth-child(2) { animation-delay: 0.06s; }
        .scope-wing[open] > .scope-wing-body > *:nth-child(3) { animation-delay: 0.12s; }
        .scope-wing[open] > .scope-wing-body > *:nth-child(4) { animation-delay: 0.18s; }
        .scope-wing[open] > .scope-wing-body > *:nth-child(5) { animation-delay: 0.24s; }
        .scope-wing-body { display: flex; flex-direction: column; gap: 7px; padding: 9px 10px 10px; background: rgba(0, 0, 0, 0.78); border: 1px solid var(--border-color); border-radius: 8px; backdrop-filter: blur(6px); max-width: min(720px, calc(100vw - 40px)); }
        .scope-wing summary { list-style: none; cursor: pointer; }
        .scope-wing summary::-webkit-details-marker { display: none; }
        .sc-scope-select {
            font-family: var(--font-mono); font-size: 10px; padding: 4px 8px;
            background: var(--bg-input); color: var(--text); border: 1px solid var(--border-color);
            border-radius: 0px; cursor: pointer;
        }
        .sc-scope-select:focus { outline: none; border-color: var(--accent-neon); }
        .sc-scope-advanced { margin-top: 2px; }
        .sc-scope-advanced summary {
            font-family: var(--font-mono); font-size: 9px; text-transform: uppercase;
            color: var(--text-muted); cursor: pointer; letter-spacing: 0.05em;
        }
        .sc-scope-advanced[open] summary { color: var(--text); margin-bottom: 6px; }
        .sc-scope-empty {
            display: flex; align-items: center; justify-content: center;
            font-family: var(--font-tech); font-size: 13px; color: var(--text-muted);
            background: rgba(0,0,0,0.5); position: absolute; inset: 0; z-index: 10;
            text-align: center; padding: 20px; pointer-events: none;
        }
        .sc-map-canvas-wrap { position: relative; }

        .sc-layer-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
        .sc-layer-label { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.08em; }
        .sc-layer-bar .retro-map-btn {
            clip-path: polygon(5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%, 0 5px);
        }

        /* Floating Command Deck — REAL beehive tiles (sc-hud-* design language,
           incl. the connected-grid neighbor reaction) hovering directly on the
           full-width map. No container box: the deck positions, tiles style. */
        .sc-deck {
            position: absolute; top: 10px; left: 10px; z-index: 8;
            /* click-THROUGH container: the expanded deck box spans a large map
               area — only the pentagon and the tiles themselves take pointers,
               so AOI placement and map drags pass through empty comb space. */
            pointer-events: none;
        }
        .sc-deck > .hive-pent, .sc-deck > .scope-wing { pointer-events: auto; }
        /* Compact action tiles share the EXACT sc-hud-tile DNA — same band,
           cuts, hover physics and connected-grid neighbor reaction — so the
           whole deck reads as one beehive instead of a separate button row. */
        .sc-hud-tile.sm { width: 118px; height: 64px; }
        .sc-hud-tile.sm .sc-hud-inner { gap: 2px; }
        .sc-hud-tile.sm .sc-hud-label { font-size: 8.5px; letter-spacing: 0.12em; color: var(--accent-cyan); }
        .sc-hud-tile.sm.engaged { background-color: #10b981; transform: scale(0.98); filter: drop-shadow(0 0 12px rgba(16, 185, 129, 0.45)); }
        .sc-hud-tile.sm.engaged .sc-wireframe-box { border-color: #10b981; }
        .scope-wing { display: none; position: absolute; top: 100%; left: 0; margin-top: 12px; z-index: 30; }
        .scope-wing.open { display: flex; }
        /* Authentic KPI-tile anatomy: sc-hud-tile carries size (165x120), cuts,
           band colors, hover physics; sc-hud-inner carries fonts. Additions below
           are only the engagement state and the invisible toggle surface. */
        .sc-deck .sc-hud-tile { pointer-events: auto; }
        .sc-deck .sc-hud-tile .retro-map-btn {
            position: absolute; inset: 0; width: 100%; height: 100%;
            background: transparent; border: none; cursor: pointer;
            font: inherit; color: transparent; padding: 0; letter-spacing: 0;
        }
        .sc-deck .sc-hud-tile .retro-map-btn:hover, .sc-deck .sc-hud-tile .retro-map-btn:focus {
            background: transparent; color: transparent; box-shadow: none;
        }
        /* Engaged = neighbor-active language held steady + a soft beacon glow */
        .sc-deck .sc-hud-tile:has(.retro-map-btn-active) { transform: scale(0.98); filter: drop-shadow(0 0 12px rgba(16, 185, 129, 0.45)); }
        .sc-deck .sc-hud-tile.sc-tile-live:has(.retro-map-btn-active) { background-color: rgba(34, 211, 238, 0.9); }
        .sc-deck .sc-hud-tile.sc-tile-live:has(.retro-map-btn-active) .sc-hud-value { color: #0891b2; }
        .sc-deck .sc-hud-tile.sc-tile-indices:has(.retro-map-btn-active) { background-color: rgba(223, 241, 64, 0.85); }
        /* KPI values keep the light Space Grotesk look even with <b> count nodes */
        .sc-deck .sc-hud-value b { font-weight: inherit; }
        .sc-deck-chips { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
        /* ---- Mini hive tiles: traffic sub-filters + deck-head actions ----
           Same DNA as the KPI tiles (cut corners, band bg, hover physics,
           staggered entrance); rows stagger horizontally like the original
           offset-row honeycomb. */
        .hm-row { display: flex; gap: 8px; }
        .hm-row-offset { transform: translateX(26px); }
        .hive-mini {
            position: relative; width: 96px; height: 56px;
            background-color: var(--border-color);
            padding: 1.5px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer; user-select: none;
            clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
        }
        .hive-mini:hover { z-index: 10; background-color: rgba(255, 255, 255, 0.35); transform: scale(1.06); filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.5)); }
        .hm-inner {
            width: 100%; height: 100%; background-color: var(--bg-card);
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
        }
        .hm-val { font-family: var(--font-tech); font-size: 16px; font-weight: 300; line-height: 1.05; color: var(--text); }
        .hm-lbl { font-family: var(--font-mono); font-size: 7.5px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.08em; }
        .hive-mini .retro-map-btn {
            position: absolute; inset: 0; width: 100%; height: 100%;
            background: transparent; border: none; cursor: pointer;
            font: inherit; color: transparent; padding: 0; letter-spacing: 0;
        }
        .hive-mini .retro-map-btn:hover, .hive-mini .retro-map-btn:focus { background: transparent; color: transparent; box-shadow: none; }
        /* Engaged minis: cyan live-band held + beacon */
        .hive-mini:has(.retro-map-btn-active) { background-color: rgba(34, 211, 238, 0.85); filter: drop-shadow(0 0 10px rgba(34, 211, 232, 0.4)); }
        .hive-mini:has(.retro-map-btn-active) .hm-inner { background-color: rgba(34, 211, 232, 0.14); }
        .hive-mini:has(.retro-map-btn-active) .hm-val { color: #22d3ee; }
        .hive-mini:has(.retro-map-btn-active) .hm-lbl { color: #67e8f9; }
        /* Modifier minis (Motion/FOV): lime family */
        .hive-mini.hm-mod:has(.retro-map-btn-active) { background-color: rgba(223, 241, 64, 0.8); filter: drop-shadow(0 0 10px rgba(223, 241, 64, 0.35)); }
        .hive-mini.hm-mod:has(.retro-map-btn-active) .hm-val { color: #DFF140; }
        .hive-mini.hm-mod:has(.retro-map-btn-active) .hm-lbl { color: #e9ffa3; }
        /* ON/OFF state text driven purely by engagement */
        .hive-mini .hm-off { display: inline; }
        .hive-mini .hm-on { display: none; }
        .hive-mini:has(.retro-map-btn-active) .hm-off { display: none; }
        .hive-mini:has(.retro-map-btn-active) .hm-on { display: inline; }
        /* Disabled action (e.g. MAVEN until ontology feeds load) */
        .hive-mini:has(.retro-map-btn:disabled) { opacity: 0.45; cursor: not-allowed; }
        .hive-mini:has(.retro-map-btn:disabled):hover { transform: none; filter: none; background-color: var(--border-color); }
        /* Entrance cascade — replays whenever the hive unfolds */
        @keyframes hive-pop { from { opacity: 0; transform: translateY(10px) scale(0.88); } }
        /* ---- Pentagon launcher + expandable honeycomb hive ----
           One draggable pentagon floats on the map; clicking it blooms the
           full connected honeycomb (deck tiles + traffic chips interlocked
           in offset stacked rows). Tiles drag-swap between comb slots and
           the arrangement persists locally. Cells are positioned via the
           --tx/--ty custom props so hover/engaged scales compose cleanly. */
        .hive-pent {
            position: absolute; top: 0; left: 0; width: 76px; height: 70px;
            padding: 1.5px; background: var(--border-color); border: none;
            cursor: pointer; z-index: 20; touch-action: none; user-select: none;
            clip-path: polygon(50% 0, 100% 38%, 82% 100%, 18% 100%, 0 38%);
            transition: background-color 0.2s ease, filter 0.25s ease;
        }
        .hive-pent:hover { background: var(--accent-neon); filter: drop-shadow(0 0 14px rgba(223, 241, 64, 0.5)); }
        .hive-pent-inner {
            width: 100%; height: 100%; background: var(--bg-card);
            clip-path: polygon(50% 0, 100% 38%, 82% 100%, 18% 100%, 0 38%);
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
        }
        .hive-pent-glyph { font-family: var(--font-tech); font-weight: 300; font-size: 15px; letter-spacing: 0.16em; color: var(--text); }
        .hive-pent-count { font-family: var(--font-mono); font-size: 8px; font-weight: 400; color: var(--accent-neon); letter-spacing: 0.1em; }
        .hive-pent-caret { font-family: var(--font-mono); font-size: 7px; color: var(--text-muted); transition: transform 0.3s ease, color 0.2s ease; }
        .sc-deck.is-expanded .hive-pent-caret { transform: rotate(180deg); color: var(--accent-neon); }
        /* decoratives are pointer-transparent so a grab lands on the button
           itself from anywhere — no need to hit a specific child first */
        .hive-pent-inner, .hive-pent-glyph, .hive-pent-count, .hive-pent-caret { pointer-events: none; }
        /* YONO quick-launch embedded in the pentagon base */
        .hive-pent-yono {
            position: absolute; left: 50%; bottom: 3px; transform: translateX(-50%);
            font-family: var(--font-mono); font-size: 7px; letter-spacing: 0.14em;
            color: var(--text-muted); padding: 1px 7px; cursor: pointer;
            pointer-events: auto; z-index: 2;
            transition: color 0.15s ease, text-shadow 0.15s ease;
        }
        .hive-pent-yono:hover { color: var(--accent-neon); text-shadow: 0 0 6px rgba(223, 241, 64, 0.6); }

        .hive-layer { position: absolute; top: 78px; left: 0; width: 792px; height: 358px; pointer-events: none; }
        .hive-layer .sc-hud-tile, .hive-layer .hive-mini {
            position: absolute; top: 0; left: 0; width: 152px; height: 88px; margin: 0;
            touch-action: none; pointer-events: auto;
            transform: translate(var(--tx, 0px), var(--ty, 0px));
            transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease,
                        background-color 0.2s ease, filter 0.25s ease;
            transition-delay: var(--hd, 0ms);
        }
        /* compact comb-cell typography — same DNA, tighter anatomy */
        .hive-layer .sc-hud-inner { padding: 7px; gap: 2px; }
        .hive-layer .sc-hud-value { font-size: 17px; margin-top: 11px; }
        .hive-layer .sc-hud-label { font-size: 7.5px; }
        .hive-layer .sc-hud-check { bottom: 5px; font-size: 9px; }
        .hive-layer .sc-hud-tag { top: 4px; right: 9px; }
        .hive-layer .sc-wireframe-boxes { top: 5px; left: 9px; }
        .hive-layer .hm-inner { gap: 1px; }
        .hive-layer .hm-val { font-size: 17px; }
        .hive-layer .hm-lbl { font-size: 7.5px; }
        /* states recompose the slot translate instead of wiping it */
        .hive-layer .sc-hud-tile:hover, .hive-layer .hive-mini:hover {
            transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(1.07); z-index: 12;
        }
        .hive-layer .sc-hud-tile.neighbor-active, .hive-layer .hive-mini.neighbor-active,
        .hive-layer .sc-hud-tile:has(.retro-map-btn-active),
        .hive-layer .hive-mini:has(.retro-map-btn-active) {
            transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(0.97);
        }
        .hive-layer .sc-hud-tile.sm.engaged {
            transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(0.97);
        }
        /* bloom / fold — collapsed cells shrink into the pentagon core */
        .sc-deck:not(.is-expanded) .hive-layer .sc-hud-tile,
        .sc-deck:not(.is-expanded) .hive-layer .hive-mini {
            opacity: 0; pointer-events: none;
            transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(0.3);
            transition-delay: 0ms;
        }
        /* traffic cells idle until Aircraft is engaged — no holes in the comb */
        .hive-layer .hive-mini.hive-dim { opacity: 0.28; pointer-events: none; }
        .sc-deck:not(.is-expanded) .hive-layer .hive-mini.hive-dim { opacity: 0; }
        /* drag-to-arrange: ghost follows pointer, target slot lights up */
        body.hive-dragging { user-select: none; -webkit-user-select: none; }
        body.hive-dragging * { cursor: grabbing !important; }
        .hive-layer .hive-grab {
            z-index: 40 !important; transition: none !important;
            transform: translate(var(--gx, 0px), var(--gy, 0px)) scale(1.1) !important;
            filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.6));
        }
        .hive-layer .hive-drop { background-color: var(--accent-neon) !important; }
        @media (max-width: 1100px) {
            .hive-layer { transform: scale(0.8); transform-origin: top left; }
        }

        /* Blueprint HUD container (centra compliance-tab design language) */
        .sc-hud-container {
            position: relative;
            background-color: var(--bg-card);
            background-image:
                linear-gradient(to right, rgba(203, 213, 225, 0.07) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(203, 213, 225, 0.07) 1px, transparent 1px);
            background-size: 20px 20px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px 14px;
            overflow: hidden;
        }
        .sc-hud-grid { display: flex; flex-direction: column; gap: 6px; align-items: center; }
        .sc-hud-row { display: flex; gap: 8px; justify-content: center; transition: transform 0.3s ease; }
        .sc-hud-row.offset-row { transform: translateX(28px); }
        .sc-hud-tile {
            position: relative; width: 165px; height: 120px;
            background-color: var(--border-color);
            padding: 1.5px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }
        .sc-hud-tile.cut-tr-bl { clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 22px 100%, 0 calc(100% - 22px)); }
        .sc-hud-tile.cut-tr-bl .sc-hud-inner { clip-path: polygon(0 0, calc(100% - 21px) 0, 100% 21px, 100% 100%, 21px 100%, 0 calc(100% - 21px)); }
        .sc-hud-tile.cut-tl-br { clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px); }
        .sc-hud-tile.cut-tl-br .sc-hud-inner { clip-path: polygon(21px 0, 100% 0, 100% calc(100% - 21px), calc(100% - 21px) 100%, 0 100%, 0 21px); }
        .sc-hud-inner {
            background-color: var(--bg-card); width: 100%; height: 100%;
            padding: 10px;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
            position: relative;
            transition: background-color 0.2s ease;
        }
        .sc-hud-tile:hover { z-index: 10; background-color: rgba(255, 255, 255, 0.35); transform: scale(1.06); filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5)); }
        .sc-hud-tile:hover .sc-hud-inner { background-color: var(--bg-light); }
        .sc-hud-tile.neighbor-active { background-color: #10b981; transform: scale(0.98); }
        .sc-hud-tile.neighbor-active .sc-wireframe-box { border-color: #10b981; }

        .sc-tile-live { background-color: rgba(34, 211, 238, 0.55); }
        .sc-tile-signal { background-color: rgba(244, 63, 94, 0.55); }
        .sc-tile-indices { background-color: rgba(223, 241, 64, 0.55); }
        .sc-tile-live .sc-hud-value { color: #22d3ee; }
        .sc-tile-signal .sc-hud-value { color: var(--red); }
        .sc-tile-indices .sc-hud-value { color: var(--accent-neon); }

        .sc-wireframe-boxes { display: flex; gap: 3px; position: absolute; top: 6px; left: 12px; }
        .sc-wireframe-box { width: 8px; height: 8px; border: 1px solid #94a3b8; border-radius: 1px; transition: all 0.2s ease; }
