let fx=0,fy=0,dragging=false,sx=0,sy=0,sr=0,st=0;
document.getElementById('yonoHeader').addEventListener('pointerdown',function(e){
  if(docked)return; // no free-position dragging while docked in Maven
  if(e.target.closest('.yono-hbtn'))return;dragging=true;sx=e.clientX;sy=e.clientY;
