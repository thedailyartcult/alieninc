    /* -------------------------------------------------------- markers ---- */
    function clearMarkers() {
        S.markers.forEach(function (mk) { try { mk.remove(); } catch (e) {} });
        S.markers = [];
        Object.keys(S.detMarkers).forEach(function (k) {
            try { S.detMarkers[k].remove(); } catch (e) {}
        });
        S.detMarkers = {};
    }
    function chosenSig() {
        var sig = [], n = 0;
        function push(d, st) { if (n < 30) { sig.push(d.pk + ':' + st); n++; } }
        S.state.detections.forEach(function (d) {
            var st = d.validated === true ? 'y' : (d.validated === false ? 'n' : 'p');
            if (st === 'p') push(d, st);
        });
        for (var i = 0; i < S.state.detections.length; i++) {
            var d = S.state.detections[i];
            push(d, d.validated === true ? 'y' : (d.validated === false ? 'n' : 'p'));
        }
        return sig.join(',');
    }
    function drawMarkers() {
        var m = getMap();
        if (!m) return;
        try { window.__mvDetMarkers = S.detMarkers; } catch (e) {}
        var msig = S.state.assets.map(function (a) {
            return a.callsign + a.state + (Number(a.lat) || 0).toFixed(2) + (Number(a.lng) || 0).toFixed(2);
        }).join('|') + '#' + chosenSig();
        if (msig === drawMarkers.__last) return;
        drawMarkers.__last = msig;
        // Assets: reuse DOM nodes in place (diff updater keeps it snappy).
        // NB: no silent auto-fitBounds — the operator frames the map via the
        // FLY buttons; surprise viewport yanks made placement feel impossible.
        while (S.markers.length < S.state.assets.length) {
            var idx = S.markers.length, a0 = S.state.assets[idx];
            var el = svgFrame(a0.asset_class);
            el.title = a0.callsign;
            var mk = new maplibregl.Marker({ element: el })
                .setLngLat([isFinite(a0.lng) ? a0.lng : 0, isFinite(a0.lat) ? a0.lat : 0])
                .addTo(m);
            S.markers.push(mk);
        }
        while (S.markers.length > S.state.assets.length) { S.markers.pop().remove(); }
        S.state.assets.forEach(function (a, i) {
            var mk = S.markers[i];
            if (!isFinite(a.lat) || !isFinite(a.lng)) return;
            mk.setLngLat([a.lng, a.lat]);
            mk.getElement().title = a.callsign + ' · ' + a.state +
                (a.eta_remaining_s ? ' · ETA ' + Math.round(a.eta_remaining_s / 60) + 'min' : '');
        });
        // Detections: diff by pk. Marker cap: every unvalidated detection
        // plus newest validated ones, max 30 DOM nodes — the full list stays
        // in the drawer; a dense AOI must not carpet the map with markers.
        var MAX_DET_MARKERS = 30, chosen = [], picked = {};
        function pickDet(d) {
            if (picked[d.pk] || chosen.length >= MAX_DET_MARKERS) return;
            picked[d.pk] = 1; chosen.push(d);
        }
        S.state.detections.forEach(function (d) {
            if (d.validated === null || typeof d.validated === 'undefined') pickDet(d);
        });
        for (var di = 0; di < S.state.detections.length; di++) pickDet(S.state.detections[di]);
        var seen = {};
        chosen.forEach(function (d) {
            if (!isFinite(d.lat) || !isFinite(d.lng)) return;
            seen[d.pk] = true;
            var kind = d.validated === true ? 'det-ok' : (d.validated === false ? 'det-no' : 'det');
            var mk = S.detMarkers[d.pk];
            if (!mk) {
                var _t = parseInt(d.threat_score, 10);
                var el = svgFrame(kind, kind === 'det' && !isNaN(_t) ? mvTier(_t).col : null);
                var dm = new maplibregl.Marker({ element: el }).setLngLat([d.lng, d.lat]).addTo(m);
                dm.getElement().addEventListener('click', function () { detPopup(d); });
                S.detMarkers[d.pk] = dm;
            } else {
                mk.setLngLat([d.lng, d.lat]);
            }
            var _th = parseInt(d.threat_score, 10);
            S.detMarkers[d.pk].getElement().title =
                (d.label || 'contact') +
                (!isNaN(_th) ? ' \u00b7 T:' + _th : '') +
                (d.pattern ? ' \u00b7 ' + d.pattern : '') +
                ' \u00b7 conf ' + Math.round((d.confidence || 0) * 100) + '%';
        });
        Object.keys(S.detMarkers).forEach(function (pk) {
            if (!seen[pk]) { S.detMarkers[pk].remove(); delete S.detMarkers[pk]; }
        });
    }
