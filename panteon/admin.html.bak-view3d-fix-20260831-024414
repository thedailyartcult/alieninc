/* ==========================================================================
   CONSTANCIO BERNARDO THEME ENGINE (Wild Flower Series II, 1977)
   ========================================================================== */
(function() {
    'use strict';
    // 4 Keyframe Palettes derived directly from Bernardo's 4 Panels
    const BERNARDO_PANELS = [
        {
            // Panel I: Emerald / Sage / Cadmium Amber
            bg: [22, 45, 34],
