    try {
        const pre = await simsApi('research/bh-gate?k=5');
        const r = await simsApi('research/improve', { method: 'POST', timeout: 180000, body: '{}' });
        if (r.error) throw new Error(r.error);
        const changes = r.changes || [];
        alert(`Self-improvement complete: ${r.changes_applied} parameter change(s).\n\n` +
            (changes.length ? changes.map(c => `${c.doctrine}/${c.terrain} ${c.field}: ${Number(c.before).toFixed(2)}→${Number(c.after).toFixed(2)} (win ${(100 * c.win_rate).toFixed(0)}%, p=${Number(c.p_value).toFixed(4)})`).join('\n') : 'No change survived the significance gate.') +
            (pre && !pre.error ? `\n\nGate context: ${pre.hypotheses_tested} tested, ${pre.hypotheses_survived} survived at FDR ${pre.fdr}.` : ''));
