let fusionDataLoaded = false;

async function preloadFusionData(force) {
    if (fusionDataLoaded && !force) return;
    fusionDataLoaded = true;
    try {
        await doPreloadFusionData();
    } finally {
        fusionDataLoaded = false;
    }
}
window.__forceFusionReload = function () { return preloadFusionData(true); };
async function doPreloadFusionData() {
    const hud = document.getElementById('fusionMapHud');
    if (hud) hud.textContent = 'Loading GDELT + OpenSky data…';
    // Fetch both sources in parallel.
    let events = [], flights = [];
    try {
        const cc2 = (typeof scCountryFips === 'function' && SCScope.country) ? ('&country=' + encodeURIComponent(SCScope.country)) : '';
        const [evData, flData] = await Promise.all([
            api('/gkg/events?limit=250' + cc2).catch(() => ({ events: [] })),
            api('/opensky/flights?limit=2000').catch(() => ({ flights: [] })),
        ]);
        events = gkgEventsFrom(evData && evData.events);
        flights = (flData && flData.flights) || [];
        if (flData && flData.meta) fusionFeedMeta = flData.meta;
    } catch (e) { /* keep empty */ }
    // Filter to scope bbox (client-side post-filter; backend scoping happens on run)
    const bbox = scBbox();
    if (bbox) {
        events = events.filter(ev => {
            const g = parseActionGeo(ev);
            if (!g) return false;
            return g.latitude >= bbox.lamin && g.latitude <= bbox.lamax &&
                   g.longitude >= bbox.lomin && g.longitude <= bbox.lomax;
        });
        flights = flights.filter(f => {
            const p = normalizeAircraftPoint(f);
            if (!p) return false;
            return p.lat >= bbox.lamin && p.lat <= bbox.lamax &&
                   p.lng >= bbox.lomin && p.lng <= bbox.lomax;
        });
    }
    fusionThreatEvents = events;
    fusionFlights = flights;
    window.fusionThreatEvents = fusionThreatEvents;
    window.fusionFlights = fusionFlights;
    updateFusionKpis();
    refreshFusionRateMeter();
    refreshFusionBqStatus();
    if (hud) hud.textContent = 'Data loaded - scoped to ' + (SCScope.country || SCScope.region);
}

async function renderFusionMap(forceReload) {
    if (forceReload) fusionDataLoaded = false;
    if (!scScopeComplete()) {
        scUpdateEmptyState();
        return;
    }
    scUpdateEmptyState();
    if (!fusionDataLoaded) await preloadFusionData();
    const map = initFusionMap();
    if (!map) return;
    const hud = document.getElementById('fusionMapHud');
    if (hud) hud.textContent = 'Loading GDELT + OpenSky data…';
    renderFusionThreatLayer();
    renderFusionAviationLayer();
    if (hud) hud.textContent = fusionThreatMarkers.length + ' threats · ' + fusionAviationMarkers.length + ' aircraft plotted';
    requestAnimationFrame(() => { if (fusionMap) fusionMap.resize(); });
    fitFusionBounds();
    // Anti-placebo: once the map is up, positions keep advancing on their own.
    startFusionLiveLoop();
}

