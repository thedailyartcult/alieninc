async function loadArsenalCounts(countries) {
    const results = await Promise.allSettled(
        countries.filter(c => c.name).map(c =>
            api('sims/ontology/arsenal/counts?country=' + encodeURIComponent(c.name))));
    results.forEach((r, i) => {
        const c = countries.filter(x => x.name)[i];
        const cell = document.getElementById('arsCnt_' + simsEsc(c.iso3 || 'NA'));
        if (!cell) return;
        let val = '--';
        if (r.status === 'fulfilled' && r.value && r.value.available) {
            val = String(r.value.total ?? 0);
            c.__equipment_total = r.value.total ?? 0;
            c.__equipment_counts = r.value.counts || {};
        }
        cell.textContent = val;
    });
}

