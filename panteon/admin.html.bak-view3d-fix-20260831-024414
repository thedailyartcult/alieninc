async function loadCrossLineage() {
    try {
        const data = await api('/lineage/graph');
        const wsNodes = data.nodes.filter(n => n.node_type === 'workspace');
        const wsEdges = data.edges.filter(e => { const f = data.nodes.find(n => n.id === e.upstream_node_id); const t = data.nodes.find(n => n.id === e.downstream_node_id); return f && t && f.node_type === 'workspace' && t.node_type === 'workspace'; });
        const svg = document.getElementById('crossLineageSvg');
        const W = svg.clientWidth || 900, H = svg.clientHeight || 500;
        const edgeColors = { risk_data: '#3b82f6', vulnerability_data: '#ef4444', reports: '#f59e0b', cultural_programming: '#10b981' };
        const cx = W / 2, cy = H / 2, r = Math.min(W, H) * 0.35;
        const positions = {};
        wsNodes.forEach((n, i) => { const angle = (i / wsNodes.length) * Math.PI * 2 - Math.PI / 2; positions[n.id] = { x: cx + r * Math.cos(angle), y: cy + r * Math.sin(angle) }; });
        let svgContent = '';
        wsEdges.forEach(e => {
            const from = positions[e.upstream_node_id], to = positions[e.downstream_node_id];
            if (!from || !to) return;
            const col = edgeColors[e.edge_type] || '#83858c';
            const dx = to.x - from.x, dy = to.y - from.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const nx = dx / dist, ny = dy / dist;
            const x1 = from.x + nx * 40, y1 = from.y + ny * 40;
            const x2 = to.x - nx * 40, y2 = to.y - ny * 40;
            const mx = (x1 + x2) / 2 + ny * 30, my = (y1 + y2) / 2 - nx * 30;
            svgContent += '<path d="M' + x1 + ',' + y1 + ' Q' + mx + ',' + my + ' ' + x2 + ',' + y2 + '" fill="none" stroke="' + col + '" stroke-width="2" opacity="0.6" stroke-dasharray="6,3"><animate attributeName="stroke-dashoffset" from="0" to="-18" dur="2s" repeatCount="infinite"/></path>';
            const lx = mx, ly = my - 8;
            svgContent += '<text x="' + lx + '" y="' + ly + '" fill="' + col + '" font-size="9" text-anchor="middle" font-family="var(--font-sans)" opacity="0.8">' + (e.description ? e.description.slice(0, 30) : e.edge_type) + '</text>';
        });
        wsNodes.forEach(n => {
            const pos = positions[n.id];
            if (!pos) return;
            svgContent += '<circle cx="' + pos.x + '" cy="' + pos.y + '" r="36" fill="rgba(0,240,255,0.08)" stroke="var(--accent-cyan)" stroke-width="1.5"/><text x="' + pos.x + '" y="' + (pos.y + 4) + '" fill="white" font-size="11" text-anchor="middle" font-weight="500" font-family="var(--font-sans)">' + (n.name || n.node_id).slice(0, 14) + '</text>';
        });
        svg.innerHTML = svgContent;
        const details = document.getElementById('crossLineageDetails');
        if (wsEdges.length) {
            details.innerHTML = wsEdges.map(e => { const from = wsNodes.find(n => n.id === e.upstream_node_id); const to = wsNodes.find(n => n.id === e.downstream_node_id); const col = edgeColors[e.edge_type] || '#83858c'; return '<div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.04)"><span style="font-weight:500">' + (from ? from.name : '?') + '</span><span style="color:' + col + '">-- ' + e.edge_type + ' --></span><span style="font-weight:500">' + (to ? to.name : '?') + '</span><span style="font-size:10px;color:var(--text-dim);margin-left:auto">' + (e.description || '') + '</span></div>'; }).join('');
        } else { details.innerHTML = '<div class="empty-state">No cross-company data flows found</div>'; }
    } catch (e) { document.getElementById('crossLineageDetails').innerHTML = '<div class="empty-state">Error: ' + e.message + '</div>'; }
}

