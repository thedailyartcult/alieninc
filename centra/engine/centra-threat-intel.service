[Unit]
Description=Centra Threat Intelligence Sync
After=network.target alieninc.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/alieninc/centra/engine
ExecStart=/usr/bin/python3 /home/alieninc/centra/engine/threat_intel.py
StandardOutput=append:/home/alieninc/centra/engine/threat-intel.log
StandardError=append:/home/alieninc/centra/engine/threat-intel.log
