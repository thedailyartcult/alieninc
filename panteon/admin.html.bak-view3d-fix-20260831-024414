async function loadSimsResearch() {
    try {
        const [table, params, gate, findings] = await Promise.all([
            simsApi('research/strategy-table'),
            simsApi('research/parameters'),
            simsApi('research/bh-gate?k=20'),
            simsApi('research/findings?k=12'),
        ]);
        if (!table.error && table.matrix) { SIMS.learning = table; renderStrategyMatrix(table); }
        if (params.current) renderDoctrineParams(params);
        if (!gate.error) renderGate(gate);
        if (findings.findings) renderFindings(findings.findings);
        const lt = document.getElementById('simsLearningTag');
        if (params.current) {
            lt.textContent = `LEARNING: ${params.total_adjustments || 0} ADJ`;
            lt.className = 'tag tag-blue';
        }
    } catch (e) { /* gateway offline — tags already show it */ }
}

function renderStrategyMatrix(t) {
