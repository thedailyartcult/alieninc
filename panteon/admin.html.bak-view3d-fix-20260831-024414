        function sessionIsFresh(s) {
            if (!s || !s.expires_at) return false;
            return Date.now() < (s.expires_at * 1000) - 30000; // 30s skew margin
        }

        async function restoreSession() {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (session) {
                    if (sessionIsFresh(session)) return session;
                    // A stored-but-stale session must never be handed to the
                    // API layer: it 401s everywhere and doLogout() bounces the
                    // user to login even though fresh tokens sit in
                    // hs_session. Rotate it; if that fails, fall through.
                    try {
                        const { data: ref } = await supabaseClient.auth.refreshSession();
                        if (ref && ref.session && sessionIsFresh(ref.session)) return ref.session;
                    } catch (e) {}
                }
            } catch (e) {
                console.warn('getSession failed, trying localStorage fallback', e);
            }
            const raw = localStorage.getItem('hs_session');
            if (raw) {
                try {
                    const stored = JSON.parse(raw);
                    if (stored.access_token && stored.refresh_token) {
                        const { data, error } = await supabaseClient.auth.setSession({ access_token: stored.access_token, refresh_token: stored.refresh_token });
                        if (!error && data.session && sessionIsFresh(data.session)) return data.session;
                    }
                } catch (e) {
                    console.warn('setSession from localStorage failed', e);
                }
            }
            return null;
        }

