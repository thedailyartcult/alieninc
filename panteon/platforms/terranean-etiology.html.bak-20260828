<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panteon | Terranean Etiology — Causal Forensics at the Scale of Reality</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@900&family=Montserrat:wght@500;700&family=Playfair+Display:wght@600&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../styles.css">
    <style>
        .platform-hero {
            position: relative;
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 160px 40px 100px;
            overflow: hidden;
            background-color: var(--bg-dark);
        }
        .platform-hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }
        .platform-hero-content .tag {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 20px;
            display: block;
        }
        .platform-hero-content h1 { font-family: var(--font-tech);
            font-size: clamp(2.6rem, 6vw, 4.4rem);
            font-weight: 300;
            line-height: 1.05;
            letter-spacing: -0.03em;
            margin-bottom: 24px;
            color: var(--text-light);
        }
        .platform-hero-content p {
            font-size: 1.15rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.65);
            max-width: 600px;
            margin: 0 auto;
        }
        /* Terranean contour mountain — fixed global homepage-style renderer */
        #webgl-bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            pointer-events: none;
            display: block;
            background-color: var(--bg-light);
            opacity: 1;
            transition: opacity 0.6s ease;
        }
        @media (prefers-reduced-motion: reduce) {
            #webgl-bg-canvas { display: none; }
        }
        /* Make content reveal mountain — Panteon white glass (like index.html) */
        main.main-content { background-color: transparent; position: relative; z-index: 10; }
        .prose-section, .section, .editorial-callout { background-color: transparent; position: relative; z-index: 10; }
        .architecture-card { background-color: rgba(255,255,255,0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .workflow-step { background-color: rgba(255,255,255,0.72); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 0; }
        .platform-hero { background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.32) 100%); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); position: relative; z-index: 10; }
        .platform-nav { background-color: rgba(255,255,255,0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); position: relative; z-index: 10; }
        .platform-nav {
            display: flex;
            gap: 6px;
            padding: 24px 40px;
            border-bottom: 1px solid var(--border-dark);
            max-width: 1400px;
            margin: 0 auto;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .platform-nav::-webkit-scrollbar { display: none; }
        .platform-nav a {
            padding: 8px 18px;
            font-size: 0.85rem;
            color: var(--text-muted);
            border-radius: 0px;
            white-space: nowrap;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }
        .platform-nav a:hover { color: var(--text-dark); }
        .platform-nav a.active {
            color: var(--text-dark);
            background-color: #ffffff;
            border-color: rgba(0, 0, 0, 0.15);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }
        .architecture-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
        }
        .architecture-card {
            border: 1px solid var(--border-dark);
            border-radius: 0px;
            padding: 48px 40px;
            background: var(--bg-light);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .architecture-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }
        .architecture-card .card-tag {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 16px;
            display: block;
        }
        .architecture-card h3 { font-family: var(--font-tech);
            font-size: 1.3rem;
            font-weight: 400;
            letter-spacing: -0.01em;
            margin-bottom: 16px;
        }
        .architecture-card p {
            font-size: 0.95rem;
            line-height: 1.55;
            color: var(--text-muted);
        }
        .prose-section {
            max-width: 800px;
            margin: 0 auto;
            padding: 100px 40px;
        }
        .prose-section h2 { font-family: var(--font-tech);
            font-size: 2.4rem;
            font-weight: 300;
            letter-spacing: -0.02em;
            margin-bottom: 32px;
        }
        .prose-section p {
            font-size: 1.05rem;
            line-height: 1.75;
            color: var(--text-muted);
            margin-bottom: 24px;
        }
        .prose-section p strong {
            color: var(--text-dark);
            font-weight: 500;
        }
        .workflow-steps {
            display: flex;
            flex-direction: column;
            gap: 0;
        }
        .workflow-step {
            display: grid;
            grid-template-columns: 80px 1fr 1fr;
            gap: 40px;
            align-items: center;
            padding: 44px 20px;
            border-top: 1px solid var(--border-dark);
        }
        .workflow-step:last-child {
            border-bottom: 1px solid var(--border-dark);
        }
        .workflow-step .step-num {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .workflow-step h3 { font-family: var(--font-tech);
            font-size: 1.2rem;
            font-weight: 400;
            margin-bottom: 8px;
        }
        .workflow-step p {
            font-size: 0.95rem;
            line-height: 1.55;
            color: var(--text-muted);
        }
        .workflow-step .step-media {
            width: 100%;
            aspect-ratio: 16 / 9;
            background-color: #000000;
            border: 1px solid var(--border-dark);
            border-radius: 0px;
            overflow: hidden;
        }
        .workflow-step .step-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        @media (max-width: 1024px) {
            .architecture-grid { grid-template-columns: 1fr; }
            .workflow-step { grid-template-columns: 1fr; gap: 16px; }
        }
        @media (max-width: 768px) {
            .platform-hero { padding: 120px 24px 60px; }
            .platform-nav { padding: 16px 24px; }
            .prose-section { padding: 60px 24px; }
        }
    
        .logo svg{fill:currentColor;width:118px;height:34px;transition:transform .4s cubic-bezier(.16,1,.3,1)}
        .logo:hover svg{transform:none}
    </style>
</head>
<body>

    <!-- Single-source brand lockup: the custom P and ANTEON share one SVG coordinate system. -->
    <svg aria-hidden="true" width="0" height="0" style="position:absolute;overflow:hidden">
        <defs>
            <filter id="panteon-brush" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.23" numOctaves="4" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="0.85" xChannelSelector="R" yChannelSelector="B"/></filter>
            <mask id="panteon-roll"><rect width="100" height="100" fill="white"/><path d="M16 60 C20 58 24 59 27 63" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round"/></mask>
            <g id="panteon-lockup" fill="currentColor"><g transform="translate(4 -4) scale(0.98)"><g filter="url(#panteon-brush)"><path d="M63 19 C57 19 54 23 54 29 L54 55 C54 59 56 62 60 64 L46 64 C42 64 40 66 40 68 C41 70 44 70 48 70 L65 70 C69 70 72 67 72 63 L72 29 C72 23 69 19 63 19 Z"/><circle cx="20" cy="64" r="7" mask="url(#panteon-roll)"/></g></g><text x="78" y="62" fill="currentColor" font-family="'Zen Dots', Inter, Arial, sans-serif" font-size="60" font-weight="300" letter-spacing="0.9">PANTEON</text></g>
        </defs>
    </svg>

